{
  "Routes": [
    {
      "//": "Admin panel traffic. ChamundaHandicraft.Admin calls /Admin/<Controller>/<Action>.",
      "DownstreamPathTemplate": "/api/admin/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7139
        }
      ],
      "UpstreamPathTemplate": "/Admin/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
      "HttpHandlerOptions": {
        "AllowAutoRedirect": false,
        "UseCookieContainer": false,
        "UseTracing": true,
        "TimeoutValue": 100000
      }
    },
    {
      "//": "Storefront traffic. ChamundaHandicraft.Storefront calls /Shop/<Controller>/<Action>.",
      "DownstreamPathTemplate": "/api/storefront/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7139
        }
      ],
      "UpstreamPathTemplate": "/Shop/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
      "HttpHandlerOptions": {
        "AllowAutoRedirect": false,
        "UseCookieContainer": false,
        "UseTracing": true,
        "TimeoutValue": 100000
      }
    },
    {
      "//": "Anonymous public surface: sitemap, robots, tracking by token, gateway callbacks.",
      "DownstreamPathTemplate": "/api/public/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7139
        }
      ],
      "UpstreamPathTemplate": "/Public/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "HttpHandlerOptions": {
        "AllowAutoRedirect": false,
        "UseCookieContainer": false,
        "UseTracing": true,
        "TimeoutValue": 100000
      }
    },
    {
      "//": "Inbound webhooks from payment gateways, couriers and the email provider.",
      "DownstreamPathTemplate": "/api/webhooks/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7139
        }
      ],
      "UpstreamPathTemplate": "/Webhooks/{everything}",
      "UpstreamHttpMethod": [ "POST" ],
      "HttpHandlerOptions": {
        "AllowAutoRedirect": false,
        "UseCookieContainer": false,
        "UseTracing": true,
        "TimeoutValue": 100000
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7138"
  }
}
