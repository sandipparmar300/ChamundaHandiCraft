{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "AppDbContext": "Server=.;Database=ChamundaHandicraft;User Id=;Password=;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Jwt": {
    "JwtKey": "",
    "JwtIssuer": "ChamundaHandicraft.API",
    "JwtAudience": "ChamundaHandicraft.Clients",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },

  "Storage": {
    "//": "S3 or local disk. Provider = S3 | Local",
    "Provider": "Local",
    "LocalRoot": "wwwroot/uploads",
    "S3": {
      "BucketName": "",
      "Region": "ap-south-1",
      "AccessKey": "",
      "SecretKey": "",
      "CdnBaseUrl": ""
    }
  },

  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Chamunda Handicraft"
  },

  "Sms": {
    "Provider": "",
    "ApiKey": "",
    "SenderId": ""
  },

  "WhatsApp": {
    "Provider": "",
    "ApiKey": "",
    "PhoneNumberId": ""
  },

  "PaymentGateways": {
    "//": "Live credentials belong in GatewayCredentials (encrypted at rest), not here.",
    "Default": "",
    "Razorpay": { "Enabled": false, "KeyId": "", "WebhookSecret": "" },
    "Payu": { "Enabled": false, "MerchantKey": "", "WebhookSecret": "" },
    "Cod": { "Enabled": true, "MaxOrderValue": 20000 }
  },

  "Couriers": {
    "Shiprocket": { "Enabled": false, "Email": "", "Password": "" },
    "Delhivery": { "Enabled": false, "ApiToken": "" }
  },

  "BackgroundJobs": {
    "AbandonedCartRecoveryEnabled": true,
    "LowStockAlertEnabled": true,
    "OrderStatusSyncEnabled": true,
    "ReportAggregationEnabled": true,
    "SitemapRegenerationEnabled": true,
    "ReviewRequestEnabled": true
  },

  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordExpiryDays": 90,
    "TwoFactorRequiredForRoles": [ "Super Admin", "Admin", "Finance" ]
  }
}
