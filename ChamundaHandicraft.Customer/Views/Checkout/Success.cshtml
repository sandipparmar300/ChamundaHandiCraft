@model OrderDetailViewModel
@{
    Layout = "_CheckoutLayout";
    var orderNumber = Model.Header?.OrderNumber ?? (ViewData["OrderNumber"] as string ?? "CH-2026-000000");
    var summary = Model.Summary ?? new OrderSummaryViewModel();
    var deliveryBy = Model.Header?.DeliveryBy ?? DateTime.Today.AddDays(4);
    var shipping = Model.ShippingAddress ?? new AddressViewModel();
    var recipientName = !string.IsNullOrWhiteSpace(shipping.FullName) ? shipping.FullName : "Valued Patron";
    var paymentMethodLabel = Model.PaymentMethod switch
    {
        PaymentMethod.CashOnDelivery => "Cash on Delivery (COD)",
        PaymentMethod.Upi => "Instant UPI",
        PaymentMethod.Card => "Credit / Debit Card",
        PaymentMethod.NetBanking => "Net Banking",
        _ => Model.PaymentMethod.ToString()
    };
}

<div class="container-wide" style="padding-block:var(--space-xl)">

    <div class="confirm-card">
        <span class="confirm-card__check">
            <svg class="ico ico-2xl" aria-hidden="true"><use href="#i-circle-check"></use></svg>
        </span>

        <h1 class="t-display-lg">Order Confirmed!</h1>
        <p class="t-body-lg text-secondary-c mt-sm">
            Thank you, <strong>@recipientName</strong>. Your handcrafted pieces are being prepared with artisanal care.
        </p>

        <div class="row-flex center wrap gap-sm mt-md">
            <span class="order-number">
                @orderNumber
                <button class="icon-btn icon-btn-sm" type="button" onclick="navigator.clipboard.writeText('@orderNumber'); alert('Order number copied: @orderNumber');" aria-label="Copy order number">
                    <svg class="ico ico-xs" aria-hidden="true"><use href="#i-copy"></use></svg>
                </button>
            </span>
        </div>

        <p class="t-body-sm text-secondary-c mt-md">
            A confirmation message has been dispatched to <strong>@shipping.Phone</strong>.
        </p>

        <div class="row-flex center wrap gap-sm mt-lg">
            <a class="btn btn-primary btn-lg" href="/">Continue Shopping</a>
            <a class="btn btn-outline btn-lg" href="/account/orders/@orderNumber">View Order Status</a>
            <button class="btn btn-ghost btn-lg" type="button" onclick="window.print()">
                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-printer"></use></svg>
                Print Receipt
            </button>
        </div>
    </div>

    @* Delivery promise, stated as a date *@
    <div class="card card-craft mt-lg">
        <div class="row-flex gap-md">
            <span class="trust-badge__icon shrink-0"><svg class="ico ico-lg" aria-hidden="true"><use href="#i-truck"></use></svg></span>
            <div class="grow">
                <p class="t-heading-sm text-craft-c">Estimated Delivery by @deliveryBy.ToString("dddd, dd MMMM yyyy")</p>
                <p class="t-body-sm text-craft-c">
                    Delivering to <strong>@shipping.City, @shipping.State (@shipping.Pincode)</strong>.
                    You will receive tracking updates as soon as our artisans dispatch your parcel.
                </p>
            </div>
        </div>
    </div>

    @* Mandatory variation notice for handmade goods *@
    <div class="mt-md">
        @await Html.PartialAsync("_VariationNotice")
    </div>

    @* ---- What you ordered ---- *@
    <section class="card mt-lg">
        <h2 class="t-heading-md mb-md">Order Items (@Model.Lines.Count)</h2>

        <ul>
            @foreach (var line in Model.Lines)
            {
                <li class="cart-line" style="grid-template-columns:72px minmax(0,1fr) auto">
                    <a class="cart-line__media" href="/p/@line.Slug">
                        <img class="img-product" src="@line.ImageUrl" alt="@line.ImageAlt" width="72" height="72" loading="lazy" />
                    </a>
                    <div class="grow">
                        <a class="cart-line__title" href="/p/@line.Slug">@line.Name</a>
                        <p class="cart-line__meta">
                            @(string.IsNullOrWhiteSpace(line.VariantSummary) ? "" : $"{line.VariantSummary} · ")Qty @line.Quantity · Sku: @line.Sku
                        </p>
                        <span class="artisan-chip mt-2xs">
                            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-hand-heart"></use></svg>
                            100% Handcrafted Original
                        </span>
                    </div>
                    <span class="t-body-md tabular" style="font-weight:600">@Money.Inr(line.LineTotal)</span>
                </li>
            }
        </ul>

        <div class="layout-halves mt-lg" style="align-items:start">
            <div>
                <h3 class="t-heading-xs mb-xs">Delivering to</h3>
                <p class="t-body-sm text-secondary-c">
                    <strong class="text-primary-c">@shipping.FullName</strong><br />
                    @shipping.OneLine<br />
                    Phone: @shipping.Phone
                </p>
            </div>

            <dl class="summary">
                <div class="summary__row">
                    <dt>Subtotal</dt>
                    <dd class="tabular">@Money.Inr(summary.Subtotal)</dd>
                </div>
                @if (summary.CouponDiscount > 0)
                {
                    <div class="summary__row summary__row--discount">
                        <dt>Coupon Discount (@summary.CouponCode)</dt>
                        <dd class="tabular">−@Money.Inr(summary.CouponDiscount)</dd>
                    </div>
                }
                <div class="summary__row">
                    <dt>Delivery</dt>
                    <dd class="tabular">@(summary.Shipping == 0 ? "Free" : Money.Inr(summary.Shipping))</dd>
                </div>
                @if (summary.CodFee > 0)
                {
                    <div class="summary__row">
                        <dt>COD Convenience Fee</dt>
                        <dd class="tabular">@Money.Inr(summary.CodFee)</dd>
                    </div>
                }
                <div class="summary__row">
                    <dt>Payment Method</dt>
                    <dd class="text-secondary-c" style="font-weight:600">@paymentMethodLabel</dd>
                </div>
                <div class="summary__total">
                    <dt>Total Paid</dt>
                    <dd class="tabular">@Money.Inr(summary.Total)</dd>
                </div>
            </dl>
        </div>

        <div class="row-flex wrap gap-sm mt-lg no-print">
            <a class="btn btn-outline btn-sm" href="/account/orders/@orderNumber">
                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-file-text"></use></svg>
                View Full Order Details
            </a>
            <a class="btn btn-ghost btn-sm" href="/contact">Need help with your order? Contact Support</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            var colours = ['#B85D19', '#2C1810', '#D4AF37', '#059669'];
            var host = document.querySelector('.confirm-card');
            if (!host) return;

            host.style.position = 'relative';
            host.style.overflow = 'hidden';

            for (var i = 0; i < 40; i++) {
                var bit = document.createElement('span');
                bit.style.cssText =
                    'position:absolute;top:-12px;width:7px;height:12px;pointer-events:none;border-radius:1px;' +
                    'left:' + (Math.floor(i * 2.5) % 100) + '%;' +
                    'background:' + colours[i % colours.length] + ';' +
                    'animation:fall ' + (1000 + (i % 7) * 120) + 'ms ease-in ' + (i % 5) * 60 + 'ms forwards';
                host.appendChild(bit);
            }

            var style = document.createElement('style');
            style.textContent =
                '@@keyframes fall{to{transform:translateY(320px) rotate(540deg);opacity:0}}';
            document.head.appendChild(style);

            setTimeout(function () {
                host.querySelectorAll('span[style*="fall"]').forEach(function (s) { s.remove(); });
            }, 2400);
        })();
    </script>
}
