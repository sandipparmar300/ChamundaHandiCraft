@model ListingViewModel
@{
    var crumbs = ViewData["Breadcrumbs"] as List<BreadcrumbItem>;

    var sortOptions = new (string Value, string Label)[]
    {
        ("popularity", "Popularity"),
        ("latest", "Latest"),
        ("bestselling", "Bestselling"),
        ("rating", "Rating"),
        ("price-asc", "Price: Low to High"),
        ("price-desc", "Price: High to Low"),
        ("discount", "Discount")
    };

    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Math.Max(1, Model.PageSize));
}

<div class="container">
    @if (crumbs is not null)
    {
        @await Html.PartialAsync("_Breadcrumb", crumbs)
    }

    @* ---- Heading block. One H1 per page: the category name (SEO §10). ---- *@
    <div class="page-head">
        <h1 class="t-display-lg page-head__title">@Model.Heading</h1>
        <p class="page-head__sub measure clamp-3">@Model.Intro</p>
    </div>

    @* ---- Sub-category / Category chips ---- *@
    @if (Model.SubCategories != null && Model.SubCategories.Count > 0)
    {
        <div class="chip-nav mb-sm">
            <a class="chip-nav__item @(string.IsNullOrEmpty(Model.CategorySlug) && string.IsNullOrEmpty(Model.SelectedMaterial) ? "is-active" : "")"
               href="/shop">
                All <span class="text-tertiary-c">@Model.TotalCount</span>
            </a>
            @foreach (var sub in Model.SubCategories)
            {
                var isCatActive = string.Equals(Model.CategorySlug, sub.Slug, StringComparison.OrdinalIgnoreCase);
                <a class="chip-nav__item @(isCatActive ? "is-active" : "")"
                   href="/c/@sub.Slug">
                    @sub.Name <span class="text-tertiary-c">@sub.ProductCount</span>
                </a>
            }
        </div>
    }

    @* ---- Mobile sticky filter/sort bar ---- *@
    @{
        var activeFilterCount = (!string.IsNullOrEmpty(Model.SelectedMaterial) ? 1 : 0)
            + (Model.SelectedMinPrice.HasValue || Model.SelectedMaxPrice.HasValue ? 1 : 0)
            + (Model.InStockOnly == true ? 1 : 0)
            + (Model.Rating.HasValue ? 1 : 0);
    }
    <div class="filter-bar-mobile">
        <button class="btn btn-outline btn-sm grow" type="button" data-open="filterSheet">
            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-filter"></use></svg>
            Filters @if (activeFilterCount > 0) { <span class="counter counter-brand">@activeFilterCount</span> }
        </button>
        <button class="btn btn-outline btn-sm grow" type="button" data-open="sortSheet">
            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-sort"></use></svg>
            Sort
        </button>
    </div>

    <div class="layout-rail-grid">

        @* ---- Filter rail (desktop) ---- *@
        <aside class="hide-tablet-down sticky-col" aria-label="Filters">
            @await Html.PartialAsync("_FilterRail")
        </aside>

        <div>
            @* ---- Toolbar ---- *@
            <div class="plp-toolbar">
                <p class="t-body-md">
                    <strong class="tabular" aria-live="polite">@Model.TotalCount</strong>
                    <span class="text-secondary-c">products</span>
                </p>

                <div class="row-flex gap-sm hide-tablet-down">
                    <div class="sort-select">
                        <label class="t-body-sm text-secondary-c" for="sortSelect">Sort by</label>
                        <select class="select" id="sortSelect" onchange="var u = new URL(location.href); u.searchParams.set('sort', this.value); location.href = u.toString();">
                            @foreach (var option in sortOptions)
                            {
                                <option value="@option.Value" selected="@(Model.Sort == option.Value)">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div class="view-toggle" role="group" aria-label="View layout">
                        <button class="@(Model.View == "grid" ? "is-active" : "")" type="button"
                                aria-pressed="@(Model.View == "grid")" aria-label="Grid view">
                            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-grid"></use></svg>
                        </button>
                        <button class="@(Model.View == "list" ? "is-active" : "")" type="button"
                                aria-pressed="@(Model.View == "list")" aria-label="List view">
                            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-list"></use></svg>
                        </button>
                    </div>
                </div>
            </div>

            @* ---- Active filter bar — FL-11 / FL-12 ---- *@
            @{
                var hasActiveFilters = !string.IsNullOrEmpty(Model.SelectedMaterial)
                    || Model.SelectedMinPrice.HasValue
                    || Model.SelectedMaxPrice.HasValue
                    || Model.InStockOnly == true
                    || Model.Rating.HasValue;
            }
            @if (hasActiveFilters)
            {
                <div class="active-filters mb-md">
                    <span class="t-body-sm text-secondary-c">Filtered by</span>
                    @if (!string.IsNullOrEmpty(Model.SelectedMaterial))
                    {
                        <span class="chip is-active">
                            @Model.SelectedMaterial
                            <button class="chip__remove" type="button" aria-label="Remove @Model.SelectedMaterial filter"
                                    onclick="var u = new URL(location.href); u.searchParams.delete('material'); u.searchParams.set('page', '1'); location.href = u.toString();">
                                <svg class="ico ico-xs" aria-hidden="true"><use href="#i-x"></use></svg>
                            </button>
                        </span>
                    }
                    @if (Model.SelectedMinPrice.HasValue || Model.SelectedMaxPrice.HasValue)
                    {
                        <span class="chip is-active">
                            @(Model.SelectedMinPrice.HasValue ? $"From ₹{Model.SelectedMinPrice:N0}" : "")
                            @(Model.SelectedMaxPrice.HasValue ? $"Up to ₹{Model.SelectedMaxPrice:N0}" : "")
                            <button class="chip__remove" type="button" aria-label="Remove price filter"
                                    onclick="var u = new URL(location.href); u.searchParams.delete('minPrice'); u.searchParams.delete('maxPrice'); u.searchParams.set('page', '1'); location.href = u.toString();">
                                <svg class="ico ico-xs" aria-hidden="true"><use href="#i-x"></use></svg>
                            </button>
                        </span>
                    }
                    @if (Model.InStockOnly == true)
                    {
                        <span class="chip is-active">
                            In Stock
                            <button class="chip__remove" type="button" aria-label="Remove in stock filter"
                                    onclick="var u = new URL(location.href); u.searchParams.delete('inStock'); u.searchParams.set('page', '1'); location.href = u.toString();">
                                <svg class="ico ico-xs" aria-hidden="true"><use href="#i-x"></use></svg>
                            </button>
                        </span>
                    }
                    @if (Model.Rating.HasValue)
                    {
                        <span class="chip is-active">
                            @Model.Rating★ &amp; above
                            <button class="chip__remove" type="button" aria-label="Remove rating filter"
                                    onclick="var u = new URL(location.href); u.searchParams.delete('rating'); u.searchParams.set('page', '1'); location.href = u.toString();">
                                <svg class="ico ico-xs" aria-hidden="true"><use href="#i-x"></use></svg>
                            </button>
                        </span>
                    }
                    <a class="btn btn-link btn-sm" href="@(Model.CategorySlug is null ? "/shop" : $"/c/{Model.CategorySlug}")">Clear all</a>
                </div>
            }

            @if (Model.Products.Count == 0)
            {
                @* STA-03-02 · No results — icon, reason, active chips, clear action. *@
                <div class="state-block">
                    <span class="state-block__icon">
                        <svg class="ico ico-2xl" aria-hidden="true"><use href="#i-search"></use></svg>
                    </span>
                    <h2 class="t-heading-md">No pieces match these filters</h2>
                    <p class="state-block__desc">
                        Nothing in this catalog matches your current filter selection right now.
                        Widen the price, or clear a filter and try again.
                    </p>
                    <div class="state-block__actions">
                        <a class="btn btn-primary" href="@(Model.CategorySlug is null ? "/shop" : $"/c/{Model.CategorySlug}")">Clear all filters</a>
                        <a class="btn btn-outline" href="/shop">Browse everything</a>
                    </div>
                </div>
            }
            else
            {
                <div class="@(Model.View == "list" ? "pgrid-list" : "pgrid")">
                    @for (var i = 0; i < Model.Products.Count; i++)
                    {
                        var product = Model.Products[i];

                        if (Model.View == "list")
                        {
                            @await Html.PartialAsync("_ProductCardList", product)
                        }
                        else
                        {
                            @await Html.PartialAsync("_ProductCard", product)
                        }

                        @* Injected collection banner — max 1 per 8 cards, spans the grid. *@
                        if (Model.View == "grid" && i == 7)
                        {
                            <div class="pgrid__injection">
                                <a class="collection-banner" href="/shop">
                                    <img src="~/assets/images/placeholders/banner.svg"
                                         alt="Authentic handcrafted artisan collection" loading="lazy" />
                                    <span class="collection-banner__body">
                                        <span class="t-overline" style="color:rgba(255,255,255,.86)">Artisan Heritage</span>
                                        <span class="t-heading-lg" style="display:block;color:#fff;margin:4px 0 8px">Pure Handcrafted Elegance</span>
                                        <span class="btn btn-inverse btn-sm">Explore Collection</span>
                                    </span>
                                </a>
                            </div>
                        }
                    }
                </div>

                @* ---- Pagination: Dynamic pages and progress indicator ---- *@
                @if (totalPages > 1)
                {
                    <div class="load-more mt-2xl">
                        <div class="load-more__progress" role="progressbar"
                             aria-valuenow="@Model.Products.Count" aria-valuemin="0" aria-valuemax="@Model.TotalCount">
                            <span style="width:@(Math.Min(100, (Model.Page * Model.PageSize) * 100 / Math.Max(1, Model.TotalCount)))%"></span>
                        </div>
                        <nav class="pagination mt-sm" aria-label="Pagination">
                            @if (Model.Page > 1)
                            {
                                <a class="pagination__item" href="javascript:void(0)"
                                   onclick="var u = new URL(location.href); u.searchParams.set('page', '@(Model.Page - 1)'); location.href = u.toString();"
                                   aria-label="Previous page">
                                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-left"></use></svg>
                                </a>
                            }
                            else
                            {
                                <span class="pagination__item is-disabled" aria-label="Previous page">
                                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-left"></use></svg>
                                </span>
                            }

                            @for (var p = 1; p <= totalPages; p++)
                            {
                                if (p == Model.Page)
                                {
                                    <span class="pagination__item is-current" aria-current="page">@p</span>
                                }
                                else if (p <= 3 || p > totalPages - 2 || Math.Abs(p - Model.Page) <= 1)
                                {
                                    <a class="pagination__item" href="javascript:void(0)"
                                       onclick="var u = new URL(location.href); u.searchParams.set('page', '@p'); location.href = u.toString();">@p</a>
                                }
                                else if (p == 4 && Model.Page > 4 || p == totalPages - 2 && Model.Page < totalPages - 3)
                                {
                                    <span class="pagination__gap">…</span>
                                }
                            }

                            @if (Model.Page < totalPages)
                            {
                                <a class="pagination__item" href="javascript:void(0)"
                                   onclick="var u = new URL(location.href); u.searchParams.set('page', '@(Model.Page + 1)'); location.href = u.toString();"
                                   aria-label="Next page">
                                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                                </a>
                            }
                            else
                            {
                                <span class="pagination__item is-disabled" aria-label="Next page">
                                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                                </span>
                            }
                        </nav>
                    </div>
                }
            }
        </div>
    </div>

    @* ---- Category intro copy (80–150 words, editorially controlled) ---- *@
    <section class="band-sm">
        <div class="card">
            <h2 class="t-heading-md mb-sm">About @Model.Heading</h2>
            <div class="measure t-body-md text-secondary-c stack stack-sm">
                <p>@Model.Intro</p>
                <p>
                    Prices reflect what the maker is paid, not what a middleman adds. Every listing names the
                    artisan and their craft cluster, and shows a real delivery date once you enter a PIN code.
                    Because these are handmade, colour and finish vary a little from piece to piece — the
                    variation notice on each product page explains exactly what to expect.
                </p>
            </div>
        </div>
    </section>

    @* ---- Related categories ---- *@
    <section class="band-sm">
        <h2 class="t-heading-lg mb-md">Related categories</h2>
        <div class="cat-grid">
            @foreach (var category in DemoContent.Categories().Take(6))
            {
                <a class="cat-tile" href="@category.Url">
                    <img src="@category.ImageUrl" alt="@category.Name" loading="lazy" width="480" height="360" />
                    <span class="cat-tile__body">
                        <span class="cat-tile__title">@category.Name</span>
                        <span class="cat-tile__count">@category.ProductCount pieces</span>
                    </span>
                </a>
            }
        </div>
    </section>

    <section class="band-sm">
        @await Html.PartialAsync("_ProductRail", new ProductRailViewModel
        {
            Heading = "Recently viewed",
            Products = DemoContent.Products(5, 3),
            Compact = true
        })
    </section>
</div>

@* ---- SHT-03-01 · Filters sheet (mobile). Selections batch until "Show N products". ---- *@
<div class="sheet" id="filterSheet" role="dialog" aria-modal="true" aria-label="Filters"
     aria-hidden="true" data-scrim="globalScrim">
    <div class="sheet__handle"></div>
    <div class="sheet__head">
        <button class="icon-btn" data-close aria-label="Close filters">
            <svg class="ico ico-lg" aria-hidden="true"><use href="#i-x"></use></svg>
        </button>
        <h2 class="t-heading-md">Filters</h2>
        <button class="btn btn-link btn-sm" type="button">Clear all</button>
    </div>
    <div class="sheet__body">
        @await Html.PartialAsync("_FilterRail")
    </div>
    <div class="sheet__foot">
        <button class="btn btn-primary btn-xl btn-block" type="button" data-close>Show @Model.TotalCount products</button>
    </div>
</div>

@* ---- SHT-03-02 · Sort sheet (mobile) ---- *@
<div class="sheet" id="sortSheet" role="dialog" aria-modal="true" aria-label="Sort products"
     aria-hidden="true" data-scrim="globalScrim">
    <div class="sheet__handle"></div>
    <div class="sheet__head">
        <h2 class="t-heading-md">Sort by</h2>
        <button class="icon-btn" data-close aria-label="Close sort options">
            <svg class="ico ico-lg" aria-hidden="true"><use href="#i-x"></use></svg>
        </button>
    </div>
    <div class="sheet__body">
        @foreach (var option in sortOptions)
        {
            <label class="check" style="min-height:48px;align-items:center">
                <input type="radio" name="mobileSort" checked="@(Model.Sort == option.Value)"
                       onchange="var u = new URL(location.href); u.searchParams.set('sort', '@option.Value'); location.href = u.toString();" />
                <span class="check__label">@option.Label</span>
            </label>
        }
    </div>
</div>

@if (Model.Products.Count > 0)
{
    @await Html.PartialAsync("_QuickView", Model.Products[0])
}
