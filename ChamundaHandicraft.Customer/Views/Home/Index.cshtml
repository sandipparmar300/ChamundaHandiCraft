        <div class="trust-band card" style="padding:var(--space-md)">
            <div class="trust-badge">
                <span class="trust-badge__icon"><svg class="ico ico-lg" aria-hidden="true"><use href="#i-hand-heart"></use></svg></span>
                <span>
                    <span class="trust-badge__title">100% handmade</span>
                    <span class="trust-badge__sub">240 named artisans</span>
                </span>
            </div>
            <div class="trust-badge">
                <span class="trust-badge__icon"><svg class="ico ico-lg" aria-hidden="true"><use href="#i-undo"></use></svg></span>
                <span>
                    <span class="trust-badge__title">@Model.Config.ReturnWindowDays-day returns</span>
                    <span class="trust-badge__sub">Free pickup anywhere</span>
                </span>
            </div>
            <div class="trust-badge">
                <span class="trust-badge__icon"><svg class="ico ico-lg" aria-hidden="true"><use href="#i-shield-check"></use></svg></span>
                <span>
                    <span class="trust-badge__title">Secure payments</span>
                    <span class="trust-badge__sub">UPI, cards, COD</span>
                </span>
            </div>
            <div class="trust-badge">
                <span class="trust-badge__icon"><svg class="ico ico-lg" aria-hidden="true"><use href="#i-truck"></use></svg></span>
