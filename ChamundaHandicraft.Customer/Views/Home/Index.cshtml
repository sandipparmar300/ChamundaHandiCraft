@model HomeIndexViewModel
@{
    var banners = Model.HeroBanners != null && Model.HeroBanners.Count > 0
        ? Model.HeroBanners
        : new List<BannerViewModel>
        {
            new BannerViewModel
            {
                ImageUrl = "/assets/images/placeholders/hero.svg",
                Eyebrow = "Handmade for Diwali",
                Heading = "Light your home with pieces made by hand",
                SubHeading = "Brass diyas, blue pottery and festive décor from artisans across India — each piece credited to the person who made it.",
                PrimaryCtaLabel = "Shop the Collection",
                PrimaryCtaUrl = "/c/festive",
                SecondaryCtaLabel = "Meet the Makers",
                SecondaryCtaUrl = "/artisans"
            }
        };

    var materials = new (string Label, string Slug)[]
    {
        ("Brass", "brass"), ("Ceramic", "ceramic"), ("Terracotta", "terracotta"),
        ("Wood", "wood"), ("Cotton", "cotton"), ("Silk", "silk"),
        ("Silver", "silver"), ("Jute", "jute")
    };
}

@* ══════════ SEC-02-01 · Hero Carousel ══════════
   LCP surface. The first slide is eager with fetchpriority=high; the rest are
   lazy. Interactive carousel with smooth transitions, autoplay with pause on
   hover/focus, clickable navigation dots, and prev/next controls (A11Y-09). *@
<section class="container" style="padding-top:var(--space-md)" aria-label="Featured collection">
    <div class="hero hero-carousel" data-hero-carousel aria-roledescription="carousel" aria-label="Featured collection carousel">
        <div class="hero__slides" aria-live="polite">
            @for (int i = 0; i < banners.Count; i++)
            {
                var b = banners[i];
                var bImg = !string.IsNullOrWhiteSpace(b.ImageUrl) ? b.ImageUrl : "/assets/images/placeholders/hero.svg";
                var bTitle = !string.IsNullOrWhiteSpace(b.Heading) ? b.Heading : "Light your home with pieces made by hand";
                var bAlt = !string.IsNullOrWhiteSpace(b.ImageAlt) ? b.ImageAlt : bTitle;

                <div class="hero__slide @(i == 0 ? "is-active" : "")"
                     role="group"
                     aria-roledescription="slide"
                     aria-label="Slide @(i + 1) of @banners.Count"
                     data-slide-index="@i">

                    @if (!string.IsNullOrWhiteSpace(b.MobileImageUrl))
                    {
                        <picture>
                            <source media="(max-width: 640px)" srcset="@b.MobileImageUrl" />
                            <img class="hero__img" src="@bImg" alt="@bAlt"
                                 @(i == 0 ? Html.Raw("fetchpriority=\"high\"") : Html.Raw("loading=\"lazy\""))
                                 width="1200" height="500" />
                        </picture>
                    }
                    else
                    {
                        <img class="hero__img" src="@bImg" alt="@bAlt"
                             @(i == 0 ? Html.Raw("fetchpriority=\"high\"") : Html.Raw("loading=\"lazy\""))
                             width="1200" height="500" />
                    }

                    <div class="hero__scrim" aria-hidden="true"></div>

                    @if (!string.IsNullOrWhiteSpace(b.Eyebrow) || !string.IsNullOrWhiteSpace(b.Heading) || !string.IsNullOrWhiteSpace(b.SubHeading) || !string.IsNullOrWhiteSpace(b.PrimaryCtaLabel) || !string.IsNullOrWhiteSpace(b.SecondaryCtaLabel))
                    {
                        <div class="hero__body">
                            @if (!string.IsNullOrWhiteSpace(b.Eyebrow))
                            {
                                <span class="t-overline hero__eyebrow">@b.Eyebrow</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(b.Heading))
                            {
                                <h1 class="t-display-2xl hero__title mt-xs">@b.Heading</h1>
                            }
                            @if (!string.IsNullOrWhiteSpace(b.SubHeading))
                            {
                                <p class="hero__sub">@b.SubHeading</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(b.PrimaryCtaLabel) || !string.IsNullOrWhiteSpace(b.SecondaryCtaLabel))
                            {
                                <div class="hero__actions">
                                    @if (!string.IsNullOrWhiteSpace(b.PrimaryCtaLabel))
                                    {
                                        <a class="btn btn-primary btn-xl" href="@(string.IsNullOrWhiteSpace(b.PrimaryCtaUrl) ? "/c/festive" : b.PrimaryCtaUrl)">@b.PrimaryCtaLabel</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(b.SecondaryCtaLabel))
                                    {
                                        <a class="btn btn-inverse btn-xl" href="@(string.IsNullOrWhiteSpace(b.SecondaryCtaUrl) ? "/artisans" : b.SecondaryCtaUrl)">@b.SecondaryCtaLabel</a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (banners.Count > 1)
        {
            <button type="button" class="hero__nav-btn hero__nav-btn--prev" aria-label="Previous slide" data-hero-prev>
                <svg class="ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <button type="button" class="hero__nav-btn hero__nav-btn--next" aria-label="Next slide" data-hero-next>
                <svg class="ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>

            <div class="hero__dots" role="tablist" aria-label="Hero carousel pagination">
                @for (int i = 0; i < banners.Count; i++)
                {
                    <button type="button"
                            class="hero__dot @(i == 0 ? "is-active" : "")"
                            role="tab"
                            aria-selected="@(i == 0 ? "true" : "false")"
                            aria-label="Go to slide @(i + 1) of @banners.Count"
                            data-hero-dot="@i">
                    </button>
                }
            </div>
        }
    </div>
</section>

@* ══════════ SEC-02-02 · Trust badges strip ══════════
   Trust before persuasion — this sits above every urgency device on the page. *@
<section class="band-sm" aria-label="Our guarantees">
