                        <div class="t-body-sm text-secondary-c">artisans we buy from</div>
                    </div>
                    <div>
                        <div class="t-display-lg text-craft-c tabular">18</div>
                        <div class="t-body-sm text-secondary-c">craft clusters</div>
                    </div>
                    <div>
                        <div class="t-display-lg text-craft-c tabular">62%</div>
                        <div class="t-body-sm text-secondary-c">of price reaches the maker</div>
                    </div>
                </div>

                <div class="row-flex wrap gap-sm mt-lg">
                    <a class="btn btn-secondary btn-lg" href="/pages/about">Read Our Story</a>
                    <a class="btn btn-outline btn-lg" href="/artisans">Meet the Makers</a>
