@* ══════════ SEC-02-14 · Customer reviews ══════════
   Real reviews from verified purchases only — the authenticity note is mandatory. *@
@if (Model.Testimonials.Count > 0)
{
    <section class="band band-surface" aria-labelledby="revHead">
        <div class="container">
            <div class="band-head">
                <div class="band-head__text">
                    <h2 class="t-display-lg" id="revHead">What our customers say</h2>
                    <p class="band-head__sub">We only publish reviews from verified purchases.</p>
                </div>
                <div class="row-flex gap-xs">
                    <span class="rating rating-lg" aria-label="Average rating 4.9 out of 5 from verified customer feedback">
                        <span class="rating__stars">
                            @for (var i = 0; i < 5; i++)
                            {
                                <svg class="ico is-filled" aria-hidden="true"><use href="#i-star"></use></svg>
                            }
                        </span>
                        <span class="rating__value">5.0</span>
                        <span class="rating__count">verified feedback</span>
                    </span>
                </div>
            </div>

            <div class="rail-wrap">
                <div class="rail" tabindex="0" role="group" aria-label="Customer reviews">
                    @foreach (var review in Model.Testimonials)
                    {
                        <div class="testimonial">
                            <span class="rating" aria-label="Rated @review.Rating out of 5">
                                <span class="rating__stars">
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        <svg class="ico @(i < review.Rating ? "is-filled" : "")" aria-hidden="true"><use href="#i-star"></use></svg>
                                    }
                                </span>
                            </span>
                            <p class="testimonial__quote clamp-4">@review.Quote</p>
                            <div class="row-flex gap-xs mt-auto" style="padding-top:var(--space-sm)">
                                <span class="avatar avatar-sm">@(!string.IsNullOrEmpty(review.CustomerName) ? review.CustomerName[..1] : "C")</span>
                                <span class="grow">
                                    <span class="t-body-sm" style="font-weight:600;display:block">@review.CustomerName</span>
                                    <span class="review-card__verified">
                                        <svg class="ico ico-xs" aria-hidden="true"><use href="#i-badge-check"></use></svg>
                                        @(string.IsNullOrWhiteSpace(review.Location) ? "Verified Buyer" : review.Location)
                                    </span>
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

