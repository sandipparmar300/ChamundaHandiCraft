@* ══════════ SEC-02-03 · Shop by category ══════════ *@
<section class="band band-surface" aria-labelledby="catHead">
    <div class="container">
        <div class="band-head">
            <div class="band-head__text">
                <span class="craft-rule"></span>
                <h2 class="t-display-lg" id="catHead">Shop by category</h2>
                <p class="band-head__sub">Authentic craft collections from workshops across India.</p>
            </div>
            <a class="link-standalone" href="/shop">
                View all
