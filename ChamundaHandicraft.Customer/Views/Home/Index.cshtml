            </a>
        </div>

        <div class="cat-grid">
            @foreach (var category in Model.FeaturedCategories)
            {
                <a class="cat-tile reveal" href="@category.Url">
                    <img src="@(!string.IsNullOrWhiteSpace(category.ImageUrl) ? category.ImageUrl : "/assets/images/placeholders/category-1.svg")"
                         alt="@category.Name" loading="lazy" width="480" height="360" />
                    <span class="cat-tile__body">
                        <span class="cat-tile__title">@category.Name</span>
                        <span class="cat-tile__count">@category.ProductCount pieces</span>
                    </span>
                </a>
            }
        </div>
    </div>
</section>

@* ══════════ SEC-02-04 · Flash sale (conditional) ══════════
   Only rendered while a genuine scheduled sale window is open. *@
@if (Model.FlashSaleOffer != null && Model.FlashSaleOffer.IsLiveNow)
{
    var flashEndsAt = Model.FlashSaleOffer.EndsOn;
    <section class="band band-craft" aria-labelledby="flashHead">
        <div class="container">
            <div class="band-head">
                <div class="band-head__text">
                    <span class="t-overline text-craft-c">
                        <svg class="ico ico-xs" aria-hidden="true" style="display:inline;vertical-align:-2px"><use href="#i-flame"></use></svg>
                        @Model.FlashSaleOffer.OfferType @(Model.FlashSaleOffer.DiscountPercent > 0 ? $"({Model.FlashSaleOffer.DiscountPercent}% OFF)" : "")
                    </span>
                    <h2 class="t-display-lg" id="flashHead">@Model.FlashSaleOffer.Name, ending @Money.DeliveryDate(flashEndsAt)</h2>
                    <div class="countdown mt-sm" data-countdown-to="@flashEndsAt.ToString("O")"
                         aria-label="Sale ends on @Money.LongDate(flashEndsAt) at @flashEndsAt.ToString("h:mm tt")">
                        <span class="countdown__unit"><span class="countdown__num" data-cd-hours>--</span><span class="countdown__lbl">Hrs</span></span>
                        <span class="countdown__unit"><span class="countdown__num" data-cd-mins>--</span><span class="countdown__lbl">Min</span></span>
                        <span class="countdown__unit"><span class="countdown__num" data-cd-secs>--</span><span class="countdown__lbl">Sec</span></span>
                    </div>
                </div>
                <a class="link-standalone" href="/c/sale">
                    Shop all offers
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </a>
            </div>

            <div class="rail-wrap">
                <button class="rail__arrow rail__arrow--prev" type="button" aria-label="Scroll left">
                    <svg class="ico" aria-hidden="true"><use href="#i-chevron-left"></use></svg>
                </button>
                <div class="rail" tabindex="0" role="group" aria-label="Flash sale products">
                    @foreach (var product in Model.FlashSaleProducts)
                    {
                        @await Html.PartialAsync("_ProductCard", product)
                    }
                </div>
                <button class="rail__arrow rail__arrow--next" type="button" aria-label="Scroll right">
                    <svg class="ico" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </button>
            </div>
        </div>
    </section>
}

