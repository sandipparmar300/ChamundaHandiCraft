@{
    Layout = "_AccountLayout";
    var products = DemoContent.Products(3);
    var reviews = DemoContent.Reviews();
}

<div class="page-head" style="padding-top:0">
    <h1 class="t-heading-xl page-head__title">My reviews</h1>
    <p class="page-head__sub">What you've written, and what's still waiting for you.</p>
</div>

<div class="tabs mb-lg" role="tablist" aria-label="Review status" data-tabs-scope>
    <button class="tabs__item is-active" data-tab="reviews-pending" role="tab" aria-selected="true">To review (3)</button>
    <button class="tabs__item" data-tab="reviews-published" role="tab" aria-selected="false" tabindex="-1">Published (2)</button>
</div>

<div class="tab-panel is-active" id="reviews-pending" role="tabpanel" style="padding-top:0">
    <div class="alert alert-craft mb-md">
        <svg class="ico" aria-hidden="true"><use href="#i-gem"></use></svg>
        <div>
            <p class="alert__title">50 points per review</p>
            <p>Reviews with a photo earn 75. Points arrive when the review publishes.</p>
        </div>
    </div>

    <div class="stack stack-sm">
        @foreach (var product in products)
        {
            <div class="card">
                <div class="row-flex wrap between gap-md">
                    <div class="row-flex gap-md">
                        <img class="img-product shrink-0" src="@product.ImageUrl" alt="" width="64" height="64"
                             style="width:64px;height:64px;border-radius:var(--radius-md);object-fit:cover" />
                        <div>
                            <p class="t-body-md">@product.Name</p>
                            <p class="t-body-sm text-secondary-c">
                                Delivered @Money.LongDate(DateTime.Today.AddDays(-18))
                                @if (product.Artisan is not null)
                                {
                                    <text> · made by @product.Artisan.Name</text>
                                }
                            </p>
                            <div class="rating-input mt-xs" aria-label="Quick rating">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <button type="button" aria-label="@i out of 5">
                                        <svg class="ico" aria-hidden="true" style="width:22px;height:22px"><use href="#i-star"></use></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <a class="btn btn-outline btn-sm shrink-0" href="/reviews/write/@product.Slug">Write a Review</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="tab-panel" id="reviews-published" role="tabpanel" style="padding-top:0">
    <div class="stack stack-md">
        @foreach (var review in reviews.Take(2))
        {
            <div class="card">
                <div class="row-flex wrap between gap-md mb-sm">
                    <div class="row-flex gap-md">
                        <img class="img-product shrink-0" src="~/assets/images/placeholders/pottery.svg" alt=""
                             width="48" height="48"
                             style="width:48px;height:48px;border-radius:var(--radius-sm);object-fit:cover" />
                        <div>
                            <p class="t-body-sm">Blue Pottery Vase — Jaipur Floral</p>
                            <div class="row-flex gap-sm mt-2xs">
                                <span class="rating__stars" role="img" aria-label="Rated @review.Rating out of 5">
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        <svg class="ico ico-xs @(i < review.Rating ? "is-filled" : "")" aria-hidden="true"><use href="#i-star"></use></svg>
                                    }
                                </span>
                                <span class="t-body-xs text-tertiary-c">@Money.Relative(review.PostedOn)</span>
                            </div>
                        </div>
                    </div>
                    <span class="tag tag-success shrink-0">
                        <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-check"></use></svg>
                        Published
                    </span>
                </div>

                <p class="t-heading-xs">@review.Title</p>
                <p class="t-body-md text-secondary-c mt-2xs clamp-3">@review.Body</p>

                @if (review.Photos.Count > 0)
                {
                    <div class="review-card__photos">
                        @foreach (var photo in review.Photos)
                        {
                            <img src="@photo" alt="Your photo attached to this review" width="56" height="56"
                                 style="width:56px;height:56px" loading="lazy" />
                        }
                    </div>
                }

                <div class="row-flex wrap gap-md mt-md">
                    <span class="t-body-sm text-secondary-c row-flex gap-2xs">
                        <svg class="ico ico-xs" aria-hidden="true"><use href="#i-thumbs-up"></use></svg>
                        @review.HelpfulCount people found this helpful
                    </span>
                    <button class="cart-line__link" type="button">
                        <svg class="ico ico-xs" aria-hidden="true"><use href="#i-pencil"></use></svg>
                        Edit
                    </button>
                    <button class="cart-line__link cart-line__link--danger" type="button">
                        <svg class="ico ico-xs" aria-hidden="true"><use href="#i-trash"></use></svg>
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>
</div>
