            <h2 class="t-heading-md" id="sizeGuideTitle">Size guide</h2>
            <button class="icon-btn" data-close="sizeGuide" aria-label="Close"><svg class="ico ico-lg" aria-hidden="true"><use href="#i-x"></use></svg></button>
        </div>
        <div class="modal__body">
            <div class="data-table table-scroll">
                <table>
                    <caption class="sr-only">Vase sizes in centimetres and inches</caption>
                    <thead>
                        <tr><th scope="col">Size</th><th scope="col">Height</th><th scope="col">Diameter</th><th scope="col">Capacity</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Small</td><td class="tabular">18 cm / 7.1 in</td><td class="tabular">10 cm</td><td class="tabular">0.6 L</td></tr>
                        <tr><td>Medium</td><td class="tabular">24 cm / 9.4 in</td><td class="tabular">12 cm</td><td class="tabular">1.2 L</td></tr>
                        <tr><td>Large</td><td class="tabular">32 cm / 12.6 in</td><td class="tabular">15 cm</td><td class="tabular">2.1 L</td></tr>
