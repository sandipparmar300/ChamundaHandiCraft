@section Scripts {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Product",
      "name": "@Model.Name",
      "image": "@Model.ImageUrl",
      "description": "@Model.ShortDescription",
      "sku": "HC-POT-0421",
      "brand": { "@@type": "Brand", "name": "Chamunda Handicraft" },
      "aggregateRating": {
        "@@type": "AggregateRating",
        "ratingValue": "@Model.Rating.ToString("0.0")",
        "reviewCount": "@Model.ReviewCount"
      },
      "offers": {
        "@@type": "Offer",
        "priceCurrency": "INR",
        "price": "@Model.Price",
        "availability": "https://schema.org/@(Model.Stock == StockState.OutOfStock ? "OutOfStock" : "InStock")"
      }
    }
    </script>
}
