@model ShellViewModel
@functions {
    public static bool IsInNavbar(CategoryViewModel c)
    {
        var prop = typeof(CategoryViewModel).GetProperty("ShowInNavbar");
        if (prop != null && prop.GetValue(c) is bool b) return b;
        return string.Equals(c.Slug, "festive", StringComparison.OrdinalIgnoreCase);
    }
}
@{
    var drawerCats = Model.Categories != null && Model.Categories.Count > 0 ? Model.Categories : DemoContent.Categories();
}

@*
    CMP-NAV-MobileDrawer — left drawer, 88vw max 360, full height.
    Order: close + logo, account row, search, category accordion, quick links,
    account links, help links, currency/language, theme, social.
*@
<div class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true"
     aria-label="Site menu" aria-hidden="true" data-scrim="globalScrim">

    <div class="mobile-drawer__head">
        <a class="header-logo" href="/">@await Html.PartialAsync("_Logo", "auto")</a>
        <button class="icon-btn" data-close aria-label="Close menu">
            <svg class="ico ico-lg" aria-hidden="true"><use href="#i-x"></use></svg>
        </button>
    </div>

    <div class="mobile-drawer__body">

        @if (Model.IsSignedIn)
        {
            <a class="card card-craft row-flex gap-sm" href="/account" style="padding:12px">
                <span class="avatar">@(Model.FirstName.Length > 0 ? Model.FirstName[..1] : "A")</span>
                <span class="grow">
                    <span class="t-heading-xs" style="display:block">Hello, @Model.FirstName</span>
                    <span class="t-body-xs text-craft-c">@Model.RewardPoints.ToString("N0") reward points</span>
                </span>
                <svg class="ico text-craft-c" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
            </a>
        }
        else
        {
            <div class="row-flex gap-xs">
                <a class="btn btn-primary grow" href="/login">Sign in</a>
                <a class="btn btn-outline grow" href="/register">Create account</a>
            </div>
        }

        <form class="search-bar mt-md" action="/search" method="get" role="search">
            <label class="sr-only" for="drawerSearch">Search products</label>
            <svg class="ico search-bar__icon" aria-hidden="true"><use href="#i-search"></use></svg>
            <input class="search-bar__input" id="drawerSearch" name="q" type="search" placeholder="Search handmade treasures…" />
        </form>

        <div class="mobile-drawer__section">
            <span class="t-overline">Shop</span>
            <div class="accordion mt-xs" data-single>
                @foreach (var cat in drawerCats.Where(c => c.ParentId == null))
                {
                    <div class="accordion__item">
                        <button class="accordion__head" type="button" aria-expanded="false">
                            @cat.Name
                            <svg class="ico" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
                        </button>
                        <div class="accordion__body">
                            <div>
                                @if (cat.Children != null && cat.Children.Count > 0)
                                {
                                    @foreach (var child in cat.Children)
                                    {
                                        <a class="mobile-drawer__link" href="@child.Url">@child.Name</a>
                                    }
                                }
                                <a class="mobile-drawer__link" href="@cat.Url" style="font-weight:600">View all @cat.Name</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="mobile-drawer__section">
            <span class="t-overline">Quick links</span>
            <a class="mobile-drawer__link" href="/c/new-arrivals"><svg class="ico" aria-hidden="true"><use href="#i-badge-plus"></use></svg>New Arrivals</a>
            <a class="mobile-drawer__link" href="/c/sale"><svg class="ico" aria-hidden="true"><use href="#i-percent"></use></svg>Sale</a>
            @foreach (var navCat in drawerCats.Where(c => c.ParentId == null && IsInNavbar(c)))
            {
                <a class="mobile-drawer__link" href="@navCat.Url"><svg class="ico" aria-hidden="true"><use href="#i-sparkles"></use></svg>@navCat.Name</a>
            }
            <a class="mobile-drawer__link" href="/c/gifting"><svg class="ico" aria-hidden="true"><use href="#i-gift"></use></svg>Gifting</a>
            <a class="mobile-drawer__link" href="/artisans"><svg class="ico" aria-hidden="true"><use href="#i-hand-heart"></use></svg>Meet the Makers</a>
            <a class="mobile-drawer__link" href="/blog"><svg class="ico" aria-hidden="true"><use href="#i-book-open"></use></svg>Stories</a>
        </div>

        <div class="mobile-drawer__section">
            <span class="t-overline">Help &amp; contact</span>
            <a class="mobile-drawer__link" href="/help"><svg class="ico" aria-hidden="true"><use href="#i-circle-help"></use></svg>Help Centre</a>
            <a class="mobile-drawer__link" href="/track"><svg class="ico" aria-hidden="true"><use href="#i-package"></use></svg>Track Order</a>
            <a class="mobile-drawer__link" href="/pages/shipping"><svg class="ico" aria-hidden="true"><use href="#i-truck"></use></svg>Shipping Info</a>
            <a class="mobile-drawer__link" href="/pages/returns"><svg class="ico" aria-hidden="true"><use href="#i-undo"></use></svg>Returns &amp; Refunds</a>
            <a class="mobile-drawer__link" href="/pages/contact"><svg class="ico" aria-hidden="true"><use href="#i-mail"></use></svg>Contact Us</a>
            <a class="mobile-drawer__link" href="https://wa.me/@Model.Config.SupportWhatsApp" rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-whatsapp"></use></svg>WhatsApp Us</a>
        </div>

        <div class="mobile-drawer__section">
            <div class="row-flex wrap gap-xs">
                <button class="btn btn-ghost btn-sm" data-theme-toggle aria-label="Switch between light and dark theme">
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-moon"></use></svg>
                    Theme
                </button>
            </div>
        </div>

    </div>
</div>
