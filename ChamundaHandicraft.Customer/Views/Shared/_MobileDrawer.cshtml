@model ShellViewModel

@*
    CMP-NAV-MobileDrawer — left drawer, 88vw max 360, full height.
    Order: close + logo, account row, search, category accordion, quick links,
    account links, help links, currency/language, theme, social.
*@
<div class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true"
     aria-label="Site menu" aria-hidden="true" data-scrim="globalScrim">

    <div class="mobile-drawer__head">
        <a class="header-logo" href="/">@await Html.PartialAsync("_Logo", "auto")</a>
        <button class="icon-btn" data-close aria-label="Close menu">
            <svg class="ico ico-lg" aria-hidden="true"><use href="#i-x"></use></svg>
        </button>
    </div>

    <div class="mobile-drawer__body">

        @if (Model.IsSignedIn)
        {
            <a class="card card-craft row-flex gap-sm" href="/account" style="padding:12px">
                <span class="avatar">@(Model.FirstName.Length > 0 ? Model.FirstName[..1] : "A")</span>
                <span class="grow">
                    <span class="t-heading-xs" style="display:block">Hello, @Model.FirstName</span>
                    <span class="t-body-xs text-craft-c">@Model.RewardPoints.ToString("N0") reward points</span>
                </span>
                <svg class="ico text-craft-c" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
            </a>
        }
        else
        {
            <div class="row-flex gap-xs">
                <a class="btn btn-primary grow" href="/login">Sign in</a>
                <a class="btn btn-outline grow" href="/register">Create account</a>
            </div>
        }

        <form class="search-bar mt-md" action="/search" method="get" role="search">
            <label class="sr-only" for="drawerSearch">Search products</label>
            <svg class="ico search-bar__icon" aria-hidden="true"><use href="#i-search"></use></svg>
            <input class="search-bar__input" id="drawerSearch" name="q" type="search" placeholder="Search handmade treasures…" />
        </form>

        <div class="mobile-drawer__section">
            <span class="t-overline">Shop</span>
            <div class="accordion mt-xs" data-single>
                <div class="accordion__item">
                    <button class="accordion__head" type="button" aria-expanded="false">
                        Home Décor
                        <svg class="ico" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
                    </button>
                    <div class="accordion__body">
                        <div>
                            <a class="mobile-drawer__link" href="/c/home-decor/vases">Vases &amp; Planters</a>
                            <a class="mobile-drawer__link" href="/c/home-decor/wall-art">Wall Art</a>
                            <a class="mobile-drawer__link" href="/c/home-decor/lamps">Lamps &amp; Lighting</a>
                            <a class="mobile-drawer__link" href="/c/home-decor/figurines">Figurines</a>
                            <a class="mobile-drawer__link" href="/c/home-decor">View all Home Décor</a>
                        </div>
                    </div>
                </div>
                <div class="accordion__item">
                    <button class="accordion__head" type="button" aria-expanded="false">
                        Textiles
                        <svg class="ico" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
                    </button>
                    <div class="accordion__body">
                        <div>
                            <a class="mobile-drawer__link" href="/c/textiles/cushions">Cushion Covers</a>
                            <a class="mobile-drawer__link" href="/c/textiles/throws">Throws &amp; Quilts</a>
                            <a class="mobile-drawer__link" href="/c/textiles/rugs">Rugs &amp; Dhurries</a>
                            <a class="mobile-drawer__link" href="/c/textiles">View all Textiles</a>
                        </div>
                    </div>
                </div>
                <div class="accordion__item">
                    <button class="accordion__head" type="button" aria-expanded="false">
                        Brass &amp; Metal
                        <svg class="ico" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
                    </button>
                    <div class="accordion__body">
                        <div>
                            <a class="mobile-drawer__link" href="/c/brassware/diyas">Diyas &amp; Lamps</a>
                            <a class="mobile-drawer__link" href="/c/brassware/urli">Urlis &amp; Bowls</a>
                            <a class="mobile-drawer__link" href="/c/brassware/dhokra">Dhokra Art</a>
                            <a class="mobile-drawer__link" href="/c/brassware">View all Brass &amp; Metal</a>
                        </div>
                    </div>
                </div>
                <div class="accordion__item">
                    <button class="accordion__head" type="button" aria-expanded="false">
                        Jewellery
                        <svg class="ico" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
                    </button>
                    <div class="accordion__body">
                        <div>
                            <a class="mobile-drawer__link" href="/c/jewellery/earrings">Earrings</a>
                            <a class="mobile-drawer__link" href="/c/jewellery/necklaces">Necklaces</a>
                            <a class="mobile-drawer__link" href="/c/jewellery">View all Jewellery</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mobile-drawer__section">
            <span class="t-overline">Quick links</span>
            <a class="mobile-drawer__link" href="/c/new-arrivals"><svg class="ico" aria-hidden="true"><use href="#i-badge-plus"></use></svg>New Arrivals</a>
            <a class="mobile-drawer__link" href="/c/sale"><svg class="ico" aria-hidden="true"><use href="#i-percent"></use></svg>Sale</a>
            <a class="mobile-drawer__link" href="/c/gifting"><svg class="ico" aria-hidden="true"><use href="#i-gift"></use></svg>Gifting</a>
            <a class="mobile-drawer__link" href="/artisans"><svg class="ico" aria-hidden="true"><use href="#i-hand-heart"></use></svg>Artisans</a>
            <a class="mobile-drawer__link" href="/blog"><svg class="ico" aria-hidden="true"><use href="#i-book-open"></use></svg>Stories</a>
        </div>

        <div class="mobile-drawer__section">
            <span class="t-overline">Your account</span>
            <a class="mobile-drawer__link" href="/account/orders"><svg class="ico" aria-hidden="true"><use href="#i-package"></use></svg>My Orders</a>
            <a class="mobile-drawer__link" href="/wishlist"><svg class="ico" aria-hidden="true"><use href="#i-heart"></use></svg>Wishlist</a>
            <a class="mobile-drawer__link" href="/account/rewards"><svg class="ico" aria-hidden="true"><use href="#i-gem"></use></svg>Rewards</a>
            <a class="mobile-drawer__link" href="/account/addresses"><svg class="ico" aria-hidden="true"><use href="#i-map-pin"></use></svg>Addresses</a>
        </div>

        <div class="mobile-drawer__section">
            <span class="t-overline">Help</span>
            <a class="mobile-drawer__link" href="/help"><svg class="ico" aria-hidden="true"><use href="#i-circle-help"></use></svg>Help Centre</a>
            <a class="mobile-drawer__link" href="/track"><svg class="ico" aria-hidden="true"><use href="#i-truck"></use></svg>Track Order</a>
            <a class="mobile-drawer__link" href="/pages/contact"><svg class="ico" aria-hidden="true"><use href="#i-mail"></use></svg>Contact Us</a>
            <a class="mobile-drawer__link" href="https://wa.me/919876543210" rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-whatsapp"></use></svg>WhatsApp</a>
        </div>

        <div class="mobile-drawer__section">
            <div class="row-flex between gap-sm">
                <span class="t-body-sm text-secondary-c">India (₹ INR) · English</span>
                <button class="btn btn-ghost btn-sm" data-theme-toggle>
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-moon"></use></svg>
                    Theme
                </button>
            </div>
            <div class="row-flex gap-xs mt-md">
                <a class="icon-btn icon-btn-outline" href="https://instagram.com" rel="noopener" aria-label="Instagram"><svg class="ico" aria-hidden="true"><use href="#i-instagram"></use></svg></a>
                <a class="icon-btn icon-btn-outline" href="https://facebook.com" rel="noopener" aria-label="Facebook"><svg class="ico" aria-hidden="true"><use href="#i-facebook"></use></svg></a>
                <a class="icon-btn icon-btn-outline" href="https://youtube.com" rel="noopener" aria-label="YouTube"><svg class="ico" aria-hidden="true"><use href="#i-youtube"></use></svg></a>
                <a class="icon-btn icon-btn-outline" href="https://pinterest.com" rel="noopener" aria-label="Pinterest"><svg class="ico" aria-hidden="true"><use href="#i-pinterest"></use></svg></a>
            </div>
        </div>
    </div>
</div>
