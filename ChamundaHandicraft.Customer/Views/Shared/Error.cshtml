@{
    ViewData["Title"] = "Something went wrong";
    var code = ViewData["StatusCode"] as int? ?? 500;

    var (heading, body) = code switch
    {
        404 => ("We couldn't find that page",
                "The link may be old, or the piece may have sold out and been retired. Everything below still works."),
        503 => ("We're back shortly",
                "We're making a quick change to the site. Your cart is safe and will be waiting."),
        _   => ("Something went wrong at our end",
                "This is our fault, not yours. Nothing has been charged and your cart is intact.")
    };
}

<div class="container">
    <div class="state-block" style="padding-block:var(--space-4xl)">
        <span class="t-display-2xl text-craft-c" aria-hidden="true">@code</span>
        <h1 class="t-heading-xl mt-sm">@heading</h1>
        <p class="state-block__desc">@body</p>

        <div class="state-block__actions">
            <a class="btn btn-primary btn-lg" href="/">Go to the Home page</a>
            <a class="btn btn-outline btn-lg" href="/shop">Browse the Shop</a>
        </div>

        <p class="t-body-sm text-tertiary-c mt-lg">
            Still stuck? <a class="link" href="/help">Visit the Help Centre</a> or
            <a class="link" href="/pages/contact">contact us</a> — we reply within one working day.
        </p>
    </div>

    <div class="band-sm">
        @await Html.PartialAsync("_ProductRail", new ProductRailViewModel
        {
            Heading = "Popular right now",
            SubHeading = "Where most shoppers start.",
            ViewAllUrl = "/shop",
            Products = DemoContent.Products(6)
        })
    </div>
</div>
