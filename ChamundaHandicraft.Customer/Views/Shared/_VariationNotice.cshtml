@*
    CMP-PRD-VariationNotice — mandatory on PDP, cart line items and the order
    confirmation. It prevents the single most common return reason
    (CX principle 4). Never remove it from a handmade product surface.
*@
<div class="variation-notice">
    <svg class="ico ico-lg variation-notice__icon" aria-hidden="true"><use href="#i-hand-heart"></use></svg>
    <div>
        <p class="variation-notice__title">Every piece is unique</p>
        <p class="variation-notice__body">
            Handmade items vary slightly in colour, finish and size. Yours will be one of a kind —
            that difference is the proof a person made it, not a machine.
        </p>
        <a class="variation-notice__link" href="#" data-open="variationModal">
            What to expect
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
        </a>
    </div>
</div>
