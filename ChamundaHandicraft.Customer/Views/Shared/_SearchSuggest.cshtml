@*
    CMP-SRC-Suggestions — Recent · Trending · Suggestions · Products · Categories/Artisans
    Empty query shows Recent + Trending only. Query match is bolded in suggestions.
*@
<div class="search-suggest" id="headerSuggest" role="listbox" aria-label="Search suggestions">

    <div class="search-suggest__group">
        <div class="search-suggest__head">
            <span class="t-overline">Recent</span>
            <button class="btn btn-link btn-sm" type="button">Clear all</button>
        </div>
        <a class="search-suggest__row" href="/search?q=blue+pottery+vase" role="option">
            <svg class="ico ico-sm text-tertiary-c" aria-hidden="true"><use href="#i-clock"></use></svg>
            <span class="grow">blue pottery vase</span>
            <span class="icon-btn icon-btn-sm" aria-label="Remove from recent searches">
                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-x"></use></svg>
            </span>
        </a>
        <a class="search-suggest__row" href="/search?q=brass+diya+set" role="option">
            <svg class="ico ico-sm text-tertiary-c" aria-hidden="true"><use href="#i-clock"></use></svg>
            <span class="grow">brass diya set</span>
        </a>
    </div>

    <div class="search-suggest__group">
        <span class="t-overline">Trending</span>
        <div class="row-flex wrap gap-xs mt-xs">
            <a class="chip" href="/search?q=diwali+gifts">
                <svg class="ico ico-xs" aria-hidden="true"><use href="#i-flame"></use></svg>diwali gifts
            </a>
            <a class="chip" href="/search?q=kantha+cushion">
                <svg class="ico ico-xs" aria-hidden="true"><use href="#i-flame"></use></svg>kantha cushion
            </a>
            <a class="chip" href="/search?q=marble+inlay">
                <svg class="ico ico-xs" aria-hidden="true"><use href="#i-flame"></use></svg>marble inlay
            </a>
        </div>
    </div>

    <div class="search-suggest__group">
        <span class="t-overline">Products</span>
        <div data-suggest-products>
            <div class="t-body-xs text-tertiary-c" style="padding:var(--space-xs) 0">Type to search handcrafted pieces...</div>
        </div>
    </div>

    <div class="search-suggest__group">
        <div class="row-flex gap-lg" style="align-items:flex-start">
            <div class="grow">
                <span class="t-overline">Categories</span>
                <div data-suggest-categories>
                    <a class="search-suggest__row" href="/c/brass-and-metalware" role="option">Brass &amp; Metalware</a>
                    <a class="search-suggest__row" href="/c/wooden-handicrafts" role="option">Wooden Handicrafts</a>
                    <a class="search-suggest__row" href="/c/handloom-textiles" role="option">Handloom &amp; Textiles</a>
                </div>
            </div>
            <div class="grow">
                <span class="t-overline">Artisan Clusters</span>
                <a class="search-suggest__row" href="/search?q=sankheda" role="option">Sankheda Lacquerware</a>
                <a class="search-suggest__row" href="/search?q=patan" role="option">Patan Double Ikat</a>
            </div>
        </div>
    </div>

    <a class="search-suggest__footer" href="/search" data-suggest-footer>
        <span>Search all handcrafted items</span>
        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
    </a>
</div>
