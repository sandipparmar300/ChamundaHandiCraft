@model ListingViewModel
@{
    var categoryFacet = Model?.Facets?.FirstOrDefault(f => f.Key == "category");
    var materialFacet = Model?.Facets?.FirstOrDefault(f => f.Key == "material");
    var resetUrl = Model?.CategorySlug != null ? $"/c/{Model.CategorySlug}" : "/shop";
}
<div class="filter-rail">

    <div class="row-flex between mb-md">
        <h2 class="t-heading-xs">Filters</h2>
        <a class="btn btn-link btn-sm" href="@resetUrl">Clear all</a>
    </div>

    @* ---- Category Filter ---- *@
    @if (categoryFacet != null && categoryFacet.Values.Count > 0)
    {
        var queryCat = Context.Request.Query["category"].ToString();
        var rawSlugs = !string.IsNullOrWhiteSpace(queryCat) ? queryCat : (Model?.CategorySlug ?? "");
        var selectedSlugs = rawSlugs
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        <div class="filter-group">
            <button class="filter-group__head" type="button" aria-expanded="true">
                Category
                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
            </button>
            <div class="filter-group__body">
                @foreach (var v in categoryFacet.Values)
                {
                    var isSelected = v.IsSelected || selectedSlugs.Contains(v.Value, StringComparer.OrdinalIgnoreCase);
                    <label class="check">
                        <input type="checkbox" checked="@isSelected"
                               onchange="window.toggleCategoryFilter('@v.Value', this.checked);" />
                        <span class="check__label t-body-sm grow">@v.Label</span>
                        <span class="filter-count">@v.Count</span>
                    </label>
                }
            </div>
        </div>
    }
    else if (Model?.SubCategories != null && Model.SubCategories.Count > 0)
    {
        var selectedSlugs = (Model?.CategorySlug ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        <div class="filter-group">
            <button class="filter-group__head" type="button" aria-expanded="true">
                Category
                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
            </button>
            <div class="filter-group__body">
                @foreach (var c in Model.SubCategories)
                {
                    var isSelected = selectedSlugs.Contains(c.Slug, StringComparer.OrdinalIgnoreCase);
                    <label class="check">
                        <input type="checkbox" checked="@isSelected"
                               onchange="window.toggleCategoryFilter('@c.Slug', this.checked);" />
                        <span class="check__label t-body-sm grow">@c.Name</span>
                        <span class="filter-count">@c.ProductCount</span>
                    </label>
                }
            </div>
        </div>
    }

<script>
    window.toggleCategoryFilter = window.toggleCategoryFilter || function (slug, isChecked) {
        var u = new URL(location.href);
        var existing = [];
        var catParam = u.searchParams.get('category');
        if (catParam) {
            existing = catParam.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        } else {
            var pathParts = u.pathname.split('/').filter(Boolean);
            if (pathParts.length >= 2 && pathParts[0] === 'c') {
                existing.push(pathParts[1]);
            }
        }

        if (isChecked) {
            if (existing.indexOf(slug) === -1) {
                existing.push(slug);
            }
        } else {
            existing = existing.filter(function (s) { return s.toLowerCase() !== slug.toLowerCase(); });
        }

        u.searchParams.set('page', '1');

        if (existing.length === 0) {
            u.pathname = '/shop';
            u.searchParams.delete('category');
        } else if (existing.length === 1) {
            u.pathname = '/shop';
            u.searchParams.set('category', existing[0]);
        } else {
            u.pathname = '/shop';
            u.searchParams.set('category', existing.join(','));
        }

        location.href = u.toString();
    };
</script>

    @* ---- Material Filter ---- *@
    @if (materialFacet != null && materialFacet.Values.Count > 0)
    {
        <div class="filter-group">
            <button class="filter-group__head" type="button" aria-expanded="true">
                Material
                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
            </button>
            <div class="filter-group__body">
                @foreach (var v in materialFacet.Values)
                {
                    var isSelected = string.Equals(Model?.SelectedMaterial, v.Value, StringComparison.OrdinalIgnoreCase);
                    var disabled = v.Count == 0 && !isSelected;
                    <label class="check" style="@(disabled ? "opacity:.45;cursor:not-allowed" : "")">
                        <input type="checkbox" checked="@isSelected" disabled="@disabled"
                               onchange="var u = new URL(location.href); if (this.checked) { u.searchParams.set('material', '@v.Value'); } else { u.searchParams.delete('material'); } u.searchParams.set('page', '1'); location.href = u.toString();" />
                        <span class="check__label t-body-sm grow">@v.Label</span>
                        <span class="filter-count">@v.Count</span>
                    </label>
                }
            </div>
        </div>
    }

    @* ---- Price Filter ---- *@
    <div class="filter-group">
        <button class="filter-group__head" type="button" aria-expanded="true">
            Price (₹)
            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </button>
        <div class="filter-group__body">
            <div class="range-slider">
                <div class="range-slider__values">
                    <input class="input" id="filterMinPrice" type="number" min="0" step="100" placeholder="Min"
                           value="@Model?.SelectedMinPrice" aria-label="Minimum price" />
                    <span class="text-tertiary-c">to</span>
                    <input class="input" id="filterMaxPrice" type="number" min="0" step="100" placeholder="Max"
                           value="@Model?.SelectedMaxPrice" aria-label="Maximum price" />
                </div>
                <button class="btn btn-outline btn-sm btn-block mt-xs" type="button"
                        onclick="var u = new URL(location.href); var mn = document.getElementById('filterMinPrice').value; var mx = document.getElementById('filterMaxPrice').value; if(mn) u.searchParams.set('minPrice', mn); else u.searchParams.delete('minPrice'); if(mx) u.searchParams.set('maxPrice', mx); else u.searchParams.delete('maxPrice'); u.searchParams.set('page', '1'); location.href = u.toString();">
                    Apply Price
                </button>
            </div>
        </div>
    </div>

    @* ---- Availability ---- *@
    <div class="filter-group">
        <button class="filter-group__head" type="button" aria-expanded="true">
            Availability
            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </button>
        <div class="filter-group__body">
            <label class="check">
                <input type="checkbox" checked="@(Model?.InStockOnly == true)"
                       onchange="var u = new URL(location.href); if (this.checked) { u.searchParams.set('inStock', 'true'); } else { u.searchParams.delete('inStock'); } u.searchParams.set('page', '1'); location.href = u.toString();" />
                <span class="check__label t-body-sm grow">In stock only</span>
            </label>
        </div>
    </div>

    @* ---- Rating Filter ---- *@
    <div class="filter-group is-collapsed">
        <button class="filter-group__head" type="button" aria-expanded="false">
            Customer Rating
            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </button>
        <div class="filter-group__body">
            @foreach (var stars in new[] { 4, 3 })
            {
                var isSelected = Model?.Rating == stars;
                <label class="check">
                    <input type="radio" name="ratingFilter" checked="@isSelected"
                           onchange="var u = new URL(location.href); u.searchParams.set('rating', '@stars'); u.searchParams.set('page', '1'); location.href = u.toString();" />
                    <span class="check__label t-body-sm grow row-flex gap-2xs">
                        <span class="rating__stars">
                            @for (var i = 0; i < 5; i++)
                            {
                                <svg class="ico ico-xs @(i < stars ? "is-filled" : "")" aria-hidden="true"><use href="#i-star"></use></svg>
                            }
                        </span>
                        <span>&amp; above</span>
                    </span>
                </label>
            }
        </div>
    </div>

</div>
