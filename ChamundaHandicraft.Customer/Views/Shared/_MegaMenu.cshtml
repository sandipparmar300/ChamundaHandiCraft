@model List<CategoryViewModel>?
@functions {
    public static bool IsInNavbar(CategoryViewModel c)
    {
        var prop = typeof(CategoryViewModel).GetProperty("ShowInNavbar");
        if (prop != null && prop.GetValue(c) is bool b) return b;
        return string.Equals(c.Slug, "festive", StringComparison.OrdinalIgnoreCase);
    }
}
@{
    var categories = Model != null && Model.Count > 0 ? Model : DemoContent.Categories();

    // Categories enabled for standalone top navbar
    var navbarCats = categories
        .Where(c => c.ParentId == null && IsInNavbar(c))
        .OrderBy(c => c.SortOrder)
        .ThenBy(c => c.Name)
        .ToList();

    // Shop dropdown categories: parent categories NOT in standalone navbar
    var shopCols = categories
        .Where(c => c.ParentId == null && !IsInNavbar(c))
        .OrderBy(c => c.SortOrder)
        .ThenBy(c => c.Name)
        .ToList();

    if (shopCols.Count == 0)
    {
        shopCols = categories.Where(c => c.ParentId == null).ToList();
    }

    var featureCategory = shopCols.FirstOrDefault(c => c.IsFeaturedOnHome) ?? shopCols.FirstOrDefault();
    var shopColCount = Math.Min(Math.Max(shopCols.Count, 1), 5);
}

@* 1. General Shop dropdown menu *@
<div class="megamenu" id="megaShop" role="region" aria-label="Shop categories">
    <div class="megamenu__inner" style="grid-template-columns: repeat(@shopColCount, minmax(0, 1fr)) 260px;">
        @foreach (var col in shopCols.Take(5))
        {
            <div>
                <span class="t-overline megamenu__col-title">@col.Name</span>
                @if (col.Children != null && col.Children.Count > 0)
                {
                    @foreach (var child in col.Children.Take(6))
                    {
                        <a class="megamenu__link" href="@child.Url">@child.Name</a>
                    }
                }
                else
                {
                    <a class="megamenu__link" href="@col.Url">All @col.Name</a>
                }
                <a class="megamenu__link" href="@col.Url" style="font-weight:600;margin-top:4px">View all @col.Name</a>
            </div>
        }

        @if (featureCategory != null)
        {
            <a class="megamenu__feature" href="@featureCategory.Url">
                <img src="@(!string.IsNullOrWhiteSpace(featureCategory.ImageUrl) ? featureCategory.ImageUrl : "/assets/images/placeholders/category-5.svg")"
                     alt="@featureCategory.Name" loading="lazy" />
                <span class="megamenu__feature-body">
                    <span class="t-overline" style="color:rgba(255,255,255,.86)">The collection</span>
                    <span class="t-heading-md" style="display:block;color:#fff;margin:4px 0 6px">@featureCategory.Name</span>
                    <span class="t-body-sm" style="color:rgba(255,255,255,.9)">@(featureCategory.Description ?? "Authentic handcrafted masterpieces by Indian artisans.")</span>
                    <span class="link-standalone mt-sm" style="color:#fff">
                        Shop the collection
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                    </span>
                </span>
            </a>
        }
    </div>
</div>

@* 2. Dynamic Mega Menus for each parent category enabled with ShowInNavbar and Children *@
@foreach (var navCat in navbarCats.Where(c => c.Children != null && c.Children.Count > 0))
{
    var subCols = navCat.Children;
    var colCount = Math.Min(Math.Max(subCols.Count, 1), 4);
    var featuredImg = !string.IsNullOrWhiteSpace(navCat.ImageUrl)
        ? navCat.ImageUrl
        : "/assets/images/placeholders/banner-festive.svg";
    var catTitle = navCat.Name;
    var catDesc = !string.IsNullOrWhiteSpace(navCat.Description)
        ? navCat.Description
        : $"Handcrafted {navCat.Name} collections curated by master artisans.";
    var catUrl = navCat.Url;

    <div class="megamenu" id="mega_@navCat.Id" role="region" aria-label="@catTitle collections">
        <div class="megamenu__inner" style="grid-template-columns: repeat(@colCount, minmax(0, 1fr)) 260px;">
            @foreach (var sub in subCols.Take(4))
            {
                <div>
                    <span class="t-overline megamenu__col-title">@sub.Name</span>
                    @if (sub.Children != null && sub.Children.Count > 0)
                    {
                        @foreach (var leaf in sub.Children.Take(6))
                        {
                            <a class="megamenu__link" href="@leaf.Url">@leaf.Name</a>
                        }
                    }
                    else
                    {
                        <a class="megamenu__link" href="@sub.Url">All @sub.Name</a>
                    }
                    <a class="megamenu__link" href="@sub.Url" style="font-weight:600;margin-top:4px">View @sub.Name</a>
                </div>
            }

            <a class="megamenu__feature" href="@catUrl">
                <img src="@featuredImg" alt="@catTitle" loading="lazy" />
                <span class="megamenu__feature-body">
                    <span class="t-overline" style="color:rgba(255,255,255,.86)">Special Collection</span>
                    <span class="t-heading-md" style="display:block;color:#fff;margin:4px 0 6px">@catTitle</span>
                    <span class="t-body-sm" style="color:rgba(255,255,255,.9)">@catDesc</span>
                    <span class="link-standalone mt-sm" style="color:#fff">
                        Explore collection
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                    </span>
                </span>
            </a>
        </div>
    </div>
}
