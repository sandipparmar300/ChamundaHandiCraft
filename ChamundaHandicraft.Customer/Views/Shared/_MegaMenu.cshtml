@model List<CategoryViewModel>?
@{
    var categories = Model != null && Model.Count > 0 ? Model : DemoContent.Categories();
    var rootCols = categories.Where(c => c.ParentId == null).Take(3).ToList();
    var browseCols = categories.Where(c => c.ParentId == null).Skip(3).Take(4).ToList();
    var featureCategory = categories.FirstOrDefault(c => c.IsFeaturedOnHome) ?? categories.FirstOrDefault();
}

<div class="megamenu" id="megaShop" role="region" aria-label="Shop categories">
    <div class="megamenu__inner">
        @foreach (var col in rootCols)
        {
            <div>
                <span class="t-overline megamenu__col-title">@col.Name</span>
                @if (col.Children != null && col.Children.Count > 0)
                {
                    @foreach (var child in col.Children.Take(6))
                    {
                        <a class="megamenu__link" href="@child.Url">@child.Name</a>
                    }
                }
                else
                {
                    <a class="megamenu__link" href="@col.Url">All @col.Name</a>
                }
                <a class="megamenu__link" href="@col.Url" style="font-weight:600;margin-top:4px">View all @col.Name</a>
            </div>
        }

        <div>
            <span class="t-overline megamenu__col-title">Browse by</span>
            @foreach (var browse in browseCols)
            {
                <a class="megamenu__link" href="@browse.Url">@browse.Name</a>
            }
            <a class="megamenu__link" href="/artisans">Shop by Artisan</a>
            <a class="megamenu__link" href="/c/craft-clusters">Craft Clusters</a>
            <a class="megamenu__link" href="/shop">View All Products</a>
        </div>

        @if (featureCategory != null)
        {
            <a class="megamenu__feature" href="@featureCategory.Url">
                <img src="@(!string.IsNullOrWhiteSpace(featureCategory.ImageUrl) ? featureCategory.ImageUrl : "/assets/images/placeholders/category-5.svg")"
                     alt="@featureCategory.Name" loading="lazy" />
                <span class="megamenu__feature-body">
                    <span class="t-overline" style="color:rgba(255,255,255,.86)">The collection</span>
                    <span class="t-heading-md" style="display:block;color:#fff;margin:4px 0 6px">@featureCategory.Name</span>
                    <span class="t-body-sm" style="color:rgba(255,255,255,.9)">@(featureCategory.Description ?? "Authentic handcrafted masterpieces by Indian artisans.")</span>
                    <span class="link-standalone mt-sm" style="color:#fff">
                        Shop the collection
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                    </span>
                </span>
            </a>
        }
    </div>
</div>

<div class="megamenu" id="megaFestive" role="region" aria-label="Festive collections">
    <div class="megamenu__inner">
        <div>
            <span class="t-overline megamenu__col-title">Diwali</span>
            <a class="megamenu__link" href="/c/festive/diyas">Diyas &amp; Tea Lights</a>
            <a class="megamenu__link" href="/c/festive/rangoli">Rangoli &amp; Torans</a>
            <a class="megamenu__link" href="/c/festive/lanterns">Lanterns</a>
            <a class="megamenu__link" href="/c/festive/pooja-thali">Pooja Thalis</a>
        </div>

        <div>
            <span class="t-overline megamenu__col-title">Gift sets</span>
            <a class="megamenu__link" href="/c/gifting/corporate">Corporate Hampers</a>
            <a class="megamenu__link" href="/c/gifting/under-1000">Gifts under ₹1,000</a>
            <a class="megamenu__link" href="/c/gifting/under-2500">Gifts under ₹2,500</a>
            <a class="megamenu__link" href="/c/gifting/luxury">Luxury Gifting</a>
        </div>

        <div>
            <span class="t-overline megamenu__col-title">Other festivals</span>
            <a class="megamenu__link" href="/c/festive/navratri">Navratri</a>
            <a class="megamenu__link" href="/c/festive/onam">Onam</a>
            <a class="megamenu__link" href="/c/festive/pongal">Pongal</a>
            <a class="megamenu__link" href="/c/festive/christmas">Christmas</a>
        </div>

        <div>
            <span class="t-overline megamenu__col-title">Shop by price</span>
            <a class="megamenu__link" href="/c/festive?price=0-1000">Under ₹1,000</a>
            <a class="megamenu__link" href="/c/festive?price=1000-2500">₹1,000 – ₹2,500</a>
            <a class="megamenu__link" href="/c/festive?price=2500-5000">₹2,500 – ₹5,000</a>
            <a class="megamenu__link" href="/c/festive?price=5000-">Above ₹5,000</a>
        </div>

        <a class="megamenu__feature" href="/c/festive">
            <img src="~/assets/images/placeholders/banner-festive.svg"
                 alt="Diwali brass diyas with marigold garland background" loading="lazy" />
            <span class="megamenu__feature-body">
                <span class="t-overline" style="color:rgba(255,255,255,.86)">Diwali 2026</span>
                <span class="t-heading-md" style="display:block;color:#fff;margin:4px 0 6px">The Festive Room</span>
                <span class="t-body-sm" style="color:rgba(255,255,255,.9)">Brass diyas, silver coins and handcrafted dry-fruit hampers.</span>
                <span class="link-standalone mt-sm" style="color:#fff">
                    Explore festive décor
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </span>
            </span>
        </a>
    </div>
</div>
