@model List<ArticleCardViewModel>
@{
    var crumbs = ViewData["Breadcrumbs"] as List<BreadcrumbItem>;
    var featured = Model.First();
    var rest = Model.Skip(1).Concat(Model).Take(6).ToList();
}

<div class="container">
    @if (crumbs is not null)
    {
        @await Html.PartialAsync("_Breadcrumb", crumbs)
    }

    <div class="page-head">
        <span class="craft-rule"></span>
        <h1 class="t-display-lg page-head__title">Stories from the workshop</h1>
        <p class="page-head__sub measure">
            How things are made, and who makes them. We visit every workshop we buy from —
            these are the notes we bring back.
        </p>
    </div>

    <div class="chip-nav mb-lg">
        <a class="chip-nav__item is-active" href="/blog">All</a>
        @foreach (var category in new[] { "Craft Stories", "Living", "Meet the Makers", "Materials", "Gifting" })
        {
            <a class="chip-nav__item" href="/blog?category=@Uri.EscapeDataString(category)">@category</a>
        }
    </div>

    @* ---- Featured article ---- *@
    <a class="card card-flush mb-2xl" href="@featured.Url" style="display:block">
        <div class="layout-halves" style="gap:0;align-items:stretch">
            <div class="img-box img-16-9" style="border-radius:0;height:100%">
                <img src="@featured.CoverUrl" alt="@featured.Title" loading="eager" width="800" height="450" />
            </div>
            <div style="padding:var(--space-lg);display:flex;flex-direction:column;justify-content:center">
                <span class="t-overline eyebrow-craft">@featured.Category</span>
                <h2 class="t-display-lg mt-xs">@featured.Title</h2>
                <p class="t-body-lg text-secondary-c mt-sm">@featured.Excerpt</p>
                <p class="t-body-sm text-tertiary-c mt-md">
                    @featured.Author · @Money.LongDate(featured.PublishedOn) · @featured.ReadMinutes min read
                </p>
                <span class="link-standalone mt-md">
                    Read the story
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
                </span>
            </div>
        </div>
    </a>

    @* ---- Article grid ---- *@
    <div class="cat-grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
        @foreach (var article in rest)
        {
            <a class="article-card reveal" href="@article.Url">
                <div class="article-card__media">
                    <img src="@article.CoverUrl" alt="@article.Title" loading="lazy" width="800" height="450" />
                </div>
                <div class="article-card__body">
                    <span class="t-overline eyebrow-craft">@article.Category</span>
                    <h2 class="article-card__title clamp-2">@article.Title</h2>
                    <p class="t-body-sm text-secondary-c clamp-3">@article.Excerpt</p>
                    <p class="article-card__meta">
                        @article.Author · @Money.LongDate(article.PublishedOn) · @article.ReadMinutes min read
                    </p>
                </div>
            </a>
        }
    </div>

    <div class="load-more mt-2xl">
        <button class="btn btn-outline btn-lg" type="button">
            <span class="btn__spinner" aria-hidden="true"></span>
            <span class="btn__label">Load More (7 of 42)</span>
        </button>
    </div>
</div>

<section class="band band-craft mt-2xl">
    <div class="container">
        <div class="layout-halves">
            <div>
                <span class="craft-rule"></span>
                <h2 class="t-display-lg">Meet the makers</h2>
                <p class="t-body-lg text-craft-c mt-sm">
                    240 artisans across 18 craft clusters. Every product page names one of them —
                    these are their stories in full.
                </p>
                <a class="btn btn-secondary btn-lg mt-lg" href="/artisans">Browse Artisans</a>
            </div>
            <div class="cat-grid" style="grid-template-columns:repeat(2,1fr);gap:var(--space-sm)">
                @foreach (var artisan in DemoContent.Artisans())
                {
                    <a class="card card-flush" href="/artisans/@artisan.Slug">
                        <div class="img-box img-1-1" style="border-radius:0">
                            <img src="@artisan.PhotoUrl" alt="@artisan.Name at work" loading="lazy" width="240" height="240" />
                        </div>
                        <div style="padding:var(--space-sm)">
                            <span class="t-body-sm" style="font-weight:600;display:block">@artisan.Name</span>
                            <span class="t-body-xs text-craft-c">@artisan.Craft</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</section>
