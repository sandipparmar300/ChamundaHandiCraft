@model ChamundaHandicraft.Helper.ViewModel.Customer.CustomerResetPasswordRequest
@{
    Layout = "_AuthLayout";
    var token = ViewData["Token"] as string ?? Model?.Token;
}

@* PG-01-05 · Reset Password *@
<h1 class="t-heading-xl">Choose a new password</h1>
<p class="t-body-md text-secondary-c mt-xs mb-lg">
    Pick something you haven't used elsewhere. We'll sign you in straight after.
</p>

@if (string.IsNullOrEmpty(token))
{
    @* Error state — expired or missing token. Explain, don't block. *@
    <div class="alert alert-danger mb-lg" role="alert">
        <svg class="ico" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
        <div>
            <p class="alert__title">This link has expired or is invalid</p>
            <p>Reset links work for 30 minutes. Request a fresh one and we'll send it right away.</p>
            <a class="btn btn-outline btn-sm mt-sm" href="/forgot-password">Request a new link</a>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
{
    <div class="alert alert-danger mb-md" role="alert">
        <svg class="ico" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
        <div>
            <p class="alert__title">Please check the errors below</p>
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    </div>
}

<form method="post" action="/reset-password" data-validate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Token" value="@token" />

    <div class="field">
        <label class="field__label" for="newPassword">New password</label>
        <div class="input-group has-suffix">
            <input class="input" id="newPassword" name="Password" type="password" required
                   minlength="8" autocomplete="new-password" data-pw-strength="pwMeter" style="padding-left:12px" />
            <span class="input-group__suffix">
                <button class="icon-btn icon-btn-sm pw-toggle" type="button" aria-label="Show password">
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-eye"></use></svg>
                </button>
            </span>
        </div>
        <div class="pw-strength" id="pwMeter" data-score="0" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
        </div>
        <p class="field__help">At least 8 characters with a letter and a number.</p>
        <span asp-validation-for="Password" class="field__error" style="display:block"></span>
        <p class="field__error">
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
            <span>Use at least 8 characters with a letter and a number</span>
        </p>
    </div>

    <div class="field">
        <label class="field__label" for="confirmPassword">Confirm password</label>
        <input class="input" id="confirmPassword" name="ConfirmPassword" type="password" required autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field__error" style="display:block"></span>
        <p class="field__error" data-static>
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
            <span>Passwords don't match</span>
        </p>
    </div>

    @* Default on — the safe choice after a reset. *@
    <label class="check mt-md">
        <input type="checkbox" name="SignOutOthers" value="true" @(Model?.SignOutOthers != false ? "checked" : "") />
        <span class="check__label t-body-sm">
            Sign out of other devices
            <span class="check__help">Recommended if you think someone else had access.</span>
        </span>
    </label>

    <button class="btn btn-primary btn-xl btn-block mt-lg" type="submit">
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__label">Save New Password</span>
    </button>
</form>
