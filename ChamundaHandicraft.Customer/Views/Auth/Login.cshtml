@{
    Layout = "_AuthLayout";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

@* PG-01-01 · Sign In *@
<h1 class="t-heading-xl">Welcome back</h1>
<p class="t-body-md text-secondary-c mt-xs mb-lg">Sign in to continue shopping.</p>

@* Method tabs — Password and OTP are equal-weight; neither is hidden behind the other. *@
<div data-tabs-scope>
    <div class="segmented w-full mb-lg" role="tablist" aria-label="Sign-in method" style="display:grid;grid-template-columns:1fr 1fr">
        <button class="segmented__item tabs__item is-active" data-tab="pane-password" role="tab" aria-selected="true">Password</button>
        <button class="segmented__item tabs__item" data-tab="pane-otp" role="tab" aria-selected="false" tabindex="-1">OTP</button>
    </div>

    @* ---------- Password ---------- *@
    <div class="tab-panel is-active" id="pane-password" role="tabpanel" style="padding-top:0">
        <form method="post" action="/login" data-validate>
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="field">
                <label class="field__label" for="identifier">Email or mobile number</label>
                <input class="input" id="identifier" name="identifier" type="text" required
                       placeholder="ananya@example.com or 98765 43210"
                       autocomplete="username" aria-describedby="identifierError" />
                <p class="field__error" id="identifierError">
                    <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
                    <span>Enter your email or mobile number</span>
                </p>
            </div>

            <div class="field">
                <div class="row-flex between">
                    <label class="field__label" for="password">Password</label>
                    <a class="link t-body-sm" href="/forgot-password">Forgot password?</a>
                </div>
                <div class="input-group has-suffix">
                    <input class="input" id="password" name="password" type="password" required
                           autocomplete="current-password" style="padding-left:12px" />
                    <span class="input-group__suffix">
                        <button class="icon-btn icon-btn-sm pw-toggle" type="button" aria-label="Show password">
                            <svg class="ico ico-sm" aria-hidden="true"><use href="#i-eye"></use></svg>
                        </button>
                    </span>
                </div>
                <p class="field__error">
                    <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
                    <span>Enter your password</span>
                </p>
                <p class="inline-msg text-warning-c" id="capsWarning" hidden>
                    <svg class="ico ico-xs" aria-hidden="true"><use href="#i-triangle-alert"></use></svg>
                    Caps Lock is on
                </p>
            </div>

            @* Default off, with the duration stated plainly. *@
            <label class="check mt-md">
                <input type="checkbox" name="rememberMe" />
                <span class="check__label t-body-sm">
                    Keep me signed in
                    <span class="check__help">Stay signed in for 30 days on this device.</span>
                </span>
            </label>

            <button class="btn btn-primary btn-xl btn-block mt-lg" type="submit">
                <span class="btn__spinner" aria-hidden="true"></span>
                <span class="btn__label">Sign In</span>
            </button>
        </form>
    </div>

    @* ---------- OTP ---------- *@
    <div class="tab-panel" id="pane-otp" role="tabpanel" style="padding-top:0">
        <form method="post" action="/signin/otp" data-validate>
            <div class="field">
                <label class="field__label" for="otpTarget">Mobile number</label>
                <div class="phone-input">
                    <select class="select" aria-label="Country code">
                        <option selected>+91</option>
                        <option>+1</option>
                        <option>+44</option>
                        <option>+971</option>
                    </select>
                    <input class="input" id="otpTarget" name="target" type="tel" required
                           placeholder="98765 43210" autocomplete="tel" inputmode="numeric" />
                </div>
                <p class="field__help">We'll send a 6-digit code. Standard SMS rates apply.</p>
                <p class="field__error">
                    <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
                    <span>Enter a valid 10-digit mobile number</span>
                </p>
            </div>

            <button class="btn btn-primary btn-xl btn-block mt-lg" type="submit">
                <span class="btn__spinner" aria-hidden="true"></span>
                <span class="btn__label">Send Code</span>
            </button>

            <p class="t-body-xs text-tertiary-c text-center mt-sm">
                Prefer email? <a class="link" href="/signin/otp?channel=email">Send the code to my email instead</a>
            </p>
        </form>
    </div>
</div>

<div class="auth-divider mt-lg mb-lg">or</div>

<div class="social-btns">
    <button class="btn btn-outline btn-lg btn-block" type="button">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" style="fill:none;stroke:none">
            <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4Z" />
            <path fill="#34A853" d="M12 22c2.7 0 4.9-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z" />
            <path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14Z" />
            <path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.4L6.4 10c.8-2.3 3-4.1 5.6-4.1Z" />
        </svg>
        Continue with Google
    </button>
</div>

<p class="t-body-md text-center mt-lg">
    New to Chamunda Handicraft? <a class="link" href="/register">Create an account</a>
</p>

@* Guest checkout is never buried — CX principle 6. *@
<div class="card card-craft mt-lg">
    <div class="row-flex gap-sm">
        <svg class="ico ico-lg text-craft-c shrink-0" aria-hidden="true"><use href="#i-cart"></use></svg>
        <div class="grow">
            <p class="t-heading-xs text-craft-c">You don't need an account to buy</p>
            <p class="t-body-sm text-craft-c">Checkout as a guest and create an account afterwards if you want to.</p>
        </div>
        <a class="btn btn-secondary btn-sm shrink-0" href="/checkout">Continue as Guest</a>
    </div>
</div>

<p class="t-body-xs text-tertiary-c text-center mt-lg">
    By continuing you agree to our <a class="link" href="/pages/terms">Terms</a> and
    <a class="link" href="/pages/privacy-policy">Privacy Policy</a>.
</p>

@section Scripts {
    <script>
        // Caps-lock warning — a password field that silently rejects is a dark pattern.
        (function () {
            var input = document.getElementById('password');
            var warning = document.getElementById('capsWarning');
            if (!input || !warning) return;

            input.addEventListener('keyup', function (e) {
                warning.hidden = !(e.getModifierState && e.getModifierState('CapsLock'));
            });
        })();
    </script>
}
