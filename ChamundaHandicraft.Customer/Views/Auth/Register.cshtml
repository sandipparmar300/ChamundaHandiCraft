@{
    Layout = "_AuthLayout";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

@* PG-01-02 · Create Account *@
<h1 class="t-heading-xl">Create your account</h1>
<p class="t-body-md text-secondary-c mt-xs mb-lg">
    Track orders, keep a wishlist across devices, and collect points on every purchase.
</p>

<form method="post" action="/register" data-validate>
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <div class="field">
        <label class="field__label" for="fullName">Full name</label>
        <input class="input" id="fullName" name="fullName" type="text" required
               minlength="2" maxlength="60" pattern="[A-Za-zऀ-ॿ' \-]{2,60}"
               placeholder="Ananya Iyer" autocomplete="name" />
        <p class="field__error">
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
            <span>Enter your name</span>
        </p>
    </div>

    <div class="field">
        <label class="field__label" for="email">Email address</label>
        <input class="input" id="email" name="email" type="email" required
               placeholder="ananya@example.com" autocomplete="email" />
        <p class="field__help">Order confirmations and delivery updates go here.</p>
        <p class="field__error">
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
            <span>Enter a valid email address</span>
        </p>
    </div>

    <div class="field">
        <label class="field__label" for="mobile">Mobile number</label>
        <div class="phone-input">
            <select class="select" aria-label="Country code">
                <option selected>+91</option>
                <option>+1</option>
                <option>+44</option>
                <option>+971</option>
            </select>
            <input class="input" id="mobile" name="mobile" type="tel" required
                   pattern="[0-9 ]{10,12}" placeholder="98765 43210"
                   autocomplete="tel" inputmode="numeric" />
        </div>
        <p class="field__help">Couriers call this number on the delivery day.</p>
        <p class="field__error">
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
            <span>Enter a valid 10-digit mobile number</span>
        </p>
    </div>

    <div class="field">
        <label class="field__label" for="newPassword">Password</label>
        <div class="input-group has-suffix">
            <input class="input" id="newPassword" name="password" type="password" required
                   minlength="8" autocomplete="new-password" data-pw-strength="pwMeter"
                   style="padding-left:12px" aria-describedby="pwRules" />
            <span class="input-group__suffix">
                <button class="icon-btn icon-btn-sm pw-toggle" type="button" aria-label="Show password">
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-eye"></use></svg>
                </button>
            </span>
        </div>
        <div class="pw-strength" id="pwMeter" data-score="0" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
        </div>
        <p class="field__help" id="pwRules">Use at least 8 characters with a letter and a number.</p>
        <p class="field__error">
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
            <span>Use at least 8 characters with a letter and a number</span>
        </p>
    </div>

    @* Unticked — no pre-ticked marketing consent (§8.1). *@
    <label class="check mt-md">
        <input type="checkbox" name="marketingConsent" />
        <span class="check__label t-body-sm">
            Send me craft stories and offers by email and WhatsApp
            <span class="check__help">Two emails a month. Unsubscribe in one click.</span>
        </span>
    </label>

    <button class="btn btn-primary btn-xl btn-block mt-lg" type="submit">
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__label">Create Account</span>
    </button>

    <p class="t-body-xs text-tertiary-c mt-sm">
        By creating an account you agree to our <a class="link" href="/pages/terms">Terms</a> and
        <a class="link" href="/pages/privacy-policy">Privacy Policy</a>.
    </p>
</form>

<div class="auth-divider mt-lg mb-lg">or</div>

<button class="btn btn-outline btn-lg btn-block" type="button">
    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" style="fill:none;stroke:none">
        <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4Z" />
        <path fill="#34A853" d="M12 22c2.7 0 4.9-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z" />
        <path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14Z" />
        <path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.4L6.4 10c.8-2.3 3-4.1 5.6-4.1Z" />
    </svg>
    Continue with Google
</button>

<p class="t-body-md text-center mt-lg">
    Already have an account? <a class="link" href="/login">Sign in</a>
</p>
