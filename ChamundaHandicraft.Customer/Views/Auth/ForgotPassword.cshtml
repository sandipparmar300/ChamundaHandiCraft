@model ChamundaHandicraft.Helper.ViewModel.Customer.CustomerForgotPasswordRequest
@{
    Layout = "_AuthLayout";
    var resetSent = ViewData["ResetSent"] as bool? ?? false;
}

@* PG-01-04 · Forgot Password *@
<a class="btn btn-ghost btn-sm mb-md" href="/login" style="min-width:0;padding-inline:0">
    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-left"></use></svg>
    Back to sign in
</a>

<h1 class="t-heading-xl">Reset your password</h1>
<p class="t-body-md text-secondary-c mt-xs mb-lg">
    Enter the email or mobile number on your account. We'll send a reset link by email,
    or a code by SMS — whichever you give us.
</p>

@if (resetSent)
{
    @* Success state (STA) — shown after submission. *@
    <div class="alert alert-success mt-lg mb-lg" role="status">
        <svg class="ico" aria-hidden="true"><use href="#i-circle-check"></use></svg>
        <div>
            <p class="alert__title">Check your inbox or SMS</p>
            <p>If an account exists for that address, a password reset link has been sent. The link remains valid for 30 minutes.</p>
        </div>
    </div>
}

<form method="post" action="/forgot-password" data-validate>
    @Html.AntiForgeryToken()
    <div class="field">
        <label class="field__label" for="recovery">Email or mobile number</label>
        <input class="input" id="recovery" name="Identifier" type="text" required
               value="@Model?.Identifier"
               placeholder="ananya@example.com or 98765 43210" autocomplete="username" />
        <span asp-validation-for="Identifier" class="field__error" style="display:block"></span>
        <p class="field__error">
            <svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
            <span>Enter your email or mobile number</span>
        </p>
    </div>

    <button class="btn btn-primary btn-xl btn-block mt-lg" type="submit">
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__label">Send Reset Link</span>
    </button>
</form>

<p class="t-body-sm text-tertiary-c mt-lg">
    Still stuck? <a class="link" href="/help">Visit the Help Centre</a> or
    <a class="link" href="/pages/contact">contact us</a> — we reply within one working day.
</p>
