@model ChamundaHandicraft.Helper.ViewModel.Customer.CustomerDashboardViewModel
@{
    Layout = "_AccountLayout";
    var customerName = !string.IsNullOrWhiteSpace(Model?.Profile?.FirstName) ? Model.Profile.FirstName : (User.Identity?.Name?.Split(' ')[0] ?? "Shopper");
    var orders = DemoContent.Orders();
    var activeOrder = Model?.ActiveOrder ?? orders.FirstOrDefault();
    var rewardPoints = Model?.Rewards?.Points ?? Model?.Profile?.RewardPointBalance ?? 50;
    var rewardTier = Model?.Rewards?.TierName ?? Model?.Profile?.RewardTier ?? "Bronze";
}

<div class="page-head" style="padding-top:0">
    <h1 class="t-display-lg page-head__title">Hello, @customerName</h1>
    <p class="page-head__sub">Everything about your orders, saved pieces and points, in one place.</p>
</div>

@* ---- Stat tiles ---- *@
<div class="stat-grid mb-lg">
    <a class="stat-tile" href="/account/orders">
        <p class="stat-tile__value">@(Model?.OrderCount ?? 0)</p>
        <p class="stat-tile__label">Orders placed</p>
    </a>
    <a class="stat-tile" href="/account/orders">
        <p class="stat-tile__value">@(Model?.InTransitCount ?? 0)</p>
        <p class="stat-tile__label">In transit</p>
    </a>
    <a class="stat-tile" href="/wishlist">
        <p class="stat-tile__value">@(Model?.SavedPiecesCount ?? 0)</p>
        <p class="stat-tile__label">Saved pieces</p>
    </a>
    <a class="stat-tile" href="/account/coupons">
        <p class="stat-tile__value">@(Model?.CouponsAvailableCount ?? 2)</p>
        <p class="stat-tile__label">Coupons available</p>
    </a>
</div>

@if (activeOrder != null)
{
    @* ---- Active order — the most useful thing on this page ---- *@
    <section class="card mb-lg">
        <div class="card__head">
            <h2 class="t-heading-md">Arriving soon</h2>
            <a class="link-standalone" href="/account/orders">
                All orders
                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
            </a>
        </div>

        <div class="row-flex wrap between gap-md">
            <div class="row-flex gap-md">
                <div class="order-thumbs">
                    @foreach (var thumb in activeOrder.Thumbnails.Take(2))
                    {
                        <img class="img-product" src="@thumb" alt="" width="56" height="56" loading="lazy" />
                    }
                </div>
                <div>
                    <span class="status-chip status-chip--@activeOrder.StatusModifier">
                        <svg class="ico ico-xs" aria-hidden="true"><use href="#@activeOrder.StatusIcon"></use></svg>
                        @activeOrder.StatusLabel
                    </span>
                    <p class="t-body-md mt-2xs">@activeOrder.PrimaryItemName@(activeOrder.ItemCount > 1 ? $" + {activeOrder.ItemCount - 1} more" : "")</p>
                    <p class="t-body-sm text-secondary-c">
                        <span class="t-mono">@activeOrder.OrderNumber</span> ·
                        Arriving @(activeOrder.DeliveryBy.HasValue ? Money.DeliveryDate(activeOrder.DeliveryBy.Value) : "Soon")
                    </p>
                </div>
            </div>

            <div class="row-flex gap-xs shrink-0">
                <a class="btn btn-primary btn-sm" href="/track/@activeOrder.OrderNumber">Track Order</a>
                <a class="btn btn-outline btn-sm" href="@activeOrder.Url">View Details</a>
            </div>
        </div>

        <div class="card__divider"></div>

        <div class="track-strip">
            @foreach (var step in DemoContent.Timeline())
            {
                <div class="track-strip__step @(step.State == "done" ? "is-done" : step.State == "current" ? "is-current" : "")">
                    <span class="timeline__dot" style="@(step.State == "done" ? "background:var(--success-600);border-color:var(--success-600);color:#fff" : step.State == "current" ? "background:var(--color-action-primary-bg);border-color:var(--color-action-primary-bg);color:#fff" : "")">
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#@step.Icon"></use></svg>
                    </span>
                    <p class="t-body-sm" style="font-weight:@(step.State == "upcoming" ? "500" : "600")">@step.Title</p>
                    @if (step.At is not null)
                    {
                        <p class="t-body-xs text-tertiary-c">@Money.DeliveryDate(step.At.Value)</p>
                    }
                </div>
            }
        </div>
    </section>
}

@* ---- Points ---- *@
<div class="layout-halves mb-lg" style="align-items:stretch;gap:var(--space-md)">
    <div class="points-card">
        <span class="t-overline" style="color:rgba(255,255,255,.7)">Chamunda rewards · @rewardTier</span>
        <p class="points-card__value mt-xs">@rewardPoints.ToString("N0")</p>
        <p class="points-card__label">points · worth @Money.Inr(rewardPoints)</p>
        <div class="row-flex gap-sm mt-md">
            <a class="btn btn-inverse btn-sm" href="/account/rewards">View Rewards</a>
            <a class="btn btn-ghost btn-sm" href="/shop" style="color:#fff">Shop &amp; Earn</a>
        </div>
        <p class="t-body-xs mt-md" style="color:rgba(255,255,255,.66)">
            Earn reward points on every handcrafted purchase. Redeem at checkout.
        </p>
    </div>

    <div class="card">
        <div class="card__head">
            <h2 class="t-heading-md">Quick links</h2>
        </div>
        <ul class="quick-links">
            <li>
                <a class="quick-link" href="/account/profile">
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-user"></use></svg>
                    <span>Edit profile &amp; GST details</span>
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </a>
            </li>
            <li>
                <a class="quick-link" href="/account/addresses">
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-map-pin"></use></svg>
                    <span>Delivery addresses</span>
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </a>
            </li>
            <li>
                <a class="quick-link" href="/account/security">
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-shield"></use></svg>
                    <span>Password &amp; security</span>
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </a>
            </li>
            <li>
                <a class="quick-link" href="/account/coupons">
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-tag"></use></svg>
                    <span>My coupons &amp; vouchers</span>
                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </a>
            </li>
        </ul>
    </div>
</div>
