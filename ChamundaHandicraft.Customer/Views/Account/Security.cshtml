@model ChamundaHandicraft.Helper.ViewModel.Customer.CustomerChangePasswordRequest
@{
    Layout = "_AccountLayout";
}

<div class="page-head" style="padding-top:0">
    <h1 class="t-heading-xl page-head__title">Security</h1>
    <p class="page-head__sub">Your password, sign-in methods and the devices currently signed in.</p>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
{
    <div class="alert alert-danger mb-md" role="alert">
        <svg class="ico" aria-hidden="true"><use href="#i-circle-alert"></use></svg>
        <div>
            <p class="alert__title">Please check the errors below</p>
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    </div>
}

<section class="card">
    <h2 class="t-heading-md mb-md">Change password</h2>
    <form method="post" action="/account/security" data-validate style="max-width:420px">
        @Html.AntiForgeryToken()
        <div class="field">
            <label class="field__label" for="currentPw">Current password</label>
            <div class="input-group has-suffix">
                <input class="input" id="currentPw" name="CurrentPassword" type="password" required autocomplete="current-password" style="padding-left:12px" />
                <span class="input-group__suffix">
                    <button class="icon-btn icon-btn-sm pw-toggle" type="button" aria-label="Show password">
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-eye"></use></svg>
                    </button>
                </span>
            </div>
            <span asp-validation-for="CurrentPassword" class="field__error" style="display:block"></span>
            <p class="field__error"><svg class="ico ico-xs" aria-hidden="true"><use href="#i-circle-alert"></use></svg><span></span></p>
        </div>

        <div class="field">
            <label class="field__label" for="nextPw">New password</label>
            <div class="input-group has-suffix">
                <input class="input" id="nextPw" name="NewPassword" type="password" required minlength="8" autocomplete="new-password"
                       data-pw-strength="secPwMeter" style="padding-left:12px" />
                <span class="input-group__suffix">
                    <button class="icon-btn icon-btn-sm pw-toggle" type="button" aria-label="Show password">
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-eye"></use></svg>
                    </button>
                </span>
            </div>
            <div class="pw-strength" id="secPwMeter" data-score="0" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
            </div>
            <p class="field__help">At least 8 characters with a letter and a number.</p>
            <span asp-validation-for="NewPassword" class="field__error" style="display:block"></span>
        </div>

        <div class="field">
            <label class="field__label" for="confPw">Confirm new password</label>
            <div class="input-group has-suffix">
                <input class="input" id="confPw" name="ConfirmPassword" type="password" required minlength="8" autocomplete="new-password" style="padding-left:12px" />
                <span class="input-group__suffix">
                    <button class="icon-btn icon-btn-sm pw-toggle" type="button" aria-label="Show password">
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-eye"></use></svg>
                    </button>
                </span>
            </div>
            <span asp-validation-for="ConfirmPassword" class="field__error" style="display:block"></span>
        </div>

        <label class="check mt-md">
            <input type="checkbox" name="SignOutOthers" value="true" checked />
            <span class="check__label t-body-sm">Sign out of other devices</span>
        </label>

        <button class="btn btn-primary mt-lg" type="submit">
            <span class="btn__spinner" aria-hidden="true"></span>
            <span class="btn__label">Update Password</span>
        </button>
    </form>
</section>

<section class="card mt-md">
    <h2 class="t-heading-md mb-md">Two-factor authentication</h2>
    <div class="row-flex wrap between gap-md">
        <div class="grow">
            <p class="t-body-md">A one-time code by SMS on every new device.</p>
            <p class="t-body-sm text-secondary-c mt-2xs">
                Recommended. It stops someone signing in even if they have your password.
            </p>
        </div>
        <label class="switch shrink-0">
            <input type="checkbox" />
            <span class="t-body-sm">Off</span>
        </label>
    </div>
</section>

<section class="card mt-md">
    <h2 class="t-heading-md mb-md">Connected sign-in methods</h2>
    <div class="stack stack-sm">
        <div class="row-flex wrap between gap-sm" style="padding-bottom:var(--space-sm);border-bottom:1px solid var(--color-border-subtle)">
            <span class="row-flex gap-sm">
                <svg class="ico" aria-hidden="true"><use href="#i-mail"></use></svg>
                <span>
                    <span class="t-body-md" style="display:block">Password</span>
                    <span class="t-body-xs text-tertiary-c">Active credentials</span>
                </span>
            </span>
            <span class="tag tag-success">Active</span>
        </div>
        <div class="row-flex wrap between gap-sm">
            <span class="row-flex gap-sm">
                <svg class="ico" aria-hidden="true"><use href="#i-user"></use></svg>
                <span>
                    <span class="t-body-md" style="display:block">Google</span>
                    <span class="t-body-xs text-tertiary-c">Not connected</span>
                </span>
            </span>
            <button class="btn btn-outline btn-sm" type="button">Connect</button>
        </div>
    </div>
</section>

<section class="card mt-md">
    <h2 class="t-heading-md mb-md">Where you're signed in</h2>
    <div class="stack stack-sm">
        @foreach (var (device, place, when, current) in new[]
        {
            ("Chrome on Windows", "Ahmedabad, India", "Right now", true),
            ("Safari on iPhone", "Ahmedabad, India", "2 hours ago", false)
        })
        {
            <div class="row-flex wrap between gap-sm" style="padding-bottom:var(--space-sm);border-bottom:1px solid var(--color-border-subtle)">
                <div>
                    <p class="t-body-md">
                        @device
                        @if (current)
                        {
                            <span class="tag tag-success" style="margin-left:6px">This device</span>
                        }
                    </p>
                    <p class="t-body-xs text-tertiary-c">@place · @when</p>
                </div>
                @if (!current)
                {
                    <button class="btn btn-ghost btn-sm" type="button" style="color:var(--color-status-danger-text)">Sign out</button>
                }
            </div>
        }
    </div>

    <button class="btn btn-outline mt-md" type="button">Sign Out Everywhere Else</button>
</section>
