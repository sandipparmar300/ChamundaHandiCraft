@model RoleGridItem
@{
    ViewData["Title"] = "Role Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Role" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Role Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Role" asp-action="Index" class="links">Role Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header">
            <h2><i class="fas fa-user-shield" style="color:var(--accent);margin-right:8px;"></i>Role Information</h2>
        </div>
        <div class="form-section-body">
            <div class="row g-3">
                @foreach (var f in new[] { "Role Name", "Description", "Assigned Users", "Granted Permissions", "Created At", "Status" })
                {
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">@f</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="listing-section common-box">
        <div class="latest-orders">
            <div class="div-search-box-panel flex-ending-cls-here">
                <h3 class="section-heading">Users in this Role</h3>
                <a asp-controller="AdminUser" asp-action="Index" class="custom_button secondary_button">All Admin Users</a>
            </div>
        </div>
        <div class="table-main">
            <table class="custom-datatable listing-order-table" id="role-users-grid">
                <thead>
                    <tr>
                        <th style="min-width:60px;">Photo</th>
                        <th style="min-width:180px;">Full Name</th>
                        <th style="min-width:200px;">Email</th>
                        <th style="min-width:140px;">Department</th>
                        <th style="min-width:150px;">Last Login</th>
                        <th style="min-width:110px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @* Who currently holds this role. Removing the last holder of a system
                       role is what locks an organisation out, so the count is shown plainly. *@
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            @Model.UserCount user@(Model.UserCount == 1 ? "" : "s") hold this role.
                            <a asp-controller="AdminUser" asp-action="Index">See the team list</a>.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }

            $('#role-users-grid').DataTable({
                paging: true, ordering: true, filter: false,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No users assigned to this role yet" }
            });
        });
    </script>
}
