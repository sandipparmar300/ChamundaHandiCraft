@model ChamundaHandicraft.Helper.ViewModel.Admin.RoleSaveRequest
@{
    ViewData["Title"] = "Role Details - " + Model.RoleName;
    var permissions = ViewBag.Permissions as List<PermissionMatrixItem> ?? new List<PermissionMatrixItem>();
    var grantedPermissions = permissions.Where(p => p.IsGranted || (Model.PermissionIds != null && Model.PermissionIds.Contains(p.Id))).ToList();
    var groupedGranted = grantedPermissions.GroupBy(p => p.Module).OrderBy(g => g.Key).ToList();
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Role" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Role Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Role" asp-action="Index" class="links">Role Listing</a></li>
            <li>@Model.RoleName</li>
        </ul>
    </div>
}

<main class="page-content">

    <!-- Role Summary Header -->
    <section class="form-section">
        <div class="form-section-body">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="fas fa-user-shield fa-2x"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 class="mb-0">@Model.RoleName</h3>
                            @if (Model.IsSystem)
                            {
                                <span class="badge bg-dark">System Role</span>
                            }
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                        <p class="text-muted mb-0">
                            Key: <code>@Model.RoleKey</code> &middot;
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="custom_button primary_button">
                        <i class="fas fa-pen me-1"></i> Edit Role &amp; Permissions
                    </a>
                    <a asp-action="Index" class="custom_button secondary_button">
                        <i class="fas fa-arrow-left me-1"></i> Back to Listing
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-12">
            <div class="card border shadow-sm p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase">Assigned Users</span>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h2 class="mb-0 fw-bold">@Model.UserCount</h2>
                    <a asp-controller="AdminUser" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        View Users <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card border shadow-sm p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase">Granted Permissions</span>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h2 class="mb-0 fw-bold text-success">@grantedPermissions.Count</h2>
                    <span class="text-muted small">out of @permissions.Count total</span>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card border shadow-sm p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase">Modules Covered</span>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h2 class="mb-0 fw-bold text-info">@groupedGranted.Count</h2>
                    <span class="text-muted small">functional areas</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Granted Permissions Breakdown -->
    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-key text-primary me-2"></i>Granted Permissions (@grantedPermissions.Count)</h2>
            <a asp-controller="Permission" asp-action="Index" asp-route-roleId="@Model.Id" class="small text-decoration-none">
                Open in Permission Browser <i class="fas fa-external-link-alt ms-1"></i>
            </a>
        </div>

        <div class="form-section-body">
            @if (!grantedPermissions.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-lock-open fa-2x mb-2 text-warning"></i>
                    <p>No permissions granted to this role yet.</p>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Grant Permissions</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var group in groupedGranted)
                    {
                        <div class="col-lg-6 col-12">
                            <div class="card border shadow-sm h-100">
                                <div class="card-header bg-light py-2 px-3 fw-bold text-uppercase d-flex justify-content-between align-items-center" style="font-size:0.85rem;">
                                    <span><i class="fas fa-folder me-1 text-secondary"></i> @group.Key</span>
                                    <span class="badge bg-secondary">@group.Count()</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var perm in group.OrderBy(p => p.Entity).ThenBy(p => p.Action))
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1" title="@perm.Description" style="font-size:0.8rem; font-weight:normal;">
                                                <i class="fas fa-check text-success me-1"></i>
                                                <strong class="text-primary">@perm.Action</strong>: @perm.Entity
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }
        });
    </script>
}
