@model PagedResult<RoleGridItem>
@{
    ViewData["Title"] = "Roles";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Roles</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>User Management</li>
            <li>Role Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search role" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <a asp-controller="Role" asp-action="Add" class="custom_button primary_button">Add Role</a>
        </div>
    </div>

    <div class="table-main">
        <table id="role-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:200px;">Role</th>
                    <th style="min-width:280px;">Description</th>
                    <th style="min-width:120px;">Users</th>
                    <th style="min-width:130px;">Permissions</th>
                    <th style="min-width:130px;">Created At</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id">@row.RoleName</a>
                            @if (row.IsSystem)
                            {
                                <span class="badge bg-dark ms-1">System</span>
                            }
                        </td>
                        <td class="text-muted">@(row.Description ?? "—")</td>
                        <td class="text-end">@row.UserCount</td>
                        <td class="text-end">
                            <a asp-controller="Permission" asp-action="Index" asp-route-roleId="@row.Id">@row.PermissionCount keys</a>
                        </td>
                        <td>@Money.LongDate(row.CreatedOn)</td>
                        <td>@await Html.PartialAsync("_StatusPill", row.IsActive)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-4">No roles yet. <a asp-action="Add">Create the first one</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="role-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this role?</p>
                <p class="text-muted" style="font-size:.8rem;">A role that still has users assigned cannot be deleted.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;
        let searchValue = "";

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }

            datatable = $('#role-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No roles to show yet" },
                initComplete: function () {
                    const $w = $("#role-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            searchValue = $(ctrl).val();
            $("#clearSearch").toggle(searchValue.length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            searchValue = "";
            if (datatable) datatable.draw();
        }
    </script>
}
