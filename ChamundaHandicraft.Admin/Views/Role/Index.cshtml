@model PagedResult<RoleGridItem>
@{
    ViewData["Title"] = "Roles";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Roles &amp; Access Control</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>User Management</li>
            <li>Role Listing</li>
        </ul>
    </div>
}

@Html.AntiForgeryToken()

<section class="listing-section common-box">
    <!-- ================= SINGLE UNIFIED TOOLBAR ================= -->
    <div class="p-3 border-bottom bg-white rounded-top">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">
            <!-- Left: Search & Filter Controls -->
            <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1" style="min-width: 280px;">
                <!-- Search Box -->
                <div class="position-relative" style="min-width: 240px; max-width: 340px; flex: 1 1 240px;">
                    <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none;">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search role name or description..." id="txtSearch" onkeyup="fnSearch(this);"
                           class="form-control rounded-pill ps-5 font-13"
                           style="height: 40px; background: #F3F8FD; border: 1px solid #e2e8f0;">
                    <span id="clearSearch" onclick="clearSearch()"
                          style="display:none; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); cursor:pointer; color: #888;">&#10006;</span>
                </div>

                <!-- Status Filter -->
                <select id="filterStatus" class="form-select font-13 rounded-3" style="width: 135px; height: 40px; background-color: #fff; border: 1px solid #e2e8f0;" onchange="applyFilters()">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <!-- Right: Action Buttons -->
            <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                <a asp-controller="Role" asp-action="Add" class="custom_button primary_button text-nowrap">
                    <i class="fas fa-plus me-1"></i> Add Role
                </a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="role-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:180px;">Role Name</th>
                    <th style="min-width:280px;">Description</th>
                    <th style="min-width:100px; text-align:center;">Assigned Users</th>
                    <th style="min-width:130px; text-align:center;">Permissions</th>
                    <th style="min-width:100px;">Status</th>
                    <th style="min-width:120px;">Created At</th>
                    <th style="min-width:90px; text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="role-row-@row.Id">
                        <td>
                            <a asp-action="Details" asp-route-id="@row.Id" class="fw-semibold text-dark">@row.RoleName</a>
                            @if (row.Id == 1 || row.RoleName == "Super Admin" || row.RoleName == "Admin")
                            {
                                <span class="badge bg-dark ms-1" style="font-size:0.65rem;">System</span>
                            }
                        </td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(row.Description) ? "—" : row.Description)</td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border px-2 py-1">@row.UserCount users</span>
                        </td>
                        <td class="text-center">
                            <a asp-controller="Permission" asp-action="Index" asp-route-roleId="@row.Id" class="badge bg-info text-white text-decoration-none px-2 py-1">
                                <i class="fas fa-key me-1"></i> @row.PermissionCount keys
                            </a>
                        </td>
                        <td>
                            @if (row.Id == 1 || row.RoleName == "Super Admin")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <label class="switch" title="@(row.IsActive ? "Active" : "Inactive")">
                                    <input type="checkbox" class="toggle-active" @(row.IsActive ? "checked" : "") onchange="toggleRoleStatus(@row.Id, this)" />
                                    <span class="slider round"></span>
                                </label>
                            }
                        </td>
                        <td>@Money.LongDate(row.CreatedOn)</td>
                        <td class="text-center" style="white-space: nowrap !important;">
                            <a asp-action="Details" asp-route-id="@row.Id" title="View Details" class="text-info"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit Role & Permissions" class="ms-2 text-primary"><i class="fas fa-pen"></i></a>
                            @if (row.Id != 1 && row.RoleName != "Super Admin")
                            {
                                <a href="javascript:void(0);" onclick="confirmDeleteRole(@row.Id, '@Html.Raw(Html.Encode(row.RoleName))', @row.UserCount)" title="Delete" class="ms-2 text-danger"><i class="fas fa-trash-alt"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">No roles found. <a asp-action="Add">Create the first role</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Delete confirmation modal -->
<div class="modal delete-common-modal common-modal" id="role-delete-confirm-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Role</h3>
                <p>Are you sure you want to delete role <strong id="deleteRoleName"></strong>?</p>
                <p class="text-danger small" id="deleteWarningMsg"></p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-role-yes" class="custom_button primary_button" onclick="executeDeleteRole()">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }

            datatable = $('#role-grid').DataTable({
                paging: true,
                ordering: true,
                filter: true,
                destroy: true,
                bLengthChange: false,
                pageLength: 10,
                scrollX: true,
                autoWidth: false,
                language: { emptyTable: "No roles to show yet" },
                dom: 'rtip',
                order: [[5, "desc"]],
                initComplete: function () {
                    const $w = $("#role-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function applyFilters() {
            if (!datatable) return;
            const status = $('#filterStatus').val() || '';
            // Column 4 is Status
            datatable.column(4).search(status).draw();
        }

        function toggleRoleStatus(id, checkbox) {
            const isActive = $(checkbox).is(":checked");
            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("UpdateStatus", "Role")',
                type: 'POST',
                data: {
                    id: id,
                    status: isActive ? 1 : 0,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    if (res && res.success) {
                        toastr.success(res.message || 'Role status updated successfully.', 'Success');
                        $(checkbox).attr('title', isActive ? 'Active' : 'Inactive');
                    } else {
                        toastr.error(res ? res.message : 'Failed to update role status.', 'Error');
                        $(checkbox).prop('checked', !isActive);
                    }
                },
                error: function () {
                    toastr.error('Error updating status.', 'Error');
                    $(checkbox).prop('checked', !isActive);
                }
            });
        }

        function confirmDeleteRole(id, name, userCount) {
            deleteTargetId = id;
            $('#deleteRoleName').text(name);

            if (userCount > 0) {
                $('#deleteWarningMsg').text('Warning: ' + userCount + ' admin users are currently assigned to this role. You must reassign them before deleting this role.');
                $('#btn-delete-role-yes').prop('disabled', true);
            } else {
                $('#deleteWarningMsg').text('This role will be permanently removed.');
                $('#btn-delete-role-yes').prop('disabled', false);
            }

            $('#role-delete-confirm-modal').modal('show');
        }

        function executeDeleteRole() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-role-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Role")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#role-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Role deleted successfully.', 'Deleted');
                        const row = document.getElementById('role-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error(res ? res.message : 'Failed to delete role.', 'Error');
                    }
                },
                error: function () {
                    $('#role-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');
                    toastr.error('An error occurred while deleting the role.', 'Error');
                }
            });
        }
    </script>
}
