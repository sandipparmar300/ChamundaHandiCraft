@model PagedResult<StockTransferGridItem>
@*
    Inventory - Stock Transfers listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Stock Transfers";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Stock Transfers</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Inventory</li>
            <li>Stock Transfers Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search transfer number or product" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="StockTransfer" asp-action="Add" class="custom_button primary_button">Add Stock Transfer</a>
            </div>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
    <div class="table-main">
        <table id="stocktransfer-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:150px;">Transfer Number</th>
                    <th style="min-width:130px;">Transfer Date</th>
                    <th style="min-width:180px;">Source Warehouse</th>
                    <th style="min-width:190px;">Destination Warehouse</th>
                    <th style="min-width:210px;">Product</th>
                    <th style="min-width:110px;">Quantity</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:150px;">Created By</th>
                    <th style="min-width:80px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="stocktransfer-row-@row.Id">
                        <td class="t-mono"><a asp-action="Edit" asp-route-id="@row.Id">@row.TransferNumber</a></td>
                        <td>@Money.LongDate(row.InitiatedOn)</td>
                        <td>@row.FromWarehouse</td>
                        <td>@row.ToWarehouse</td>
                        <td class="text-end">@row.SkuCount SKUs</td>
                        <td class="text-end">@row.TotalQuantity</td>
                        <td><span class="badge bg-secondary">@row.Status</span></td>
                        <td>@(row.CreatedBy ?? "—")</td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteTransfer(@row.Id, '@Html.Raw(Html.Encode(row.TransferNumber))')" title="Delete" class="text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="stocktransfer-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete transfer <strong id="deleteTransferNumber"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteTransfer()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }

            datatable = $('#stocktransfer-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                dom: 'rtip',
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#stocktransfer-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function confirmDeleteTransfer(id, trfNumber) {
            deleteTargetId = id;
            $('#deleteTransferNumber').text(trfNumber);
            $('#stocktransfer-delete-confirm-modal').modal('show');
        }

        function executeDeleteTransfer() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "StockTransfer")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#stocktransfer-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Stock transfer deleted successfully.', 'Deleted');
                        const row = document.getElementById('stocktransfer-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error((res && res.message) || 'Failed to delete stock transfer.', 'Error');
                    }
                },
                error: function () {
                    $('#stocktransfer-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');
                    toastr.error('A server error occurred while deleting the transfer.', 'Error');
                }
            });
        }
    </script>
}
