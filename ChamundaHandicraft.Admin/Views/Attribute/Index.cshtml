@model PagedResult<AttributeGridItem>
@{
    ViewData["Title"] = "Attributes";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Attributes</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Catalog</li>
            <li>Attributes Listing</li>
        </ul>
    </div>
}

@Html.AntiForgeryToken()

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search attribute" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <a asp-controller="Attribute" asp-action="Add" class="custom_button primary_button">
                <i class="fas fa-plus me-1"></i> Add Attribute
            </a>
        </div>
    </div>

    <div class="table-main">
        <table id="attribute-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:180px;">Attribute</th>
                    <th style="min-width:130px;">Display Type</th>
                    <th style="min-width:100px;">Values</th>
                    <th style="min-width:160px;">Storefront Role</th>
                    <th style="min-width:110px;">Used By</th>
                    <th style="min-width:100px;">Status</th>
                    <th style="min-width:110px; text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="attribute-row-@row.Id">
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" class="fw-semibold">@row.AttributeName</a>
                            @if (row.IsRequired)
                            {
                                <span class="badge bg-secondary ms-1" style="font-size: 10px;">Required</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@row.DisplayType</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-info text-dark">@row.ValueCount</span>
                        </td>
                        <td>@(row.IsFilterable ? "Filter + Display" : "Display only")</td>
                        <td class="text-end">@row.UsedByProductCount products</td>
                        <td>@await Html.PartialAsync("_StatusPill", row.IsActive)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View Details" class="ms-2 text-info"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteAttribute(@row.Id, '@Html.Raw(Html.Encode(row.AttributeName))')" title="Delete" class="ms-2 text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-4">No attributes yet. <a asp-action="Add">Add the first one</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal delete-common-modal common-modal" id="attribute-delete-confirm-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Attribute</h3>
                <p>Are you sure you want to delete <strong id="deleteAttributeName"></strong>? This attribute and its values will be archived.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteAttribute()">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Product"); }

            datatable = $('#attribute-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                dom: 'rtip',
                initComplete: function () {
                    const $w = $("#attribute-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function confirmDeleteAttribute(id, name) {
            deleteTargetId = id;
            $('#deleteAttributeName').text(name);
            $('#attribute-delete-confirm-modal').modal('show');
        }

        function executeDeleteAttribute() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Attribute")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#attribute-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Attribute deleted successfully.', 'Deleted');
                        const row = document.getElementById('attribute-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error(res ? res.message : 'Failed to delete attribute.', 'Error');
                    }
                },
                error: function () {
                    $('#attribute-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');
                    toastr.error('An error occurred while deleting the attribute.', 'Error');
                }
            });
        }
    </script>
}
