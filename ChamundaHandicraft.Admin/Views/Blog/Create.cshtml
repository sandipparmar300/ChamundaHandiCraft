@model BlogPostSaveRequest
@{
    ViewData["Title"] = "Post";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Post" : "Add Post";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Blog" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Blog" asp-action="Index" class="links">Blog Posts Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="blogForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-pen-nib" style="color:var(--accent);margin-right:8px;"></i>Post Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Cover Image</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="image" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Title <span class="req">*</span></label>
                        <input id="Title" name="Title" class="form-control-custom" placeholder="Enter title" / value="@Model.Title" >
                        <span class="error-msg" data-valmsg-for="Title"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Slug <span class="req">*</span></label>
                        <input id="Slug" name="Slug" class="form-control-custom" placeholder="Enter slug" / value="@Model.Slug" >
                        <span class="error-msg" data-valmsg-for="Slug"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Category <span class="req">*</span></label>
                        <select id="Category" name="Category" class="form-control-custom select2-single">
                            <option value="">Select category</option>
                            <option>Select from master</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Category"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Author <span class="req">*</span></label>
                        <select id="Author" name="Author" class="form-control-custom select2-single">
                            <option value="">Select author</option>
                            <option>Select from master</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Author"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Reading Time (min)</label>
                        <input type="number" id="ReadingTimemin" name="ReadingTimemin" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="ReadingTimemin"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Published On</label>
                        <input type="datetime-local" id="PublishedOn" name="PublishedOn" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="PublishedOn"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Excerpt</label>
                        <textarea id="Excerpt" name="Excerpt" class="form-control-custom" rows="3" placeholder="Enter excerpt">@Model.Excerpt</textarea>
                        <span class="error-msg" data-valmsg-for="Excerpt"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Content <span class="req">*</span></label>
                        <textarea id="Content" name="Content" class="form-control-custom" rows="3" placeholder="Enter content"></textarea>
                        <span class="error-msg" data-valmsg-for="Content"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-magnifying-glass" style="color:var(--accent);margin-right:8px;"></i>SEO and Tags</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">SEO Title</label>
                        <input id="SEOTitle" name="SEOTitle" class="form-control-custom" placeholder="Enter seo title" />
                        <span class="error-msg" data-valmsg-for="SEOTitle"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Tags</label>
                        <input id="Tags" name="Tags" class="form-control-custom" placeholder="Enter tags" />
                        <span class="error-msg" data-valmsg-for="Tags"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Meta Keywords</label>
                        <input id="MetaKeywords" name="MetaKeywords" class="form-control-custom" placeholder="Enter meta keywords" />
                        <span class="error-msg" data-valmsg-for="MetaKeywords"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Meta Description</label>
                        <textarea id="MetaDescription" name="MetaDescription" class="form-control-custom" rows="3" placeholder="Enter meta description"></textarea>
                        <span class="error-msg" data-valmsg-for="MetaDescription"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Blog" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Blog"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
