@model PagedResult<ReturnRequestViewModel>
@*
    Sales - Returns listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Returns";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Returns</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Sales</li>
            <li>Returns Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search return or order number" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Return" asp-action="Add" class="custom_button primary_button">Add Return</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="return-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:140px;">Return Number</th>
                    <th style="min-width:150px;">Order Number</th>
                    <th style="min-width:190px;">Customer</th>
                    <th style="min-width:210px;">Product</th>
                    <th style="min-width:110px;">Quantity</th>
                    <th style="min-width:180px;">Return Reason</th>
                    <th style="min-width:140px;">Inspection</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:140px;">Requested On</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td class="t-mono"><a asp-action="Edit" asp-route-id="@row.Id">@row.RmaNumber</a></td>
                        <td>@row.OrderNumber</td>
                        <td>—</td>
                        <td>@(row.Lines.FirstOrDefault()?.ProductName ?? "—")</td>
                        <td class="text-end">@row.Lines.Sum(l => l.Quantity)</td>
                        <td>@row.Reason</td>
                        <td>@row.Resolution</td>
                        <td><span class="badge bg-secondary">@row.Status</span></td>
                        <td>@Money.LongDate(row.RequestedOn)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Process"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="text-center py-4">No return requests.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="return-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this record?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Order"); }

            datatable = $('#return-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#return-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Return API.');
            }
        }
    </script>
}
