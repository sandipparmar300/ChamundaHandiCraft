@model ReturnRequestViewModel
@{
    ViewData["Title"] = "Return";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Return" : "Add Return";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Return" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Return" asp-action="Index" class="links">Returns Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="returnForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-arrow-rotate-left" style="color:var(--accent);margin-right:8px;"></i>Return Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Return Number <span class="req">*</span></label>
                        <input id="ReturnNumber" name="ReturnNumber" class="form-control-custom" placeholder="Enter return number" />
                        <span class="error-msg" data-valmsg-for="ReturnNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Order Number <span class="req">*</span></label>
                        <input id="OrderNumber" name="OrderNumber" class="form-control-custom" placeholder="Enter order number" / value="@Model.OrderNumber" >
                        <span class="error-msg" data-valmsg-for="OrderNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Product <span class="req">*</span></label>
                        <select id="Product" name="Product" class="form-control-custom select2-single">
                            <option value="">Select product</option>
                            <option>Select from order</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Product"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Quantity <span class="req">*</span></label>
                        <input type="number" id="Quantity" name="Quantity" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="Quantity"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Return Reason <span class="req">*</span></label>
                        <select id="ReturnReason" name="ReturnReason" class="form-control-custom select2-single">
                            <option value="">Select return reason</option>
                            <option>Damaged</option>
                            <option>Wrong Item</option>
                            <option>Not As Described</option>
                            <option>Size Issue</option>
                            <option>Quality Issue</option>
                            <option>Changed Mind</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="ReturnReason"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Inspection Result</label>
                        <select id="InspectionResult" name="InspectionResult" class="form-control-custom select2-single">
                            <option value="">Select inspection result</option>
                            <option>Pending</option>
                            <option>Passed</option>
                            <option>Failed</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="InspectionResult"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <select id="Status" name="Status" class="form-control-custom select2-single">
                            <option value="">Select status</option>
                            <option>Requested</option>
                            <option>Received</option>
                            <option>Inspected</option>
                            <option>Approved</option>
                            <option>Rejected</option>
                            <option>Refunded</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Status"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Restock Action</label>
                        <select id="RestockAction" name="RestockAction" class="form-control-custom select2-single">
                            <option value="">Select restock action</option>
                            <option>Restock</option>
                            <option>Damage</option>
                            <option>Return to Supplier</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="RestockAction"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Remarks</label>
                        <textarea id="Remarks" name="Remarks" class="form-control-custom" rows="3" placeholder="Enter remarks"></textarea>
                        <span class="error-msg" data-valmsg-for="Remarks"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Return" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Order"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
