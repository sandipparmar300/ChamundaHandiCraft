@*
    The signed-in operator's own profile. Fields mirror AdminProfileViewModel exactly —
    the role and last sign-in are shown as facts, not inputs, because neither is
    something you change about yourself here.
*@
@model AdminProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">My Profile</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Account</li>
            <li>Profile</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-controller="Profile" asp-action="Save" id="profileForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-user" style="color:var(--accent);margin-right:8px;"></i>Profile Information</h2>
                <span class="text-muted" style="font-size:.8rem;">
                    @Model.RoleName
                    @if (Model.LastLoginOn.HasValue)
                    {
                        <text> &middot; last signed in @Money.Relative(Model.LastLoginOn.Value)</text>
                    }
                </span>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Profile Photo</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ProfilePhotoPreview"
                                 src="@(string.IsNullOrEmpty(Model.PhotoUrl) ? Url.Content("~/assets/images/default-profile.png") : Model.PhotoUrl)"
                                 class="pic-preview clickable-img" alt="@Model.FullName" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom" for="FullName">Full Name <span class="req">*</span></label>
                        <input id="FullName" name="FullName" class="form-control-custom"
                               value="@Model.FullName" placeholder="Enter full name" />
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom" for="Email">Email</label>
                        <input id="Email" name="Email" class="form-control-custom" value="@Model.Email" readonly />
                        <p class="upload-note">Changing this needs an administrator.</p>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom" for="Phone">Mobile Number</label>
                        <input id="Phone" name="Phone" class="form-control-custom"
                               value="@Model.Phone" placeholder="Enter mobile number" />
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom" for="Timezone">Time Zone</label>
                        <select id="Timezone" name="Timezone" class="form-control-custom select2-single">
                            @foreach (var tz in new[] { "Asia/Kolkata", "Asia/Dubai", "Europe/London", "America/New_York" })
                            {
                                <option value="@tz" selected="@(tz == Model.Timezone)">@tz</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Role</label>
                        <input class="form-control-custom" value="@Model.RoleName" readonly />
                    </div>

                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-shield-halved" style="color:var(--accent);margin-right:8px;"></i>Security</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Two-factor authentication</label>
                        <div>
                            @if (Model.TwoFactorEnabled)
                            {
                                <span class="status-pill status-active"><i class="fas fa-check"></i> Enabled</span>
                            }
                            else
                            {
                                <span class="status-pill status-inactive"><i class="fas fa-triangle-exclamation"></i> Not enabled</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom" for="CurrentPassword">Current Password</label>
                        <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control-custom" autocomplete="current-password" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom" for="NewPassword">New Password</label>
                        <input type="password" id="NewPassword" name="NewPassword" class="form-control-custom" autocomplete="new-password" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom" for="ConfirmPassword">Confirm New Password</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control-custom" autocomplete="new-password" />
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div></div>
            <div>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save Changes</button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });
    </script>
}
