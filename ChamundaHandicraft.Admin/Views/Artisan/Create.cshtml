@model ArtisanSaveRequest
@{
    ViewData["Title"] = "Artisan";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Artisan" : "Add Artisan";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Artisan" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Artisan" asp-action="Index" class="links">Artisan Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="artisanForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-person-workspace" style="color:var(--accent);margin-right:8px;"></i>Artisan Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Photo</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="photo" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Artisan Name <span class="req">*</span></label>
                        <input id="ArtisanName" name="ArtisanName" class="form-control-custom" placeholder="Enter artisan name" />
                        <span class="error-msg" data-valmsg-for="ArtisanName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Craft Cluster</label>
                        <input id="CraftCluster" name="CraftCluster" class="form-control-custom" placeholder="Enter craft cluster" />
                        <span class="error-msg" data-valmsg-for="CraftCluster"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Region</label>
                        <input id="Region" name="Region" class="form-control-custom" placeholder="Enter region" />
                        <span class="error-msg" data-valmsg-for="Region"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Experience (years)</label>
                        <input type="number" id="Experienceyears" name="Experienceyears" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="Experienceyears"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Contact Number</label>
                        <input id="ContactNumber" name="ContactNumber" class="form-control-custom" placeholder="Enter contact number" />
                        <span class="error-msg" data-valmsg-for="ContactNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Email</label>
                        <input id="Email" name="Email" class="form-control-custom" placeholder="Enter email" />
                        <span class="error-msg" data-valmsg-for="Email"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Artisan Story</label>
                        <textarea id="ArtisanStory" name="ArtisanStory" class="form-control-custom" rows="3" placeholder="Enter artisan story"></textarea>
                        <span class="error-msg" data-valmsg-for="ArtisanStory"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Artisan" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Product"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
