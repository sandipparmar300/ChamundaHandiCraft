@model ChamundaHandicraft.Helper.ViewModel.Admin.StockAdjustmentDetailViewModel
@{
    ViewData["Title"] = $"Adjustment: {Model.AdjustmentNumber}";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="StockAdjustment" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Stock Adjustment Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="StockAdjustment" asp-action="Index" class="links">Stock Adjustments</a></li>
            <li>@Model.AdjustmentNumber</li>
        </ul>
    </div>
}

<main class="page-content">
    <div class="row g-4">
        <div class="col-lg-6 col-md-12">
            <div class="common-box p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0 fw-bold">@Model.AdjustmentNumber</h4>
                    <span class="badge bg-light text-dark border">@Model.AdjustedOn.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>

                <hr class="my-3" />

                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted font-12 d-block">Warehouse</span>
                        <strong>@Model.WarehouseName</strong>
                    </div>

                    <div class="col-sm-6">
                        <span class="text-muted font-12 d-block">Reason</span>
                        <span class="badge bg-info text-dark">@Model.Reason</span>
                    </div>

                    <div class="col-12">
                        <span class="text-muted font-12 d-block">Product</span>
                        <strong class="fs-6">@Model.ProductName</strong>
                        <small class="text-muted d-block">SKU: <code>@Model.Sku</code></small>
                    </div>

                    <div class="col-sm-4">
                        <span class="text-muted font-12 d-block">Quantity Before</span>
                        <span class="fs-5">@Model.QuantityBefore</span>
                    </div>

                    <div class="col-sm-4">
                        <span class="text-muted font-12 d-block">Adjustment Difference</span>
                        <strong class="fs-5 @(Model.QuantityChange > 0 ? "text-success" : "text-danger")">
                            @(Model.QuantityChange > 0 ? "+" : "")@Model.QuantityChange
                        </strong>
                    </div>

                    <div class="col-sm-4">
                        <span class="text-muted font-12 d-block">Quantity After</span>
                        <strong class="fs-5 text-primary">@Model.QuantityAfter</strong>
                    </div>

                    <div class="col-12">
                        <span class="text-muted font-12 d-block">Logged By</span>
                        <span>@(Model.CreatedByName ?? "Admin")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="col-12">
                            <span class="text-muted font-12 d-block">Remarks</span>
                            <p class="mb-0 p-2 bg-light rounded font-13">@Model.Note</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
        });
    </script>
}
