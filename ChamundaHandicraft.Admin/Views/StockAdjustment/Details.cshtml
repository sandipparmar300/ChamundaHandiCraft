@{
    ViewData["Title"] = "Stock Adjustment Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="StockAdjustment" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Stock Adjustment Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="StockAdjustment" asp-action="Index" class="links">Stock Adjustments Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Stock Adjustment Information</h2>
            <a asp-controller="StockAdjustment" asp-action="Edit" asp-route-id="0" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Adjustment Number</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Date</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Product</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Warehouse</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Previous Quantity</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">New Quantity</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Difference</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reason</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Remarks</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Adjusted By</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
        });
    </script>
}
