@model PagedResult<StockAdjustmentGridItem>
@*
    Inventory - Stock Adjustments listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Stock Adjustments";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Stock Adjustments</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Inventory</li>
            <li>Stock Adjustments Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search adjustment number or product" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="StockAdjustment" asp-action="Add" class="custom_button primary_button">Add Stock Adjustment</a>
            </div>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
    <div class="table-main">
        <table id="stockadjustment-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:160px;">Adjustment Number</th>
                    <th style="min-width:130px;">Date</th>
                    <th style="min-width:210px;">Product</th>
                    <th style="min-width:170px;">Warehouse</th>
                    <th style="min-width:140px;">Previous Qty</th>
                    <th style="min-width:130px;">New Qty</th>
                    <th style="min-width:120px;">Difference</th>
                    <th style="min-width:190px;">Reason</th>
                    <th style="min-width:150px;">Adjusted By</th>
                    <th style="min-width:90px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="stockadjustment-row-@row.Id">
                        <td class="t-mono">@row.AdjustmentNumber</td>
                        <td>@Money.LongDate(row.AdjustedOn)</td>
                        <td>@row.ProductName <span class="text-muted">@row.Sku</span></td>
                        <td>@row.WarehouseName</td>
                        <td class="text-end">@row.QuantityBefore</td>
                        <td class="text-end">@row.QuantityAfter</td>
                        <td class="text-end @(row.IsIncrease ? "text-success" : "text-danger")">
                            @(row.IsIncrease ? "+" : "")@row.QuantityChange
                        </td>
                        @* Every adjustment carries a reason — an unexplained change is how shrinkage hides. *@
                        <td>@row.Reason</td>
                        <td>@(row.CreatedBy ?? "—")</td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteAdjustment(@row.Id, '@Html.Raw(Html.Encode(row.AdjustmentNumber))')" title="Delete" class="text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="stockadjustment-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete adjustment <strong id="deleteAdjustmentNumber"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteAdjustment()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }

            datatable = $('#stockadjustment-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                dom: 'rtip',
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#stockadjustment-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function confirmDeleteAdjustment(id, adjNumber) {
            deleteTargetId = id;
            $('#deleteAdjustmentNumber').text(adjNumber);
            $('#stockadjustment-delete-confirm-modal').modal('show');
        }

        function executeDeleteAdjustment() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "StockAdjustment")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#stockadjustment-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Stock adjustment deleted successfully.', 'Deleted');
                        const row = document.getElementById('stockadjustment-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error((res && res.message) || 'Failed to delete stock adjustment.', 'Error');
                    }
                },
                error: function () {
                    $('#stockadjustment-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');
                    toastr.error('A server error occurred while deleting the adjustment.', 'Error');
                }
            });
        }
    </script>
}
