@{
    ViewData["Title"] = "Stock Adjustment";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Stock Adjustment" : "Add Stock Adjustment";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="StockAdjustment" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="StockAdjustment" asp-action="Index" class="links">Stock Adjustments Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="stockadjustmentForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-pen-to-square" style="color:var(--accent);margin-right:8px;"></i>Adjustment Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Adjustment Number <span class="req">*</span></label>
                        <input id="AdjustmentNumber" name="AdjustmentNumber" class="form-control-custom" placeholder="Enter adjustment number" />
                        <span class="error-msg" data-valmsg-for="AdjustmentNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Date <span class="req">*</span></label>
                        <input type="date" id="Date" name="Date" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="Date"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Product <span class="req">*</span></label>
                        <select id="Product" name="Product" class="form-control-custom select2-single">
                            <option value="">Select product</option>
                            <option>Select from catalog</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Product"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Warehouse <span class="req">*</span></label>
                        <select id="Warehouse" name="Warehouse" class="form-control-custom select2-single">
                            <option value="">Select warehouse</option>
                            <option>Select from master</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Warehouse"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Previous Quantity</label>
                        <input type="number" id="PreviousQuantity" name="PreviousQuantity" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="PreviousQuantity"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">New Quantity <span class="req">*</span></label>
                        <input type="number" id="NewQuantity" name="NewQuantity" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="NewQuantity"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Difference</label>
                        <input type="number" id="Difference" name="Difference" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="Difference"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reason <span class="req">*</span></label>
                        <select id="Reason" name="Reason" class="form-control-custom select2-single">
                            <option value="">Select reason</option>
                            <option>Manual Correction</option>
                            <option>Physical Verification</option>
                            <option>Counting Error</option>
                            <option>Lost Stock</option>
                            <option>Extra Stock</option>
                            <option>System Correction</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Reason"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Remarks</label>
                        <textarea id="Remarks" name="Remarks" class="form-control-custom" rows="3" placeholder="Enter remarks"></textarea>
                        <span class="error-msg" data-valmsg-for="Remarks"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="StockAdjustment" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
