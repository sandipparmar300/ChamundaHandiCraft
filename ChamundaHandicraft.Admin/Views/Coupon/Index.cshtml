@model PagedResult<CouponGridItem>
@*
    Marketing - Coupons listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Coupons";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Coupons</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Marketing</li>
            <li>Coupons Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search coupon code or name" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Export')"><i class="fas fa-file-export"></i> Export</button>
                <a asp-controller="Coupon" asp-action="Add" class="custom_button primary_button">Add Coupon</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="coupon-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:150px;">Coupon Code</th>
                    <th style="min-width:190px;">Coupon Name</th>
                    <th style="min-width:140px;">Discount Type</th>
                    <th style="min-width:130px;">Value</th>
                    <th style="min-width:140px;">Min Order</th>
                    <th style="min-width:130px;">Usage Limit</th>
                    <th style="min-width:120px;">Used</th>
                    <th style="min-width:140px;">Valid From</th>
                    <th style="min-width:140px;">Valid To</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td class="t-mono"><a asp-action="Edit" asp-route-id="@row.Id">@row.Code</a></td>
                        <td>@row.Title</td>
                        <td>@row.DiscountType</td>
                        <td class="text-end">@(row.DiscountType == DiscountType.Percentage ? row.DiscountValue + "%" : Money.Inr(row.DiscountValue))</td>
                        <td class="text-end">@(row.MinimumOrderValue is null ? "—" : Money.Inr(row.MinimumOrderValue.Value))</td>
                        <td class="text-end">@(row.TotalUsageLimit is null ? "Unlimited" : row.TotalUsageLimit.ToString())</td>
                        <td class="text-end">
                            @row.UsageCount
                            @if (row.IsExhausted)
                            {
                                <span class="badge bg-secondary ms-1">Exhausted</span>
                            }
                        </td>
                        <td>@Money.LongDate(row.StartsOn)</td>
                        <td>@(row.ExpiresOn is null ? "No expiry" : Money.LongDate(row.ExpiresOn.Value))</td>
                        <td>
                            <span class="badge @(row.Status == CouponStatus.Active ? "bg-success" : "bg-secondary")">@row.Status</span>
                            @* Hidden coupons never appear in the shopper's "My Coupons" — they must be typed. *@
                            @if (!row.IsPublic)
                            {
                                <span class="badge bg-dark ms-1">Private</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="11" class="text-center py-4">No coupons yet. <a asp-action="Add">Create the first one</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="coupon-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this record?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Promotions"); }

            datatable = $('#coupon-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#coupon-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Coupon API.');
            }
        }
    </script>
}
