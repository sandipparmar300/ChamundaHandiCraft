@model CouponSaveRequest
@{
    ViewData["Title"] = "Coupon";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Coupon" : "Add Coupon";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Coupon" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Coupon" asp-action="Index" class="links">Coupons Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-action="Save" asp-controller="Coupon" id="couponForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-ticket" style="color:var(--accent);margin-right:8px;"></i>Coupon Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Coupon Code <span class="req">*</span></label>
                        <input asp-for="Code" class="form-control-custom text-uppercase" placeholder="e.g. WELCOME10" required />
                        <span class="error-msg" asp-validation-for="Code"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Coupon Name / Title <span class="req">*</span></label>
                        <input asp-for="Title" class="form-control-custom" placeholder="e.g. Welcome Discount" required />
                        <span class="error-msg" asp-validation-for="Title"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Discount Type <span class="req">*</span></label>
                        <select asp-for="DiscountType" class="form-control-custom select2-single">
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.DiscountType.Percentage)">Percentage (%)</option>
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.DiscountType.FixedAmount)">Fixed Amount (₹)</option>
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.DiscountType.FreeShipping)">Free Shipping</option>
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.DiscountType.BuyXGetY)">Buy X Get Y</option>
                        </select>
                        <span class="error-msg" asp-validation-for="DiscountType"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Discount Value <span class="req">*</span></label>
                        <input type="number" step="0.01" asp-for="DiscountValue" class="form-control-custom" placeholder="0.00" required />
                        <span class="error-msg" asp-validation-for="DiscountValue"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Maximum Discount (₹)</label>
                        <input type="number" step="0.01" asp-for="MaxDiscount" class="form-control-custom" placeholder="Optional cap" />
                        <span class="error-msg" asp-validation-for="MaxDiscount"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Minimum Order Value (₹)</label>
                        <input type="number" step="0.01" asp-for="MinimumOrderValue" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" asp-validation-for="MinimumOrderValue"></span>
                    </div>

                    <div class="col-lg-12 col-md-12">
                        <label class="form-label-custom">Description</label>
                        <textarea asp-for="Description" class="form-control-custom" rows="3" placeholder="Enter coupon description"></textarea>
                        <span class="error-msg" asp-validation-for="Description"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-calendar-days" style="color:var(--accent);margin-right:8px;"></i>Validity and Limits</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid From <span class="req">*</span></label>
                        <input type="datetime-local" asp-for="StartsOn" class="form-control-custom" value="@(Model.StartsOn.ToString("yyyy-MM-ddTHH:mm"))" required />
                        <span class="error-msg" asp-validation-for="StartsOn"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid To</label>
                        <input type="datetime-local" asp-for="ExpiresOn" class="form-control-custom" value="@(Model.ExpiresOn?.ToString("yyyy-MM-ddTHH:mm"))" />
                        <span class="error-msg" asp-validation-for="ExpiresOn"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Usage Limit Total</label>
                        <input type="number" asp-for="TotalUsageLimit" class="form-control-custom" placeholder="Optional (e.g. 100)" />
                        <span class="error-msg" asp-validation-for="TotalUsageLimit"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Usage Limit Per Customer</label>
                        <input type="number" asp-for="PerCustomerLimit" class="form-control-custom" placeholder="1" />
                        <span class="error-msg" asp-validation-for="PerCustomerLimit"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Visibility</label>
                        <select asp-for="IsPublic" class="form-control-custom select2-single">
                            <option value="true">Public (Visible in My Coupons)</option>
                            <option value="false">Private / Secret (Must type code)</option>
                        </select>
                        <span class="error-msg" asp-validation-for="IsPublic"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" asp-for="IsActive" id="IsActiveCheckbox" />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>

            <div>
                <a asp-controller="Coupon" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Promotions"); }

            $('#IsActiveCheckbox').on('change', function () {
                $('#isActiveStatus').text(this.checked ? 'Active' : 'Inactive');
            });
        });
    </script>
}
