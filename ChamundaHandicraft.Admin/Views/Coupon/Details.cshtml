@model CouponGridItem
@{
    ViewData["Title"] = "Coupon Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Coupon" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Coupon Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Coupon" asp-action="Index" class="links">Coupons Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Coupon Information</h2>
            <a asp-controller="Coupon" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Coupon Code</label>
                        <p class="detail-value">@Model.Code</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Coupon Name</label>
                        <p class="detail-value">@Model.Title</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Discount Type</label>
                        <p class="detail-value">@Model.DiscountType</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Discount Value</label>
                        <p class="detail-value">@Model.DiscountValue</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Maximum Discount</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Minimum Order Value</label>
                        <p class="detail-value">@(Model.MinimumOrderValue is null ? "None" : Money.Inr(Model.MinimumOrderValue.Value))</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid From</label>
                        <p class="detail-value">@Money.LongDate(Model.StartsOn)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid To</label>
                        <p class="detail-value">@(Model.ExpiresOn is null ? "No expiry" : Money.LongDate(Model.ExpiresOn.Value))</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Usage Limit Total</label>
                        <p class="detail-value">@(Model.TotalUsageLimit is null ? "Unlimited" : Model.TotalUsageLimit.ToString())</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Usage Limit Per Customer</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Times Used</label>
                        <p class="detail-value">@Model.UsageCount</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Applies To</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Customer Eligibility</label>
                        <p class="detail-value">@(Model.IsPublic ? "Anyone" : "Private — must be typed")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Stackable</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@Model.Status</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Created By</label>
                        <p class="detail-value">@(Model.CreatedBy ?? "—")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Promotions"); }
        });
    </script>
}
