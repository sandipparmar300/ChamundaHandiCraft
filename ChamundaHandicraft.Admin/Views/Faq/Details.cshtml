@model FaqGridItem
@{
    ViewData["Title"] = "FAQ Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Faq" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">FAQ Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Faq" asp-action="Index" class="links">FAQs Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>FAQ Information</h2>
            <a asp-controller="Faq" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Question</label>
                        <p class="detail-value">@Model.Question</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Answer</label>
                        <p class="detail-value">@Model.Answer</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Category</label>
                        <p class="detail-value">@Model.Topic</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Sort Order</label>
                        <p class="detail-value">@Model.SortOrder</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Helpful Votes</label>
                        <p class="detail-value">@Model.HelpfulCount up / @Model.NotHelpfulCount down</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Last Updated</label>
                        <p class="detail-value">@Money.LongDate(Model.ModifiedOn ?? Model.CreatedOn)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@(Model.IsActive ? "Active" : "Inactive")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-CmsPage"); }
        });
    </script>
}
