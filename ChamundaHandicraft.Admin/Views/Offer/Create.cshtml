@model FlashSaleSaveRequest
@{
    ViewData["Title"] = "Offer";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Offer" : "Add Offer";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Offer" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Offer" asp-action="Index" class="links">Offers Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-action="Save" asp-controller="Offer" id="offerForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="BannerUrl" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-gift" style="color:var(--accent);margin-right:8px;"></i>Offer Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Banner Image</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="@(string.IsNullOrEmpty(Model.BannerUrl) ? Url.Content("~/assets/images/default-profile.png") : Model.BannerUrl)" class="pic-preview clickable-img" alt="image" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Offer Name <span class="req">*</span></label>
                        <input asp-for="OfferName" class="form-control-custom" placeholder="Enter offer name" />
                        <span class="text-danger" asp-validation-for="OfferName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Offer Type <span class="req">*</span></label>
                        <select asp-for="OfferType" class="form-control-custom select2-single">
                            <option value="">Select offer type</option>
                            <option value="Flat Discount">Flat Discount</option>
                            <option value="Percentage Discount">Percentage Discount</option>
                            <option value="Buy X Get Y">Buy X Get Y</option>
                            <option value="Combo">Combo</option>
                            <option value="Flash Sale">Flash Sale</option>
                            <option value="Bundle">Bundle</option>
                        </select>
                        <span class="text-danger" asp-validation-for="OfferType"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Discount Value (%) <span class="req">*</span></label>
                        <input asp-for="DiscountValue" class="form-control-custom" placeholder="0" />
                        <span class="text-danger" asp-validation-for="DiscountValue"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Applies To</label>
                        <select asp-for="AppliesTo" class="form-control-custom select2-single">
                            <option value="">Select applies to</option>
                            <option value="Entire Store">Entire Store</option>
                            <option value="Specific Products">Specific Products</option>
                            <option value="Specific Categories">Specific Categories</option>
                            <option value="Specific Brands">Specific Brands</option>
                        </select>
                        <span class="text-danger" asp-validation-for="AppliesTo"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Priority</label>
                        <input type="number" asp-for="Priority" class="form-control-custom" placeholder="0" />
                        <span class="text-danger" asp-validation-for="Priority"></span>
                    </div>

                    <div class="col-lg-12 col-md-12">
                        <label class="form-label-custom">Description</label>
                        <textarea asp-for="Description" class="form-control-custom" rows="3" placeholder="Enter description"></textarea>
                        <span class="text-danger" asp-validation-for="Description"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-calendar-days" style="color:var(--accent);margin-right:8px;"></i>Schedule</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid From <span class="req">*</span></label>
                        <input type="datetime-local" asp-for="ValidFrom" class="form-control-custom" value="@(Model.ValidFrom != default ? Model.ValidFrom.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <span class="text-danger" asp-validation-for="ValidFrom"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid To <span class="req">*</span></label>
                        <input type="datetime-local" asp-for="ValidTo" class="form-control-custom" value="@(Model.ValidTo != default ? Model.ValidTo.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <span class="text-danger" asp-validation-for="ValidTo"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" asp-for="IsActive" id="IsActiveCheckbox" />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>

            <div>
                <a asp-controller="Offer" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Promotions"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
            $('#IsActiveCheckbox').change(function () {
                $('#isActiveStatus').text(this.checked ? 'Active' : 'Inactive');
            });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
