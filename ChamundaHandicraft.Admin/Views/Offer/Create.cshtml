@model FlashSaleSaveRequest
@{
    ViewData["Title"] = "Offer";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Offer" : "Add Offer";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Offer" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Offer" asp-action="Index" class="links">Offers Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="offerForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-gift" style="color:var(--accent);margin-right:8px;"></i>Offer Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Banner Image</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="image" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Offer Name <span class="req">*</span></label>
                        <input id="OfferName" name="OfferName" class="form-control-custom" placeholder="Enter offer name" />
                        <span class="error-msg" data-valmsg-for="OfferName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Offer Type <span class="req">*</span></label>
                        <select id="OfferType" name="OfferType" class="form-control-custom select2-single">
                            <option value="">Select offer type</option>
                            <option>Flat Discount</option>
                            <option>Percentage Discount</option>
                            <option>Buy X Get Y</option>
                            <option>Combo</option>
                            <option>Flash Sale</option>
                            <option>Bundle</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="OfferType"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Discount Value <span class="req">*</span></label>
                        <input id="DiscountValue" name="DiscountValue" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" data-valmsg-for="DiscountValue"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Applies To</label>
                        <select id="AppliesTo" name="AppliesTo" class="form-control-custom select2-single">
                            <option value="">Select applies to</option>
                            <option>Entire Store</option>
                            <option>Specific Products</option>
                            <option>Specific Categories</option>
                            <option>Specific Brands</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="AppliesTo"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Priority</label>
                        <input type="number" id="Priority" name="Priority" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="Priority"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Description</label>
                        <textarea id="Description" name="Description" class="form-control-custom" rows="3" placeholder="Enter description"></textarea>
                        <span class="error-msg" data-valmsg-for="Description"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-calendar-days" style="color:var(--accent);margin-right:8px;"></i>Schedule</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid From <span class="req">*</span></label>
                        <input type="datetime-local" id="ValidFrom" name="ValidFrom" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="ValidFrom"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Valid To <span class="req">*</span></label>
                        <input type="datetime-local" id="ValidTo" name="ValidTo" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="ValidTo"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Show Countdown</label>
                        <select id="ShowCountdown" name="ShowCountdown" class="form-control-custom select2-single">
                            <option value="">Select show countdown</option>
                            <option>No</option>
                            <option>Yes</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="ShowCountdown"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Stackable</label>
                        <select id="Stackable" name="Stackable" class="form-control-custom select2-single">
                            <option value="">Select stackable</option>
                            <option>No</option>
                            <option>Yes</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Stackable"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Offer" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Promotions"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
