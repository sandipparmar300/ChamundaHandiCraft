@model PagedResult<OfferGridItem>
@*
    Marketing - Offers listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Offers";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Offers</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Marketing</li>
            <li>Offers Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search offer name" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Offer" asp-action="Add" class="custom_button primary_button">Add Offer</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="offer-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:200px;">Offer Name</th>
                    <th style="min-width:150px;">Offer Type</th>
                    <th style="min-width:160px;">Applies To</th>
                    <th style="min-width:130px;">Discount</th>
                    <th style="min-width:140px;">Valid From</th>
                    <th style="min-width:140px;">Valid To</th>
                    <th style="min-width:130px;">Priority</th>
                    <th style="min-width:120px;">Orders</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
@Html.AntiForgeryToken()
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="offer-row-@row.Id">
                        <td><a asp-action="Edit" asp-route-id="@row.Id">@row.Name</a></td>
                        <td>@row.OfferType</td>
                        <td class="text-end">@row.ProductCount products</td>
                        <td class="text-end">@row.DiscountPercent%</td>
                        <td>@Money.DateAndTime(row.StartsOn)</td>
                        <td>@Money.DateAndTime(row.EndsOn)</td>
                        <td class="text-end">—</td>
                        <td class="text-end">@row.OrdersInfluenced</td>
                        <td>
                            @if (row.IsLiveNow)
                            {
                                <span class="badge bg-success">Live now</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@(row.IsActive ? "Scheduled" : "Inactive")</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteOffer(@row.Id, '@Html.Raw(Html.Encode(row.Name))')" title="Delete" class="text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="text-center py-4">No offers yet. <a asp-action="Add">Create the first one</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="offer-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete offer <strong id="deleteOfferName"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteOffer()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Promotions"); }

            datatable = $('#offer-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                dom: 'rtip',
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#offer-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) datatable.search(query).draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.search('').draw();
        }

        function confirmDeleteOffer(id, name) {
            deleteTargetId = id;
            $('#deleteOfferName').text(name);
            $('#offer-delete-confirm-modal').modal('show');
        }

        function executeDeleteOffer() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Offer")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#offer-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Offer deleted successfully.', 'Deleted');
                        const row = document.getElementById('offer-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error((res && res.message) || 'Failed to delete offer.', 'Error');
                    }
                },
                error: function () {
                    $('#offer-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');
                    toastr.error('A server error occurred while deleting the offer.', 'Error');
                }
            });
        }
    </script>
}
