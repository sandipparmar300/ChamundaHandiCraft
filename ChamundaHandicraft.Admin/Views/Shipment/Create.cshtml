@{
    ViewData["Title"] = "Shipment";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Shipment" : "Add Shipment";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Shipment" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Shipment" asp-action="Index" class="links">Shipments Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="shipmentForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-box-open" style="color:var(--accent);margin-right:8px;"></i>Shipment Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">AWB Number <span class="req">*</span></label>
                        <input id="AWBNumber" name="AWBNumber" class="form-control-custom" placeholder="Enter awb number" />
                        <span class="error-msg" data-valmsg-for="AWBNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Order Number <span class="req">*</span></label>
                        <input id="OrderNumber" name="OrderNumber" class="form-control-custom" placeholder="Enter order number" />
                        <span class="error-msg" data-valmsg-for="OrderNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Courier <span class="req">*</span></label>
                        <select id="Courier" name="Courier" class="form-control-custom select2-single">
                            <option value="">Select courier</option>
                            <option>Select from master</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Courier"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Tracking Number</label>
                        <input id="TrackingNumber" name="TrackingNumber" class="form-control-custom" placeholder="Enter tracking number" />
                        <span class="error-msg" data-valmsg-for="TrackingNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Dispatch Date</label>
                        <input type="date" id="DispatchDate" name="DispatchDate" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="DispatchDate"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Estimated Delivery</label>
                        <input type="date" id="EstimatedDelivery" name="EstimatedDelivery" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="EstimatedDelivery"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Number of Packages</label>
                        <input type="number" id="NumberofPackages" name="NumberofPackages" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="NumberofPackages"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Package Weight (kg)</label>
                        <input type="number" id="PackageWeightkg" name="PackageWeightkg" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="PackageWeightkg"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Shipping Charges</label>
                        <input id="ShippingCharges" name="ShippingCharges" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" data-valmsg-for="ShippingCharges"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <select id="Status" name="Status" class="form-control-custom select2-single">
                            <option value="">Select status</option>
                            <option>Ready to Ship</option>
                            <option>Picked Up</option>
                            <option>In Transit</option>
                            <option>Out for Delivery</option>
                            <option>Delivered</option>
                            <option>RTO</option>
                            <option>Cancelled</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Status"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Packing Notes</label>
                        <textarea id="PackingNotes" name="PackingNotes" class="form-control-custom" rows="3" placeholder="Enter packing notes"></textarea>
                        <span class="error-msg" data-valmsg-for="PackingNotes"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Shipment" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Shipping"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
