@{
    ViewData["Title"] = "Courier";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Courier" : "Add Courier";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Courier" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Courier" asp-action="Index" class="links">Couriers Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="courierForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-truck-fast" style="color:var(--accent);margin-right:8px;"></i>Courier Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Logo</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="image" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Courier Name <span class="req">*</span></label>
                        <input id="CourierName" name="CourierName" class="form-control-custom" placeholder="Enter courier name" />
                        <span class="error-msg" data-valmsg-for="CourierName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Integration <span class="req">*</span></label>
                        <select id="Integration" name="Integration" class="form-control-custom select2-single">
                            <option value="">Select integration</option>
                            <option>Shiprocket</option>
                            <option>Delhivery</option>
                            <option>Blue Dart</option>
                            <option>India Post</option>
                            <option>Manual</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Integration"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Tracking URL Pattern</label>
                        <input type="url" id="TrackingURLPattern" name="TrackingURLPattern" class="form-control-custom" placeholder="https://" />
                        <span class="error-msg" data-valmsg-for="TrackingURLPattern"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Pickup Cut-off Time</label>
                        <input id="PickupCutoffTime" name="PickupCutoffTime" class="form-control-custom" placeholder="Enter pickup cut-off time" />
                        <span class="error-msg" data-valmsg-for="PickupCutoffTime"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Max Weight (kg)</label>
                        <input type="number" id="MaxWeightkg" name="MaxWeightkg" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="MaxWeightkg"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Supports COD</label>
                        <select id="SupportsCOD" name="SupportsCOD" class="form-control-custom select2-single">
                            <option value="">Select supports cod</option>
                            <option>Yes</option>
                            <option>No</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="SupportsCOD"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-key" style="color:var(--accent);margin-right:8px;"></i>Credentials</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">API Key</label>
                        <input id="APIKey" name="APIKey" class="form-control-custom" placeholder="Enter api key" />
                        <span class="error-msg" data-valmsg-for="APIKey"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">API Secret</label>
                        <input id="APISecret" name="APISecret" class="form-control-custom" placeholder="Enter api secret" />
                        <span class="error-msg" data-valmsg-for="APISecret"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Account Code</label>
                        <input id="AccountCode" name="AccountCode" class="form-control-custom" placeholder="Enter account code" />
                        <span class="error-msg" data-valmsg-for="AccountCode"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Courier" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Shipping"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
