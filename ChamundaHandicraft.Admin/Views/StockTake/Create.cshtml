@model StockTakeGridItem
@{
    ViewData["Title"] = "Stock Take";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Stock Take" : "Add Stock Take";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="StockTake" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="StockTake" asp-action="Index" class="links">Stock Takes Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-action="Save" asp-controller="StockTake" id="stocktakeForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-clipboard-check" style="color:var(--accent);margin-right:8px;"></i>Stock Take Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Stock Take Number</label>
                        <input id="StockTakeNumber" name="StockTakeNumber" class="form-control-custom" placeholder="Auto-generated if blank" value="@Model.StockTakeNumber" />
                        <span class="error-msg" data-valmsg-for="StockTakeNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Scheduled / Started Date <span class="req">*</span></label>
                        <input type="date" id="StartedOn" name="StartedOn" class="form-control-custom" value="@(Model.StartedOn == default ? DateTime.Today.ToString("yyyy-MM-dd") : Model.StartedOn.ToString("yyyy-MM-dd"))" required />
                        <span class="error-msg" data-valmsg-for="StartedOn"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Warehouse <span class="req">*</span></label>
                        <select id="WarehouseId" name="WarehouseId" class="form-control-custom select2-single" required>
                            <option value="">Select warehouse</option>
                            @if (ViewBag.Warehouses is List<IdNamePair> whList)
                            {
                                foreach (var wh in whList)
                                {
                                    <option value="@wh.Id" selected="@(Model.WarehouseId == wh.Id ? "selected" : null)">@wh.Name</option>
                                }
                            }
                        </select>
                        <span class="error-msg" data-valmsg-for="WarehouseId"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Count Type</label>
                        <select id="CountType" name="CountType" class="form-control-custom select2-single">
                            <option value="">Select count type</option>
                            <option value="Full Count" selected="@(Model.CountType == "Full Count" ? "selected" : null)">Full Count</option>
                            <option value="Cycle Count" selected="@(Model.CountType == "Cycle Count" ? "selected" : null)">Cycle Count</option>
                            <option value="Spot Check" selected="@(Model.CountType == "Spot Check" ? "selected" : null)">Spot Check</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="CountType"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <select id="Status" name="Status" class="form-control-custom select2-single">
                            <option value="Scheduled" selected="@(Model.Status == "Scheduled" ? "selected" : null)">Scheduled</option>
                            <option value="In Progress" selected="@(Model.Status == "In Progress" ? "selected" : null)">In Progress</option>
                            <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Completed</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Status"></span>
                    </div>

                    <div class="col-lg-12 col-md-12">
                        <label class="form-label-custom">Remarks / Note</label>
                        <textarea id="Note" name="Note" class="form-control-custom" rows="3" placeholder="Enter remarks or instructions for stock take count...">@Model.Note</textarea>
                        <span class="error-msg" data-valmsg-for="Note"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div></div>

            <div>
                <a asp-controller="StockTake" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
