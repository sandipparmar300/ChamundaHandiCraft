@model PagedResult<StockTakeGridItem>
@*
    Inventory - Stock Takes listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Stock Takes";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Stock Takes</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Inventory</li>
            <li>Stock Takes Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search stock take number" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="StockTake" asp-action="Add" class="custom_button primary_button">Add Stock Take</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="stocktake-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:150px;">Stock Take Number</th>
                    <th style="min-width:130px;">Scheduled Date</th>
                    <th style="min-width:170px;">Warehouse</th>
                    <th style="min-width:130px;">Items Counted</th>
                    <th style="min-width:130px;">Variances</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:150px;">Counted By</th>
                    <th style="min-width:130px;">Completed On</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td class="t-mono"><a asp-action="Edit" asp-route-id="@row.Id">@row.StockTakeNumber</a></td>
                        <td>@Money.LongDate(row.StartedOn)</td>
                        <td>@row.WarehouseName</td>
                        <td class="text-end">@row.SkusCounted</td>
                        <td class="text-end">
                            @row.DiscrepancyCount
                            @if (row.DiscrepancyValue != 0)
                            {
                                <span class="text-danger">(@Money.Inr(row.DiscrepancyValue))</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@row.Status</span></td>
                        <td>@(row.CreatedBy ?? "—")</td>
                        <td>@(row.CompletedOn is null ? "—" : Money.LongDate(row.CompletedOn.Value))</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" class="text-center py-4">No stock takes yet. <a asp-action="Add">Start one</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="stocktake-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this record?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }

            datatable = $('#stocktake-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#stocktake-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Stock Take API.');
            }
        }
    </script>
}
