@model PagedResult<StockRateGridItem>
@{
    ViewData["Title"] = "Stock Rates & Valuation";
    var warehouses = ViewBag.Warehouses as List<IdNamePair> ?? new List<IdNamePair>();
    int? selectedWh = ViewBag.SelectedWarehouse as int?;

    var totalValuation = Model.Items.Sum(i => i.Valuation);
    var avgMargin = Model.Items.Any(i => i.Price > 0) ? Model.Items.Where(i => i.Price > 0).Average(i => i.MarginPercent) : 0;
    var totalOnHand = Model.Items.Sum(i => i.OnHand);
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Stock Rates &amp; Valuation</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Inventory</li>
            <li>Stock Rates &amp; Margins</li>
        </ul>
    </div>
}

<!-- Summary KPIs -->
<section class="form-section mb-4">
    <div class="form-section-header">
        <h2><i class="fas fa-coins" style="color:var(--accent);margin-right:8px;"></i>Valuation &amp; Margins Overview</h2>
    </div>
    <div class="form-section-body">
        <div class="row g-3">
            <div class="col-xl-3 col-md-6">
                <div class="status-card">
                    <span class="status-count text-primary">@Money.Inr(totalValuation)</span>
                    <span class="status-label">Total Stock Valuation</span>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="status-card">
                    <span class="status-count text-success">@totalOnHand.ToString("N0")</span>
                    <span class="status-label">Total Units On Hand</span>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="status-card">
                    <span class="status-count text-info">@avgMargin.ToString("F1")%</span>
                    <span class="status-label">Average Profit Margin</span>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="status-card">
                    <span class="status-count text-secondary">@Model.Items.Count</span>
                    <span class="status-label">Priced Items</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stock Rates Table -->
<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search product name or SKU" id="txtSearch" value="@ViewData["Search"]" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="@(string.IsNullOrEmpty(ViewData["Search"]?.ToString()) ? "display:none;" : "") cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select id="filterWarehouse" class="form-control-custom" style="min-width:180px;" onchange="applyFilters()">
                    <option value="">All Warehouses</option>
                    @foreach (var wh in warehouses)
                    {
                        <option value="@wh.Id" selected="@(selectedWh == wh.Id ? "selected" : null)">@wh.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="table-main mt-3">
        <table id="rates-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:220px;">Product Name</th>
                    <th style="min-width:130px;">SKU</th>
                    <th style="min-width:90px;" class="text-end">On Hand</th>
                    <th style="min-width:120px;" class="text-end">Cost Price</th>
                    <th style="min-width:120px;" class="text-end">Selling Price</th>
                    <th style="min-width:110px;" class="text-end">MRP</th>
                    <th style="min-width:130px;" class="text-end">Stock Valuation</th>
                    <th style="min-width:110px;" class="text-end">Margin (%)</th>
                    <th style="min-width:90px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td><strong>@row.ProductName</strong></td>
                        <td><code>@row.Sku</code></td>
                        <td class="text-end fw-bold">@row.OnHand</td>
                        <td class="text-end">@Money.Inr(row.CostPrice)</td>
                        <td class="text-end fw-semibold">@Money.Inr(row.Price)</td>
                        <td class="text-end text-muted">@Money.Inr(row.Mrp)</td>
                        <td class="text-end fw-bold text-primary">@Money.Inr(row.Valuation)</td>
                        <td class="text-end">
                            <span class="badge @(row.MarginPercent >= 30 ? "bg-success" : (row.MarginPercent > 0 ? "bg-info text-dark" : "bg-danger")) font-12">
                                @row.MarginPercent.ToString("F1")%
                            </span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-light border" onclick="openRateModal(@row.ProductId, @(row.VariantId ?? 0), '@Html.Raw(Html.Encode(row.ProductName))', @row.CostPrice, @row.Price, @row.Mrp)" title="Update Rates">
                                <i class="fas fa-edit text-primary"></i> Rates
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Update Rates Modal -->
<div class="modal fade" id="rateModal" tabindex="-1" aria-labelledby="rateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Save" asp-controller="StockRate" id="stockRateForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalProductId" name="ProductId" value="0" />
                <input type="hidden" id="modalVariantId" name="VariantId" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="rateModalLabel">Update Stock Rates</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label-custom">Product</label>
                        <input type="text" id="modalProductName" class="form-control-custom bg-light" readonly />
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label-custom">Cost Price (₹) <span class="req">*</span></label>
                            <input type="number" step="0.01" min="0" id="modalCostPrice" name="CostPrice" class="form-control-custom" oninput="calcModalMargin()" required />
                        </div>

                        <div class="col-6">
                            <label class="form-label-custom">Selling Price (₹) <span class="req">*</span></label>
                            <input type="number" step="0.01" min="0" id="modalPrice" name="Price" class="form-control-custom" oninput="calcModalMargin()" required />
                        </div>

                        <div class="col-6">
                            <label class="form-label-custom">MRP (₹) <span class="req">*</span></label>
                            <input type="number" step="0.01" min="0" id="modalMrp" name="Mrp" class="form-control-custom" required />
                        </div>

                        <div class="col-6">
                            <label class="form-label-custom">Projected Margin</label>
                            <input type="text" id="modalMarginDisplay" class="form-control-custom bg-light fw-bold text-success" readonly value="0.0%" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-save"></i> Save Rates
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }

            $('#rates-grid').DataTable({
                paging: true,
                ordering: true,
                filter: false,
                destroy: true,
                bLengthChange: false,
                pageLength: 25,
                scrollX: true,
                autoWidth: false,
                language: { emptyTable: "No stock rates found." }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (event.keyCode === 13) {
                applyFilters();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            applyFilters();
        }

        function applyFilters() {
            var search = $('#txtSearch').val() || '';
            var wh = $('#filterWarehouse').val() || '';

            var url = '@Url.Action("Index", "StockRate")?search=' + encodeURIComponent(search);
            if (wh) url += '&warehouseId=' + encodeURIComponent(wh);

            window.location.href = url;
        }

        function openRateModal(productId, variantId, productName, costPrice, price, mrp) {
            $('#modalProductId').val(productId);
            $('#modalVariantId').val(variantId);
            $('#modalProductName').val(productName);
            $('#modalCostPrice').val(costPrice);
            $('#modalPrice').val(price);
            $('#modalMrp').val(mrp);

            calcModalMargin();
            var modal = new bootstrap.Modal(document.getElementById('rateModal'));
            modal.show();
        }

        function calcModalMargin() {
            var cost = parseFloat($('#modalCostPrice').val()) || 0;
            var price = parseFloat($('#modalPrice').val()) || 0;

            if (price > 0) {
                var margin = ((price - cost) / price) * 100.0;
                var profit = price - cost;
                $('#modalMarginDisplay').val(margin.toFixed(1) + '% (₹' + profit.toFixed(2) + ')');

                if (margin > 0) {
                    $('#modalMarginDisplay').removeClass('text-danger').addClass('text-success');
                } else {
                    $('#modalMarginDisplay').removeClass('text-success').addClass('text-danger');
                }
            } else {
                $('#modalMarginDisplay').val('0.0%');
            }
        }
    </script>
}
