@model ChamundaHandicraft.Helper.ViewModel.Admin.AdminUserSaveRequest
@{
    ViewData["Title"] = "Admin User Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="AdminUser" asp-action="Index">
                <picture>
                    <img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" />
                </picture>
            </a>
            <h2 class="page-title">Admin User Details</h2>
        </div>

        <ul class="page-breadcrumb">
            <li><a asp-controller="AdminUser" asp-action="Index" class="links">Admin User Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

@Html.AntiForgeryToken()

<main class="page-content">

    <!-- ================= SUMMARY CARD ================= -->
    <section class="form-section">
        <div class="form-section-body">
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <img src="@(string.IsNullOrEmpty(Model.PhotoUrl) ? "/assets/images/default-profile.png" : Model.PhotoUrl)"
                     class="pic-preview"
                     alt="@Model.FullName"
                     style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #e2e8f0;" />

                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h3 class="mb-0">@Model.FullName</h3>
                        @if (Model.Id == 1)
                        {
                            <span class="badge bg-primary">Super Admin</span>
                        }
                        @if (Model.IsLocked)
                        {
                            <span class="badge bg-danger">Locked</span>
                        }
                        else if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">
                        <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.RoleName) ? "No Role" : Model.RoleName)</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Department))
                        {
                            <span> &middot; @Model.Department</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Designation))
                        {
                            <span> (@Model.Designation)</span>
                        }
                        <span> &middot; Last login: @(Model.LastLoginOn is null ? "Never" : Money.Relative(Model.LastLoginOn.Value))</span>
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="AdminUser" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button primary_button">
                        <i class="fas fa-pen me-1"></i> Edit User
                    </a>
                    <button type="button" class="custom_button secondary_button" onclick="openChangePasswordModal(@Model.Id, '@Html.Raw(Html.Encode(Model.FullName))')">
                        <i class="fas fa-key me-1"></i> Change Password
                    </button>
                    <a asp-controller="AdminUser" asp-action="Index" class="custom_button secondary_button">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= DETAILS GRID ================= -->
    <div class="row g-3">
        <!-- Personal & Account Details -->
        <div class="col-lg-6 col-12">
            <section class="form-section h-100 mb-0">
                <div class="form-section-header">
                    <h2><i class="fas fa-user text-primary me-2"></i>Personal &amp; Account Information</h2>
                </div>
                <div class="form-section-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Full Name</label>
                            <p class="fw-semibold mb-0">@Model.FullName</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Employee ID</label>
                            <p class="mb-0">
                                <span class="badge bg-light text-dark border px-2 py-1 font-monospace">@(string.IsNullOrWhiteSpace(Model.EmployeeId) ? "EMP-" + Model.Id.ToString("D4") : Model.EmployeeId)</span>
                            </p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Email Address</label>
                            <p class="fw-semibold mb-0">@Model.Email</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Mobile Phone</label>
                            <p class="fw-semibold mb-0">@(string.IsNullOrWhiteSpace(Model.Mobile) ? "—" : Model.Mobile)</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Username</label>
                            <p class="fw-semibold mb-0">@(string.IsNullOrWhiteSpace(Model.Username) ? Model.Email : Model.Username)</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Account Created</label>
                            <p class="fw-semibold mb-0">@Money.LongDate(Model.CreatedOn)</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Organisation Details -->
        <div class="col-lg-6 col-12">
            <section class="form-section h-100 mb-0">
                <div class="form-section-header">
                    <h2><i class="fas fa-briefcase text-primary me-2"></i>Organisation Details</h2>
                </div>
                <div class="form-section-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Assigned Role</label>
                            <p class="fw-semibold mb-0">
                                <span class="badge bg-light text-dark border px-2 py-1">@Model.RoleName</span>
                            </p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Department</label>
                            <p class="fw-semibold mb-0">@(string.IsNullOrWhiteSpace(Model.Department) ? "—" : Model.Department)</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Designation</label>
                            <p class="fw-semibold mb-0">@(string.IsNullOrWhiteSpace(Model.Designation) ? "—" : Model.Designation)</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label-custom text-muted mb-1">Time Zone</label>
                            <p class="fw-semibold mb-0">@(string.IsNullOrWhiteSpace(Model.TimeZone) ? "Asia/Kolkata" : Model.TimeZone)</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

</main>

<!-- Change Password Modal -->
<div class="modal common-modal" id="change-password-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-start" style="text-align: left !important;">
            <div class="modal-header pb-2 border-bottom">
                <h5 class="modal-title fs-6 fw-bold"><i class="fas fa-key text-warning me-2"></i>Change Password</h5>
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture>
                        <img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24">
                    </picture>
                </button>
            </div>
            <div class="modal-body pt-3" style="text-align: left !important;">
                <input type="hidden" id="cpUserId" value="@Model.Id" />
                <p class="text-muted mb-3 font-13">Resetting password for: <strong class="text-dark" id="cpUserFullName">@Model.FullName</strong></p>

                <div class="mb-3 text-start">
                    <label class="form-label-custom text-start d-block mb-1">New Password <span class="req">*</span></label>
                    <div class="input-group">
                        <input type="password" id="cpNewPassword" class="form-control form-control-custom rounded-start" placeholder="Enter new password (min 6 characters)" autocomplete="new-password" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('cpNewPassword', this)" style="border-color: #cbd5e1; background: #fff;" title="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span class="text-danger font-12 mt-1 d-block" id="cpNewPasswordError"></span>
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label-custom text-start d-block mb-1">Confirm New Password <span class="req">*</span></label>
                    <div class="input-group">
                        <input type="password" id="cpConfirmPassword" class="form-control form-control-custom rounded-start" placeholder="Re-enter new password" autocomplete="new-password" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('cpConfirmPassword', this)" style="border-color: #cbd5e1; background: #fff;" title="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span class="text-danger font-12 mt-1 d-block" id="cpConfirmPasswordError"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-save-password" class="custom_button primary_button" onclick="executeChangePassword()">
                        <i class="fas fa-save me-1"></i> Update Password
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }
        });

        function togglePasswordVisibility(fieldId, btn) {
            const input = document.getElementById(fieldId);
            if (!input) return;
            const isPass = input.type === "password";
            input.type = isPass ? "text" : "password";
            const icon = btn.querySelector('i');
            if (icon) {
                icon.className = isPass ? "fas fa-eye-slash" : "fas fa-eye";
            }
        }

        function openChangePasswordModal(id, name) {
            $('#cpUserId').val(id || '@Model.Id');
            $('#cpUserFullName').text(name || '@Html.Raw(Html.Encode(Model.FullName))');
            $('#cpNewPassword').val('').attr('type', 'password');
            $('#cpConfirmPassword').val('').attr('type', 'password');
            $('#change-password-modal .fa-eye-slash').removeClass('fa-eye-slash').addClass('fa-eye');
            $('#cpNewPasswordError').text('');
            $('#cpConfirmPasswordError').text('');
            $('#change-password-modal').modal('show');
        }

        $(document).on('input change', '#cpNewPassword, #cpConfirmPassword', function () {
            $('#cpNewPasswordError').text('');
            $('#cpConfirmPasswordError').text('');
        });

        function executeChangePassword() {
            const id = parseInt($('#cpUserId').val());
            const newPassword = $('#cpNewPassword').val();
            const confirmPassword = $('#cpConfirmPassword').val();

            $('#cpNewPasswordError').text('');
            $('#cpConfirmPasswordError').text('');

            let hasError = false;

            if (!newPassword) {
                $('#cpNewPasswordError').text('New password is required.');
                hasError = true;
            } else if (newPassword.length < 6) {
                $('#cpNewPasswordError').text('Password must be at least 6 characters long.');
                hasError = true;
            }

            if (!confirmPassword) {
                $('#cpConfirmPasswordError').text('Please confirm your new password.');
                hasError = true;
            } else if (newPassword !== confirmPassword) {
                $('#cpConfirmPasswordError').text('Passwords do not match.');
                hasError = true;
            }

            if (hasError) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-save-password');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Updating...');

            $.ajax({
                url: '@Url.Action("ChangePassword", "AdminUser")',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify({
                    id: id,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                }),
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Password');
                    if (res && res.success) {
                        $('#change-password-modal').modal('hide');
                        toastr.success(res.message || 'Password changed successfully.', 'Success');
                    } else {
                        toastr.error(res ? res.message : 'Failed to update password.', 'Error');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Password');
                    toastr.error('Error occurred while changing password.', 'Error');
                }
            });
        }
    </script>
}
