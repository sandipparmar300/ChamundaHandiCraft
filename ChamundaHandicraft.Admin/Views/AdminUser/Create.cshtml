@model ChamundaHandicraft.Helper.ViewModel.Admin.AdminUserSaveRequest
@{
    var isEdit = Model.Id > 0;
    var heading = isEdit ? "Edit Admin User" : "Add Admin User";
    ViewData["Title"] = heading;
    var roles = ViewBag.Roles as List<IdNamePair> ?? new List<IdNamePair>();
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="AdminUser" asp-action="Index">
                <picture>
                    <img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" />
                </picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>

        <ul class="page-breadcrumb">
            <li><a asp-controller="AdminUser" asp-action="Index" class="links">Admin User Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-action="Save" asp-controller="AdminUser" id="adminUserForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" id="Id" name="Id" value="@Model.Id" />
        <input type="hidden" id="PhotoUrl" name="PhotoUrl" value="@Model.PhotoUrl" />
        <input type="hidden" id="saveAndNew" name="saveAndNew" value="false" />

        <!-- ================= PERSONAL ================= -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-user" style="color:var(--accent);margin-right:8px;"></i>Personal Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Profile Photo</label>

                        <div class="profile-pic-box" id="uploadBox" style="cursor:pointer;">
                            <img id="ProfilePhotoPreview"
                                 src="@(string.IsNullOrEmpty(Model.PhotoUrl) ? "/assets/images/default-profile.png" : Model.PhotoUrl)"
                                 class="pic-preview clickable-img"
                                 alt="profile"
                                 style="width: 90px; height: 90px; object-fit: cover; border-radius: 50%; border: 2px solid #e2e8f0;" />

                            <label class="upload-btn-custom mt-2" for="Photo">
                                <i class="fas fa-camera"></i> Upload
                            </label>

                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="fileValidation(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">First Name <span class="req">*</span></label>
                        <input asp-for="FirstName" id="FirstName" class="form-control-custom" placeholder="Enter first name" required />
                        <span asp-validation-for="FirstName" id="valFirstName" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Last Name <span class="req">*</span></label>
                        <input asp-for="LastName" id="LastName" class="form-control-custom" placeholder="Enter last name" required />
                        <span asp-validation-for="LastName" id="valLastName" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Full Name</label>
                        <input asp-for="FullName" id="FullName" class="form-control-custom" placeholder="Auto generated" readonly />
                    </div>

                </div>
            </div>
        </section>

        <!-- ================= ACCOUNT ================= -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-id-badge" style="color:var(--accent);margin-right:8px;"></i>Account &amp; Contact</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Email <span class="req">*</span></label>
                        <input type="email" asp-for="Email" id="Email" class="form-control-custom" placeholder="Enter email address" required />
                        <span asp-validation-for="Email" id="valEmail" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Username</label>
                        <input asp-for="Username" id="Username" class="form-control-custom" placeholder="Enter username" />
                        <span asp-validation-for="Username" id="valUsername" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Mobile Number <span class="req">*</span></label>
                        <input asp-for="Mobile" id="Mobile" class="form-control-custom" placeholder="Enter mobile number" maxlength="15" required />
                        <span asp-validation-for="Mobile" id="valMobile" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    @if (!isEdit)
                    {
                        <div class="col-lg-4 col-md-6" id="passwordBlock">
                            <label class="form-label-custom">Password <span class="req">*</span></label>
                            <input type="password" asp-for="Password" id="Password" class="form-control-custom" placeholder="Enter password" autocomplete="new-password" required />
                            <span asp-validation-for="Password" id="valPassword" class="text-danger font-12 mt-1 d-block"></span>
                        </div>

                        <div class="col-lg-4 col-md-6" id="confirmPasswordBlock">
                            <label class="form-label-custom">Confirm Password <span class="req">*</span></label>
                            <input type="password" asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control-custom" placeholder="Re-enter password" autocomplete="new-password" required />
                            <span asp-validation-for="ConfirmPassword" id="valConfirmPassword" class="text-danger font-12 mt-1 d-block"></span>
                        </div>
                    }

                </div>
            </div>
        </section>

        <!-- ================= ORGANISATION ================= -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-sitemap" style="color:var(--accent);margin-right:8px;"></i>Organisation &amp; Access</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Role <span class="req">*</span></label>
                        <select asp-for="RoleId" id="RoleId" class="form-control-custom" required>
                            <option value="">Select role</option>
                            @foreach (var r in roles)
                            {
                                if (Model.RoleId == r.Id)
                                {
                                    <option value="@r.Id" selected>@r.Name</option>
                                }
                                else
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="RoleId" id="valRoleId" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Department</label>
                        <input id="Department" name="Department" class="form-control-custom" placeholder="e.g. Operations, IT, Sales" value="@Model.Department" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Designation</label>
                        <input id="Designation" name="Designation" class="form-control-custom" placeholder="e.g. Senior Manager, Executive" value="@Model.Designation" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Time Zone</label>
                        <select id="TimeZone" name="TimeZone" class="form-control-custom">
                            <option value="Asia/Kolkata" selected>India Standard Time (IST - UTC+5:30)</option>
                            <option value="UTC">Coordinated Universal Time (UTC)</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Language</label>
                        <select id="Language" name="Language" class="form-control-custom">
                            <option value="en-IN" selected>English (India)</option>
                            <option value="hi-IN">Hindi</option>
                        </select>
                    </div>

                </div>
            </div>
        </section>

        <!-- ================= ACTION BAR ================= -->
        <div class="form-action-bar">

            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>

            <div>
                <a asp-controller="AdminUser" asp-action="Index" class="btn btn-light me-2">Cancel</a>
                @if (!isEdit)
                {
                    <button type="button" class="btn-save me-2" onclick="submitForm(true)">
                        <i class="fas fa-plus"></i> Save &amp; New
                    </button>
                }
                <button type="button" class="btn-save" onclick="submitForm(false)">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>

        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }

            $('#uploadBox').click(function () { $('#Photo').click(); });

            // Auto-update FullName
            $('#FirstName, #LastName').on('keyup change input', function () {
                var first = ($('#FirstName').val() || '').trim();
                var last = ($('#LastName').val() || '').trim();
                $('#FullName').val((first + ' ' + last).trim());
            });

            // Live clear field validation errors on typing
            $('input, select').on('input change', function () {
                const fieldId = $(this).attr('id');
                if (fieldId) {
                    $('#val' + fieldId).text('');
                    $(this).removeClass('is-invalid');
                }
            });

            // Is Active toggle status label
            $('#IsActiveCheckbox').on('change', function () {
                $('#isActiveStatus').text($(this).is(':checked') ? 'Active' : 'Inactive');
            });
        });

        function fileValidation(input) {
            if (!input.files || input.files.length === 0) return;

            var file = input.files[0];
            var maxSize = 5 * 1024 * 1024;

            if (!/(\.png|\.jpg|\.jpeg)$/i.exec(file.name)) {
                toastr.error('Only JPG and PNG images are allowed.', 'Invalid Image');
                input.value = '';
                return false;
            }

            if (file.size > maxSize) {
                toastr.error('File size must be less than 5MB.', 'File Too Large');
                input.value = '';
                return false;
            }

            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('ProfilePhotoPreview').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function submitForm(isSaveAndNew) {
            $('#saveAndNew').val(isSaveAndNew ? "true" : "false");

            // Reset all validation error messages below fields
            $('.text-danger[id^="val"]').text('');
            $('input, select').removeClass('is-invalid');

            let isValid = true;
            let firstInvalidElem = null;

            function markInvalid(selector, valSelector, message) {
                isValid = false;
                $(valSelector).text(message);
                $(selector).addClass('is-invalid');
                if (!firstInvalidElem) {
                    firstInvalidElem = $(selector);
                }
            }

            const first = ($('#FirstName').val() || '').trim();
            const last = ($('#LastName').val() || '').trim();
            const email = ($('#Email').val() || '').trim();
            const mobile = ($('#Mobile').val() || '').trim();
            const roleId = $('#RoleId').val();

            if (!first) {
                markInvalid('#FirstName', '#valFirstName', 'First name is required.');
            }

            if (!last) {
                markInvalid('#LastName', '#valLastName', 'Last name is required.');
            }

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!email) {
                markInvalid('#Email', '#valEmail', 'Email address is required.');
            } else if (!emailRegex.test(email)) {
                markInvalid('#Email', '#valEmail', 'Please enter a valid email address.');
            }

            if (!mobile) {
                markInvalid('#Mobile', '#valMobile', 'Mobile number is required.');
            } else if (!/^[0-9+\-\s]{7,15}$/.test(mobile)) {
                markInvalid('#Mobile', '#valMobile', 'Please enter a valid mobile number (7-15 digits).');
            }

            if (!roleId || roleId === "0") {
                markInvalid('#RoleId', '#valRoleId', 'Please select a role.');
            }

            const isEdit = @(isEdit ? "true" : "false");
            if (!isEdit) {
                const password = $('#Password').val() || '';
                const confirmPassword = $('#ConfirmPassword').val() || '';

                if (!password) {
                    markInvalid('#Password', '#valPassword', 'Password is required.');
                } else if (password.length < 6) {
                    markInvalid('#Password', '#valPassword', 'Password must be at least 6 characters long.');
                }

                if (!confirmPassword) {
                    markInvalid('#ConfirmPassword', '#valConfirmPassword', 'Please confirm your password.');
                } else if (password !== confirmPassword) {
                    markInvalid('#ConfirmPassword', '#valConfirmPassword', 'Passwords do not match.');
                }
            }

            if (!isValid) {
                if (firstInvalidElem) {
                    firstInvalidElem.focus();
                    firstInvalidElem[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return false;
            }

            $('#adminUserForm').submit();
        }
    </script>
}
