@model AdminUserGridItem
@*
    Module 02 - Create / Edit Admin User.  Spec: docs/Admin Flows/Users.txt
    Serves both Add and Edit; the controller renders this view for either.
*@
@{
    ViewData["Title"] = "Admin User";
    var isEdit = (Context.Request.Query["id"].Count > 0)
        || string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Admin User" : "Add Admin User";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="AdminUser" asp-action="Index">
                <picture>
                    <img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" />
                </picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>

        <ul class="page-breadcrumb">
            <li><a asp-controller="AdminUser" asp-action="Index" class="links">Admin User Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="adminUserForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <!-- ================= PERSONAL ================= -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-user" style="color:var(--accent);margin-right:8px;"></i>Personal Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Profile Photo</label>

                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ProfilePhotoPreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="profile" />

                            <label class="upload-btn-custom" for="Photo">
                                <i class="fas fa-camera"></i> Upload
                            </label>

                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="fileValidation(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">First Name <span class="req">*</span></label>
                        <input id="FirstName" name="FirstName" class="form-control-custom" placeholder="Enter first name" onkeypress="allowOnlyAlpha(event)" />
                        <span class="error-msg" data-valmsg-for="FirstName"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Last Name <span class="req">*</span></label>
                        <input id="LastName" name="LastName" class="form-control-custom" placeholder="Enter last name" onkeypress="allowOnlyAlpha(event)" />
                        <span class="error-msg" data-valmsg-for="LastName"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Full Name</label>
                        <input id="FullName" name="FullName" class="form-control-custom" placeholder="Auto generated" readonly / value="@Model.FullName" >
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Employee ID</label>
                        <input id="EmployeeId" name="EmployeeId" class="form-control-custom" placeholder="Optional" />
                    </div>

                </div>
            </div>
        </section>

        <!-- ================= ACCOUNT ================= -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-id-badge" style="color:var(--accent);margin-right:8px;"></i>Account &amp; Contact</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Username <span class="req">*</span></label>
                        <input id="Username" name="Username" class="form-control-custom" placeholder="Enter username" />
                        <span class="error-msg" data-valmsg-for="Username"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Email <span class="req">*</span></label>
                        <input type="email" id="Email" name="Email" class="form-control-custom" placeholder="Enter email" / value="@Model.Email" >
                        <span class="error-msg" data-valmsg-for="Email"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Mobile Number <span class="req">*</span></label>
                        <input id="Mobile" name="Mobile" class="form-control-custom" placeholder="Enter mobile number" maxlength="15" onkeypress="return allowOnlyNumber(event)" />
                        <span class="error-msg" data-valmsg-for="Mobile"></span>
                    </div>

                    <div class="col-lg-4 col-md-6" id="passwordBlock">
                        <label class="form-label-custom">Password <span class="req">*</span></label>
                        <input type="password" id="Password" name="Password" class="form-control-custom" placeholder="Enter password" autocomplete="new-password" />
                        <span class="error-msg" data-valmsg-for="Password"></span>
                    </div>

                    <div class="col-lg-4 col-md-6" id="confirmPasswordBlock">
                        <label class="form-label-custom">Confirm Password <span class="req">*</span></label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control-custom" placeholder="Re-enter password" autocomplete="new-password" />
                        <span class="error-msg" data-valmsg-for="ConfirmPassword"></span>
                    </div>

                </div>
            </div>
        </section>

        <!-- ================= ORGANISATION ================= -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-sitemap" style="color:var(--accent);margin-right:8px;"></i>Organisation &amp; Access</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Role <span class="req">*</span></label>
                        <select id="RoleId" name="RoleId" class="form-control-custom select2-single">
                            <option value="">Select role</option>
                            <option>Super Admin</option>
                            <option>Admin</option>
                            <option>Product Manager</option>
                            <option>Inventory Manager</option>
                            <option>Sales Manager</option>
                            <option>Customer Support</option>
                            <option>Finance Manager</option>
                            <option>Marketing Manager</option>
                            <option>Content Manager</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="RoleId"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Department</label>
                        <input id="Department" name="Department" class="form-control-custom" placeholder="Enter department" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Designation</label>
                        <input id="Designation" name="Designation" class="form-control-custom" placeholder="Enter designation" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Time Zone</label>
                        <select id="TimeZone" name="TimeZone" class="form-control-custom select2-single">
                            <option value="India Standard Time" selected>India Standard Time</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Language</label>
                        <select id="Language" name="Language" class="form-control-custom select2-single">
                            <option value="en-IN" selected>English (India)</option>
                            <option value="hi-IN">Hindi</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Two Factor Authentication</label>
                        <select id="TwoFactorEnabled" name="TwoFactorEnabled" class="form-control-custom" disabled>
                            <option value="false" selected>Disabled (coming soon)</option>
                        </select>
                    </div>

                </div>
            </div>
        </section>

        <!-- ================= ACTION BAR ================= -->
        <div class="form-action-bar">

            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="AdminUser" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save" onclick="saveAdminUser(event, true)">
                    <i class="fas fa-plus"></i> Save &amp; New
                </button>
                <button type="button" class="btn-save" onclick="saveAdminUser(event, false)">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>

        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }

            $('#uploadBox').click(function () { $('#Photo').click(); });

            // Full name is derived, never typed.
            $('#FirstName, #LastName').on('keyup change', function () {
                var first = $('#FirstName').val() || '';
                var last = $('#LastName').val() || '';
                $('#FullName').val((first + ' ' + last).trim());
            });

            // Password is changed from its own screen once the record exists.
            var isEdit = @(isEdit ? "true" : "false");
            if (isEdit) { $('#passwordBlock, #confirmPasswordBlock').hide(); }
        });

        function fileValidation(input) {
            if (!input.files || input.files.length === 0) return;

            var file = input.files[0];
            var maxSize = 5 * 1024 * 1024;

            if (!/(\.png|\.jpg|\.jpeg)$/i.exec(file.name)) {
                if (typeof showErrorMessage === 'function') showErrorMessage('Only JPG and PNG images are allowed.');
                input.value = '';
                return false;
            }

            if (file.size > maxSize) {
                if (typeof showErrorMessage === 'function') showErrorMessage('File size must be less than 5MB.');
                input.value = '';
                return false;
            }

            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ProfilePhotoPreview').src = e.target.result; };
            reader.readAsDataURL(file);
        }

        function saveAdminUser(event, saveAndNew) {
            event.preventDefault();
            // POSTs to AdminUser/Save once the API is wired.
        }
    </script>
}
