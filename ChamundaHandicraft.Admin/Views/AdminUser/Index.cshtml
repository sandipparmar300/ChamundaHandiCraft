@model PagedResult<AdminUserGridItem>
@*
    Module 02 - Admin User list.  Spec: docs/Admin Flows/Users.txt (Sub Module 1)
    Grid renders empty until GridList is wired; the DataTable swaps to
    serverSide + ajax at that point without any markup change.
*@
@{
    ViewData["Title"] = "Admin Users";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Admin Users</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>User Management</li>
            <li>Admin User Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">

            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search by name, username, email or mobile" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select id="filterRole" class="form-control-custom" style="min-width:150px;" onchange="reloadGrid()">
                    <option value="">All Roles</option>
                    <option>Super Admin</option>
                    <option>Admin</option>
                    <option>Product Manager</option>
                    <option>Inventory Manager</option>
                    <option>Sales Manager</option>
                    <option>Customer Support</option>
                    <option>Finance Manager</option>
                    <option>Marketing Manager</option>
                    <option>Content Manager</option>
                </select>

                <select id="filterStatus" class="form-control-custom" style="min-width:140px;" onchange="reloadGrid()">
                    <option value="">All Status</option>
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                    <option value="locked">Locked</option>
                </select>

                <button type="button" class="custom_button secondary_button" onclick="exportGrid()">
                    <i class="fas fa-file-export"></i> Export
                </button>

                <a asp-controller="AdminUser" asp-action="Add" class="custom_button primary_button">Add Admin User</a>
            </div>

        </div>
    </div>

    <div class="table-main">
        <table id="adminuser-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:60px;">Photo</th>
                    <th style="min-width:170px;">Full Name</th>
                    <th style="min-width:120px;">Employee ID</th>
                    <th style="min-width:140px;">Username</th>
                    <th style="min-width:210px;">Email</th>
                    <th style="min-width:130px;">Mobile</th>
                    <th style="min-width:150px;">Role</th>
                    <th style="min-width:140px;">Department</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:150px;">Last Login</th>
                    <th style="min-width:130px;">Created</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td><img src="@(row.PhotoUrl ?? "/assets/images/default-profile.png")" width="36" height="36" alt="@row.FullName" style="object-fit:cover;border-radius:50%" /></td>
                        <td><a asp-action="Edit" asp-route-id="@row.Id">@row.FullName</a></td>
                        <td>EMP-@row.Id.ToString("D4")</td>
                        <td>@row.Email</td>
                        <td>@row.Email</td>
                        <td>@(row.Phone ?? "—")</td>
                        <td>@row.RoleName</td>
                        <td>—</td>
                        <td>
                            @if (row.IsLocked)
                            {
                                <span class="badge bg-danger">Locked</span>
                            }
                            else
                            {
                                @await Html.PartialAsync("_StatusPill", row.IsActive)
                            }
                        </td>
                        <td>@(row.LastLoginOn is null ? "Never" : Money.Relative(row.LastLoginOn.Value))</td>
                        <td>@Money.LongDate(row.CreatedOn)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="12" class="text-center py-4">No team members yet. <a asp-action="Add">Invite someone</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<!-- Delete confirmation -->
<div class="modal delete-common-modal common-modal" id="adminuser-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture>
                        <img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24">
                    </picture>
                </button>
            </div>

            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this admin user?</p>
                <p class="text-muted" style="font-size:.8rem;">Super Admin accounts cannot be deleted.</p>

                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;
        let searchValue = "";

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }
            fnBindDatatable();
        });

        function fnSearch(ctrl) {
            searchValue = $(ctrl).val();
            $("#clearSearch").toggle(searchValue.length > 0);
            reloadGrid();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            searchValue = "";
            reloadGrid();
        }

        function reloadGrid() {
            if (datatable) { datatable.draw(); }
        }

        function exportGrid() {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage('Export will be wired with the Admin User API.');
            }
        }

        function confirmDeleteAdminUser(id) {
            $("#btn-delete-yes").attr("onclick", 'deleteAdminUser("' + id + '")');
            $("#adminuser-delete-confirm-modal").modal("show");
        }

        function deleteAdminUser(id) {
            // POST to AdminUser/Delete once the API is wired.
            $("#adminuser-delete-confirm-modal").modal("hide");
        }

        function fnBindDatatable() {
            datatable = $('#adminuser-grid').DataTable({
                paging: true,
                ordering: true,
                filter: false,
                destroy: true,
                orderMulti: false,
                bLengthChange: false,
                pageLength: 10,
                scrollX: true,
                scrollCollapse: true,
                autoWidth: false,
                order: [[10, "desc"]],
                columnDefs: [{ targets: "_all", orderSequence: ["asc", "desc"] }],
                language: { emptyTable: "No admin users to show yet" },
                initComplete: function () {
                    const $wrapper = $("#adminuser-grid").closest(".dataTables_wrapper");
                    if (!$wrapper.parent().hasClass("tb-responsive")) {
                        $wrapper.wrap("<div class='tb-responsive'></div>");
                    }
                }
            });
        }

        // Status toggle. Posts to ActiveInactive once wired.
        $(document).on("change", ".toggle-active", function () {
            const text = $(this).is(":checked") ? "Active" : "Inactive";
            $(this).attr("title", text).closest(".switch").attr("title", text);
        });
    </script>
}
