@model PagedResult<AdminUserGridItem>
@{
    ViewData["Title"] = "Admin Users";
    var roleList = ViewBag.Roles as List<IdNamePair> ?? new List<IdNamePair>();
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Admin Users</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>User Management</li>
            <li>Admin User Listing</li>
        </ul>
    </div>
}

@Html.AntiForgeryToken()

<section class="listing-section common-box">
    <!-- ================= SINGLE UNIFIED TOOLBAR ================= -->
    <div class="p-3 border-bottom bg-white rounded-top">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">
            <!-- Left: Search & Filter Controls -->
            <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1" style="min-width: 280px;">
                <!-- Search Box -->
                <div class="position-relative" style="min-width: 240px; max-width: 340px; flex: 1 1 240px;">
                    <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none;">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search by name, email or mobile..." id="txtSearch" onkeyup="fnSearch(this);"
                           class="form-control rounded-pill ps-5 font-13"
                           style="height: 40px; background: #F3F8FD; border: 1px solid #e2e8f0;">
                    <span id="clearSearch" onclick="clearSearch()"
                          style="display:none; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); cursor:pointer; color: #888;">&#10006;</span>
                </div>

                <!-- Role Filter -->
                <select id="filterRole" class="form-select font-13 rounded-3" style="width: 165px; height: 40px; background-color: #fff; border: 1px solid #e2e8f0;" onchange="applyFilters()">
                    <option value="">All Roles</option>
                    @foreach (var r in roleList)
                    {
                        <option value="@r.Name">@r.Name</option>
                    }
                </select>

                <!-- Status Filter -->
                <select id="filterStatus" class="form-select font-13 rounded-3" style="width: 135px; height: 40px; background-color: #fff; border: 1px solid #e2e8f0;" onchange="applyFilters()">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Locked">Locked</option>
                </select>
            </div>

            <!-- Right: Action Buttons -->
            <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                <a asp-controller="AdminUser" asp-action="Add" class="custom_button primary_button text-nowrap">
                    <i class="fas fa-plus me-1"></i> Add Admin User
                </a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="adminuser-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:55px;">Photo</th>
                    <th style="min-width:160px;">Full Name</th>
                    <th style="min-width:200px;">Email</th>
                    <th style="min-width:120px;">Mobile</th>
                    <th style="min-width:140px;">Role</th>
                    <th style="min-width:100px;">Status</th>
                    <th style="min-width:140px;">Last Login</th>
                    <th style="min-width:120px;">Created</th>
                    <th style="min-width:110px; text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="user-row-@row.Id">
                        <td>
                            <img src="@(string.IsNullOrEmpty(row.PhotoUrl) ? "/assets/images/default-profile.png" : row.PhotoUrl)"
                                 alt="@row.FullName"
                                 style="width: 38px !important; height: 38px !important; min-width: 38px; min-height: 38px; max-width: 38px; max-height: 38px; aspect-ratio: 1/1; object-fit: cover; border-radius: 50%; display: block;" />
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@row.Id" class="fw-semibold text-dark">@row.FullName</a>
                            @if (row.Id == 1)
                            {
                                <span class="badge bg-primary ms-1" style="font-size:0.65rem;">Primary</span>
                            }
                        </td>
                        <td>@row.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                        <td>
                            <span class="badge bg-light text-dark border px-2 py-1">@row.RoleName</span>
                        </td>
                        <td>
                            @if (row.IsLocked)
                            {
                                <span class="badge bg-danger">Locked</span>
                            }
                            else if (row.Id == 1)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <label class="switch" title="@(row.IsActive ? "Active" : "Inactive")">
                                    <input type="checkbox" class="toggle-active" @(row.IsActive ? "checked" : "") onchange="toggleStatus(@row.Id, this)" />
                                    <span class="slider round"></span>
                                </label>
                            }
                        </td>
                        <td>@(row.LastLoginOn is null ? "Never" : Money.Relative(row.LastLoginOn.Value))</td>
                        <td>@Money.LongDate(row.CreatedOn)</td>
                        <td class="text-center" style="white-space: nowrap !important;">
                            <a asp-action="Details" asp-route-id="@row.Id" title="View Details" class="text-info"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="ms-2 text-primary"><i class="fas fa-pen"></i></a>
                            <a href="javascript:void(0);" onclick="openChangePasswordModal(@row.Id, '@Html.Raw(Html.Encode(row.FullName))')" title="Change Password" class="ms-2 text-warning"><i class="fas fa-key"></i></a>
                            @if (row.Id != 1)
                            {
                                <a href="javascript:void(0);" onclick="confirmDeleteAdminUser(@row.Id, '@Html.Raw(Html.Encode(row.FullName))')" title="Delete" class="ms-2 text-danger"><i class="fas fa-trash-alt"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No admin users found. <a asp-action="Add">Add a new admin user</a>.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Delete confirmation modal -->
<div class="modal delete-common-modal common-modal" id="adminuser-delete-confirm-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture>
                        <img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24">
                    </picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">This user will lose access immediately.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteAdminUser()">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal common-modal" id="change-password-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-start" style="text-align: left !important;">
            <div class="modal-header pb-2 border-bottom">
                <h5 class="modal-title fs-6 fw-bold"><i class="fas fa-key text-warning me-2"></i>Change Password</h5>
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture>
                        <img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24">
                    </picture>
                </button>
            </div>
            <div class="modal-body pt-3" style="text-align: left !important;">
                <input type="hidden" id="cpUserId" />
                <p class="text-muted mb-3 font-13">Resetting password for: <strong class="text-dark" id="cpUserFullName"></strong></p>

                <div class="mb-3 text-start">
                    <label class="form-label-custom text-start d-block mb-1">New Password <span class="req">*</span></label>
                    <div class="input-group">
                        <input type="password" id="cpNewPassword" class="form-control form-control-custom rounded-start" placeholder="Enter new password (min 6 characters)" autocomplete="new-password" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('cpNewPassword', this)" style="border-color: #cbd5e1; background: #fff;" title="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span class="text-danger font-12 mt-1 d-block" id="cpNewPasswordError"></span>
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label-custom text-start d-block mb-1">Confirm New Password <span class="req">*</span></label>
                    <div class="input-group">
                        <input type="password" id="cpConfirmPassword" class="form-control form-control-custom rounded-start" placeholder="Re-enter new password" autocomplete="new-password" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('cpConfirmPassword', this)" style="border-color: #cbd5e1; background: #fff;" title="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span class="text-danger font-12 mt-1 d-block" id="cpConfirmPasswordError"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-save-password" class="custom_button primary_button" onclick="executeChangePassword()">
                        <i class="fas fa-save me-1"></i> Update Password
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }

            datatable = $('#adminuser-grid').DataTable({
                paging: true,
                ordering: true,
                filter: true,
                destroy: true,
                bLengthChange: false,
                pageLength: 10,
                scrollX: true,
                autoWidth: false,
                language: { emptyTable: "No admin users to show yet" },
                dom: 'rtip',
                order: [[7, "desc"]],
                initComplete: function () {
                    const $w = $("#adminuser-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function applyFilters() {
            if (!datatable) return;

            const roleFilter = $('#filterRole').val() || '';
            const statusFilter = $('#filterStatus').val() || '';

            // Column 4 is Role, Column 5 is Status
            datatable.column(4).search(roleFilter);

            if (statusFilter === 'Locked') {
                datatable.column(5).search('Locked');
            } else if (statusFilter === 'Active') {
                datatable.column(5).search('Active');
            } else if (statusFilter === 'Inactive') {
                datatable.column(5).search('Inactive');
            } else {
                datatable.column(5).search('');
            }

            datatable.draw();
        }

        function toggleStatus(id, checkbox) {
            const isActive = $(checkbox).is(":checked");
            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("UpdateStatus", "AdminUser")',
                type: 'POST',
                data: {
                    id: id,
                    status: isActive ? 1 : 0,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    if (res && res.success) {
                        toastr.success(res.message || 'Status updated successfully.', 'Success');
                        $(checkbox).attr('title', isActive ? 'Active' : 'Inactive');
                    } else {
                        toastr.error(res ? res.message : 'Failed to update status.', 'Error');
                        $(checkbox).prop('checked', !isActive);
                    }
                },
                error: function () {
                    toastr.error('Error updating status.', 'Error');
                    $(checkbox).prop('checked', !isActive);
                }
            });
        }

        function confirmDeleteAdminUser(id, name) {
            deleteTargetId = id;
            $('#deleteUserName').text(name);
            $('#adminuser-delete-confirm-modal').modal('show');
        }

        function executeDeleteAdminUser() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "AdminUser")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#adminuser-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Admin user deleted successfully.', 'Deleted');
                        const row = document.getElementById('user-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error(res ? res.message : 'Failed to delete user.', 'Error');
                    }
                },
                error: function () {
                    $('#adminuser-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');
                    toastr.error('An error occurred while deleting the user.', 'Error');
                }
            });
        }

        function togglePasswordVisibility(fieldId, btn) {
            const input = document.getElementById(fieldId);
            if (!input) return;
            const isPass = input.type === "password";
            input.type = isPass ? "text" : "password";
            const icon = btn.querySelector('i');
            if (icon) {
                icon.className = isPass ? "fas fa-eye-slash" : "fas fa-eye";
            }
        }

        function openChangePasswordModal(id, name) {
            $('#cpUserId').val(id);
            $('#cpUserFullName').text(name);
            $('#cpNewPassword').val('').attr('type', 'password');
            $('#cpConfirmPassword').val('').attr('type', 'password');
            $('#change-password-modal .fa-eye-slash').removeClass('fa-eye-slash').addClass('fa-eye');
            $('#cpNewPasswordError').text('');
            $('#cpConfirmPasswordError').text('');
            $('#change-password-modal').modal('show');
        }

        $(document).on('input change', '#cpNewPassword, #cpConfirmPassword', function () {
            $('#cpNewPasswordError').text('');
            $('#cpConfirmPasswordError').text('');
        });

        function executeChangePassword() {
            const id = parseInt($('#cpUserId').val());
            const newPassword = $('#cpNewPassword').val();
            const confirmPassword = $('#cpConfirmPassword').val();

            $('#cpNewPasswordError').text('');
            $('#cpConfirmPasswordError').text('');

            let hasError = false;

            if (!newPassword) {
                $('#cpNewPasswordError').text('New password is required.');
                hasError = true;
            } else if (newPassword.length < 6) {
                $('#cpNewPasswordError').text('Password must be at least 6 characters long.');
                hasError = true;
            }

            if (!confirmPassword) {
                $('#cpConfirmPasswordError').text('Please confirm your new password.');
                hasError = true;
            } else if (newPassword !== confirmPassword) {
                $('#cpConfirmPasswordError').text('Passwords do not match.');
                hasError = true;
            }

            if (hasError) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-save-password');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Updating...');

            $.ajax({
                url: '@Url.Action("ChangePassword", "AdminUser")',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify({
                    id: id,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                }),
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Password');
                    if (res && res.success) {
                        $('#change-password-modal').modal('hide');
                        toastr.success(res.message || 'Password changed successfully.', 'Success');
                    } else {
                        toastr.error(res ? res.message : 'Failed to update password.', 'Error');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Update Password');
                    toastr.error('Error occurred while changing password.', 'Error');
                }
            });
        }
    </script>
}
