@model OrderDetailAdminViewModel
@*
    Module 06 - Order detail. Spec: docs/Admin Flows/Orders.txt §2 lifecycle,
    §5-10 stage screens, §4 row actions.
*@
@{
    ViewData["Title"] = "Order Details";


}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Order" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Order Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Order" asp-action="Index" class="links">Order Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <!-- ================= HEADER + ACTIONS ================= -->
    <section class="form-section">
        <div class="form-section-body">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="flex-grow-1">
                    <h3 class="mb-1">Order <span id="ordNumber">@Model.Header.OrderNumber</span></h3>
                    <p class="text-muted mb-0" style="font-size:.85rem;">
                        Placed <span id="ordDate">@Money.LongDate(Model.Header.PlacedOn)</span> &middot;
                        <span id="ordCustomer">@Model.Header.CustomerName</span> &middot;
                        <span id="ordItems">@Model.Header.ItemCount</span> items &middot;
                        <span id="ordTotal">@Money.Inr(Model.Header.Total)</span>
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="custom_button secondary_button"><i class="fas fa-file-invoice"></i> Invoice</button>
                    <button type="button" class="custom_button secondary_button"><i class="fas fa-tag"></i> Shipping Label</button>
                    <button type="button" class="custom_button secondary_button"><i class="fas fa-truck"></i> Assign Courier</button>
                    <button type="button" class="custom_button secondary_button" data-bs-toggle="modal" data-bs-target="#order-cancel-modal"><i class="fas fa-ban"></i> Cancel</button>
                    <button type="button" class="custom_button primary_button" data-bs-toggle="modal" data-bs-target="#order-status-modal"><i class="fas fa-arrow-right"></i> Update Status</button>
                </div>
            </div>

            <!-- Lifecycle -->
            <div class="order-timeline mt-4">
                @* Done / current / upcoming, from the order status rather than a static strip. *@
                @foreach (var step in Model.Timeline)
                {
                    <div class="timeline-step is-@step.State">
                        <span class="timeline-dot"></span>
                        <span class="timeline-label">@step.Title</span>
                        @if (step.At is not null)
                        {
                            <span class="timeline-meta text-muted">@Money.LongDate(step.At.Value)</span>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="row g-3">
        <!-- ================= ITEMS ================= -->
        <div class="col-xl-8">
            <section class="listing-section common-box h-100">
                <div class="latest-orders">
                    <div class="div-search-box-panel flex-ending-cls-here">
                        <h3 class="section-heading">Order Items</h3>
                    </div>
                </div>
                <div class="table-main">
                    <table class="custom-datatable listing-order-table" id="order-items-grid">
                        <thead>
                            <tr>
                                <th style="min-width:60px;">Image</th>
                                <th style="min-width:220px;">Product</th>
                                <th style="min-width:120px;">SKU</th>
                                <th style="min-width:140px;">Variant</th>
                                <th style="min-width:90px;">Qty</th>
                                <th style="min-width:110px;">Price</th>
                                <th style="min-width:110px;">Discount</th>
                                <th style="min-width:100px;">Tax</th>
                                <th style="min-width:120px;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td><img src="@line.ImageUrl" width="36" height="36" alt="@line.ImageAlt" style="object-fit:cover;border-radius:6px" /></td>
                            <td>@line.Name</td>
                            <td>@line.Sku</td>
                            <td>@line.VariantSummary</td>
                            <td class="text-end">@line.Quantity</td>
                            <td class="text-end">@Money.Inr(line.Price)</td>
                            <td class="text-end">@(line.Mrp is null ? "—" : Money.Inr(line.Mrp.Value - line.Price))</td>
                            <td class="text-end">Included</td>
                            <td class="text-end"><strong>@Money.Inr(line.LineTotal)</strong></td>
                        </tr>
                    }
                    @if (!Model.Lines.Any())
                    {
                        <tr><td colspan="9" class="text-center py-4">No line items on this order.</td></tr>
                    }
                </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- ================= SUMMARY ================= -->
        <div class="col-xl-4">
            <section class="form-section h-100">
                <div class="form-section-header">
                    <h2><i class="fas fa-receipt" style="color:var(--accent);margin-right:8px;"></i>Order Summary</h2>
                </div>
                <div class="form-section-body">
                    @* The same OrderSummaryViewModel the customer's own order page renders.
                       One order, one set of numbers — nothing to reconcile. *@
                    <ul class="simple-list">
                        <li><span>Sub Total</span><strong>@Money.Inr(Model.Summary.MrpTotal)</strong></li>
                        <li><span>Discount</span><strong>&minus;@Money.Inr(Model.Summary.ProductSavings)</strong></li>
                        <li>
                            <span>Coupon@(Model.Summary.CouponCode is null ? "" : " (" + Model.Summary.CouponCode + ")")</span>
                            <strong>&minus;@Money.Inr(Model.Summary.CouponDiscount)</strong>
                        </li>
                        <li><span>Shipping Charges</span><strong>@(Model.Summary.Shipping == 0 ? "Free" : Money.Inr(Model.Summary.Shipping))</strong></li>
                        <li><span>COD Charges</span><strong>@Money.Inr(Model.Summary.CodFee)</strong></li>
                        <li><span>Tax (GST)</span><strong>@(Model.Summary.TaxInclusive ? "Included" : Money.Inr(Model.Summary.TaxTotal))</strong></li>
                        <li><span>Grand Total</span><strong>@Money.Inr(Model.Summary.Total)</strong></li>
                    </ul>

                    <h4 class="section-heading mt-3">Payment</h4>
                    <ul class="simple-list">
                        <li><span>Payment Method</span><strong>@Model.Header.PaymentMethod</strong></li>
                        <li><span>Payment Status</span><strong>@Model.Header.PaymentStatus</strong></li>
                        <li><span>Transaction ID</span><strong>@(Model.PaymentReference ?? "&mdash;")</strong></li>
                        <li><span>Paid On</span><strong>@Money.LongDate(Model.Header.PlacedOn)</strong></li>
                    </ul>
                </div>
            </section>
        </div>
    </div>

    <!-- ================= TABS ================= -->
    <section class="form-section">
        <div class="form-section-body">

            <ul class="nav nav-tabs" id="orderDetailTabs" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#o-addresses" type="button" role="tab">Addresses</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#o-fulfilment" type="button" role="tab">Fulfilment</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#o-shipment" type="button" role="tab">Shipment</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#o-returns" type="button" role="tab">Returns &amp; Refunds</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#o-activity" type="button" role="tab">Activity Log</button></li>
            </ul>

            <div class="tab-content pt-3">

                <div class="tab-pane fade show active" id="o-addresses" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <h4 class="section-heading">Billing Address</h4>
                            <p class="detail-value">&mdash;</p>
                        </div>
                        <div class="col-lg-6">
                            <h4 class="section-heading">Shipping Address</h4>
                            <p class="detail-value">&mdash;</p>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="o-fulfilment" role="tabpanel">
                    <div class="row g-3">
                        @foreach (var f in new[] { "Warehouse", "Picking List", "Packed By", "Packing Date", "Number of Packages", "Package Weight", "Package Dimensions", "Packing Notes" })
                        {
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label-custom">@f</label>
                                <p class="detail-value">&mdash;</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="o-shipment" role="tabpanel">
                    <div class="row g-3">
                        @foreach (var f in new[] { "Courier", "AWB Number", "Tracking Number", "Dispatch Date", "Estimated Delivery", "Delivered On", "Receiver Name", "Shipping Charges" })
                        {
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label-custom">@f</label>
                                <p class="detail-value">&mdash;</p>
                            </div>
                        }
                    </div>

                    <div class="table-main mt-3">
                        <table class="custom-datatable listing-order-table">
                            <thead>
                                <tr>
                                    <th style="min-width:150px;">Date</th>
                                    <th style="min-width:180px;">Status</th>
                                    <th style="min-width:200px;">Location</th>
                                    <th style="min-width:280px;">Remarks</th>
                                </tr>
                            </thead>
                            <tbody><tr><td colspan="8" class="text-center py-4">Nothing recorded here yet.</td></tr></tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="o-returns" role="tabpanel">
                    <div class="table-main">
                        <table class="custom-datatable listing-order-table">
                            <thead>
                                <tr>
                                    <th style="min-width:150px;">Reference</th>
                                    <th style="min-width:120px;">Type</th>
                                    <th style="min-width:210px;">Product</th>
                                    <th style="min-width:100px;">Qty</th>
                                    <th style="min-width:170px;">Reason</th>
                                    <th style="min-width:130px;">Amount</th>
                                    <th style="min-width:130px;">Status</th>
                                    <th style="min-width:140px;">Date</th>
                                </tr>
                            </thead>
                            <tbody><tr><td colspan="8" class="text-center py-4">Nothing recorded here yet.</td></tr></tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="o-activity" role="tabpanel">
                    <div class="table-main">
                        <table class="custom-datatable listing-order-table">
                            <thead>
                                <tr>
                                    <th style="min-width:150px;">Date</th>
                                    <th style="min-width:180px;">Action</th>
                                    <th style="min-width:160px;">By</th>
                                    <th style="min-width:300px;">Details</th>
                                </tr>
                            </thead>
                            <tbody><tr><td colspan="8" class="text-center py-4">Nothing recorded here yet.</td></tr></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </section>

</main>

<!-- Update status -->
<div class="modal delete-common-modal common-modal" id="order-status-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Update Order Status</h3>
                <div class="text-start mt-2">
                    <label class="form-label-custom">New Status</label>
                    @* Only the legal next steps, computed by the API from the lifecycle in
                       Orders.txt §2 — an operator cannot skip Packed and jump to Delivered. *@
                    <select class="form-control-custom" name="NewStatus">
                        @foreach (var next in Model.AllowedNextStatuses)
                        {
                            <option value="@((int)next)">@next</option>
                        }
                        @if (!Model.AllowedNextStatuses.Any())
                        {
                            <option value="">No further transitions from @Model.Header.Status</option>
                        }
                    </select>

                    @* Ticked by default: every transition the shopper can act on fires the
                       matching notification, which is what keeps their tracking page honest. *@
                    <label class="d-flex align-items-center gap-2 mt-3">
                        <input type="checkbox" name="NotifyCustomer" checked />
                        <span>Notify the customer</span>
                    </label>

                    <label class="form-label-custom mt-2">Notes</label>
                    <textarea class="form-control-custom" rows="3" placeholder="Optional note recorded in the activity log"></textarea>

                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="NotifyOnStatus" checked />
                        <label class="form-check-label" for="NotifyOnStatus">Notify the customer</label>
                    </div>
                </div>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="custom_button primary_button" data-bs-dismiss="modal">Update</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel order -->
<div class="modal delete-common-modal common-modal" id="order-cancel-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Cancel Order</h3>
                <p>Cancelling releases reserved stock and, if payment was captured, starts a refund.</p>
                <div class="text-start mt-2">
                    <label class="form-label-custom">Cancellation Reason <span class="req">*</span></label>
                    <select class="form-control-custom">
                        <option>Customer Request</option>
                        <option>Out of Stock</option>
                        <option>Payment Failed</option>
                        <option>Address Not Serviceable</option>
                        <option>Fraud Suspected</option>
                        <option>Duplicate Order</option>
                    </select>
                    <label class="form-label-custom mt-2">Remarks</label>
                    <textarea class="form-control-custom" rows="3"></textarea>
                </div>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Keep Order</button>
                    <button type="button" class="custom_button primary_button" data-bs-dismiss="modal">Cancel Order</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Order"); }

            $('#order-items-grid').DataTable({
                paging: false, ordering: false, filter: false, info: false,
                scrollX: true, autoWidth: false,
                language: { emptyTable: "No items on this order" }
            });

            $('#orderDetailTabs button[data-bs-toggle="tab"]').on('shown.bs.tab', function () {
                $($(this).data('bs-target')).find('table.custom-datatable').each(function () {
                    if (!$.fn.DataTable.isDataTable(this)) {
                        $(this).DataTable({
                            paging: true, ordering: true, filter: false,
                            bLengthChange: false, pageLength: 10,
                            scrollX: true, autoWidth: false,
                            language: { emptyTable: "No records to show yet" }
                        });
                    }
                });
            });
        });
    </script>
}
