@model BrandSaveRequest
@{
    ViewData["Title"] = "Brand Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Brand" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Brand Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Brand" asp-action="Index" class="links">Brand Listing</a></li>
            <li>@Model.BrandName</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-award" style="color:var(--accent);margin-right:8px;"></i>Brand Overview</h2>
            <div class="d-flex gap-2">
                <a asp-controller="Brand" asp-action="Index" class="custom_button secondary_button">
                    <i class="fas fa-arrow-left me-1"></i> Back to List
                </a>
                <a asp-controller="Brand" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button primary_button">
                    <i class="fas fa-pen me-1"></i> Edit Brand
                </a>
            </div>
        </div>

        <div class="form-section-body">
            <div class="row g-4">
                <div class="col-lg-3 col-md-4 text-center">
                    <div class="p-3 border rounded bg-white shadow-sm">
                        <img src="@(string.IsNullOrEmpty(Model.LogoUrl) ? "/assets/images/default-profile.png" : Model.LogoUrl)" 
                             alt="@Model.BrandName" 
                             class="img-fluid rounded" 
                             style="max-height: 140px; object-fit: contain;" />
                        <h4 class="mt-3 mb-1 fw-bold">@Model.BrandName</h4>
                        <div class="mt-2">
                            @await Html.PartialAsync("_StatusPill", Model.IsActive)
                            @if (Model.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark ms-1"><i class="fas fa-star me-1"></i> Featured</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-9 col-md-8">
                    <div class="row g-3">
                        <div class="col-lg-6 col-md-6">
                            <label class="form-label-custom">Brand Name</label>
                            <p class="detail-value fw-semibold">@Model.BrandName</p>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <label class="form-label-custom">Slug (URL identifier)</label>
                            <p class="detail-value text-monospace">@(string.IsNullOrEmpty(Model.Slug) ? "—" : Model.Slug)</p>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <label class="form-label-custom">Website</label>
                            <p class="detail-value">
                                @if (!string.IsNullOrEmpty(Model.Website))
                                {
                                    <a href="@Model.Website" target="_blank" rel="noopener" class="text-primary fw-medium">
                                        @Model.Website <i class="fas fa-external-link-alt font-12 ms-1"></i>
                                    </a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Sort Order</label>
                            <p class="detail-value">@Model.SortOrder</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Homepage Featured</label>
                            <p class="detail-value">@(Model.IsFeatured ? "Yes" : "No")</p>
                        </div>
                        <div class="col-12">
                            <label class="form-label-custom">Description &amp; Heritage</label>
                            <div class="p-3 bg-light rounded border text-secondary" style="min-height: 80px; white-space: pre-line;">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this brand." : Model.Description)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Product"); }
        });
    </script>
}
