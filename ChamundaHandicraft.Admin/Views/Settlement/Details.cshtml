@model SettlementGridItem
@{
    ViewData["Title"] = "Settlement Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Settlement" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Settlement Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Settlement" asp-action="Index" class="links">Settlements Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Settlement Information</h2>

        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Settlement ID</label>
                        <p class="detail-value">@Model.SettlementId</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Settlement Date</label>
                        <p class="detail-value">@Money.LongDate(Model.SettledOn)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Gateway</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Transactions</label>
                        <p class="detail-value">@Model.TransactionCount</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Gross Amount</label>
                        <p class="detail-value">@Money.Inr(Model.GrossAmount)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Gateway Fees</label>
                        <p class="detail-value">@Money.Inr(Model.Fees)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Tax</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Net Amount</label>
                        <p class="detail-value">@Money.Inr(Model.NetAmount)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">UTR Number</label>
                        <p class="detail-value">@(Model.BankReference ?? "—")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Bank Account</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@Model.Status</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reconciled By</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Payment"); }
        });
    </script>
}
