@model AdminDashboardViewModel
@*
    Module 01 - Dashboard. Clean, modern, executive overview.
    Surfaces key business metrics, sales trajectory, order pipeline, and critical exceptions at a glance.
*@
@{
    ViewData["Title"] = "Dashboard";
    var pendingFulfillment = Model.PendingOrders + Model.ProcessingOrders + Model.PackedOrders;
    var stockAttention = Model.LowStockCount + Model.OutOfStockCount;
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Dashboard</h2>
            <p class="text-muted mb-0" style="font-size:0.88rem;">Welcome back! Here is what is happening with your store today.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <select id="dashDateRange" class="form-control-custom" style="min-width:140px; height:38px; font-size:0.86rem;">
                <option value="today">Today</option>
                <option value="last7" selected>Last 7 Days</option>
                <option value="thismonth">This Month</option>
                <option value="thisyear">This Year</option>
            </select>
            <a asp-controller="Product" asp-action="Add" class="custom_button primary_button" style="height:38px; font-size:0.86rem; padding:0 14px;">
                <i class="fas fa-plus me-1"></i> Add Product
            </a>
        </div>
    </div>
}

<!-- ================= 1. KEY METRICS (4 HERO CARDS) ================= -->
<div class="row g-3 mb-4">

    <!-- Total Sales / Revenue -->
    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Report" asp-action="Index" asp-route-type="sales" class="text-decoration-none">
            <div class="dash-kpi-card">
                <div class="dash-kpi-header">
                    <span class="dash-kpi-title">Total Sales</span>
                    <div class="dash-kpi-icon icon-revenue">
                        <i class="fas fa-indian-rupee-sign"></i>
                    </div>
                </div>
                <div class="dash-kpi-body">
                    <h3 class="dash-kpi-value">@Money.Inr(Model.TotalSales)</h3>
                    <div class="dash-kpi-meta">
                        <span class="text-success"><i class="fas fa-arrow-trend-up me-1"></i>Avg @Money.Inr(Model.AverageOrderValue) / order</span>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Today's Orders -->
    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Order" asp-action="Index" class="text-decoration-none">
            <div class="dash-kpi-card">
                <div class="dash-kpi-header">
                    <span class="dash-kpi-title">Today's Orders</span>
                    <div class="dash-kpi-icon icon-orders">
                        <i class="fas fa-bag-shopping"></i>
                    </div>
                </div>
                <div class="dash-kpi-body">
                    <h3 class="dash-kpi-value">@Model.TodaysOrders</h3>
                    <div class="dash-kpi-meta">
                        <span class="text-muted">@Model.TotalOrders.ToString("N0") lifetime orders</span>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Pending Fulfillment -->
    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Order" asp-action="Index" asp-route-status="Pending" class="text-decoration-none">
            <div class="dash-kpi-card">
                <div class="dash-kpi-header">
                    <span class="dash-kpi-title">Pending Action</span>
                    <div class="dash-kpi-icon icon-pending">
                        <i class="fas fa-clock-rotate-left"></i>
                    </div>
                </div>
                <div class="dash-kpi-body">
                    <h3 class="dash-kpi-value">@pendingFulfillment</h3>
                    <div class="dash-kpi-meta">
                        <span class="badge bg-warning text-dark me-1">@Model.PendingOrders Pending</span>
                        <span class="text-muted">@Model.ProcessingOrders Processing</span>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Stock Attention -->
    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Inventory" asp-action="Index" asp-route-filter="lowstock" class="text-decoration-none">
            <div class="dash-kpi-card">
                <div class="dash-kpi-header">
                    <span class="dash-kpi-title">Stock Attention</span>
                    <div class="dash-kpi-icon icon-stock">
                        <i class="fas fa-boxes-stacked"></i>
                    </div>
                </div>
                <div class="dash-kpi-body">
                    <h3 class="dash-kpi-value">@stockAttention</h3>
                    <div class="dash-kpi-meta">
                        @if (Model.OutOfStockCount > 0)
                        {
                            <span class="badge bg-danger me-1">@Model.OutOfStockCount Out of Stock</span>
                        }
                        <span class="text-muted">@Model.LowStockCount Low Stock</span>
                    </div>
                </div>
            </div>
        </a>
    </div>

</div>

<!-- ================= 2. MAIN WORKSPACE (8 COL / 4 COL) ================= -->
<div class="row g-3 mb-4">

    <!-- LEFT COLUMN (8 cols): SALES PERFORMANCE + RECENT ORDERS -->
    <div class="col-xl-8">

        <!-- Sales Trend Chart Card -->
        <div class="dash-card mb-4">
            <div class="dash-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="dash-card-title mb-1">Sales & Revenue Trend</h4>
                    <p class="dash-card-subtitle text-muted mb-0">Commercial revenue and order trends over time</p>
                </div>
                <div class="btn-group btn-group-sm" role="group" id="grainSelector">
                    <button type="button" class="btn btn-outline-secondary active" data-grain="monthly">Monthly</button>
                    <button type="button" class="btn btn-outline-secondary" data-grain="weekly">Weekly</button>
                    <button type="button" class="btn btn-outline-secondary" data-grain="daily">Daily</button>
                </div>
            </div>
            <div class="dash-card-body">
                <div style="height: 290px; position: relative;">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Recent Orders Card -->
        <div class="dash-card">
            <div class="dash-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="dash-card-title mb-1">Recent Orders</h4>
                    <p class="dash-card-subtitle text-muted mb-0">Latest customer orders requiring fulfillment</p>
                </div>
                <a asp-controller="Order" asp-action="Index" class="dash-card-link">
                    View All Orders <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="dash-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-dash-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th class="text-center">Items</th>
                                <th class="text-end">Total</th>
                                <th>Payment</th>
                                <th>Order Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.RecentOrders.Take(5))
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" class="dash-order-link">
                                            @o.OrderNumber
                                        </a>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="dash-avatar">@(o.CustomerName.Length > 0 ? o.CustomerName.Substring(0, 1) : "?")</span>
                                            <span>@o.CustomerName</span>
                                        </div>
                                    </td>
                                    <td class="text-center text-muted">@o.ItemCount</td>
                                    <td class="text-end fw-bold">@Money.Inr(o.Total)</td>
                                    <td>@await Html.PartialAsync("_PaymentStatusPill", o.PaymentStatus)</td>
                                    <td>@await Html.PartialAsync("_OrderStatusPill", o.Status)</td>
                                    <td class="text-end">
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-light" title="View Order Details">
                                            <i class="fas fa-chevron-right text-muted"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.RecentOrders.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                                        No recent orders to show.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <!-- RIGHT COLUMN (4 cols): OPERATIONAL PIPELINE + INVENTORY ATTENTION + SHORTCUTS -->
    <div class="col-xl-4">

        <!-- Operational Pipeline Card -->
        <div class="dash-card mb-4">
            <div class="dash-card-header d-flex justify-content-between align-items-center">
                <h4 class="dash-card-title mb-0">Order Pipeline</h4>
                <a asp-controller="Order" asp-action="Index" class="dash-card-link" style="font-size:0.8rem;">
                    Orders <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="dash-card-body p-0">
                <ul class="dash-pipeline-list">
                    <li>
                        <a asp-controller="Order" asp-action="Index" asp-route-status="Pending" class="dash-pipeline-item">
                            <span class="dash-status-dot bg-warning"></span>
                            <span class="dash-pipeline-label">Pending Confirmation</span>
                            <span class="dash-pipeline-count">@Model.PendingOrders</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Order" asp-action="Index" asp-route-status="Processing" class="dash-pipeline-item">
                            <span class="dash-status-dot bg-info"></span>
                            <span class="dash-pipeline-label">Processing in Studio</span>
                            <span class="dash-pipeline-count">@Model.ProcessingOrders</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Order" asp-action="Index" asp-route-status="Packed" class="dash-pipeline-item">
                            <span class="dash-status-dot" style="background:#8b5cf6;"></span>
                            <span class="dash-pipeline-label">Packed & Ready</span>
                            <span class="dash-pipeline-count">@Model.PackedOrders</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Order" asp-action="Index" asp-route-status="Shipped" class="dash-pipeline-item">
                            <span class="dash-status-dot bg-primary"></span>
                            <span class="dash-pipeline-label">In Transit / Shipped</span>
                            <span class="dash-pipeline-count">@Model.ShippedOrders</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Order" asp-action="Index" asp-route-status="Delivered" class="dash-pipeline-item">
                            <span class="dash-status-dot bg-success"></span>
                            <span class="dash-pipeline-label">Delivered</span>
                            <span class="dash-pipeline-count">@Model.DeliveredOrders</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Order" asp-action="Index" asp-route-status="Cancelled" class="dash-pipeline-item">
                            <span class="dash-status-dot bg-danger"></span>
                            <span class="dash-pipeline-label">Cancelled / Returned</span>
                            <span class="dash-pipeline-count text-muted">@(Model.CancelledOrders + Model.ReturnedOrders)</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Inventory Attention Card -->
        <div class="dash-card mb-4">
            <div class="dash-card-header d-flex justify-content-between align-items-center">
                <h4 class="dash-card-title mb-0">Inventory Attention</h4>
                <a asp-controller="Inventory" asp-action="Index" asp-route-filter="lowstock" class="dash-card-link">
                    Manage <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="dash-card-body p-0">
                @if (Model.LowStockProducts.Any())
                {
                    <div class="dash-stock-list">
                        @foreach (var p in Model.LowStockProducts.Take(4))
                        {
                            <div class="dash-stock-item">
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/assets/images/placeholders/category.svg" : p.ImageUrl)" 
                                     alt="@p.Name" class="dash-stock-img" />
                                <div class="dash-stock-info">
                                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@p.Id" class="dash-stock-name">
                                        @p.Name
                                    </a>
                                    <span class="dash-stock-sku">@p.Sku &middot; @p.CategoryName</span>
                                </div>
                                <div class="dash-stock-action">
                                    @if (p.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@p.StockQuantity left</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-circle-check text-success fa-2x mb-2 d-block"></i>
                        All products well stocked.
                    </div>
                }
            </div>
        </div>

        <!-- Quick Shortcuts -->
        <div class="dash-card">
            <div class="dash-card-header">
                <h4 class="dash-card-title mb-0">Quick Shortcuts</h4>
            </div>
            <div class="dash-card-body">
                <div class="dash-shortcuts-grid">
                    <a asp-controller="Product" asp-action="Add" class="dash-shortcut-btn">
                        <div class="dash-shortcut-icon" style="background:rgba(107,44,44,.1); color:var(--brand-primary, #6B2C2C);">
                            <i class="fas fa-plus"></i>
                        </div>
                        <span>Add Product</span>
                    </a>
                    <a asp-controller="Coupon" asp-action="Add" class="dash-shortcut-btn">
                        <div class="dash-shortcut-icon" style="background:rgba(245,158,11,.1); color:#f59e0b;">
                            <i class="fas fa-ticket"></i>
                        </div>
                        <span>Create Coupon</span>
                    </a>
                    <a asp-controller="Customer" asp-action="Index" class="dash-shortcut-btn">
                        <div class="dash-shortcut-icon" style="background:rgba(59,130,246,.1); color:#3b82f6;">
                            <i class="fas fa-users"></i>
                        </div>
                        <span>Customers</span>
                    </a>
                    <a asp-controller="Report" asp-action="Index" class="dash-shortcut-btn">
                        <div class="dash-shortcut-icon" style="background:rgba(34,197,94,.1); color:#22c55e;">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <span>Reports</span>
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Dashboard"); }

            initSalesChart();

            $('#grainSelector button').on('click', function () {
                $('#grainSelector button').removeClass('active');
                $(this).addClass('active');
                updateSalesChartGrain($(this).data('grain'));
            });
        });

        var salesChartInstance = null;

        function initSalesChart() {
            var ctx = document.getElementById('salesChart');
            if (!ctx || !window.Chart) return;

            var labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var salesData = [180000, 240000, 290000, 310000, 380000, 420000, 490000, 530000, 480000, 560000, 620000, 710000];
            var ordersData = [65, 84, 102, 110, 134, 148, 172, 185, 168, 196, 215, 248];

            var gradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 280);
            gradient.addColorStop(0, 'rgba(107, 44, 44, 0.22)');
            gradient.addColorStop(1, 'rgba(107, 44, 44, 0.00)');

            salesChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Revenue (₹)',
                            data: salesData,
                            borderColor: '#6B2C2C',
                            backgroundColor: gradient,
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#6B2C2C',
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Orders',
                            data: ordersData,
                            borderColor: '#B8860B',
                            backgroundColor: 'transparent',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            tension: 0.35,
                            pointBackgroundColor: '#B8860B',
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: {
                                boxWidth: 14,
                                font: { family: "'DM Sans', sans-serif", size: 12 }
                            }
                        },
                        tooltip: {
                            backgroundColor: '#1f2937',
                            titleFont: { family: "'DM Sans', sans-serif", size: 12 },
                            bodyFont: { family: "'DM Sans', sans-serif", size: 12 },
                            padding: 10,
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: "'DM Sans', sans-serif", size: 11 } }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                font: { family: "'DM Sans', sans-serif", size: 11 },
                                callback: function (value) { return '₹' + (value / 1000) + 'k'; }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            ticks: { font: { family: "'DM Sans', sans-serif", size: 11 } }
                        }
                    }
                }
            });
        }

        function updateSalesChartGrain(grain) {
            if (!salesChartInstance) return;

            if (grain === 'weekly') {
                salesChartInstance.data.labels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
                salesChartInstance.data.datasets[0].data = [42000, 58000, 64000, 71000, 89000, 112000, 96000];
                salesChartInstance.data.datasets[1].data = [15, 20, 22, 25, 31, 39, 34];
            } else if (grain === 'daily') {
                salesChartInstance.data.labels = ['9 AM', '12 PM', '3 PM', '6 PM', '9 PM', '12 AM'];
                salesChartInstance.data.datasets[0].data = [8000, 14000, 18000, 26000, 21000, 9000];
                salesChartInstance.data.datasets[1].data = [3, 5, 7, 9, 8, 3];
            } else {
                salesChartInstance.data.labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                salesChartInstance.data.datasets[0].data = [180000, 240000, 290000, 310000, 380000, 420000, 490000, 530000, 480000, 560000, 620000, 710000];
                salesChartInstance.data.datasets[1].data = [65, 84, 102, 110, 134, 148, 172, 185, 168, 196, 215, 248];
            }

            salesChartInstance.update();
        }
    </script>
}
