@*
    Module 01 - Dashboard.  Spec: docs/Admin Flows/Dashboard.txt
    Markup only. Every figure below is placeholder text and gets replaced by the
    Dashboard API payload once the controller is wired.
*@
@{
    ViewData["Title"] = "Dashboard";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Dashboard</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Business Overview</li>
        </ul>
    </div>
}

<!-- ================= GLOBAL FILTERS ================= -->
<section class="listing-section common-box">
    <div class="div-search-box-panel flex-ending-cls-here">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <select id="dashDateRange" class="form-control-custom" style="min-width:170px;">
                <option value="today">Today</option>
                <option value="yesterday">Yesterday</option>
                <option value="last7" selected>Last 7 Days</option>
                <option value="last30">Last 30 Days</option>
                <option value="thismonth">This Month</option>
                <option value="lastmonth">Last Month</option>
                <option value="thisyear">This Year</option>
                <option value="custom">Custom Range</option>
            </select>

            <input type="text" id="dashCustomFrom" class="form-control-custom" placeholder="From" style="max-width:150px;display:none;" />
            <input type="text" id="dashCustomTo" class="form-control-custom" placeholder="To" style="max-width:150px;display:none;" />

            <select id="dashWarehouse" class="form-control-custom" style="min-width:150px;">
                <option value="">All Warehouses</option>
            </select>

            <select id="dashCategory" class="form-control-custom" style="min-width:150px;">
                <option value="">All Categories</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="custom_button secondary_button" onclick="exportDashboard('excel')">
                <i class="fas fa-file-excel"></i> Export
            </button>
            <button type="button" class="custom_button primary_button" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>
</section>

<!-- ================= KPI CARDS ================= -->
<section class="form-section">
    <div class="form-section-header">
        <h2><i class="fas fa-chart-line" style="color:var(--accent);margin-right:8px;"></i>Key Metrics</h2>
    </div>

    <div class="form-section-body">
        <div class="row g-3" id="kpi-cards">

            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="Report" asp-action="Index" asp-route-type="sales" class="text-decoration-none">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:rgba(34,197,94,.12);color:#22c55e;"><i class="fas fa-indian-rupee-sign"></i></div>
                        <div class="kpi-body">
                            <span class="kpi-label">Total Sales</span>
                            <span class="kpi-value" id="kpiTotalSales">&#8377;0</span>
                            <span class="kpi-trend up"><i class="fas fa-arrow-up"></i> 0% vs previous</span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="kpi-card">
                    <div class="kpi-icon" style="background:rgba(59,130,246,.12);color:#3b82f6;"><i class="fas fa-calendar-day"></i></div>
                    <div class="kpi-body">
                        <span class="kpi-label">Today's Sales</span>
                        <span class="kpi-value" id="kpiTodaySales">&#8377;0</span>
                        <span class="kpi-trend"><i class="fas fa-minus"></i> no change</span>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="kpi-card">
                    <div class="kpi-icon" style="background:rgba(139,92,246,.12);color:#8b5cf6;"><i class="fas fa-calendar-alt"></i></div>
                    <div class="kpi-body">
                        <span class="kpi-label">Monthly Sales</span>
                        <span class="kpi-value" id="kpiMonthlySales">&#8377;0</span>
                        <span class="kpi-trend up"><i class="fas fa-arrow-up"></i> 0% MoM</span>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="kpi-card">
                    <div class="kpi-icon" style="background:rgba(6,182,212,.12);color:#06b6d4;"><i class="fas fa-sack-dollar"></i></div>
                    <div class="kpi-body">
                        <span class="kpi-label">Revenue</span>
                        <span class="kpi-value" id="kpiRevenue">&#8377;0</span>
                        <span class="kpi-sub">Monthly &#8377;0 &middot; Growth 0%</span>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="kpi-card">
                    <div class="kpi-icon" style="background:rgba(245,158,11,.12);color:#f59e0b;"><i class="fas fa-chart-pie"></i></div>
                    <div class="kpi-body">
                        <span class="kpi-label">Profit</span>
                        <span class="kpi-value" id="kpiProfit">&#8377;0</span>
                        <span class="kpi-sub">Gross &#8377;0 &middot; Net &#8377;0 &middot; Margin 0%</span>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="Order" asp-action="Index" class="text-decoration-none">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:rgba(249,115,22,.12);color:#f97316;"><i class="fas fa-receipt"></i></div>
                        <div class="kpi-body">
                            <span class="kpi-label">Orders</span>
                            <span class="kpi-value" id="kpiOrders">0</span>
                            <span class="kpi-sub">New 0 &middot; Processing 0 &middot; Delivered 0</span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="Customer" asp-action="Index" class="text-decoration-none">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:rgba(236,72,153,.12);color:#ec4899;"><i class="fas fa-users"></i></div>
                        <div class="kpi-body">
                            <span class="kpi-label">Customers</span>
                            <span class="kpi-value" id="kpiCustomers">0</span>
                            <span class="kpi-sub">New today 0 &middot; Active 0</span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="kpi-card">
                    <div class="kpi-icon" style="background:rgba(20,184,166,.12);color:#14b8a6;"><i class="fas fa-globe"></i></div>
                    <div class="kpi-body">
                        <span class="kpi-label">Website Visitors</span>
                        <span class="kpi-value" id="kpiVisitors">0</span>
                        <span class="kpi-sub">Weekly 0 &middot; Monthly 0</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ================= SALES / REVENUE ANALYTICS ================= -->
<div class="row g-3">
    <div class="col-xl-8">
        <section class="form-section h-100">
            <div class="form-section-header d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-chart-area" style="color:var(--accent);margin-right:8px;"></i>Sales Analytics</h2>
                <select id="salesChartGrain" class="form-control-custom" style="max-width:140px;">
                    <option value="monthly" selected>Monthly</option>
                    <option value="weekly">Weekly</option>
                    <option value="daily">Daily</option>
                </select>
            </div>
            <div class="form-section-body">
                <canvas id="salesChart" height="110"></canvas>
            </div>
        </section>
    </div>

    <div class="col-xl-4">
        <section class="form-section h-100">
            <div class="form-section-header">
                <h2><i class="fas fa-coins" style="color:var(--accent);margin-right:8px;"></i>Revenue Breakdown</h2>
            </div>
            <div class="form-section-body">
                <canvas id="revenueChart" height="190"></canvas>
            </div>
        </section>
    </div>
</div>

<!-- ================= ORDER SUMMARY ================= -->
<section class="form-section">
    <div class="form-section-header">
        <h2><i class="fas fa-clipboard-list" style="color:var(--accent);margin-right:8px;"></i>Order Summary</h2>
    </div>
    <div class="form-section-body">
        <div class="row g-3" id="order-status-cards">
            @{
                var orderStatuses = new[]
                {
                    new { Key = "New",              Icon = "fa-plus-circle",     Color = "#3b82f6" },
                    new { Key = "Pending",          Icon = "fa-clock",           Color = "#f59e0b" },
                    new { Key = "Packed",           Icon = "fa-box",             Color = "#8b5cf6" },
                    new { Key = "Processing",       Icon = "fa-cogs",            Color = "#06b6d4" },
                    new { Key = "Shipped",          Icon = "fa-truck-fast",      Color = "#0ea5e9" },
                    new { Key = "Delivered",        Icon = "fa-circle-check",    Color = "#22c55e" },
                    new { Key = "Cancelled",        Icon = "fa-ban",             Color = "#ef4444" },
                    new { Key = "Returned",         Icon = "fa-rotate-left",     Color = "#f97316" },
                    new { Key = "Refund Requested", Icon = "fa-hand-holding-dollar", Color = "#eab308" },
                    new { Key = "Refund Completed", Icon = "fa-receipt",         Color = "#14b8a6" }
                };
            }
            @foreach (var s in orderStatuses)
            {
                <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                    <a asp-controller="Order" asp-action="Index" asp-route-status="@s.Key" class="text-decoration-none">
                        <div class="status-card">
                            <i class="fas @s.Icon" style="color:@s.Color;"></i>
                            <span class="status-count">0</span>
                            <span class="status-label">@s.Key</span>
                            <span class="status-trend">0%</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- ================= INVENTORY SUMMARY ================= -->
<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <h3 class="section-heading">Best Selling Products</h3>
            <a asp-controller="Report" asp-action="Index" asp-route-type="product" class="custom_button secondary_button">View Report</a>
        </div>
    </div>
    <div class="table-main">
        <table class="custom-datatable listing-order-table" id="best-selling-grid">
            <thead>
                <tr>
                    <th style="min-width:70px;">Image</th>
                    <th style="min-width:220px;">Product</th>
                    <th style="min-width:120px;">SKU</th>
                    <th style="min-width:150px;">Category</th>
                    <th style="min-width:100px;">Units Sold</th>
                    <th style="min-width:120px;">Revenue</th>
                    <th style="min-width:90px;">Stock</th>
                    <th style="min-width:90px;">Trend</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<div class="row g-3">
    <div class="col-xl-6">
        <section class="listing-section common-box h-100">
            <div class="latest-orders">
                <div class="div-search-box-panel flex-ending-cls-here">
                    <h3 class="section-heading">Low Stock</h3>
                    <a asp-controller="Inventory" asp-action="Index" asp-route-filter="lowstock" class="custom_button secondary_button">Manage</a>
                </div>
            </div>
            <div class="table-main">
                <table class="custom-datatable listing-order-table" id="low-stock-grid">
                    <thead>
                        <tr>
                            <th style="min-width:60px;">Image</th>
                            <th style="min-width:180px;">Product</th>
                            <th style="min-width:110px;">SKU</th>
                            <th style="min-width:90px;">Current</th>
                            <th style="min-width:90px;">Minimum</th>
                            <th style="min-width:140px;">Warehouse</th>
                            <th style="min-width:90px;">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-xl-6">
        <section class="listing-section common-box h-100">
            <div class="latest-orders">
                <div class="div-search-box-panel flex-ending-cls-here">
                    <h3 class="section-heading">Out of Stock</h3>
                    <a asp-controller="Inventory" asp-action="Index" asp-route-filter="outofstock" class="custom_button secondary_button">Restock</a>
                </div>
            </div>
            <div class="table-main">
                <table class="custom-datatable listing-order-table" id="out-of-stock-grid">
                    <thead>
                        <tr>
                            <th style="min-width:60px;">Image</th>
                            <th style="min-width:180px;">Product</th>
                            <th style="min-width:110px;">SKU</th>
                            <th style="min-width:140px;">Category</th>
                            <th style="min-width:120px;">Last Sold</th>
                            <th style="min-width:140px;">Supplier</th>
                            <th style="min-width:90px;">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<!-- ================= RECENT ORDERS ================= -->
<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <h3 class="section-heading">Recent Orders</h3>
            <a asp-controller="Order" asp-action="Index" class="custom_button primary_button">All Orders</a>
        </div>
    </div>
    <div class="table-main">
        <table class="custom-datatable listing-order-table" id="recent-orders-grid">
            <thead>
                <tr>
                    <th style="min-width:130px;">Order No</th>
                    <th style="min-width:180px;">Customer</th>
                    <th style="min-width:70px;">Items</th>
                    <th style="min-width:110px;">Amount</th>
                    <th style="min-width:130px;">Payment</th>
                    <th style="min-width:130px;">Order Status</th>
                    <th style="min-width:130px;">Delivery</th>
                    <th style="min-width:120px;">Date</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<!-- ================= LATEST CUSTOMERS + NOTIFICATIONS ================= -->
<div class="row g-3">
    <div class="col-xl-7">
        <section class="listing-section common-box h-100">
            <div class="latest-orders">
                <div class="div-search-box-panel flex-ending-cls-here">
                    <h3 class="section-heading">Latest Customers</h3>
                    <a asp-controller="Customer" asp-action="Index" class="custom_button secondary_button">View All</a>
                </div>
            </div>
            <div class="table-main">
                <table class="custom-datatable listing-order-table" id="latest-customers-grid">
                    <thead>
                        <tr>
                            <th style="min-width:60px;">Photo</th>
                            <th style="min-width:180px;">Customer</th>
                            <th style="min-width:200px;">Email</th>
                            <th style="min-width:130px;">Mobile</th>
                            <th style="min-width:90px;">Orders</th>
                            <th style="min-width:120px;">Joined</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-xl-5">
        <section class="form-section h-100">
            <div class="form-section-header d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-bell" style="color:var(--accent);margin-right:8px;"></i>Latest Notifications</h2>
                <a asp-controller="Notification" asp-action="Index" style="font-size:.8rem;">View all</a>
            </div>
            <div class="form-section-body">
                <div id="dashboard-notifications">
                    <div class="text-center py-4 text-muted" style="font-size:.85rem;">No notifications</div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- ================= WEBSITE ANALYTICS ================= -->
<section class="form-section">
    <div class="form-section-header">
        <h2><i class="fas fa-chart-simple" style="color:var(--accent);margin-right:8px;"></i>Website Analytics</h2>
    </div>
    <div class="form-section-body">
        <div class="row g-3">
            @{
                var analytics = new[]
                {
                    "Today's Visitors", "Monthly Visitors", "Returning Visitors", "New Visitors",
                    "Page Views", "Bounce Rate", "Conversion Rate", "Average Session"
                };
            }
            @foreach (var a in analytics)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="status-card">
                        <span class="status-count">0</span>
                        <span class="status-label">@a</span>
                    </div>
                </div>
            }
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-4">
                <h4 class="section-heading">Top Pages</h4>
                <ul class="simple-list" id="topPages"><li class="text-muted">No data</li></ul>
            </div>
            <div class="col-lg-4">
                <h4 class="section-heading">Top Products Viewed</h4>
                <ul class="simple-list" id="topProducts"><li class="text-muted">No data</li></ul>
            </div>
            <div class="col-lg-4">
                <h4 class="section-heading">Top Search Keywords</h4>
                <ul class="simple-list" id="topKeywords"><li class="text-muted">No data</li></ul>
            </div>
        </div>
    </div>
</section>

<!-- ================= QUICK ACTIONS ================= -->
<section class="form-section">
    <div class="form-section-header">
        <h2><i class="fas fa-bolt" style="color:var(--accent);margin-right:8px;"></i>Quick Actions</h2>
    </div>
    <div class="form-section-body">
        <div class="quick-actions">
            <a asp-controller="Product" asp-action="Add" class="custom_button primary_button"><i class="fas fa-plus"></i> Add Product</a>
            <a asp-controller="Category" asp-action="Add" class="custom_button secondary_button"><i class="fas fa-plus"></i> Add Category</a>
            <a asp-controller="Coupon" asp-action="Add" class="custom_button secondary_button"><i class="fas fa-ticket"></i> Create Coupon</a>
            <a asp-controller="Offer" asp-action="Add" class="custom_button secondary_button"><i class="fas fa-gift"></i> Create Offer</a>
            <a asp-controller="Banner" asp-action="Add" class="custom_button secondary_button"><i class="fas fa-image"></i> Create Banner</a>
            <a asp-controller="Order" asp-action="Index" class="custom_button secondary_button"><i class="fas fa-receipt"></i> View Orders</a>
            <a asp-controller="Customer" asp-action="Index" class="custom_button secondary_button"><i class="fas fa-users"></i> View Customers</a>
            <a asp-controller="Inventory" asp-action="Index" class="custom_button secondary_button"><i class="fas fa-boxes-stacked"></i> Manage Inventory</a>
            <a asp-controller="Report" asp-action="Index" class="custom_button secondary_button"><i class="fas fa-chart-line"></i> Generate Report</a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Dashboard"); }

            $('#dashDateRange').on('change', function () {
                var isCustom = $(this).val() === 'custom';
                $('#dashCustomFrom, #dashCustomTo').toggle(isCustom);
                if (!isCustom) { refreshDashboard(); }
            });

            initCharts();
        });

        // Placeholder series. Replaced by the Dashboard API payload once wired.
        function initCharts() {
            var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var zero = months.map(function () { return 0; });

            var salesEl = document.getElementById('salesChart');
            if (salesEl && window.Chart) {
                new Chart(salesEl, {
                    type: 'line',
                    data: {
                        labels: months,
                        datasets: [
                            { label: 'Sales', data: zero, borderColor: '#6B2C2C', backgroundColor: 'rgba(107,44,44,.12)', fill: true, tension: .35 },
                            { label: 'Revenue', data: zero, borderColor: '#06b6d4', backgroundColor: 'rgba(6,182,212,.10)', fill: true, tension: .35 },
                            { label: 'Profit', data: zero, borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,.10)', fill: true, tension: .35 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }

            var revEl = document.getElementById('revenueChart');
            if (revEl && window.Chart) {
                new Chart(revEl, {
                    type: 'doughnut',
                    data: {
                        labels: ['Revenue', 'Expenses', 'Profit', 'Tax'],
                        datasets: [{
                            data: [0, 0, 0, 0],
                            backgroundColor: ['#6B2C2C', '#f59e0b', '#22c55e', '#8b5cf6']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        }

        function refreshDashboard() {
            // Wired to the Dashboard API in the controller step.
        }

        function exportDashboard(format) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage('Export (' + format + ') will be wired with the Dashboard API.');
            }
        }
    </script>
}
