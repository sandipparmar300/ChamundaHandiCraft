@model CampaignGridItem
@{
    ViewData["Title"] = "Campaign Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Campaign" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Campaign Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Campaign" asp-action="Index" class="links">Campaigns Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Campaign Information</h2>
            <a asp-controller="Campaign" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Campaign Name</label>
                        <p class="detail-value">@Model.Name</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Channel</label>
                        <p class="detail-value">@Model.Channel</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Audience</label>
                        <p class="detail-value">@(Model.SegmentName ?? "All subscribers")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Subject</label>
                        <p class="detail-value">@Model.Subject</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">From Name</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reply To</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Scheduled On</label>
                        <p class="detail-value">@(Model.ScheduledOn is null ? "—" : Money.DateAndTime(Model.ScheduledOn.Value))</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Sent</label>
                        <p class="detail-value">@Model.Recipients</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Delivered</label>
                        <p class="detail-value">@Model.Delivered</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Opens</label>
                        <p class="detail-value">@Model.Opened (@Model.OpenRate%)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Clicks</label>
                        <p class="detail-value">@Model.Clicked (@Model.ClickRate%)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Unsubscribes</label>
                        <p class="detail-value">@Model.Unsubscribed</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Bounces</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@Model.Status</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Newsletter"); }
        });
    </script>
}
