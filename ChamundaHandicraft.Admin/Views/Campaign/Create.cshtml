@{
    ViewData["Title"] = "Campaign";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Campaign" : "Add Campaign";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Campaign" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Campaign" asp-action="Index" class="links">Campaigns Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="campaignForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-bullhorn" style="color:var(--accent);margin-right:8px;"></i>Campaign Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Campaign Name <span class="req">*</span></label>
                        <input id="CampaignName" name="CampaignName" class="form-control-custom" placeholder="Enter campaign name" />
                        <span class="error-msg" data-valmsg-for="CampaignName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Channel <span class="req">*</span></label>
                        <select id="Channel" name="Channel" class="form-control-custom select2-single">
                            <option value="">Select channel</option>
                            <option>Email</option>
                            <option>SMS</option>
                            <option>WhatsApp</option>
                            <option>Push</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Channel"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Audience <span class="req">*</span></label>
                        <select id="Audience" name="Audience" class="form-control-custom select2-single">
                            <option value="">Select audience</option>
                            <option>All Subscribers</option>
                            <option>Segment</option>
                            <option>List</option>
                            <option>Custom</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Audience"></span>
                    </div>

                    <div class="col-lg-8 col-md-6">
                        <label class="form-label-custom">Subject <span class="req">*</span></label>
                        <input id="Subject" name="Subject" class="form-control-custom" placeholder="Enter subject" />
                        <span class="error-msg" data-valmsg-for="Subject"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">From Name</label>
                        <input id="FromName" name="FromName" class="form-control-custom" placeholder="Enter from name" />
                        <span class="error-msg" data-valmsg-for="FromName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Reply To</label>
                        <input id="ReplyTo" name="ReplyTo" class="form-control-custom" placeholder="Enter reply to" />
                        <span class="error-msg" data-valmsg-for="ReplyTo"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Scheduled On</label>
                        <input type="datetime-local" id="ScheduledOn" name="ScheduledOn" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="ScheduledOn"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Content <span class="req">*</span></label>
                        <textarea id="Content" name="Content" class="form-control-custom" rows="3" placeholder="Enter content"></textarea>
                        <span class="error-msg" data-valmsg-for="Content"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Campaign" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Newsletter"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
