@model ShippingZoneGridItem
@{
    ViewData["Title"] = "Shipping Zone Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Shipping" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Shipping Zone Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Shipping" asp-action="Index" class="links">Shipping Zones Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Shipping Zone Information</h2>
            <a asp-controller="Shipping" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Zone Name</label>
                        <p class="detail-value">@Model.ZoneName</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Coverage Type</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Coverage Values</label>
                        <p class="detail-value">@Model.Coverage</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Rate Type</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Base Rate</label>
                        <p class="detail-value">@Money.Inr(Model.BaseRate)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Per Kg Rate</label>
                        <p class="detail-value">@Money.Inr(Model.PerKgRate)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Free Above</label>
                        <p class="detail-value">@Money.Inr(Model.FreeAboveAmount)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">COD Charges</label>
                        <p class="detail-value">@Money.Inr(Model.CodFee)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Handling Fee</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Delivery Days</label>
                        <p class="detail-value">@Model.StandardDays days</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Couriers</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@(Model.IsActive ? "Active" : "Inactive")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Shipping"); }
        });
    </script>
}
