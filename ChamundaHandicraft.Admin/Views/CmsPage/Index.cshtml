@model PagedResult<CmsPageGridItem>
@*
    Content - CMS Pages listing.  Spec: docs/Admin Flows/
*@
@{
    // Preview opens the customer site, which runs on its own host.
    var storefrontBase = Configuration["StorefrontBaseUrl"] ?? "https://localhost:7141";
    ViewData["Title"] = "CMS Pages";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">CMS Pages</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Content</li>
            <li>CMS Pages Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search page title or slug" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="CmsPage" asp-action="Add" class="custom_button primary_button">Add Page</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="cmspage-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:220px;">Page Title</th>
                    <th style="min-width:190px;">Slug</th>
                    <th style="min-width:150px;">Template</th>
                    <th style="min-width:140px;">Show In Footer</th>
                    <th style="min-width:150px;">Last Updated</th>
                    <th style="min-width:150px;">Updated By</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Edit" asp-route-id="@row.Id">@row.Title</a></td>
                        <td class="t-mono">@row.Slug</td>
                        <td>@row.Template</td>
                        <td>@await Html.PartialAsync("_YesNo", row.IsSystemPage)</td>
                        <td>@Money.LongDate(row.ModifiedOn ?? row.CreatedOn)</td>
                        <td>@(row.ModifiedBy ?? row.CreatedBy ?? "—")</td>
                        <td><span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">@row.Status</span></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="fas fa-pen"></i></a>
                            @if (row.IsActive)
                            {
                                <a href="@storefrontBase@row.StorefrontUrl" target="_blank" rel="noopener" title="Preview on the storefront" class="ms-2"><i class="fas fa-external-link-alt"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center py-4">No pages yet. <a asp-action="Add">Create the first one</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="cmspage-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this record?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-CmsPage"); }

            datatable = $('#cmspage-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#cmspage-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Page API.');
            }
        }
    </script>
}
