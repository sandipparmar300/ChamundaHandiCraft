@{
    ViewData["Title"] = "Country";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Country" : "Add Country";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Country" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Country" asp-action="Index" class="links">Countries Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="countryForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-globe" style="color:var(--accent);margin-right:8px;"></i>Country Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Flag</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="image" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Country Name <span class="req">*</span></label>
                        <input id="CountryName" name="CountryName" class="form-control-custom" placeholder="Enter country name" />
                        <span class="error-msg" data-valmsg-for="CountryName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">ISO Code <span class="req">*</span></label>
                        <input id="ISOCode" name="ISOCode" class="form-control-custom" placeholder="Enter iso code" />
                        <span class="error-msg" data-valmsg-for="ISOCode"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Dial Code</label>
                        <input id="DialCode" name="DialCode" class="form-control-custom" placeholder="Enter dial code" />
                        <span class="error-msg" data-valmsg-for="DialCode"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Currency</label>
                        <input id="Currency" name="Currency" class="form-control-custom" placeholder="Enter currency" />
                        <span class="error-msg" data-valmsg-for="Currency"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Description</label>
                        <textarea id="Description" name="Description" class="form-control-custom" rows="3" placeholder="Enter description"></textarea>
                        <span class="error-msg" data-valmsg-for="Description"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Country" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Master"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
