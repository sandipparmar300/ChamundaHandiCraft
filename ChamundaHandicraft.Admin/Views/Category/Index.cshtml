@model List<CategoryViewModel>
@*
    Module 04 - Category tree + detail split (L-09 in the spec).
    Spec: docs/Admin Flows/Category.txt
*@
@{
    // Preview opens the customer site, which runs on its own host.
    var storefrontBase = Configuration["StorefrontBaseUrl"] ?? "https://localhost:7141";
    ViewData["Title"] = "Categories";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Categories</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Catalog</li>
            <li>Category Tree</li>
        </ul>
    </div>
}

<div class="row g-3">

    <!-- ============ TREE ============ -->
    <div class="col-xl-4">
        <section class="listing-section common-box h-100">
            <div class="latest-orders">
                <div class="div-search-box-panel flex-ending-cls-here">
                    <div class="listing-search">
                        <div class="search-box">
                            <span class="search-icon">
                                <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                            </span>
                            <input placeholder="Search category" id="txtTreeSearch" onkeyup="filterTree(this)">
                        </div>
                    </div>
                    <a asp-controller="Category" asp-action="Add" class="custom_button primary_button">Add</a>
                </div>
            </div>

            <div class="p-3">
                <p class="text-muted" style="font-size:.78rem;">
                    Drag a node to re-parent or reorder. Depth is capped at three levels.
                </p>

                <ul class="category-tree" id="categoryTree">
                    @foreach (var parent in Model)
                    {
                        <li data-name="@parent.Name">
                            <a asp-action="Edit" asp-route-id="@parent.Id">@parent.Name</a>
                            <span class="text-muted">(@parent.ProductCount)</span>

                            @if (parent.Children.Any())
                            {
                                <ul>
                                    @foreach (var child in parent.Children)
                                    {
                                        <li data-name="@child.Name">
                                            <a asp-action="Edit" asp-route-id="@child.Id">@child.Name</a>
                                            <span class="text-muted">(@child.ProductCount)</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }

                    @if (!Model.Any())
                    {
                        <li class="tree-empty text-muted">No categories yet. Add the first one to start the tree.</li>
                    }
                </ul>
            </div>
        </section>
    </div>

    <!-- ============ DETAIL ============ -->
    <div class="col-xl-8">
        <section class="listing-section common-box h-100">
            <div class="latest-orders">
                <div class="div-search-box-panel flex-ending-cls-here">
                    <h3 class="section-heading">Products in selected category</h3>
                    <div class="d-flex gap-2">
                        <button type="button" class="custom_button secondary_button" onclick="reorderMode()">
                            <i class="fas fa-arrows-up-down-left-right"></i> Reorder
                        </button>
                        <a asp-controller="Product" asp-action="Index" class="custom_button secondary_button">All Products</a>
                    </div>
                </div>
            </div>

            <div class="table-main">
                <table id="category-products-grid" class="custom-datatable listing-order-table">
                    <thead>
                        <tr>
                            <th style="min-width:60px;">Image</th>
                            <th style="min-width:240px;">Category</th>
                            <th style="min-width:160px;">Slug</th>
                            <th style="min-width:160px;">Parent</th>
                            <th style="min-width:110px;">Products</th>
                            <th style="min-width:120px;">Sub-categories</th>
                            <th style="min-width:110px;">Status</th>
                            <th style="min-width:80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Children are indented under their parent, so the hierarchy the
                           mega menu renders stays readable in a flat grid. *@
                        @foreach (var parent in Model)
                        {
                            <tr>
                                <td><img src="@(parent.ImageUrl ?? "/assets/images/default-profile.png")" width="40" height="40" alt="@parent.Name" style="object-fit:cover;border-radius:6px" /></td>
                                <td><a asp-action="Edit" asp-route-id="@parent.Id"><strong>@parent.Name</strong></a></td>
                                <td class="t-mono">@parent.Slug</td>
                                <td class="text-muted">—</td>
                                <td class="text-end">@parent.ProductCount</td>
                                <td class="text-end">@parent.Children.Count</td>
                                <td>@await Html.PartialAsync("_StatusPill", true)</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@parent.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                    <a href="@storefrontBase@parent.Url" target="_blank" rel="noopener" title="Preview on the storefront" class="ms-2"><i class="fas fa-external-link-alt"></i></a>
                                </td>
                            </tr>

                            foreach (var child in parent.Children)
                            {
                                <tr>
                                    <td></td>
                                    <td style="padding-left:2rem">
                                        <i class="fas fa-level-up-alt fa-rotate-90 text-muted me-2"></i>
                                        <a asp-action="Edit" asp-route-id="@child.Id">@child.Name</a>
                                    </td>
                                    <td class="t-mono">@child.Slug</td>
                                    <td class="text-muted">@parent.Name</td>
                                    <td class="text-end">@child.ProductCount</td>
                                    <td class="text-end">—</td>
                                    <td>@await Html.PartialAsync("_StatusPill", true)</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@child.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                        <a href="@storefrontBase@child.Url" target="_blank" rel="noopener" title="Preview on the storefront" class="ms-2"><i class="fas fa-external-link-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        }

                        @if (!Model.Any())
                        {
                            <tr><td colspan="8" class="text-center py-4">No categories yet. <a asp-action="Add">Create the first one</a>.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Category"); }

            $('#category-products-grid').DataTable({
                paging: true, ordering: true, filter: false,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "Select a category to see its products" }
            });
        });

        function filterTree(ctrl) {
            var term = ($(ctrl).val() || '').toLowerCase();
            $('#categoryTree li[data-name]').each(function () {
                $(this).toggle(($(this).data('name') + '').toLowerCase().indexOf(term) > -1);
            });
        }

        function reorderMode() {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage('Drag-and-drop reordering will be wired with the Category API.');
            }
        }
    </script>
}
