@{
    ViewData["Title"] = "Category";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Category" : "Add Category";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Category" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Category" asp-action="Index" class="links">Category Tree</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="categoryForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-tags" style="color:var(--accent);margin-right:8px;"></i>Category Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Category Image</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="category" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Category Name <span class="req">*</span></label>
                        <input id="Name" name="Name" class="form-control-custom" placeholder="Enter category name" onkeyup="buildSlug()" />
                        <span class="error-msg" data-valmsg-for="Name"></span>
                    </div>

                    <div class="col-lg-5 col-md-6">
                        <label class="form-label-custom">Slug <span class="req">*</span></label>
                        <input id="Slug" name="Slug" class="form-control-custom" placeholder="auto-generated-from-name" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Parent Category</label>
                        <select id="ParentId" name="ParentId" class="form-control-custom select2-single">
                            <option value="">None (top level)</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Sort Order</label>
                        <input type="number" id="SortOrder" name="SortOrder" class="form-control-custom" placeholder="0" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Show in Menu</label>
                        <select id="ShowInMenu" name="ShowInMenu" class="form-control-custom">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label-custom">Description</label>
                        <textarea id="Description" name="Description" class="form-control-custom" rows="3" placeholder="Enter description"></textarea>
                    </div>

                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-magnifying-glass" style="color:var(--accent);margin-right:8px;"></i>SEO</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label class="form-label-custom">SEO Title</label>
                        <input id="SeoTitle" name="SeoTitle" class="form-control-custom" maxlength="60" />
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label-custom">Meta Keywords</label>
                        <input id="MetaKeywords" name="MetaKeywords" class="form-control-custom" placeholder="Comma separated" />
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">Meta Description</label>
                        <textarea id="MetaDescription" name="MetaDescription" class="form-control-custom" rows="2" maxlength="160"></textarea>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Category" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Category"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
            $('#Slug').on('input', function () { $(this).data('touched', true); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }

        function buildSlug() {
            if ($('#Slug').data('touched')) return;
            var name = $('#Name').val() || '';
            $('#Slug').val(name.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''));
        }
    </script>
}
