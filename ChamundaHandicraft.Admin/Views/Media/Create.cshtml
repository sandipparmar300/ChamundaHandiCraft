@model MediaGridItem
@{
    ViewData["Title"] = "Media File";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Media File" : "Add Media File";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Media" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Media" asp-action="Index" class="links">Media Library Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="mediaForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-cloud-arrow-up" style="color:var(--accent);margin-right:8px;"></i>Upload</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-custom">Files <span class="req">*</span></label>
                        <div class="upload-dropzone" id="mediaDropzone">
                            <i class="fas fa-cloud-arrow-up"></i>
                            <p>Drag and drop files here, or click to browse</p>
                            <span class="upload-note">JPG, PNG, WEBP, SVG, MP4, PDF &middot; max 25MB each</span>
                            <input type="file" id="MediaFiles" name="MediaFiles" multiple class="d-none" />
                        </div>
                        <div class="media-thumbs mt-3" id="mediaThumbs"></div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Folder <span class="req">*</span></label>
                        <select id="Folder" name="Folder" class="form-control-custom select2-single">
                            <option value="">Select folder</option>
                            <option>Products</option>
                            <option>Categories</option>
                            <option>Banners</option>
                            <option>Blog</option>
                            <option>CMS</option>
                            <option>Artisans</option>
                            <option>Misc</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Folder"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Title</label>
                        <input id="Title" name="Title" class="form-control-custom" placeholder="Enter title" />
                        <span class="error-msg" data-valmsg-for="Title"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Alt Text</label>
                        <input id="AltText" name="AltText" class="form-control-custom" placeholder="Enter alt text" / value="@Model.AltText" >
                        <span class="error-msg" data-valmsg-for="AltText"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Description</label>
                        <textarea id="Description" name="Description" class="form-control-custom" rows="3" placeholder="Enter description"></textarea>
                        <span class="error-msg" data-valmsg-for="Description"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Media" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Media"); }
            $('#mediaDropzone').click(function () { $('#MediaFiles').click(); });

            $('#MediaFiles').on('change', function () {
                var $wrap = $('#mediaThumbs');
                Array.prototype.forEach.call(this.files, function (f) {
                    if (!/^image\//.test(f.type)) {
                        $wrap.append('<div class="media-thumb d-flex align-items-center justify-content-center"><i class="fas fa-file"></i></div>');
                        return;
                    }
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $wrap.append('<div class="media-thumb"><img src="' + e.target.result + '" alt="' + f.name + '" />' +
                                     '<button type="button" class="thumb-remove" onclick="$(this).parent().remove()">&times;</button></div>');
                    };
                    reader.readAsDataURL(f);
                });
            });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}

