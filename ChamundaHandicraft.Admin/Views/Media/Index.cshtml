@model PagedResult<MediaGridItem>
@*
    Content - Media Library listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Media Library";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Media Library</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Content</li>
            <li>Media Library Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search file name or alt text" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Export')"><i class="fas fa-file-export"></i> Export</button>
                <a asp-controller="Media" asp-action="Add" class="custom_button primary_button">Add Media File</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="media-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:80px;">Preview</th>
                    <th style="min-width:260px;">File Name</th>
                    <th style="min-width:130px;">Type</th>
                    <th style="min-width:120px;">Size</th>
                    <th style="min-width:150px;">Dimensions</th>
                    <th style="min-width:200px;">Alt Text</th>
                    <th style="min-width:160px;">Used In</th>
                    <th style="min-width:150px;">Uploaded On</th>
                    <th style="min-width:150px;">Uploaded By</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td><img src="@(row.ThumbnailUrl ?? row.Url)" width="44" height="44" alt="@row.AltText" style="object-fit:cover;border-radius:4px" /></td>
                        <td>@row.FileName</td>
                        <td>@row.MediaType</td>
                        <td class="text-end">@row.SizeDisplay</td>
                        <td>@(row.Width is null ? "—" : row.Width + " x " + row.Height)</td>
                        @* An image with no alt text cannot be attached to a published product. *@
                        <td>
                            @if (row.IsMissingAltText)
                            {
                                <span class="badge bg-danger">Missing</span>
                            }
                            else
                            {
                                <span class="text-muted">@row.AltText</span>
                            }
                        </td>
                        <td class="text-end">@row.UsedInCount</td>
                        <td>@Money.LongDate(row.CreatedOn)</td>
                        <td>@(row.CreatedBy ?? "—")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="text-center py-4">Nothing in the library yet. <a asp-action="Add">Upload something</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="media-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this record?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Media"); }

            datatable = $('#media-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#media-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Media File API.');
            }
        }
    </script>
}
