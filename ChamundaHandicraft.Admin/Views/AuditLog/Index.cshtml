@model PagedResult<AuditLogGridItem>
@*
    Administration - Audit Log listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Audit Log";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Audit Log</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Administration</li>
            <li>Audit Log Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search user, module or record" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Export')"><i class="fas fa-file-export"></i> Export</button>

            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="auditlog-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:150px;">Date</th>
                    <th style="min-width:180px;">User</th>
                    <th style="min-width:150px;">Module</th>
                    <th style="min-width:150px;">Action</th>
                    <th style="min-width:200px;">Record</th>
                    <th style="min-width:320px;">Change Summary</th>
                    <th style="min-width:140px;">IP Address</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td>@Money.DateAndTime(row.PerformedOn)</td>
                        <td>@row.PerformedBy</td>
                        <td>@row.EntityType</td>
                        <td>@row.Action</td>
                        <td>@(row.EntityName ?? "—")</td>
                        <td class="text-muted">@(row.ChangeSummary ?? "—")</td>
                        <td class="t-mono">@(row.IpAddress ?? "—")</td>
                        <td><a asp-action="Details" asp-route-id="@row.Id" title="View"><i class="fas fa-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center py-4">No activity in this period.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AuditLog"); }

            datatable = $('#auditlog-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#auditlog-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Audit Entry API.');
            }
        }
    </script>
}
