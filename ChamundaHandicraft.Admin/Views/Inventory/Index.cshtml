@model PagedResult<StockGridItem>
@{
    ViewData["Title"] = "Inventory Management";
    var kpis = ViewBag.Kpis as InventoryKpiSummaryViewModel ?? new InventoryKpiSummaryViewModel();
    var warehouses = ViewBag.Warehouses as List<IdNamePair> ?? new List<IdNamePair>();
    int? selectedWh = ViewBag.SelectedWarehouse as int?;
    string? selectedStatus = ViewBag.SelectedStockStatus as string;
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Inventory Stock</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Inventory</li>
            <li>Stock Management</li>
        </ul>
    </div>
}

<!-- ================= KPI SUMMARY ================= -->
<section class="form-section mb-4">
    <div class="form-section-header">
        <h2><i class="fas fa-boxes" style="color:var(--accent);margin-right:8px;"></i>Inventory Snapshot</h2>
    </div>
    <div class="form-section-body">
        <div class="row g-3">
            <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                <div class="status-card">
                    <span class="status-count">@kpis.TotalSkus</span>
                    <span class="status-label">Total SKUs</span>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                <div class="status-card">
                    <span class="status-count text-success">@kpis.TotalOnHandUnits.ToString("N0")</span>
                    <span class="status-label">On Hand Units</span>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                <div class="status-card">
                    <span class="status-count text-primary">@Money.Inr(kpis.TotalValuation)</span>
                    <span class="status-label">Inventory Value</span>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                <div class="status-card">
                    <span class="status-count text-warning">@kpis.LowStockCount</span>
                    <span class="status-label">Low Stock SKUs</span>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                <div class="status-card">
                    <span class="status-count text-danger">@kpis.OutOfStockCount</span>
                    <span class="status-label">Out of Stock SKUs</span>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                <div class="status-card">
                    <span class="status-count text-secondary">@kpis.TotalReservedUnits</span>
                    <span class="status-label">Reserved (Orders)</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= STOCK LISTING ================= -->
<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
            <div class="d-flex align-items-center flex-wrap gap-2 flex-grow-1">
                <div class="listing-search" style="min-width: 280px; max-width: 360px;">
                    <div class="search-box">
                        <span class="search-icon">
                            <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                        </span>
                        <input placeholder="Search product name, SKU or barcode" id="txtSearch" value="@ViewData["Search"]" onkeyup="fnSearch(this, event);" autocomplete="off">
                        <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="@(string.IsNullOrEmpty(ViewData["Search"]?.ToString()) ? "display:none;" : "") cursor:pointer;">&#10006;</span>
                    </div>
                </div>

                <select id="filterWarehouse" class="form-control-custom" style="width: auto; min-width: 160px; height: 38px;" onchange="applyFilters()">
                    <option value="">All Warehouses</option>
                    @foreach (var wh in warehouses)
                    {
                        <option value="@wh.Id" selected="@(selectedWh == wh.Id ? "selected" : null)">@wh.Name</option>
                    }
                </select>

                <select id="filterStockStatus" class="form-control-custom" style="width: auto; min-width: 140px; height: 38px;" onchange="applyFilters()">
                    <option value="">All Statuses</option>
                    <option value="InStock" selected="@(selectedStatus == "InStock" ? "selected" : null)">In Stock</option>
                    <option value="LowStock" selected="@(selectedStatus == "LowStock" ? "selected" : null)">Low Stock</option>
                    <option value="OutOfStock" selected="@(selectedStatus == "OutOfStock" ? "selected" : null)">Out of Stock</option>
                    <option value="Reserved" selected="@(selectedStatus == "Reserved" ? "selected" : null)">Has Reserved</option>
                </select>
            </div>

            <div class="d-flex align-items-center flex-wrap gap-2">
                <a asp-controller="Inventory" asp-action="Add" class="custom_button primary_button text-nowrap">
                    <i class="fas fa-plus me-1"></i> Add Stock
                </a>
                <a asp-controller="StockAdjustment" asp-action="Add" class="custom_button secondary_button text-nowrap">
                    <i class="fas fa-sliders-h me-1"></i> Adjust
                </a>
                <a asp-controller="StockTransfer" asp-action="Add" class="custom_button secondary_button text-nowrap">
                    <i class="fas fa-exchange-alt me-1"></i> Transfer
                </a>
            </div>
        </div>
    </div>

    <div class="table-main mt-3">
        <table id="stock-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:220px;">Product Name</th>
                    <th style="min-width:130px;">SKU</th>
                    <th style="min-width:140px;">Warehouse</th>
                    <th style="min-width:90px;" class="text-end">On Hand</th>
                    <th style="min-width:90px;" class="text-end">Reserved</th>
                    <th style="min-width:90px;" class="text-end">Available</th>
                    <th style="min-width:80px;" class="text-end">Threshold</th>
                    <th style="min-width:100px;">Status</th>
                    <th style="min-width:100px; text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="stock-row-@row.Id">
                        <td>
                            <strong>@row.ProductName</strong>
                        </td>
                        <td><code>@row.Sku</code></td>
                        <td>@(row.WarehouseName ?? "—")</td>
                        <td class="text-end fw-bold">@row.OnHand</td>
                        <td class="text-end text-muted">@row.Reserved</td>
                        <td class="text-end fw-bold @(row.Available <= 0 ? "text-danger" : (row.Available <= row.LowStockThreshold ? "text-warning" : "text-success"))">
                            @row.Available
                        </td>
                        <td class="text-end">@row.LowStockThreshold</td>
                        <td>
                            @if (row.State == StockState.OutOfStock)
                            {
                                <span class="badge bg-danger font-12">Out of Stock</span>
                            }
                            else if (row.State == StockState.LowStock)
                            {
                                <span class="badge bg-warning text-dark font-12">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success font-12">In Stock</span>
                            }
                        </td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Details" asp-route-id="@row.Id" title="View Details" class="text-info"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit Stock" class="ms-2 text-primary"><i class="fas fa-pen"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteStock(@row.Id, '@Html.Raw(Html.Encode(row.ProductName))')" title="Delete" class="ms-2 text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@Html.AntiForgeryToken()

<div class="modal delete-common-modal common-modal" id="stock-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete stock record for <strong id="deleteStockName"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Stock records can be re-added anytime by raising a purchase, adjustment, or direct stock entry.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteStock()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }

            $('#stock-grid').DataTable({
                paging: true,
                ordering: true,
                filter: false,
                destroy: true,
                bLengthChange: false,
                pageLength: 25,
                scrollX: true,
                autoWidth: false,
                language: { emptyTable: "No stock positions recorded yet." }
            });
        });

        function fnSearch(ctrl, ev) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            var key = ev ? ev.keyCode : (window.event ? window.event.keyCode : null);
            if (key === 13) {
                applyFilters();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            applyFilters();
        }

        function applyFilters() {
            var search = $('#txtSearch').val() || '';
            var wh = $('#filterWarehouse').val() || '';
            var status = $('#filterStockStatus').val() || '';

            var url = '@Url.Action("Index", "Inventory")?search=' + encodeURIComponent(search);
            if (wh) url += '&warehouseId=' + encodeURIComponent(wh);
            if (status) url += '&stockStatus=' + encodeURIComponent(status);

            window.location.href = url;
        }

        function confirmDeleteStock(id, name) {
            deleteTargetId = id;
            $('#deleteStockName').text(name);
            $('#stock-delete-confirm-modal').modal('show');
        }

        function executeDeleteStock() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Inventory")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#stock-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');

                    if (res && res.success) {
                        $('#stock-row-' + deleteTargetId).fadeOut(350, function () { $(this).remove(); });
                        toastr.success(res.message || 'Stock record deleted successfully.', 'Deleted');
                        setTimeout(function () { location.reload(); }, 600);
                    } else {
                        toastr.error((res && res.message) || 'Failed to delete stock record.', 'Error');
                    }
                },
                error: function () {
                    $('#stock-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');
                    toastr.error('A server error occurred while deleting the stock record.', 'Error');
                }
            });
        }
    </script>
}
