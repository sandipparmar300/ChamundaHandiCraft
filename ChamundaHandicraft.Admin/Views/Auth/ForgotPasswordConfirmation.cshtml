@{
    ViewData["Title"] = "Check Your Email";
    ViewData["WelcomeTitle"] = "Check Your Email";
    ViewData["WelcomeSubtitle"] = "We've sent password reset instructions";
    Layout = "_OuterLayout";
    var email = ViewData["Email"] as string ?? "your registered email";
}

<div class="confirmation-card">
    <div class="mail-icon-circle">
        <i class="fas fa-envelope-open-text"></i>
    </div>

    <h2 class="confirm-title">Reset Link Dispatched</h2>

    <p class="confirm-desc">
        We have generated a secure password reset link for:
    </p>

    <div class="email-display-chip">
        <i class="fas fa-envelope me-2" style="color: var(--brand-primary, #8E1F2F);"></i>@email
    </div>

    <p class="confirm-notice">
        Please check your inbox and click the reset link to choose a new password.<br>
        <span class="text-muted"><i class="fas fa-clock me-1"></i> The link is valid for <strong>60 minutes</strong>. Be sure to check your spam/junk folder.</span>
    </p>

    <a asp-controller="Auth" asp-action="Login" class="custom_button primary_button w-100 mb-3">
        <i class="fas fa-arrow-left me-2"></i> Back to Sign In
    </a>

    <div class="cooldown-text">
        <span>Didn't receive the email? </span>
        <form id="resendForm" asp-controller="Auth" asp-action="ForgotPassword" method="post" class="d-inline" style="display:inline!important;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@email" />
            <button type="submit" id="btnResend" disabled>
                Resend (<span id="countdown">60</span>s)
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var timeLeft = 60;
            var countdownEl = document.getElementById('countdown');
            var btnResend = document.getElementById('btnResend');

            var timer = setInterval(function () {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    btnResend.disabled = false;
                    btnResend.innerHTML = '<i class="fas fa-redo me-1"></i> Resend email';
                } else {
                    countdownEl.textContent = timeLeft;
                }
            }, 1000);

            $('#resendForm').on('submit', function () {
                btnResend.disabled = true;
                btnResend.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Resending...';
            });
        });
    </script>
}
