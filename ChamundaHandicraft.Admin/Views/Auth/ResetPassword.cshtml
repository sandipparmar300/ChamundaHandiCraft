@model ChamundaHandicraft.Helper.ViewModel.Admin.ResetPasswordRequest
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_OuterLayout";
}

<form id="resetForm" asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Token" />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.88rem;"></div>

    <div class="form-group">
        <label class="form-label-custom" asp-for="NewPassword">New Password <span class="req">*</span></label>
        <div class="password-box">
            <input asp-for="NewPassword" class="form-control form-control-custom" placeholder="Enter new password" required />
            <span class="toggle-password" onclick="togglePassword('NewPassword', 'newPwdIcon')" role="button" aria-label="Toggle password visibility"><i class="fas fa-eye" id="newPwdIcon"></i></span>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.82rem;"></span>
    </div>

    <div class="form-group">
        <label class="form-label-custom" asp-for="ConfirmPassword">Confirm Password <span class="req">*</span></label>
        <div class="password-box">
            <input asp-for="ConfirmPassword" class="form-control form-control-custom" placeholder="Re-enter new password" required />
            <span class="toggle-password" onclick="togglePassword('ConfirmPassword', 'confirmPwdIcon')" role="button" aria-label="Toggle password visibility"><i class="fas fa-eye" id="confirmPwdIcon"></i></span>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.82rem;"></span>
    </div>

    <ul class="simple-list mt-2" style="font-size:.78rem; list-style-type: disc; padding-left: 1.25rem;">
        <li><span>Minimum 8 characters</span></li>
        <li><span>At least one uppercase letter and one number</span></li>
        <li><span>At least one special character</span></li>
    </ul>

    <button type="submit" class="custom_button primary_button w-100 mt-3">Reset Password</button>

    <div class="text-center mt-3">
        <a asp-controller="Auth" asp-action="Login" class="links">Back to sign in</a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
        }
    </script>
}
