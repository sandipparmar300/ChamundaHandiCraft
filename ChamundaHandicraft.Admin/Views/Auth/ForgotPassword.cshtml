@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_OuterLayout";
}

<form id="forgotForm" method="post">

    <p class="text-muted mb-3">Enter the email on your account and we will send a reset link.</p>

    <div class="form-group">
        <label class="form-label-custom">Email <span class="req">*</span></label>
        <input type="email" id="Email" name="Email" class="form-control-custom" placeholder="Enter your email" />
        <span class="error-msg" data-valmsg-for="Email"></span>
    </div>

    <button type="submit" class="custom_button primary_button w-100 mt-3">Send Reset Link</button>

    <div class="text-center mt-3">
        <a asp-controller="Auth" asp-action="Login" class="links">Back to sign in</a>
    </div>

</form>
