@model ChamundaHandicraft.Helper.ViewModel.Admin.ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["WelcomeTitle"] = "Forgot Password?";
    ViewData["WelcomeSubtitle"] = "Enter your registered email and we will send you a reset link.";
    Layout = "_OuterLayout";
}

<form id="forgotForm" asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
    @Html.AntiForgeryToken()

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.88rem;"></div>

    <div class="form-group">
        <label class="form-label-custom" asp-for="Email">Email Address <span class="req">*</span></label>
        <input asp-for="Email" class="form-control form-control-custom" placeholder="Enter your registered email" type="email" autofocus required />
        <span asp-validation-for="Email" class="text-danger" style="font-size: 0.82rem;"></span>
    </div>

    <button type="submit" id="btnSendReset" class="custom_button primary_button w-100 mt-3">
        <span id="btnSendResetText"><i class="fas fa-paper-plane me-2"></i>Send Reset Link</span>
    </button>

    <div class="text-center mt-3">
        <a asp-controller="Auth" asp-action="Login" class="links"><i class="fas fa-arrow-left me-1"></i> Back to sign in</a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('#forgotForm').on('submit', function () {
                if ($(this).valid()) {
                    $('#btnSendReset').prop('disabled', true);
                    $('#btnSendResetText').html('<i class="fas fa-spinner fa-spin me-2"></i>Sending Reset Link...');
                }
            });
        });
    </script>
}
