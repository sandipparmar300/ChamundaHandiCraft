@model PagedResult<CustomerGridItem>
@*
    Module 02 - Customer list.  Spec: docs/Admin Flows/Users.txt (Sub Module 2)
*@
@{
    ViewData["Title"] = "Customers";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Customers</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>User Management</li>
            <li>Customer Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">

            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search by name, email, mobile or customer ID" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select id="filterStatus" class="form-control-custom" style="min-width:170px;">
                    <option value="">All Status</option>
                    <option>Active</option>
                    <option>Inactive</option>
                    <option>Pending Verification</option>
                    <option>Blocked</option>
                    <option>Suspended</option>
                </select>

                <select id="filterCountry" class="form-control-custom" style="min-width:150px;">
                    <option value="">All Countries</option>
                </select>

                <button type="button" class="custom_button secondary_button" onclick="exportGrid()">
                    <i class="fas fa-file-export"></i> Export
                </button>
            </div>

        </div>
    </div>

    <div class="table-main">
        <table id="customer-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:60px;">Photo</th>
                    <th style="min-width:120px;">Customer ID</th>
                    <th style="min-width:180px;">Name</th>
                    <th style="min-width:210px;">Email</th>
                    <th style="min-width:130px;">Mobile</th>
                    <th style="min-width:140px;">Registered</th>
                    <th style="min-width:110px;">Orders</th>
                    <th style="min-width:140px;">Total Purchase</th>
                    <th style="min-width:130px;">Reward Points</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:150px;">Last Login</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark">@(row.FullName.Length > 0 ? row.FullName.Substring(0, 1) : "?")</span></td>
                        <td>CUS-@row.Id</td>
                        <td><a asp-action="Details" asp-route-id="@row.Id">@row.FullName</a></td>
                        <td>
                            @row.Email
                            @if (row.EmailVerified)
                            {
                                <i class="fas fa-check-circle text-success ms-1" title="Verified"></i>
                            }
                        </td>
                        <td>
                            @(row.Phone ?? "—")
                            @if (row.MobileVerified)
                            {
                                <i class="fas fa-check-circle text-success ms-1" title="Verified"></i>
                            }
                        </td>
                        <td>@Money.LongDate(row.CreatedOn)</td>
                        <td class="text-end">@row.OrderCount</td>
                        <td class="text-end">@Money.Inr(row.LifetimeValue)</td>
                        <td class="text-end">@row.RewardPoints</td>
                        <td>
                            <span class="badge @(row.Status == CustomerStatus.Active ? "bg-success" : "bg-danger")">@row.Status</span>
                        </td>
                        <td>@(row.LastOrderOn is null ? "—" : Money.Relative(row.LastOrderOn.Value))</td>
                        <td><a asp-action="Details" asp-route-id="@row.Id" title="View"><i class="fas fa-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="12" class="text-center py-4">No customers match this filter.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<!-- Block / unblock -->
<div class="modal delete-common-modal common-modal" id="customer-block-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Block Customer</h3>
                <p>Blocking prevents login and new orders. Order history and reward points are preserved.</p>

                <div class="text-start mt-2">
                    <label class="form-label-custom">Reason <span class="req">*</span></label>
                    <textarea id="BlockReason" class="form-control-custom" rows="3" placeholder="Record the reason for blocking"></textarea>

                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="NotifyCustomer" />
                        <label class="form-check-label" for="NotifyCustomer">Notify the customer by email</label>
                    </div>
                </div>

                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="custom_button primary_button" data-bs-dismiss="modal">Block</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;
        let searchValue = "";

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Customer"); }

            datatable = $('#customer-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                order: [[5, "desc"]],
                language: { emptyTable: "No customers to show yet" },
                initComplete: function () {
                    const $w = $("#customer-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            searchValue = $(ctrl).val();
            $("#clearSearch").toggle(searchValue.length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            searchValue = "";
            if (datatable) datatable.draw();
        }

        function exportGrid() {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage('Export will be wired with the Customer API.');
            }
        }
    </script>
}
