@model ContactSubmissionGridItem
@{
    ViewData["Title"] = "Enquiry Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="ContactSubmission" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Enquiry Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="ContactSubmission" asp-action="Index" class="links">Contact Enquiries Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Enquiry Information</h2>

        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Name</label>
                        <p class="detail-value">@Model.Name</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Email</label>
                        <p class="detail-value">@Model.Email</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Mobile</label>
                        <p class="detail-value">@(Model.Phone ?? "—")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Subject</label>
                        <p class="detail-value">@Model.Subject</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Enquiry Type</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Message</label>
                        <p class="detail-value">@Model.Message</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Received On</label>
                        <p class="detail-value">@Money.DateAndTime(Model.SubmittedOn)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Assigned To</label>
                        <p class="detail-value">@(Model.HandledBy ?? "Unassigned")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Response</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Responded On</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@(Model.IsHandled ? "Handled" : "Awaiting reply")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-CmsPage"); }
        });
    </script>
}
