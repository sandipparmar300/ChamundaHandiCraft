@model SegmentGridItem
@{
    ViewData["Title"] = "Segment Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Segment" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@Model.Name</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Segment" asp-action="Index" class="links">Segments Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Segment Information</h2>
            <a asp-controller="Segment" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Segment Name</label>
                    <p class="detail-value">@Model.Name</p>
                </div>
                <div class="col-lg-6 col-md-6">
                    <label class="form-label-custom">Description</label>
                    <p class="detail-value">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Status</label>
                    <p class="detail-value"><partial name="_StatusPill" model="Model.IsActive" /></p>
                </div>

                <div class="col-lg-6 col-md-12">
                    <label class="form-label-custom">Membership Rule</label>
                    <p class="detail-value"><code>@Model.RuleSummary</code></p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Customers Matching</label>
                    <p class="detail-value">@Model.CustomerCount.ToString("N0")</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Last Evaluated</label>
                    <p class="detail-value">
                        @(Model.LastEvaluatedOn.HasValue ? Money.Relative(Model.LastEvaluatedOn.Value) : "Never")
                    </p>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Created</label>
                    <p class="detail-value">@Money.LongDate(Model.CreatedOn)</p>
                </div>
            </div>

            <p class="upload-note mt-3">
                The count is from the last evaluation, not this moment — a segment is
                recalculated on a schedule, so a campaign sent now reaches the customers
                who matched then.
            </p>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Customer"); }
        });
    </script>
}
