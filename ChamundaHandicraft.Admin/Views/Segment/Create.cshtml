@model SegmentGridItem
@{
    ViewData["Title"] = "Customer Segment";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Segment" : "Add Segment";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Segment" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Segment" asp-action="Index" class="links">Segment Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="segmentForm">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-pie-chart" style="color:var(--accent);margin-right:8px;"></i>Segment Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Segment Name <span class="req">*</span></label>
                        <input id="Name" name="Name" class="form-control-custom" placeholder="Enter segment name" / value="@Model.Name" >
                        <span class="error-msg" data-valmsg-for="Name"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Type</label>
                        <select id="Type" name="Type" class="form-control-custom select2-single">
                            <option value="dynamic" selected>Dynamic (rule based)</option>
                            <option value="static">Static (manual list)</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Description</label>
                        <input id="Description" name="Description" class="form-control-custom" placeholder="Enter description" / value="@Model.Description" >
                    </div>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-filter" style="color:var(--accent);margin-right:8px;"></i>Rules</h2>
            </div>

            <div class="form-section-body">
                <div id="ruleRows">
                    <div class="row g-3 rule-row">
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Field</label>
                            <select class="form-control-custom">
                                <option>Total Purchase</option>
                                <option>Total Orders</option>
                                <option>Reward Points</option>
                                <option>Registration Date</option>
                                <option>Last Login</option>
                                <option>Country</option>
                                <option>State</option>
                                <option>Status</option>
                            </select>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Operator</label>
                            <select class="form-control-custom">
                                <option>equals</option>
                                <option>not equals</option>
                                <option>greater than</option>
                                <option>less than</option>
                                <option>between</option>
                                <option>contains</option>
                            </select>
                        </div>

                        <div class="col-lg-4 col-md-8">
                            <label class="form-label-custom">Value</label>
                            <input class="form-control-custom" placeholder="Enter value" />
                        </div>

                        <div class="col-lg-2 col-md-4 d-flex align-items-end">
                            <button type="button" class="custom_button secondary_button w-100" onclick="removeRule(this)">Remove</button>
                        </div>
                    </div>
                </div>

                <button type="button" class="custom_button secondary_button mt-3" onclick="addRule()">
                    <i class="fas fa-plus"></i> Add Rule
                </button>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Segment" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Customer"); }
        });

        function addRule() {
            var $first = $('#ruleRows .rule-row').first();
            var $copy = $first.clone();
            $copy.find('input').val('');
            $('#ruleRows').append($copy);
        }

        function removeRule(btn) {
            if ($('#ruleRows .rule-row').length > 1) {
                $(btn).closest('.rule-row').remove();
            }
        }
    </script>
}
