@model IntegrationGridItem
@{
    ViewData["Title"] = "Integration Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Integration" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Integration Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Integration" asp-action="Index" class="links">Integrations Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Integration Information</h2>
            <a asp-controller="Integration" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Integration Name</label>
                        <p class="detail-value">@Model.Name</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Category</label>
                        <p class="detail-value">@Model.Category</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Environment</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">API Key</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Webhook URL</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Callback URL</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Last Sync</label>
                        <p class="detail-value">@(Model.LastSyncOn is null ? "Never" : Money.Relative(Model.LastSyncOn.Value))</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Health</label>
                        <p class="detail-value">@(Model.IsConnected ? "Healthy" : Model.ErrorMessage ?? "Disconnected")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Notes</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@(Model.IsActive ? "Active" : "Inactive")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Settings"); }
        });
    </script>
}
