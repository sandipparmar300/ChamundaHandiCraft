@model PagedResult<PurchaseOrderGridItem>
@*
    Inventory - Purchase Entries listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Purchase Entries";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Purchase Entries</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Inventory</li>
            <li>Purchase Entries Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search purchase or invoice number" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Export')"><i class="fas fa-file-export"></i> Export</button>
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Import')"><i class="fas fa-file-import"></i> Import</button>
                <a asp-controller="Purchase" asp-action="Add" class="custom_button primary_button">Add Purchase Entry</a>
            </div>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
    <div class="table-main">
        <table id="purchase-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:150px;">Purchase Number</th>
                    <th style="min-width:140px;">Purchase Date</th>
                    <th style="min-width:200px;">Supplier</th>
                    <th style="min-width:170px;">Warehouse</th>
                    <th style="min-width:150px;">Invoice Number</th>
                    <th style="min-width:110px;">Items</th>
                    <th style="min-width:130px;">Total Amount</th>
                    <th style="min-width:140px;">Payment Status</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:80px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="purchase-row-@row.Id">
                        <td class="t-mono"><a asp-action="Edit" asp-route-id="@row.Id">@row.PoNumber</a></td>
                        <td>@Money.LongDate(row.OrderedOn)</td>
                        <td>@row.SupplierName</td>
                        <td>@(row.WarehouseName ?? "—")</td>
                        <td>—</td>
                        <td class="text-end">@row.QuantityReceived / @row.QuantityOrdered</td>
                        <td class="text-end">@Money.Inr(row.TotalValue)</td>
                        <td>@await Html.PartialAsync("_YesNo", row.IsFullyReceived)</td>
                        <td><span class="badge bg-secondary">@row.Status</span></td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeletePurchase(@row.Id, '@Html.Raw(Html.Encode(row.PoNumber))')" title="Delete" class="text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="purchase-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete purchase order <strong id="deletePurchaseNumber"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeletePurchase()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }

            datatable = $('#purchase-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                dom: 'rtip',
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#purchase-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function confirmDeletePurchase(id, poNumber) {
            deleteTargetId = id;
            $('#deletePurchaseNumber').text(poNumber);
            $('#purchase-delete-confirm-modal').modal('show');
        }

        function executeDeletePurchase() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Purchase")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#purchase-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Purchase order deleted successfully.', 'Deleted');
                        const row = document.getElementById('purchase-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error((res && res.message) || 'Failed to delete purchase order.', 'Error');
                    }
                },
                error: function () {
                    $('#purchase-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');
                    toastr.error('A server error occurred while deleting the purchase order.', 'Error');
                }
            });
        }
    </script>
}
