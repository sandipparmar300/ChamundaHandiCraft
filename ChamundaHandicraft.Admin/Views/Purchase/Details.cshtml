@model ChamundaHandicraft.Helper.ViewModel.Admin.PurchaseOrderDetailViewModel
@{
    ViewData["Title"] = $"PO: {Model.PoNumber}";
    var canReceive = Model.Status != "Received" && Model.Status != "Cancelled";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Purchase" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Purchase Order Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Purchase" asp-action="Index" class="links">Purchase Orders</a></li>
            <li>@Model.PoNumber</li>
        </ul>
    </div>
}

<main class="page-content">
    <div class="row g-4">
        <!-- PO Overview -->
        <div class="col-lg-4 col-md-12">
            <div class="common-box p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="mb-0 fw-bold">@Model.PoNumber</h4>
                    <span class="badge @(Model.Status == "Received" ? "bg-success" : (Model.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")) fs-6">
                        @Model.Status
                    </span>
                </div>

                <hr class="my-3" />

                <div class="mb-2">
                    <span class="text-muted font-12 d-block">Supplier</span>
                    <strong>@Model.SupplierName</strong>
                    @if (!string.IsNullOrEmpty(Model.SupplierPhone))
                    {
                        <small class="text-muted d-block font-12">@Model.SupplierPhone</small>
                    }
                </div>

                <div class="mb-2">
                    <span class="text-muted font-12 d-block">Destination Warehouse</span>
                    <strong>@Model.WarehouseName</strong>
                </div>

                <div class="mb-2">
                    <span class="text-muted font-12 d-block">Order Date</span>
                    <span>@Model.OrderDate.ToString("dd MMM yyyy")</span>
                </div>

                <div class="mb-2">
                    <span class="text-muted font-12 d-block">Expected Delivery</span>
                    <span>@(Model.ExpectedDate?.ToString("dd MMM yyyy") ?? "—")</span>
                </div>

                <div class="mb-2">
                    <span class="text-muted font-12 d-block">Stock Progress</span>
                    <strong class="fs-6">@Model.QuantityReceived / @Model.QuantityOrdered units received</strong>
                </div>

                <hr class="my-3" />

                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted font-12">Sub Total</span>
                    <span>@Money.Inr(Model.SubTotal)</span>
                </div>

                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted font-12">Tax</span>
                    <span>@Money.Inr(Model.TaxAmount)</span>
                </div>

                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted font-12">Shipping</span>
                    <span>@Money.Inr(Model.ShippingAmount)</span>
                </div>

                <div class="d-flex justify-content-between mb-3 border-top pt-2">
                    <span class="fw-bold font-14">Grand Total</span>
                    <strong class="fs-5 text-primary">@Money.Inr(Model.TotalAmount)</strong>
                </div>

                <div class="d-grid gap-2">
                    @if (canReceive)
                    {
                        <form method="post" asp-action="Receive" asp-route-id="@Model.Id" onsubmit="return confirm('Confirm stock intake? This will immediately increment on-hand inventory at @Model.WarehouseName and post movements to the ledger.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="custom_button primary_button w-100 text-center">
                                <i class="fas fa-boxes me-1"></i> Receive Stock Into Warehouse
                            </button>
                        </form>

                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            <i class="fas fa-pen me-1"></i> Edit Order
                        </a>
                    }
                    else if (Model.Status == "Received")
                    {
                        <div class="alert alert-success py-2 font-12 text-center mb-0">
                            <i class="fas fa-check-circle me-1"></i> Stock has been received into inventory.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Line Items -->
        <div class="col-lg-8 col-md-12">
            <div class="common-box p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">
                    <i class="fas fa-list me-2" style="color:var(--accent);"></i>Order Line Items (@Model.Lines.Count items)
                </h5>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle font-13">
                        <thead class="table-light">
                            <tr>
                                <th>Product / SKU</th>
                                <th class="text-end">Ordered</th>
                                <th class="text-end">Received</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end">Tax (%)</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>
                                        <strong>@line.ProductName</strong>
                                        <small class="text-muted d-block">SKU: <code>@line.Sku</code></small>
                                    </td>
                                    <td class="text-end fw-bold">@line.QuantityOrdered</td>
                                    <td class="text-end @(line.IsFullyReceived ? "text-success fw-bold" : "text-muted")">
                                        @line.QuantityReceived
                                    </td>
                                    <td class="text-end">@Money.Inr(line.UnitCost)</td>
                                    <td class="text-end">@line.TaxPercent%</td>
                                    <td class="text-end fw-bold">@Money.Inr(line.LineTotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3 p-3 bg-light rounded">
                        <span class="text-muted font-12 d-block fw-bold">Notes / Instructions:</span>
                        <p class="mb-0 font-13">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
        });
    </script>
}
