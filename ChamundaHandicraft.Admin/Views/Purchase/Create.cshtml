@{
    ViewData["Title"] = "Purchase Entry";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Purchase Entry" : "Add Purchase Entry";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Purchase" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Purchase" asp-action="Index" class="links">Purchase Entries Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="purchaseForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-cart-plus" style="color:var(--accent);margin-right:8px;"></i>Purchase Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Purchase Number <span class="req">*</span></label>
                        <input id="PurchaseNumber" name="PurchaseNumber" class="form-control-custom" placeholder="Enter purchase number" />
                        <span class="error-msg" data-valmsg-for="PurchaseNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Purchase Date <span class="req">*</span></label>
                        <input type="date" id="PurchaseDate" name="PurchaseDate" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="PurchaseDate"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Supplier <span class="req">*</span></label>
                        <select id="Supplier" name="Supplier" class="form-control-custom select2-single">
                            <option value="">Select supplier</option>
                            <option>Select from master</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Supplier"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Warehouse <span class="req">*</span></label>
                        <select id="Warehouse" name="Warehouse" class="form-control-custom select2-single">
                            <option value="">Select warehouse</option>
                            <option>Select from master</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Warehouse"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Invoice Number</label>
                        <input id="InvoiceNumber" name="InvoiceNumber" class="form-control-custom" placeholder="Enter invoice number" />
                        <span class="error-msg" data-valmsg-for="InvoiceNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Payment Status</label>
                        <select id="PaymentStatus" name="PaymentStatus" class="form-control-custom select2-single">
                            <option value="">Select payment status</option>
                            <option>Unpaid</option>
                            <option>Partially Paid</option>
                            <option>Paid</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="PaymentStatus"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <select id="Status" name="Status" class="form-control-custom select2-single">
                            <option value="">Select status</option>
                            <option>Draft</option>
                            <option>Received</option>
                            <option>Approved</option>
                            <option>Cancelled</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Status"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-receipt" style="color:var(--accent);margin-right:8px;"></i>Totals</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Sub Total</label>
                        <input id="SubTotal" name="SubTotal" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" data-valmsg-for="SubTotal"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Discount</label>
                        <input id="Discount" name="Discount" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" data-valmsg-for="Discount"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">GST</label>
                        <input id="GST" name="GST" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" data-valmsg-for="GST"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Total Amount</label>
                        <input id="TotalAmount" name="TotalAmount" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" data-valmsg-for="TotalAmount"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Remarks</label>
                        <textarea id="Remarks" name="Remarks" class="form-control-custom" rows="3" placeholder="Enter remarks"></textarea>
                        <span class="error-msg" data-valmsg-for="Remarks"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Purchase" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
