@model PagedResult<PaymentGridItem>
@*
    Sales - Payments listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Payments";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Payments</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Sales</li>
            <li>Payments Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search transaction or order number" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Export')"><i class="fas fa-file-export"></i> Export</button>

            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="payment-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:170px;">Transaction ID</th>
                    <th style="min-width:150px;">Order Number</th>
                    <th style="min-width:200px;">Customer</th>
                    <th style="min-width:140px;">Gateway</th>
                    <th style="min-width:150px;">Payment Method</th>
                    <th style="min-width:130px;">Amount</th>
                    <th style="min-width:120px;">Fee</th>
                    <th style="min-width:140px;">Status</th>
                    <th style="min-width:150px;">Paid On</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td class="t-mono">@row.TransactionId</td>
                        <td><a asp-controller="Order" asp-action="Index">@row.OrderNumber</a></td>
                        <td>@row.CustomerName</td>
                        <td>@(row.GatewayName ?? "—")</td>
                        <td>@row.Method</td>
                        <td class="text-end">@Money.Inr(row.Amount)</td>
                        <td class="text-end">@Money.Inr(row.GatewayFee)</td>
                        <td>@await Html.PartialAsync("_PaymentStatusPill", row.Status)</td>
                        <td>@Money.LongDate(row.PaidOn)</td>
                        <td><a asp-action="Details" asp-route-id="@row.Id" title="View"><i class="fas fa-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="text-center py-4">No payments in this period.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Payment"); }

            datatable = $('#payment-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#payment-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Payment API.');
            }
        }
    </script>
}
