@model WarehouseGridItem
@{
    ViewData["Title"] = "Warehouse Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Warehouse" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Warehouse Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Warehouse" asp-action="Index" class="links">Warehouses Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Warehouse Information</h2>
            <a asp-controller="Warehouse" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Warehouse Code</label>
                        <p class="detail-value">@Model.Code</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Warehouse Name</label>
                        <p class="detail-value">@Model.WarehouseName</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Contact Person</label>
                        <p class="detail-value">@(Model.ContactPerson ?? "—")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Phone</label>
                        <p class="detail-value">@(Model.Phone ?? "—")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Email</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Address</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">City</label>
                        <p class="detail-value">@Model.City</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">State</label>
                        <p class="detail-value">@Model.State</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Country</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Postal Code</label>
                        <p class="detail-value">@Model.Pincode</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Total Products</label>
                        <p class="detail-value">@Model.SkuCount</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Stock Value</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Low Stock</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reserved Stock</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Pending Purchase</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@(Model.IsActive ? "Active" : "Inactive")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
        });
    </script>
}
