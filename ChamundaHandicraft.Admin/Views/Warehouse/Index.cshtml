@model PagedResult<WarehouseGridItem>
@*
    Inventory - Warehouses listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Warehouses";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Warehouses</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Inventory</li>
            <li>Warehouses Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search warehouse code or name" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Warehouse" asp-action="Add" class="custom_button primary_button">Add Warehouse</a>
            </div>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
    <div class="table-main">
        <table id="warehouse-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:140px;">Code</th>
                    <th style="min-width:200px;">Warehouse Name</th>
                    <th style="min-width:170px;">Contact Person</th>
                    <th style="min-width:130px;">Phone</th>
                    <th style="min-width:200px;">Email</th>
                    <th style="min-width:150px;">City</th>
                    <th style="min-width:130px;">State</th>
                    <th style="min-width:120px;">Products</th>
                    <th style="min-width:120px;">Stock Value</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:80px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="warehouse-row-@row.Id">
                        <td>@row.Code</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id">@row.WarehouseName</a>
                            @if (row.IsDefault)
                            {
                                <span class="badge bg-info ms-1">Default</span>
                            }
                        </td>
                        <td>@(row.ContactPerson ?? "—")</td>
                        <td>@(row.Phone ?? "—")</td>
                        <td>—</td>
                        <td>@row.City</td>
                        <td>@row.State</td>
                        <td class="text-end">
                            <a asp-controller="Inventory" asp-action="Index" asp-route-warehouseId="@row.Id" title="View Stock In Warehouse" class="badge bg-light text-primary border text-decoration-none">
                                @row.SkuCount
                            </a>
                        </td>
                        <td class="text-end">—</td>
                        <td>@await Html.PartialAsync("_StatusPill", row.IsActive)</td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a asp-controller="Inventory" asp-action="Index" asp-route-warehouseId="@row.Id" title="View Stock In Warehouse" class="text-secondary me-2"><i class="fas fa-boxes"></i></a>
                            @if (!row.IsDefault)
                            {
                                <a href="javascript:void(0);" onclick="confirmDeleteWarehouse(@row.Id, '@Html.Raw(Html.Encode(row.WarehouseName))')" title="Delete" class="text-danger"><i class="fas fa-trash-alt"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="warehouse-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete warehouse <strong id="deleteWarehouseName"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteWarehouse()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }

            datatable = $('#warehouse-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                dom: 'rtip',
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#warehouse-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function confirmDeleteWarehouse(id, name) {
            deleteTargetId = id;
            $('#deleteWarehouseName').text(name);
            $('#warehouse-delete-confirm-modal').modal('show');
        }

        function executeDeleteWarehouse() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Warehouse")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#warehouse-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Warehouse deleted successfully.', 'Deleted');
                        const row = document.getElementById('warehouse-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error((res && res.message) || 'Failed to delete warehouse.', 'Error');
                    }
                },
                error: function () {
                    $('#warehouse-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');
                    toastr.error('A server error occurred while deleting the warehouse.', 'Error');
                }
            });
        }
    </script>
}
