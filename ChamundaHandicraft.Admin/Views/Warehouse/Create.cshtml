@model ChamundaHandicraft.Helper.ViewModel.Admin.WarehouseSaveRequest
@{
    var isEdit = Model.Id > 0;
    var heading = isEdit ? "Edit Warehouse" : "Add Warehouse";
    ViewData["Title"] = heading;
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Warehouse" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Warehouse" asp-action="Index" class="links">Warehouses Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-action="Save" asp-controller="Warehouse" id="warehouseForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <!-- 1. WAREHOUSE BASIC INFO -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-warehouse" style="color:var(--accent);margin-right:8px;"></i>Warehouse Details</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="WarehouseName" class="form-label-custom">Warehouse Name <span class="req">*</span></label>
                        <input asp-for="WarehouseName" class="form-control-custom" placeholder="e.g. Central Distribution Hub" />
                        <span asp-validation-for="WarehouseName" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <label asp-for="Code" class="form-label-custom">Warehouse Code <span class="req">*</span></label>
                        <input asp-for="Code" class="form-control-custom" placeholder="e.g. WH-MAIN, WH-SURAT" style="text-transform:uppercase;" />
                        <span asp-validation-for="Code" class="text-danger font-12 mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. CONTACT PERSON -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-user" style="color:var(--accent);margin-right:8px;"></i>Contact Details</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="ContactPerson" class="form-label-custom">Contact Person</label>
                        <input asp-for="ContactPerson" class="form-control-custom" placeholder="e.g. Rajesh Sharma" />
                        <span asp-validation-for="ContactPerson" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="Phone" class="form-label-custom">Phone Number</label>
                        <input asp-for="Phone" class="form-control-custom" placeholder="e.g. +91 98765 43210" />
                        <span asp-validation-for="Phone" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="Email" class="form-label-custom">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control-custom" placeholder="e.g. warehouse@chamunda.com" />
                        <span asp-validation-for="Email" class="text-danger font-12 mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. LOCATION & ADDRESS -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-map-marker-alt" style="color:var(--accent);margin-right:8px;"></i>Location &amp; Address</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-12">
                        <label asp-for="AddressLine1" class="form-label-custom">Address Line 1</label>
                        <input asp-for="AddressLine1" class="form-control-custom" placeholder="Building, Street, Industrial Area" />
                        <span asp-validation-for="AddressLine1" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="City" class="form-label-custom">City</label>
                        <input asp-for="City" class="form-control-custom" placeholder="e.g. Ahmedabad" />
                        <span asp-validation-for="City" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="StateName" class="form-label-custom">State</label>
                        <input asp-for="StateName" class="form-control-custom" placeholder="e.g. Gujarat" />
                        <span asp-validation-for="StateName" class="text-danger font-12 mt-1 d-block"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="Pincode" class="form-label-custom">Pincode / Postal Code</label>
                        <input asp-for="Pincode" class="form-control-custom" placeholder="e.g. 380001" />
                        <span asp-validation-for="Pincode" class="text-danger font-12 mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. SETTINGS & OPTIONS -->
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-sliders-h" style="color:var(--accent);margin-right:8px;"></i>Configuration</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsDefault" id="IsDefault">
                            <label class="form-check-label fw-bold" for="IsDefault">
                                Set as Default Warehouse
                            </label>
                            <small class="text-muted d-block font-12">New items and incoming shipments default to this location unless specified.</small>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ACTION BAR -->
        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" asp-for="IsActive" id="IsActiveCheckbox" />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>

            <div>
                <a asp-controller="Warehouse" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
        });
    </script>
}
