@*
    Module 02 - Permission catalogue. Spec: docs/Admin Flows/Users.txt - Permission Management.

    One row per `module.entity.action` key — the same keys the API checks. Showing them
    grouped by module, for one role at a time, keeps the screen readable as the catalogue
    grows and matches how the backend actually evaluates a request.
*@
@model List<PermissionMatrixItem>
@{
    ViewData["Title"] = "Permissions";

    var roles = ViewData["Roles"] as List<IdNamePair> ?? new List<IdNamePair>();
    var roleId = ViewData["RoleId"] as int?;
    var roleName = roles.FirstOrDefault(r => r.Id == roleId)?.Name;

    var grouped = Model
        .GroupBy(p => p.Module)
        .OrderBy(g => g.Key)
        .ToList();

    var grantedCount = Model.Count(p => p.IsGranted);
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Permissions</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>User Management</li>
            <li>Permission Matrix</li>
            @if (!string.IsNullOrEmpty(roleName))
            {
                <li>@roleName</li>
            }
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search module or permission key" id="txtSearch" onkeyup="filterMatrix(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap align-items-center">
                <span class="text-muted" style="font-size:.8rem;">
                    @grantedCount of @Model.Count granted
                </span>
                <form method="get" asp-controller="Permission" asp-action="Index" id="roleForm">
                    <select name="roleId" class="form-control-custom" style="min-width:180px;"
                            onchange="document.getElementById('roleForm').submit();">
                        <option value="">Select a role&hellip;</option>
                        @foreach (var r in roles)
                        {
                            <option value="@r.Id" selected="@(r.Id == roleId)">@r.Name</option>
                        }
                    </select>
                </form>
                <a asp-controller="Role" asp-action="Index" class="custom_button primary_button">Manage Roles</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="permission-grid" class="custom-datatable listing-order-table permission-matrix">
            <thead>
                <tr>
                    <th style="min-width:150px;">Module</th>
                    <th style="min-width:220px;">Permission key</th>
                    <th style="min-width:280px;">What it allows</th>
                    <th style="min-width:110px;" class="text-center">Granted</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No permissions to show. Pick a role above.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var group in grouped)
                    {
                        var first = true;
                        @foreach (var p in group.OrderBy(x => x.Entity).ThenBy(x => x.Action))
                        {
                            <tr data-search="@($"{p.Module} {p.Key} {p.Description}".ToLowerInvariant())">
                                <td>
                                    @if (first)
                                    {
                                        <strong style="text-transform:capitalize;">@group.Key</strong>
                                        <div class="text-muted" style="font-size:.72rem;">@group.Count() keys</div>
                                        first = false;
                                    }
                                </td>
                                <td><code>@p.Key</code></td>
                                <td>@p.Description</td>
                                <td class="text-center">
                                    @if (p.IsGranted)
                                    {
                                        <span class="status-pill status-active">
                                            <i class="fas fa-check"></i> Granted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-inactive">
                                            <i class="fas fa-minus"></i> Denied
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }
        });

        function filterMatrix(ctrl) {
            var term = ($(ctrl).val() || '').toLowerCase();
            $("#clearSearch").toggle(term.length > 0);

            $('#permission-grid tbody tr').each(function () {
                var hay = $(this).data('search') || '';
                $(this).toggle(hay.indexOf(term) > -1);
            });
        }

        function clearSearch() {
            $('#txtSearch').val('');
            $('#clearSearch').hide();
            $('#permission-grid tbody tr').show();
        }
    </script>
}
