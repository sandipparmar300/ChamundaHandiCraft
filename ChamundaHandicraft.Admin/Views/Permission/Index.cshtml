@*
    Module 02 - Permission catalogue. Read-only view of every permission key
    and which roles hold it. Spec: docs/Admin Flows/Users.txt - Permission Management.
*@
@{
    ViewData["Title"] = "Permissions";

    var roles = new[]
    {
        "Super Admin", "Admin", "Product Manager", "Inventory Manager", "Sales Manager",
        "Customer Support", "Finance Manager", "Marketing Manager", "Content Manager"
    };

    var modules = new[]
    {
        "Dashboard", "Products", "Categories", "Inventory", "Orders", "Payments",
        "Shipping", "Customers", "Coupons", "Offers", "Banners", "CMS", "Blog",
        "Reviews", "Testimonials", "Newsletter", "Notifications", "Reports",
        "SEO", "Settings", "Users", "Media", "Support", "Audit"
    };
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Permissions</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>User Management</li>
            <li>Permission Matrix</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search module or permission key" id="txtSearch" onkeyup="filterMatrix(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select id="filterRole" class="form-control-custom" style="min-width:180px;">
                    <option value="">All Roles</option>
                    @foreach (var r in roles)
                    {
                        <option>@r</option>
                    }
                </select>
                <a asp-controller="Role" asp-action="Index" class="custom_button primary_button">Manage Roles</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="permission-grid" class="custom-datatable listing-order-table permission-matrix">
            <thead>
                <tr>
                    <th style="min-width:180px;">Module</th>
                    @foreach (var r in roles)
                    {
                        <th style="min-width:120px;" class="text-center">@r</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var m in modules)
                {
                    <tr data-module="@m.ToLowerInvariant()">
                        <td><strong>@m</strong></td>
                        @foreach (var r in roles)
                        {
                            <td class="text-center"><span class="text-muted">&mdash;</span></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AdminUser"); }
        });

        function filterMatrix(ctrl) {
            var term = ($(ctrl).val() || '').toLowerCase();
            $("#clearSearch").toggle(term.length > 0);

            $('#permission-grid tbody tr').each(function () {
                var m = $(this).data('module') || '';
                $(this).toggle(m.indexOf(term) > -1);
            });
        }

        function clearSearch() {
            $('#txtSearch').val('');
            $('#clearSearch').hide();
            $('#permission-grid tbody tr').show();
        }
    </script>
}
