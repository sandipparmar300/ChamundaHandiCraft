@model InvoiceGridItem
@{
    ViewData["Title"] = "Invoice Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Invoice" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Invoice Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Invoice" asp-action="Index" class="links">Invoices Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Invoice Information</h2>

        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Invoice Number</label>
                        <p class="detail-value">@Model.InvoiceNumber</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Invoice Date</label>
                        <p class="detail-value">@Money.LongDate(Model.InvoiceDate)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Order Number</label>
                        <p class="detail-value">@Model.OrderNumber</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Customer</label>
                        <p class="detail-value">@Model.CustomerName</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Billing Address</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Shipping Address</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Sub Total</label>
                        <p class="detail-value">@Money.Inr(Model.TaxableValue)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Discount</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Tax</label>
                        <p class="detail-value">@Money.Inr(Model.Cgst + Model.Sgst + Model.Igst)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Shipping Charges</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Total Amount</label>
                        <p class="detail-value">@Money.Inr(Model.Total)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Payment Status</label>
                        <p class="detail-value">Paid</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Order"); }
        });
    </script>
}
