@model PagedResult<DisputeGridItem>
@*
    Sales - Disputes listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Disputes";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Disputes</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Sales</li>
            <li>Disputes Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search dispute or order number" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Dispute" asp-action="Add" class="custom_button primary_button">Add Dispute</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="dispute-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:150px;">Dispute ID</th>
                    <th style="min-width:150px;">Order Number</th>
                    <th style="min-width:200px;">Customer</th>
                    <th style="min-width:140px;">Gateway</th>
                    <th style="min-width:130px;">Amount</th>
                    <th style="min-width:160px;">Reason</th>
                    <th style="min-width:140px;">Stage</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:150px;">Raised On</th>
                    <th style="min-width:140px;">Due By</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr class="@(row.IsUrgent ? "table-warning" : "")">
                        <td class="t-mono">@row.DisputeId</td>
                        <td>@row.OrderNumber</td>
                        <td>@row.CustomerName</td>
                        <td>Razorpay</td>
                        <td class="text-end">@Money.Inr(row.Amount)</td>
                        <td class="text-muted">@row.Reason</td>
                        <td>@row.Status</td>
                        <td><span class="badge bg-secondary">@row.Status</span></td>
                        <td>@Money.LongDate(row.RaisedOn)</td>
                        @* Missing the evidence window loses the money automatically. *@
                        <td>
                            @Money.LongDate(row.EvidenceDueOn)
                            @if (row.IsUrgent)
                            {
                                <span class="badge bg-danger ms-1">@row.DaysToRespond days left</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Respond"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="11" class="text-center py-4">No disputes. Long may it last.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="dispute-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this record?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Payment"); }

            datatable = $('#dispute-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#dispute-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Dispute API.');
            }
        }
    </script>
}
