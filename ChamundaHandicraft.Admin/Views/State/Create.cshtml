@{
    ViewData["Title"] = "State";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit State" : "Add State";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="State" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="State" asp-action="Index" class="links">States Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="stateForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-map" style="color:var(--accent);margin-right:8px;"></i>State Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">State Name <span class="req">*</span></label>
                        <input id="StateName" name="StateName" class="form-control-custom" placeholder="Enter state name" />
                        <span class="error-msg" data-valmsg-for="StateName"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Country <span class="req">*</span></label>
                        <select id="Country" name="Country" class="form-control-custom select2-single">
                            <option value="">Select country</option>
                            <option>Select country</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Country"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">State Code</label>
                        <input id="StateCode" name="StateCode" class="form-control-custom" placeholder="Enter state code" />
                        <span class="error-msg" data-valmsg-for="StateCode"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">GST Code</label>
                        <input id="GSTCode" name="GSTCode" class="form-control-custom" placeholder="Enter gst code" />
                        <span class="error-msg" data-valmsg-for="GSTCode"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Description</label>
                        <textarea id="Description" name="Description" class="form-control-custom" rows="3" placeholder="Enter description"></textarea>
                        <span class="error-msg" data-valmsg-for="Description"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="State" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Master"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
