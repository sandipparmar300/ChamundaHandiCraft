@model PagedResult<ProductGridItem>
@{
    ViewData["Title"] = "Products";
    var storefrontBase = Configuration["StorefrontBaseUrl"] ?? "https://localhost:7141";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Products</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Catalog</li>
            <li>Product Listing</li>
        </ul>
    </div>
}

@Html.AntiForgeryToken()

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">

            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search by name, SKU, barcode or code" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Product" asp-action="Add" class="custom_button primary_button">
                    <i class="fas fa-plus me-1"></i> Add Product
                </a>
            </div>

        </div>
    </div>

    <div class="table-main">
        <table id="product-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:60px;">Image</th>
                    <th style="min-width:220px;">Product Name</th>
                    <th style="min-width:120px;">SKU</th>
                    <th style="min-width:110px;">Code</th>
                    <th style="min-width:140px;">Category</th>
                    <th style="min-width:130px;">Brand</th>
                    <th style="min-width:110px;">Price</th>
                    <th style="min-width:90px;">Stock</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:110px;">Storefront</th>
                    <th style="min-width:120px;">Created</th>
                    <th style="min-width:120px; text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Items)
                {
                    <tr id="product-row-@product.Id">
                        <td>
                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/assets/images/default-profile.png" : product.ImageUrl)" 
                                 alt="@product.Name"
                                 style="width: 40px !important; height: 40px !important; min-width: 40px; min-height: 40px; max-width: 40px; max-height: 40px; aspect-ratio: 1/1; border-radius: 6px; object-fit: cover; display: block;" />
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="fw-semibold">@product.Name</a>
                            @if (product.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark ms-1" style="font-size:10px;"><i class="fas fa-star"></i> Featured</span>
                            }
                        </td>
                        <td><span class="text-monospace">@product.Sku</span></td>
                        <td><span class="text-muted">@product.ProductCode</span></td>
                        <td>@product.CategoryName</td>
                        <td>@(string.IsNullOrEmpty(product.BrandName) ? "—" : product.BrandName)</td>
                        <td class="fw-semibold">@Money.Inr(product.Price)</td>
                        <td>
                            @if (product.StockQuantity == 0)
                            {
                                <span class="badge bg-danger">Out of stock</span>
                            }
                            else if (product.StockQuantity <= 5)
                            {
                                <span class="badge bg-warning text-dark">@product.StockQuantity left</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">@product.StockQuantity in stock</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(product.Status == ProductStatus.Published ? "bg-success" : product.Status == ProductStatus.Draft ? "bg-secondary" : "bg-warning text-dark")">
                                @product.Status
                            </span>
                        </td>
                        <td>
                            @if (product.IsLiveOnStorefront)
                            {
                                <span class="badge bg-success">Live</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hidden</span>
                            }
                        </td>
                        <td>@Money.LongDate(product.CreatedOn)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@product.Id" title="Edit" class="text-primary">
                                <i class="fas fa-pen"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@product.Id" title="View Details" class="ms-2 text-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="javascript:void(0);" onclick="confirmDeleteProduct(@product.Id, '@Html.Raw(Html.Encode(product.Name))')" title="Delete" class="ms-2 text-danger">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                            <a href="@storefrontBase@product.StorefrontUrl" target="_blank"
                               rel="noopener" title="Preview on the storefront" class="ms-2 text-secondary">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </td>
                    </tr>
                }

                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="12" class="text-center py-4">
                            No products in catalogue yet.
                            <a asp-action="Add">Add the first one</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal delete-common-modal common-modal" id="product-delete-confirm-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Product</h3>
                <p>Are you sure you want to delete <strong id="deleteProductName"></strong>?</p>
                <p class="text-muted font-12">Products are soft deleted and stay preserved for previous order history and reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteProduct()">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Product"); }

            datatable = $('#product-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No products to show yet" },
                dom: 'rtip',
                initComplete: function () {
                    const $w = $("#product-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) {
                datatable.search(query).draw();
            }
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) {
                datatable.search('').draw();
            }
        }

        function confirmDeleteProduct(id, name) {
            deleteTargetId = id;
            $('#deleteProductName').text(name);
            $('#product-delete-confirm-modal').modal('show');
        }

        function executeDeleteProduct() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Product")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#product-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Product deleted successfully.', 'Deleted');
                        const row = document.getElementById('product-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error(res ? res.message : 'Failed to delete product.', 'Error');
                    }
                },
                error: function () {
                    $('#product-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');
                    toastr.error('An error occurred while deleting the product.', 'Error');
                }
            });
        }
    </script>
}
