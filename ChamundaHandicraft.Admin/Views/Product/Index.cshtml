@model PagedResult<ProductGridItem>
@*
    Module 03 - Product list.  Spec: docs/Admin Flows/Product.txt

    Bound to the same ProductGridItem the API returns. The "On Storefront" column and
    the Preview link are the visible half of the Admin -> Customer contract:
    docs/INTEGRATION-MAP.md §1.
*@
@{
    ViewData["Title"] = "Products";

    // Preview opens the customer site, which runs on its own host.
    var storefrontBase = Configuration["StorefrontBaseUrl"] ?? "https://localhost:7141";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Products</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Catalog</li>
            <li>Product Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">

            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search by name, SKU, barcode or product code" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                    <i class="fas fa-filter"></i> Filters
                </button>
                <button type="button" class="custom_button secondary_button" onclick="importProducts()"><i class="fas fa-file-import"></i> Import</button>
                <button type="button" class="custom_button secondary_button" onclick="exportGrid()"><i class="fas fa-file-export"></i> Export</button>
                <a asp-controller="Product" asp-action="Add" class="custom_button primary_button">Add Product</a>
            </div>

        </div>

        <!-- Advanced filters -->
        <div class="collapse" id="advancedFilters">
            <div class="row g-3 mt-1">
                @{
                    var filterSelects = new[]
                    {
                        "Category", "Subcategory", "Brand", "Material", "Color", "Size",
                        "Style", "Artisan", "Country", "Stock Status", "Published Status"
                    };
                }
                @foreach (var f in filterSelects)
                {
                    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                        <label class="form-label-custom">@f</label>
                        <select class="form-control-custom"><option value="">All</option></select>
                    </div>
                }

                <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                    <label class="form-label-custom">Price From</label>
                    <input class="form-control-custom" placeholder="0" />
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                    <label class="form-label-custom">Price To</label>
                    <input class="form-control-custom" placeholder="0" />
                </div>

                <div class="col-12 d-flex gap-2 flex-wrap">
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="fFeatured"><label class="form-check-label" for="fFeatured">Featured</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="fBestseller"><label class="form-check-label" for="fBestseller">Bestseller</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="fTrending"><label class="form-check-label" for="fTrending">Trending</label></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bulk action bar -->
    <div class="d-flex align-items-center gap-2 flex-wrap px-3 pb-2" id="bulkBar" style="display:none !important;">
        <span class="text-muted" style="font-size:.82rem;"><span id="bulkCount">0</span> selected</span>
        <select id="bulkAction" class="form-control-custom" style="max-width:220px;">
            <option value="">Bulk action</option>
            <option>Publish</option>
            <option>Unpublish</option>
            <option>Archive</option>
            <option>Delete</option>
            <option>Update Category</option>
            <option>Update Brand</option>
            <option>Update Price</option>
            <option>Update Discount</option>
            <option>Export</option>
        </select>
        <button type="button" class="custom_button primary_button" onclick="applyBulk()">Apply</button>
    </div>

    <div class="table-main">
        <table id="product-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:40px;"><input type="checkbox" id="checkAllRows" /></th>
                    <th style="min-width:60px;">Image</th>
                    <th style="min-width:220px;">Product Name</th>
                    <th style="min-width:120px;">SKU</th>
                    <th style="min-width:120px;">Product Code</th>
                    <th style="min-width:130px;">Barcode</th>
                    <th style="min-width:150px;">Category</th>
                    <th style="min-width:140px;">Brand</th>
                    <th style="min-width:110px;">Price</th>
                    <th style="min-width:110px;">Discount</th>
                    <th style="min-width:90px;">Stock</th>
                    <th style="min-width:120px;">Status</th>
                    <th style="min-width:110px;">Visibility</th>
                    @* One unambiguous answer to "can a shopper see this right now",
                       instead of asking the operator to combine Status and Visibility. *@
                    <th style="min-width:110px;">On Storefront</th>
                    <th style="min-width:100px;">Featured</th>
                    <th style="min-width:130px;">Created</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Items)
                {
                    <tr>
                        <td><input type="checkbox" class="row-check" value="@product.Id" /></td>
                        <td>
                            <img src="@product.ImageUrl" width="40" height="40" alt="@product.Name"
                                 style="border-radius:6px;object-fit:cover" />
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@product.Id">@product.Name</a>
                        </td>
                        <td>@product.Sku</td>
                        <td>@product.ProductCode</td>
                        <td>@(product.Barcode ?? "—")</td>
                        <td>@product.CategoryName</td>
                        <td>@(product.BrandName ?? "—")</td>
                        <td>@Money.Inr(product.Price)</td>
                        <td>@(product.DiscountPercent > 0 ? $"{product.DiscountPercent}% OFF" : "—")</td>
                        <td>
                            @if (product.StockQuantity == 0)
                            {
                                <span class="badge bg-danger">Out of stock</span>
                            }
                            else if (product.StockQuantity <= 5)
                            {
                                <span class="badge bg-warning text-dark">@product.StockQuantity left</span>
                            }
                            else
                            {
                                @product.StockQuantity
                            }
                        </td>
                        <td>@product.Status</td>
                        <td>@product.Visibility</td>
                        <td>
                            @if (product.IsLiveOnStorefront)
                            {
                                <span class="badge bg-success">Live</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hidden</span>
                            }
                        </td>
                        <td>@(product.IsFeatured ? "Yes" : "No")</td>
                        <td>@Money.LongDate(product.CreatedOn)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@product.Id" title="Edit">
                                <i class="fas fa-pen"></i>
                            </a>
                            @* Opens the exact page a shopper sees — the storefront half
                               of this record. *@
                            <a href="@storefrontBase@product.StorefrontUrl" target="_blank"
                               rel="noopener" title="Preview on the storefront" class="ms-2">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </td>
                    </tr>
                }

                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="17" class="text-center py-4">
                            No products match these filters.
                            <a asp-action="Add">Add the first one</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="product-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this product?</p>
                <p class="text-muted" style="font-size:.8rem;">Products are soft deleted and stay available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Product"); }

            datatable = $('#product-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                columnDefs: [{ targets: 0, orderable: false }],
                language: { emptyTable: "No products to show yet" },
                initComplete: function () {
                    const $w = $("#product-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });

            $('#checkAllRows').on('change', function () {
                $('#product-grid tbody .row-check').prop('checked', $(this).prop('checked'));
                syncBulkBar();
            });

            $(document).on('change', '.row-check', syncBulkBar);
        });

        function syncBulkBar() {
            var n = $('#product-grid tbody .row-check:checked').length;
            $('#bulkCount').text(n);
            $('#bulkBar').css('display', n > 0 ? 'flex' : 'none');
        }

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function exportGrid() {
            if (typeof showSuccessMessage === 'function') { showSuccessMessage('Export will be wired with the Product API.'); }
        }

        function importProducts() {
            if (typeof showSuccessMessage === 'function') { showSuccessMessage('Import will be wired with the Product API.'); }
        }

        function applyBulk() {
            var action = $('#bulkAction').val();
            if (!action) {
                if (typeof showErrorMessage === 'function') { showErrorMessage('Select a bulk action first.'); }
            }
        }
    </script>
}
