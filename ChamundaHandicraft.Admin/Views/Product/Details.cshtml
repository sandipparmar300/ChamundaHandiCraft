@model ProductSaveRequest
@{
    ViewData["Title"] = "Product Details";
    var lookups = ViewBag.Lookups as ProductLookupsViewModel ?? new ProductLookupsViewModel();
    var categoryName = lookups.Categories.FirstOrDefault(c => c.Id == Model.CategoryId)?.Name ?? $"Category #{Model.CategoryId}";
    var brandName = lookups.Brands.FirstOrDefault(b => b.Id == Model.BrandId)?.Name ?? (Model.BrandId.HasValue ? $"Brand #{Model.BrandId}" : "—");
    var artisanName = lookups.Artisans.FirstOrDefault(a => a.Id == Model.ArtisanId)?.Name ?? (Model.ArtisanId.HasValue ? $"Artisan #{Model.ArtisanId}" : "—");
    var primaryImage = Model.Media?.FirstOrDefault(m => m.IsPrimary)?.Url 
                       ?? Model.Media?.FirstOrDefault()?.Url 
                       ?? "/assets/images/default-profile.png";
    var storefrontBase = Configuration["StorefrontBaseUrl"] ?? "https://localhost:7141";
    var discountPercent = (Model.Mrp.HasValue && Model.Mrp.Value > Model.Price) 
        ? (int)Math.Round((Model.Mrp.Value - Model.Price) / Model.Mrp.Value * 100) 
        : 0;
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Product" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Product Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Product" asp-action="Index" class="links">Product Listing</a></li>
            <li>@Model.Name</li>
        </ul>
    </div>
}

<main class="page-content">

    <!-- Top Product Header Card -->
    <section class="form-section">
        <div class="form-section-body">
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <img src="@primaryImage" alt="@Model.Name" 
                     style="width:96px;height:96px;border-radius:12px;object-fit:cover;border:1px solid #e0e0e0;" />

                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <h3 class="mb-0 fw-bold">@Model.Name</h3>
                        <span class="badge @(Model.Status == ProductStatus.Published ? "bg-success" : "bg-secondary")">@Model.Status</span>
                        @if (Model.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark"><i class="fas fa-star me-1"></i> Featured</span>
                        }
                        @if (Model.IsBestseller)
                        {
                            <span class="badge bg-primary"><i class="fas fa-trophy me-1"></i> Bestseller</span>
                        }
                    </div>
                    <p class="text-muted mb-0" style="font-size:.88rem;">
                        <span class="fw-semibold text-dark">SKU:</span> @Model.Sku &middot;
                        <span class="fw-semibold text-dark">Code:</span> @Model.ProductCode &middot;
                        <span class="fw-semibold text-dark">Category:</span> @categoryName &middot;
                        <span class="fw-semibold text-dark">Brand:</span> @brandName &middot;
                        <span class="fw-semibold text-dark">Maker:</span> @artisanName
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Product" asp-action="Index" class="custom_button secondary_button">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button primary_button">
                        <i class="fas fa-pen me-1"></i> Edit Product
                    </a>
                    <a href="@storefrontBase/p/@Model.Slug" target="_blank" rel="noopener" class="custom_button secondary_button">
                        <i class="fas fa-external-link-alt me-1"></i> View on Storefront
                    </a>
                </div>
            </div>

            <!-- KPI Row -->
            <div class="row g-3 mt-3">
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <div class="status-card p-3 border rounded bg-white shadow-sm">
                        <span class="font-12 text-muted text-uppercase fw-semibold">Selling Price</span>
                        <h4 class="mt-1 mb-0 fw-bold text-success">@Money.Inr(Model.Price)</h4>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <div class="status-card p-3 border rounded bg-white shadow-sm">
                        <span class="font-12 text-muted text-uppercase fw-semibold">MRP / List Price</span>
                        <h4 class="mt-1 mb-0 fw-bold text-secondary">
                            @(Model.Mrp.HasValue ? Money.Inr(Model.Mrp.Value) : "—")
                            @if (discountPercent > 0)
                            {
                                <span class="badge bg-danger font-12 ms-1">@discountPercent% OFF</span>
                            }
                        </h4>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <div class="status-card p-3 border rounded bg-white shadow-sm">
                        <span class="font-12 text-muted text-uppercase fw-semibold">Cost Price</span>
                        <h4 class="mt-1 mb-0 fw-bold text-muted">
                            @(Model.CostPrice.HasValue ? Money.Inr(Model.CostPrice.Value) : "—")
                        </h4>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <div class="status-card p-3 border rounded bg-white shadow-sm">
                        <span class="font-12 text-muted text-uppercase fw-semibold">Variants Configured</span>
                        <h4 class="mt-1 mb-0 fw-bold text-primary">@(Model.Variants?.Count ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Detail Tabs -->
    <section class="form-section">
        <div class="form-section-body">

            <ul class="nav nav-tabs" id="productDetailTabs" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#d-general" type="button" role="tab"><i class="fas fa-info-circle me-1"></i> General &amp; Specifications</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-story" type="button" role="tab"><i class="fas fa-hands-holding-child me-1"></i> Craft Story</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-media" type="button" role="tab"><i class="fas fa-images me-1"></i> Gallery &amp; Media (@(Model.Media?.Count ?? 0))</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-variants" type="button" role="tab"><i class="fas fa-cubes me-1"></i> SKU Variants (@(Model.Variants?.Count ?? 0))</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-seo" type="button" role="tab"><i class="fas fa-globe me-1"></i> SEO Metadata</button></li>
            </ul>

            <div class="tab-content pt-3">

                <!-- 1. GENERAL TAB -->
                <div class="tab-pane fade show active" id="d-general" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Product Name</label>
                            <p class="detail-value fw-semibold">@Model.Name</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Product Code</label>
                            <p class="detail-value text-monospace">@Model.ProductCode</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">SKU</label>
                            <p class="detail-value text-monospace">@Model.Sku</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Barcode / EAN</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.Barcode) ? "—" : Model.Barcode)</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Category</label>
                            <p class="detail-value">@categoryName</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Brand / Studio</label>
                            <p class="detail-value">@brandName</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Artisan Maker</label>
                            <p class="detail-value">@artisanName</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Material</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.Material) ? "—" : Model.Material)</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Craft Technique</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.CraftTechnique) ? "—" : Model.CraftTechnique)</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Origin Cluster</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.OriginCluster) ? "—" : Model.OriginCluster)</p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Dimensions (L × W × H)</label>
                            <p class="detail-value">
                                @(Model.LengthCm?.ToString() ?? "—") × @(Model.WidthCm?.ToString() ?? "—") × @(Model.HeightCm?.ToString() ?? "—") cm
                            </p>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label-custom">Shipping Weight</label>
                            <p class="detail-value">@(Model.WeightGrams.HasValue ? $"{Model.WeightGrams} g" : "—")</p>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">Short Summary</label>
                            <p class="detail-value text-secondary">@(string.IsNullOrEmpty(Model.ShortDescription) ? "—" : Model.ShortDescription)</p>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">Full Description</label>
                            <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-line;">
                                @(string.IsNullOrEmpty(Model.FullDescription) ? "No detailed description provided." : Model.FullDescription)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. CRAFT STORY TAB -->
                <div class="tab-pane fade" id="d-story" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label-custom">Handmade Story &amp; Cultural Heritage</label>
                            <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-line; min-height: 100px;">
                                @(string.IsNullOrEmpty(Model.ProductStory) ? "No artisan story recorded for this product." : Model.ProductStory)
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label-custom">Care Instructions</label>
                            <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-line;">
                                @(string.IsNullOrEmpty(Model.CareInstructions) ? "Standard care instructions apply." : Model.CareInstructions)
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label-custom">Warranty &amp; Guarantee</label>
                            <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-line;">
                                @(string.IsNullOrEmpty(Model.WarrantyInformation) ? "Standard platform return policy applies." : Model.WarrantyInformation)
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                        {
                            <div class="col-12">
                                <label class="form-label-custom"><i class="fas fa-video text-danger me-1"></i> Making &amp; Craft Showcase Video</label>
                                <div class="p-3 bg-light rounded border d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas fa-play-circle text-danger font-20"></i>
                                        <span class="text-secondary fw-medium">@Model.VideoUrl</span>
                                    </div>
                                    <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer" class="custom_button secondary_button">
                                        <i class="fas fa-external-link-alt me-1"></i> Watch Video
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 3. MEDIA TAB -->
                <div class="tab-pane fade" id="d-media" role="tabpanel">
                    <div class="d-flex flex-wrap gap-3" id="detailThumbs">
                        @if (Model.Media != null && Model.Media.Any())
                        {
                            foreach (var item in Model.Media)
                            {
                                <div class="border rounded p-2 text-center bg-white shadow-sm" style="width: 150px;">
                                    <img src="@item.Url" alt="product media" 
                                         style="width: 130px; height: 130px; object-fit: cover; border-radius: 6px;" />
                                    <div class="mt-2">
                                        @if (item.IsPrimary)
                                        {
                                            <span class="badge bg-primary font-12">Primary</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border font-12">Gallery</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted py-4">No media uploaded for this product.</p>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                    {
                        <div class="mt-4 pt-3 border-top">
                            <label class="form-label-custom d-block"><i class="fas fa-video text-danger me-1"></i> Craft Showcase Video</label>
                            <div class="p-3 bg-light rounded border d-flex align-items-center justify-content-between flex-wrap gap-2" style="max-width: 650px;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; min-width: 40px;">
                                        <i class="fas fa-play"></i>
                                    </div>
                                    <div class="text-truncate" style="max-width: 420px;">
                                        <div class="fw-semibold text-truncate">@Model.VideoUrl</div>
                                        <small class="text-muted">Artisan craft process video</small>
                                    </div>
                                </div>
                                <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer" class="custom_button secondary_button">
                                    <i class="fas fa-external-link-alt me-1"></i> Watch Video
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <!-- 4. VARIANTS TAB -->
                <div class="tab-pane fade" id="d-variants" role="tabpanel">
                    <div class="table-main">
                        <table class="custom-datatable listing-order-table">
                            <thead>
                                <tr>
                                    <th style="min-width:180px;">Variant SKU</th>
                                    <th style="min-width:130px;">Selling Price</th>
                                    <th style="min-width:130px;">MRP</th>
                                    <th style="min-width:110px;">Stock Qty</th>
                                    <th style="min-width:100px;">Default</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Variants != null && Model.Variants.Any())
                                {
                                    foreach (var v in Model.Variants)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-monospace">@v.Sku</td>
                                            <td class="text-success fw-bold">@Money.Inr(v.Price)</td>
                                            <td class="text-muted">@(v.Mrp.HasValue ? Money.Inr(v.Mrp.Value) : "—")</td>
                                            <td>@v.StockQuantity</td>
                                            <td>
                                                @if (v.IsDefault)
                                                {
                                                    <span class="badge bg-success">Default SKU</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            This is a standalone single product with no variants.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 5. SEO TAB -->
                <div class="tab-pane fade" id="d-seo" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-lg-6 col-md-6">
                            <label class="form-label-custom">SEO Title</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.Seo?.MetaTitle) ? "—" : Model.Seo.MetaTitle)</p>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <label class="form-label-custom">Canonical URL</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.Seo?.CanonicalUrl) ? "—" : Model.Seo.CanonicalUrl)</p>
                        </div>
                        <div class="col-12">
                            <label class="form-label-custom">Meta Description</label>
                            <p class="detail-value text-secondary">@(string.IsNullOrEmpty(Model.Seo?.MetaDescription) ? "—" : Model.Seo.MetaDescription)</p>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <label class="form-label-custom">Meta Keywords</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.Seo?.MetaKeywords) ? "—" : Model.Seo.MetaKeywords)</p>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <label class="form-label-custom">Open Graph Title</label>
                            <p class="detail-value">@(string.IsNullOrEmpty(Model.Seo?.OgTitle) ? "—" : Model.Seo.OgTitle)</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Product"); }
        });
    </script>
}
