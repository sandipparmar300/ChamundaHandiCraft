@*
    Module 03 - Product detail (L-02 tabbed detail).
    Spec: docs/Admin Flows/Product.txt §3 row actions + §16 activity log.
*@
@{
    ViewData["Title"] = "Product Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Product" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Product Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Product" asp-action="Index" class="links">Product Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-body">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <img src="~/assets/images/default-profile.png" alt="product" style="width:88px;height:88px;border-radius:12px;object-fit:cover;" />

                <div class="flex-grow-1">
                    <h3 class="mb-1" id="pName">&mdash;</h3>
                    <p class="text-muted mb-0" style="font-size:.85rem;">
                        SKU <span id="pSku">&mdash;</span> &middot;
                        <span id="pCategory">&mdash;</span> &middot;
                        <span id="pBrand">&mdash;</span>
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Product" asp-action="Edit" asp-route-id="0" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
                    <button type="button" class="custom_button secondary_button"><i class="fas fa-copy"></i> Duplicate</button>
                    <button type="button" class="custom_button secondary_button"><i class="fas fa-eye"></i> Preview</button>
                    <button type="button" class="custom_button primary_button"><i class="fas fa-upload"></i> Publish</button>
                </div>
            </div>

            <div class="row g-3 mt-2">
                @foreach (var kpi in new[] { "Price", "Discount", "Stock", "Units Sold", "Revenue", "Reviews" })
                {
                    <div class="col-xl-2 col-lg-4 col-md-6">
                        <div class="status-card">
                            <span class="status-count">0</span>
                            <span class="status-label">@kpi</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section-body">

            <ul class="nav nav-tabs" id="productDetailTabs" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#d-general" type="button" role="tab">General</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-media" type="button" role="tab">Media</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-variants" type="button" role="tab">Variants</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-seo" type="button" role="tab">SEO</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#d-activity" type="button" role="tab">Activity History</button></li>
            </ul>

            <div class="tab-content pt-3">

                <div class="tab-pane fade show active" id="d-general" role="tabpanel">
                    <div class="row g-3">
                        @{
                            var generalFields = new[]
                            {
                                "Product Name", "Product Code", "SKU", "Barcode", "Slug",
                                "Category", "Subcategory", "Brand", "Material", "Artisan",
                                "Country of Origin", "Cost Price", "Selling Price", "MRP",
                                "GST Rate", "Stock Quantity", "Low Stock Threshold", "Warehouse",
                                "Status", "Visibility"
                            };
                        }
                        @foreach (var f in generalFields)
                        {
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label-custom">@f</label>
                                <p class="detail-value">&mdash;</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="d-media" role="tabpanel">
                    <div class="media-thumbs" id="detailThumbs">
                        <p class="text-muted" style="font-size:.85rem;">No media uploaded yet.</p>
                    </div>
                </div>

                <div class="tab-pane fade" id="d-variants" role="tabpanel">
                    <div class="table-main">
                        <table class="custom-datatable listing-order-table">
                            <thead>
                                <tr>
                                    <th style="min-width:180px;">Variant</th>
                                    <th style="min-width:130px;">SKU</th>
                                    <th style="min-width:130px;">Barcode</th>
                                    <th style="min-width:110px;">Price</th>
                                    <th style="min-width:100px;">Stock</th>
                                    <th style="min-width:110px;">Weight</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="d-seo" role="tabpanel">
                    <div class="row g-3">
                        @foreach (var f in new[] { "SEO Title", "Meta Description", "Meta Keywords", "Canonical URL", "Open Graph Title", "Twitter Card", "Image Alt Text" })
                        {
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label-custom">@f</label>
                                <p class="detail-value">&mdash;</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="d-activity" role="tabpanel">
                    <div class="table-main">
                        <table class="custom-datatable listing-order-table">
                            <thead>
                                <tr>
                                    <th style="min-width:150px;">Date</th>
                                    <th style="min-width:170px;">Action</th>
                                    <th style="min-width:160px;">Changed By</th>
                                    <th style="min-width:300px;">Details</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Product"); }

            $('#productDetailTabs button[data-bs-toggle="tab"]').on('shown.bs.tab', function () {
                $($(this).data('bs-target')).find('table.custom-datatable').each(function () {
                    if (!$.fn.DataTable.isDataTable(this)) {
                        $(this).DataTable({
                            paging: true, ordering: true, filter: false,
                            bLengthChange: false, pageLength: 10,
                            scrollX: true, autoWidth: false,
                            language: { emptyTable: "No records to show yet" }
                        });
                    }
                });
            });
        });
    </script>
}
