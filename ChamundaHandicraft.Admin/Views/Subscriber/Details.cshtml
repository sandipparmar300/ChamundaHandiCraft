@model SubscriberGridItem
@{
    ViewData["Title"] = "Subscriber Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Subscriber" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Subscriber Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Subscriber" asp-action="Index" class="links">Subscribers Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Subscriber Information</h2>
            <a asp-controller="Subscriber" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Email</label>
                        <p class="detail-value">@Model.Email</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Name</label>
                        <p class="detail-value">@(Model.Name ?? "—")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Source</label>
                        <p class="detail-value">@Model.Source</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Lists</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Subscribed On</label>
                        <p class="detail-value">@Money.LongDate(Model.SubscribedOn)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Last Emailed</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Opens</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Clicks</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Unsubscribed On</label>
                        <p class="detail-value">@(Model.UnsubscribedOn is null ? "—" : Money.LongDate(Model.UnsubscribedOn.Value))</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@(Model.IsSuppressed ? "Suppressed — " + Model.SuppressionReason : Model.IsActive ? "Subscribed" : "Unsubscribed")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Newsletter"); }
        });
    </script>
}
