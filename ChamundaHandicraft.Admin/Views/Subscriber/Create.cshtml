@{
    ViewData["Title"] = "Subscriber";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Subscriber" : "Add Subscriber";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Subscriber" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Subscriber" asp-action="Index" class="links">Subscribers Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="subscriberForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-envelope-open-text" style="color:var(--accent);margin-right:8px;"></i>Subscriber Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Email <span class="req">*</span></label>
                        <input id="Email" name="Email" class="form-control-custom" placeholder="Enter email" />
                        <span class="error-msg" data-valmsg-for="Email"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Name</label>
                        <input id="Name" name="Name" class="form-control-custom" placeholder="Enter name" />
                        <span class="error-msg" data-valmsg-for="Name"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Source</label>
                        <select id="Source" name="Source" class="form-control-custom select2-single">
                            <option value="">Select source</option>
                            <option>Footer Form</option>
                            <option>Checkout</option>
                            <option>Popup</option>
                            <option>Manual</option>
                            <option>Import</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Source"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <select id="Status" name="Status" class="form-control-custom select2-single">
                            <option value="">Select status</option>
                            <option>Subscribed</option>
                            <option>Unsubscribed</option>
                            <option>Bounced</option>
                            <option>Suppressed</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Status"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Lists</label>
                        <select id="Lists" name="Lists" class="form-control-custom select2-multiple" multiple>
                            <option>General</option>
                            <option>Offers</option>
                            <option>New Arrivals</option>
                            <option>Festival</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Lists"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Subscriber" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Newsletter"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
