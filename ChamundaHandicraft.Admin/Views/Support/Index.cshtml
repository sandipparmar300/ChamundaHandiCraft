@model PagedResult<SupportTicketGridItem>
@*
    Customers - Support Tickets listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Support Tickets";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Support Tickets</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Customers</li>
            <li>Support Tickets Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search ticket number, subject or customer" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Support" asp-action="Add" class="custom_button primary_button">Add Ticket</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="support-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:150px;">Ticket Number</th>
                    <th style="min-width:200px;">Customer</th>
                    <th style="min-width:240px;">Subject</th>
                    <th style="min-width:150px;">Category</th>
                    <th style="min-width:130px;">Priority</th>
                    <th style="min-width:170px;">Assigned To</th>
                    <th style="min-width:150px;">Created On</th>
                    <th style="min-width:150px;">Last Reply</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
@Html.AntiForgeryToken()
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="support-row-@row.Id" class="@(row.IsBreachingSla ? "table-warning" : "")">
                        <td class="t-mono"><a asp-action="Edit" asp-route-id="@row.Id">@row.TicketNumber</a></td>
                        <td>@(string.IsNullOrWhiteSpace(row.CustomerName) ? "Guest Customer" : row.CustomerName)</td>
                        <td>@row.Subject</td>
                        <td>@row.Topic</td>
                        <td>@row.Priority</td>
                        <td>@(row.AssignedTo ?? "Unassigned")</td>
                        <td>@Money.Relative(row.OpenedOn)</td>
                        <td>
                            @(row.LastReplyOn is null ? "No reply yet" : Money.Relative(row.LastReplyOn.Value))
                            @if (row.IsBreachingSla)
                            {
                                <span class="badge bg-danger ms-1">Overdue</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@row.Status</span></td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteSupport(@row.Id, '@Html.Raw(Html.Encode(row.TicketNumber))')" title="Delete" class="text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="text-center py-4">No open tickets. <a asp-action="Add">Create a ticket</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="support-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete ticket <strong id="deleteTicketNumber"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteSupport()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Support"); }

            datatable = $('#support-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                dom: 'rtip',
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#support-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) datatable.search(query).draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.search('').draw();
        }

        function confirmDeleteSupport(id, ticketNumber) {
            deleteTargetId = id;
            $('#deleteTicketNumber').text(ticketNumber);
            $('#support-delete-confirm-modal').modal('show');
        }

        function executeDeleteSupport() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Support")',
                type: 'POST',
                data: {
                    id: deleteTargetId,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#support-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');

                    if (res && res.success) {
                        toastr.success(res.message || 'Support ticket deleted successfully.', 'Deleted');
                        const row = document.getElementById('support-row-' + deleteTargetId);
                        if (row && datatable) {
                            datatable.row($(row)).remove().draw();
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        toastr.error((res && res.message) || 'Failed to delete support ticket.', 'Error');
                    }
                },
                error: function () {
                    $('#support-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('Delete');
                    toastr.error('A server error occurred while deleting the support ticket.', 'Error');
                }
            });
        }
    </script>
}
