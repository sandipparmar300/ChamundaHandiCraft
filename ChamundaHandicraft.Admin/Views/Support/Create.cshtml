@model SupportTicketGridItem
@{
    ViewData["Title"] = "Ticket";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Ticket" : "Add Ticket";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Support" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Support" asp-action="Index" class="links">Support Tickets Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-action="Save" asp-controller="Support" id="supportForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-headset" style="color:var(--accent);margin-right:8px;"></i>Ticket Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Ticket Number</label>
                        <input asp-for="TicketNumber" class="form-control-custom" placeholder="Auto-generated if left blank" />
                        <span class="error-msg" asp-validation-for="TicketNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Customer Name <span class="req">*</span></label>
                        <input asp-for="CustomerName" class="form-control-custom" placeholder="Enter customer name" required />
                        <span class="error-msg" asp-validation-for="CustomerName"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Customer Email</label>
                        <input asp-for="RequesterEmail" type="email" class="form-control-custom" placeholder="customer@example.com" />
                        <span class="error-msg" asp-validation-for="RequesterEmail"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Customer Phone</label>
                        <input asp-for="RequesterPhone" class="form-control-custom" placeholder="Phone number" />
                        <span class="error-msg" asp-validation-for="RequesterPhone"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Category <span class="req">*</span></label>
                        <select asp-for="Topic" class="form-control-custom select2-single">
                            <option value="Order Issue">Order Issue</option>
                            <option value="Payment Issue">Payment Issue</option>
                            <option value="Shipping Issue">Shipping Issue</option>
                            <option value="Product Query">Product Query</option>
                            <option value="Return Request">Return Request</option>
                            <option value="Account">Account</option>
                            <option value="General Query">General Query</option>
                            <option value="Other">Other</option>
                        </select>
                        <span class="error-msg" asp-validation-for="Topic"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Priority <span class="req">*</span></label>
                        <select asp-for="Priority" class="form-control-custom select2-single">
                            <option value="Low">Low</option>
                            <option value="Normal">Medium / Normal</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                        <span class="error-msg" asp-validation-for="Priority"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Assigned To</label>
                        <input asp-for="AssignedTo" class="form-control-custom" placeholder="Enter assigned agent or department" />
                        <span class="error-msg" asp-validation-for="AssignedTo"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Related Order</label>
                        <input asp-for="OrderNumber" class="form-control-custom" placeholder="e.g. ORD-1001" />
                        <span class="error-msg" asp-validation-for="OrderNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <select asp-for="Status" class="form-control-custom select2-single">
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.TicketStatus.Open)">Open</option>
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.TicketStatus.AwaitingCustomer)">Waiting on Customer</option>
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.TicketStatus.AwaitingAgent)">Awaiting Agent</option>
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.TicketStatus.Resolved)">Resolved</option>
                            <option value="@((int)ChamundaHandicraft.Helper.Enums.TicketStatus.Closed)">Closed</option>
                        </select>
                        <span class="error-msg" asp-validation-for="Status"></span>
                    </div>

                    <div class="col-lg-12 col-md-12">
                        <label class="form-label-custom">Subject <span class="req">*</span></label>
                        <input asp-for="Subject" class="form-control-custom" placeholder="Enter ticket subject" required />
                        <span class="error-msg" asp-validation-for="Subject"></span>
                    </div>

                    <div class="col-lg-12 col-md-12">
                        <label class="form-label-custom">Description <span class="req">*</span></label>
                        <textarea asp-for="Description" class="form-control-custom" rows="4" placeholder="Enter ticket description / details" required></textarea>
                        <span class="error-msg" asp-validation-for="Description"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" asp-for="IsActive" id="IsActiveCheckbox" />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>

            <div>
                <a asp-controller="Support" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Support"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
