@model PagedResult<BannerViewModel>
@*
    Marketing - Banners listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Banners";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Banners</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Marketing</li>
            <li>Banners Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search banner title" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Banner" asp-action="Add" class="custom_button primary_button">Add Banner</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="banner-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:90px;">Preview</th>
                    <th style="min-width:200px;">Title</th>
                    <th style="min-width:160px;">Placement</th>
                    <th style="min-width:150px;">Device</th>
                    <th style="min-width:140px;">Link Type</th>
                    <th style="min-width:140px;">Valid From</th>
                    <th style="min-width:140px;">Valid To</th>
                    <th style="min-width:120px;">Sort Order</th>
                    <th style="min-width:130px;">Clicks</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            @Html.AntiForgeryToken()
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr id="banner-row-@row.Id">
                        <td><img src="@row.ImageUrl" width="56" height="32" alt="@row.ImageAlt" style="object-fit:cover;border-radius:4px" /></td>
                        <td><a asp-action="Edit" asp-route-id="@row.Id">@row.Heading</a></td>
                        <td>@row.Placement</td>
                        <td>@(row.MobileImageUrl is null ? "Desktop only" : "Desktop + mobile")</td>
                        <td>@(row.PrimaryCtaUrl ?? "—")</td>
                        <td>—</td>
                        <td>—</td>
                        <td class="text-end">@row.SortOrder</td>
                        <td class="text-end">—</td>
                        @* A banner without alt text cannot publish — campaign text baked into an
                           image is invisible to a screen reader and untranslatable. *@
                        <td>
                            @if (string.IsNullOrWhiteSpace(row.ImageAlt))
                            {
                                <span class="badge bg-danger">Needs alt text</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Ready</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteBanner(@row.Id, '@Html.Raw(Html.Encode(row.Heading))')" title="Delete" class="text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="11" class="text-center py-4">No banners yet. <a asp-action="Add">Create the first one</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="banner-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete banner <strong id="deleteBannerTitle"></strong>?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" onclick="executeDeleteBanner()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;
        let deleteTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Banner"); }

            datatable = $('#banner-grid').DataTable({
                paging: true, ordering: true, filter: true, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                dom: 'rtip',
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#banner-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            const query = $(ctrl).val() || '';
            $("#clearSearch").toggle(query.length > 0);
            if (datatable) datatable.search(query).draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.search('').draw();
        }

        function confirmDeleteBanner(id, title) {
            deleteTargetId = id;
            $('#deleteBannerTitle').text(title);
            $('#banner-delete-confirm-modal').modal('show');
        }

        function executeDeleteBanner() {
            if (!deleteTargetId) return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btn-delete-yes');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Deleting...');

            $.ajax({
                url: '@Url.Action("Delete", "Banner")/' + deleteTargetId,
                type: 'POST',
                headers: { 'RequestVerificationToken': token },
                success: function (res) {
                    $('#banner-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).text('Delete');
                    if (res && res.success) {
                        if (typeof showSuccessMessage === 'function') {
                            showSuccessMessage(res.message || 'Banner deleted successfully.');
                        }
                        const $row = $('#banner-row-' + deleteTargetId);
                        if (datatable) {
                            datatable.row($row).remove().draw(false);
                        } else {
                            $row.fadeOut(300, function () { $(this).remove(); });
                        }
                        deleteTargetId = 0;
                    } else {
                        if (typeof showErrorMessage === 'function') {
                            showErrorMessage((res && res.message) || 'Failed to delete banner.');
                        }
                    }
                },
                error: function (xhr) {
                    $('#banner-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).text('Delete');
                    if (typeof showErrorMessage === 'function') {
                        showErrorMessage('An error occurred while deleting the banner.');
                    }
                }
            });
        }
    </script>
}
