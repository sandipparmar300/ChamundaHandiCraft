@model BannerSaveRequest
@{
    ViewData["Title"] = "Banner";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Banner" : "Add Banner";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Banner" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Banner" asp-action="Index" class="links">Banners Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" asp-action="Save" asp-controller="Banner" id="bannerForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-image" style="color:var(--accent);margin-right:8px;"></i>Banner Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Banner Image</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content("~/assets/images/default-profile.png") : Model.ImageUrl)" class="pic-preview clickable-img" alt="image" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Title <span class="req">*</span></label>
                        <input asp-for="Heading" class="form-control-custom" placeholder="Enter title" />
                        <span class="text-danger" asp-validation-for="Heading"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Subtitle</label>
                        <input asp-for="SubHeading" class="form-control-custom" placeholder="Enter subtitle" />
                        <span class="text-danger" asp-validation-for="SubHeading"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Placement <span class="req">*</span></label>
                        <select asp-for="Placement" class="form-control-custom select2-single">
                            <option value="">Select placement</option>
                            <option value="HomeHero">Home Hero</option>
                            <option value="HomeBand">Home Strip / Band</option>
                            <option value="CategoryTop">Category Top</option>
                            <option value="PlpInjection">Product Page / PLP</option>
                            <option value="CartUpsell">Cart</option>
                            <option value="AnnouncementBar">Announcement Bar</option>
                        </select>
                        <span class="text-danger" asp-validation-for="Placement"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Device</label>
                        <select asp-for="Device" class="form-control-custom select2-single">
                            <option value="">Select device</option>
                            <option value="All">All</option>
                            <option value="Desktop">Desktop</option>
                            <option value="Mobile">Mobile</option>
                            <option value="Tablet">Tablet</option>
                        </select>
                        <span class="text-danger" asp-validation-for="Device"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Link Type</label>
                        <select asp-for="LinkType" class="form-control-custom select2-single">
                            <option value="">Select link type</option>
                            <option value="None">None</option>
                            <option value="Product">Product</option>
                            <option value="Category">Category</option>
                            <option value="Collection">Collection</option>
                            <option value="External URL">External URL</option>
                            <option value="Offer">Offer</option>
                        </select>
                        <span class="text-danger" asp-validation-for="LinkType"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Link Target (URL)</label>
                        <input asp-for="PrimaryCtaUrl" class="form-control-custom" placeholder="Enter link target URL" />
                        <span class="text-danger" asp-validation-for="PrimaryCtaUrl"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Button Text</label>
                        <input asp-for="PrimaryCtaLabel" class="form-control-custom" placeholder="Enter button text" />
                        <span class="text-danger" asp-validation-for="PrimaryCtaLabel"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Alt Text <span class="req">*</span></label>
                        <input asp-for="ImageAlt" class="form-control-custom" placeholder="Enter alt text for accessibility" />
                        <span class="text-danger" asp-validation-for="ImageAlt"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Sort Order</label>
                        <input type="number" asp-for="SortOrder" class="form-control-custom" placeholder="0" />
                        <span class="text-danger" asp-validation-for="SortOrder"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-calendar-days" style="color:var(--accent);margin-right:8px;"></i>Schedule</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Valid From</label>
                        <input type="datetime-local" asp-for="ValidFrom" class="form-control-custom" value="@(Model.ValidFrom.HasValue ? Model.ValidFrom.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <span class="text-danger" asp-validation-for="ValidFrom"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Valid To</label>
                        <input type="datetime-local" asp-for="ValidTo" class="form-control-custom" value="@(Model.ValidTo.HasValue ? Model.ValidTo.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <span class="text-danger" asp-validation-for="ValidTo"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" asp-for="IsActive" id="IsActiveCheckbox" />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>

            <div>
                <a asp-controller="Banner" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Banner"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
            $('#IsActiveCheckbox').change(function () {
                $('#isActiveStatus').text(this.checked ? 'Active' : 'Inactive');
            });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
