@{
    ViewData["Title"] = "Banner";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Banner" : "Add Banner";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Banner" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Banner" asp-action="Index" class="links">Banners Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="bannerForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-image" style="color:var(--accent);margin-right:8px;"></i>Banner Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-12">
                        <label class="form-label-custom">Banner Image</label>
                        <div class="profile-pic-box" id="uploadBox">
                            <img id="ImagePreview" src="~/assets/images/default-profile.png" class="pic-preview clickable-img" alt="image" />
                            <label class="upload-btn-custom" for="Photo"><i class="fas fa-camera"></i> Upload</label>
                            <input type="file" id="Photo" name="Photo" accept="image/*" class="d-none" onchange="previewUpload(this)" />
                            <p class="upload-note">JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Title <span class="req">*</span></label>
                        <input id="Title" name="Title" class="form-control-custom" placeholder="Enter title" />
                        <span class="error-msg" data-valmsg-for="Title"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Subtitle</label>
                        <input id="Subtitle" name="Subtitle" class="form-control-custom" placeholder="Enter subtitle" />
                        <span class="error-msg" data-valmsg-for="Subtitle"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Placement <span class="req">*</span></label>
                        <select id="Placement" name="Placement" class="form-control-custom select2-single">
                            <option value="">Select placement</option>
                            <option>Home Hero</option>
                            <option>Home Strip</option>
                            <option>Category Top</option>
                            <option>Product Page</option>
                            <option>Cart</option>
                            <option>Checkout</option>
                            <option>Footer</option>
                            <option>Popup</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Placement"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Device</label>
                        <select id="Device" name="Device" class="form-control-custom select2-single">
                            <option value="">Select device</option>
                            <option>All</option>
                            <option>Desktop</option>
                            <option>Mobile</option>
                            <option>Tablet</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Device"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Link Type</label>
                        <select id="LinkType" name="LinkType" class="form-control-custom select2-single">
                            <option value="">Select link type</option>
                            <option>None</option>
                            <option>Product</option>
                            <option>Category</option>
                            <option>Collection</option>
                            <option>External URL</option>
                            <option>Offer</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="LinkType"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Link Target</label>
                        <input id="LinkTarget" name="LinkTarget" class="form-control-custom" placeholder="Enter link target" />
                        <span class="error-msg" data-valmsg-for="LinkTarget"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Button Text</label>
                        <input id="ButtonText" name="ButtonText" class="form-control-custom" placeholder="Enter button text" />
                        <span class="error-msg" data-valmsg-for="ButtonText"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Alt Text</label>
                        <input id="AltText" name="AltText" class="form-control-custom" placeholder="Enter alt text" />
                        <span class="error-msg" data-valmsg-for="AltText"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Sort Order</label>
                        <input type="number" id="SortOrder" name="SortOrder" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="SortOrder"></span>
                    </div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-calendar-days" style="color:var(--accent);margin-right:8px;"></i>Schedule</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Valid From</label>
                        <input type="datetime-local" id="ValidFrom" name="ValidFrom" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="ValidFrom"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Valid To</label>
                        <input type="datetime-local" id="ValidTo" name="ValidTo" class="form-control-custom" />
                        <span class="error-msg" data-valmsg-for="ValidTo"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Banner" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Banner"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
