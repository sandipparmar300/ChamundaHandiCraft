@model PagedResult<ApprovalGridItem>
@*
    Administration - Approvals listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Approvals";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Approvals</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Administration</li>
            <li>Approvals Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search request type or requester" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Approve Selected')"><i class="fas fa-check"></i> Approve Selected</button>
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Reject Selected')"><i class="fas fa-xmark"></i> Reject Selected</button>

            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="approval-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:170px;">Request Type</th>
                    <th style="min-width:200px;">Record</th>
                    <th style="min-width:180px;">Requested By</th>
                    <th style="min-width:150px;">Requested On</th>
                    <th style="min-width:180px;">Reason</th>
                    <th style="min-width:170px;">Approver</th>
                    <th style="min-width:150px;">Decided On</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td>@row.EntityType</td>
                        <td>@row.EntityName</td>
                        <td>@row.RequestedBy</td>
                        <td>@Money.Relative(row.RequestedOn)</td>
                        <td class="text-muted">@(row.Reason ?? "—")</td>
                        <td>@(row.DecidedBy ?? "—")</td>
                        <td>@(row.DecidedOn is null ? "—" : Money.LongDate(row.DecidedOn.Value))</td>
                        <td>
                            <span class="badge @(row.Status == "Pending" ? "bg-warning text-dark" : row.Status == "Approved" ? "bg-success" : "bg-secondary")">@row.Status</span>
                        </td>
                        <td><a asp-action="Details" asp-route-id="@row.Id" title="Review"><i class="fas fa-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" class="text-center py-4">Nothing waiting on approval.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AuditLog"); }

            datatable = $('#approval-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#approval-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Approval API.');
            }
        }
    </script>
}
