@model ApprovalGridItem
@{
    ViewData["Title"] = "Approval Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Approval" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Approval Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Approval" asp-action="Index" class="links">Approvals Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Approval Information</h2>

        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Request Type</label>
                        <p class="detail-value">@Model.EntityType</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Record</label>
                        <p class="detail-value">@Model.EntityName</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Requested By</label>
                        <p class="detail-value">@Model.RequestedBy</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Requested On</label>
                        <p class="detail-value">@Money.DateAndTime(Model.RequestedOn)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reason</label>
                        <p class="detail-value">@(Model.Reason ?? "—")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Approver</label>
                        <p class="detail-value">@(Model.DecidedBy ?? "Not yet decided")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Decided On</label>
                        <p class="detail-value">@(Model.DecidedOn is null ? "—" : Money.DateAndTime(Model.DecidedOn.Value))</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Decision Notes</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@Model.Status</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-AuditLog"); }
        });
    </script>
}
