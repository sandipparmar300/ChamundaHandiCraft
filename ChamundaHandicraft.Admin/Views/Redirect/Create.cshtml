@{
    ViewData["Title"] = "Redirect";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Redirect" : "Add Redirect";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Redirect" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Redirect" asp-action="Index" class="links">Redirects Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="redirectForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-signs-post" style="color:var(--accent);margin-right:8px;"></i>Redirect Rule</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-6 col-md-6">
                        <label class="form-label-custom">Source URL <span class="req">*</span></label>
                        <input id="SourceURL" name="SourceURL" class="form-control-custom" placeholder="Enter source url" />
                        <span class="error-msg" data-valmsg-for="SourceURL"></span>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <label class="form-label-custom">Destination URL <span class="req">*</span></label>
                        <input id="DestinationURL" name="DestinationURL" class="form-control-custom" placeholder="Enter destination url" />
                        <span class="error-msg" data-valmsg-for="DestinationURL"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Redirect Type <span class="req">*</span></label>
                        <select id="RedirectType" name="RedirectType" class="form-control-custom select2-single">
                            <option value="">Select redirect type</option>
                            <option>301 Permanent</option>
                            <option>302 Temporary</option>
                            <option>410 Gone</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="RedirectType"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Notes</label>
                        <textarea id="Notes" name="Notes" class="form-control-custom" rows="3" placeholder="Enter notes"></textarea>
                        <span class="error-msg" data-valmsg-for="Notes"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Redirect" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Seo"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
