@{
    var fullName = Context?.User?.FindFirst("FullName")?.Value ?? "Administrator";
    var roleName = Context?.User?.FindFirst("RoleName")?.Value ?? "Super Admin";
    var searchText = ViewBag.GlobalSearchText as string ?? "";
}

<header class="topbar">

    <button class="menu-bar-btn" id="toggleBtn" onclick="fnSidebarToggle(this)" title="Toggle Sidebar">
        <svg width="20" height="15" viewBox="0 0 20 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="20" height="2.2" rx="1.1" fill="currentColor" />
            <rect y="6.4" width="20" height="2.2" rx="1.1" fill="currentColor" />
            <rect y="12.8" width="20" height="2.2" rx="1.1" fill="currentColor" />
        </svg>
    </button>

    <div class="topbar-search">
        <span class="search-icon"><i class="fas fa-search"></i></span>

        <input type="text"
               id="globalSearchText"
               class="form-control"
               value="@searchText"
               placeholder="Search orders, products, customers..." />

        <span id="globalSearchButton" style="display:none;"></span>
    </div>

    <div class="topbar-actions">

        <div class="dropdown" id="notif-bell-wrap">
            <button class="topbar-icon-btn position-relative" id="notif-bell-btn"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-bell"></i>
                <span class="badge bg-danger position-absolute" id="notif-badge"
                      style="top:2px;right:2px;font-size:.6rem;padding:2px 5px;display:none;border-radius:10px;">0</span>
            </button>
            <div class="dropdown-menu dropdown-menu-end shadow" style="width:340px;max-height:420px;overflow-y:auto;padding:0;" id="notif-dropdown">
                <div class="d-flex justify-content-between align-items-center px-3 py-2" style="border-bottom:1px solid var(--border);background:var(--card-bg);">
                    <span style="font-weight:700;font-size:.88rem;"><i class="fas fa-bell me-1" style="color:var(--accent);"></i>Notifications</span>
                    <button class="btn btn-sm btn-link p-0" style="font-size:.75rem;">Mark all read</button>
                </div>
                <div id="notif-items">
                    <div class="text-center py-4 text-muted" style="font-size:.82rem;">No notifications</div>
                </div>
                <div class="text-center py-2" style="border-top:1px solid var(--border);">
                    <a asp-controller="Notification" asp-action="Index" style="font-size:.8rem;color:var(--accent);">View all notifications</a>
                </div>
            </div>
        </div>

        <div class="dropdown">

            <div class="topbar-user" data-bs-toggle="dropdown" aria-expanded="false" style="cursor:pointer;">

                <img src="~/assets/images/default-profile.png" alt="profile" />

                <div class="user-details">
                    <div class="t-name">@fullName</div>
                    <div class="t-role">@roleName</div>
                </div>

                <i class="fas fa-chevron-down"></i>
            </div>

            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profile</a></li>
                <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#logout-confirm-modal">
                        Logout
                    </a>
                </li>
            </ul>

        </div>

    </div>

</header>
