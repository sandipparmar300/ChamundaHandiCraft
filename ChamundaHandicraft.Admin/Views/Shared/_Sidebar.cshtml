<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Expand / collapse a submenu. The CSS rule that reveals it is
        // `.nav-item-wrapper.open > .sidebar-submenu`, so all this does is
        // toggle `open` on the wrapper.
        document.querySelectorAll('.toggle-submenu').forEach(function (item) {
            item.addEventListener('click', function (e) {
                e.preventDefault();

                var parent = this.closest('.nav-item-wrapper');

                // Accordion behaviour: only one group open at a time.
                document.querySelectorAll('.nav-item-wrapper').forEach(function (el) {
                    if (el !== parent) el.classList.remove('open');
                });

                parent.classList.toggle('open');
            });
        });

        // Highlight the link matching the current URL and open its parent group,
        // choosing the longest matching path so /Product/Add still lights up Products.
        var currentPath = window.location.pathname.toLowerCase();
        var bestMatch = null;
        var bestLength = 0;

        document.querySelectorAll('.sidebar-nav a.nav-item').forEach(function (a) {
            var href = a.getAttribute("href");
            if (!href || href.indexOf("javascript") === 0) return;

            var linkUrl;
            try {
                linkUrl = new URL(a.href, window.location.origin);
            } catch (ex) {
                return;
            }

            var linkPath = linkUrl.pathname.toLowerCase();

            if (currentPath === linkPath && linkPath.length >= bestLength) {
                bestMatch = a;
                bestLength = linkPath.length;
            } else if (currentPath.indexOf(linkPath) === 0 && linkPath.length > bestLength) {
                bestMatch = a;
                bestLength = linkPath.length;
            }
        });

        if (bestMatch) {
            bestMatch.classList.add('active');

            var wrapper = bestMatch.closest('.nav-item-wrapper');
            while (wrapper) {
                wrapper.classList.add('open');

                var topLink = wrapper.querySelector('a.nav-item.toggle-submenu, a.nav-item:not(.sub-item)');
                if (topLink) topLink.classList.add('active');

                wrapper = wrapper.parentElement ? wrapper.parentElement.closest('.nav-item-wrapper') : null;
            }
        }

    });
</script>
