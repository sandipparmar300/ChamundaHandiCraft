@model ZipCodeGridItem
@{
    ViewData["Title"] = "Pincode";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Pincode" : "Add Pincode";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="ZipCode" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="ZipCode" asp-action="Index" class="links">Pincodes Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="zipcodeForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-mailbox" style="color:var(--accent);margin-right:8px;"></i>Pincode Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Pincode <span class="req">*</span></label>
                        <input id="Pincode" name="Pincode" class="form-control-custom" placeholder="Enter pincode" / value="@Model.Pincode" >
                        <span class="error-msg" data-valmsg-for="Pincode"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">City <span class="req">*</span></label>
                        <select id="City" name="City" class="form-control-custom select2-single">
                            <option value="">Select city</option>
                            <option>Select city</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="City"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">State <span class="req">*</span></label>
                        <select id="State" name="State" class="form-control-custom select2-single">
                            <option value="">Select state</option>
                            <option>Select state</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="State"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Zone</label>
                        <select id="Zone" name="Zone" class="form-control-custom select2-single">
                            <option value="">Select zone</option>
                            <option>Select shipping zone</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Zone"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">COD Available</label>
                        <select id="CODAvailable" name="CODAvailable" class="form-control-custom select2-single">
                            <option value="">Select cod available</option>
                            <option>Yes</option>
                            <option>No</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="CODAvailable"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Delivery Days</label>
                        <input type="number" id="DeliveryDays" name="DeliveryDays" class="form-control-custom" placeholder="0" />
                        <span class="error-msg" data-valmsg-for="DeliveryDays"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="ZipCode" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Master"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
