@model PagedResult<ZipCodeGridItem>
@*
    Reference Data - Pincodes listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Pincodes";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Pincodes</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Reference Data</li>
            <li>Pincodes Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search pincode" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Import')"><i class="fas fa-file-import"></i> Import</button>
                <a asp-controller="ZipCode" asp-action="Add" class="custom_button primary_button">Add Pincode</a>
            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="zipcode-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:140px;">Pincode</th>
                    <th style="min-width:190px;">City</th>
                    <th style="min-width:180px;">State</th>
                    <th style="min-width:170px;">Zone</th>
                    <th style="min-width:150px;">COD Available</th>
                    <th style="min-width:160px;">Delivery Days</th>
                    <th style="min-width:130px;">Created At</th>
                    <th style="min-width:110px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Edit" asp-route-id="@row.Id">@row.Pincode</a></td>
                        <td>@row.CityName</td>
                        <td>@row.StateName</td>
                        <td>@(row.ZoneName ?? "—")</td>
                        <td>@await Html.PartialAsync("_YesNo", row.CodAvailable)</td>
                        @* This row is what the PDP PIN check and checkout answer from. *@
                        <td>@(row.IsServiceable ? row.StandardDeliveryDays + " days" : "Not serviced")</td>
                        <td>@Money.LongDate(row.CreatedOn)</td>
                        <td>@await Html.PartialAsync("_StatusPill", row.IsActive)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View" class="ms-2"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" class="text-center py-4">No PIN codes yet. <a asp-action="Add">Add the first one</a>.</td></tr>
                }
            </tbody>

        </table>
    </div>
</section>

<div class="modal delete-common-modal common-modal" id="zipcode-delete-confirm-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Confirmation</h3>
                <p>Are you sure you want to delete this record?</p>
                <p class="text-muted" style="font-size:.8rem;">Deletes are soft; the record stays available for reporting.</p>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-yes" class="custom_button primary_button" data-bs-dismiss="modal">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Master"); }

            datatable = $('#zipcode-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#zipcode-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Pincode API.');
            }
        }
    </script>
}
