@{
    ViewData["Title"] = "Notification Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Notification" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Notification Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Notification" asp-action="Index" class="links">Notifications Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Notification Information</h2>

        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Title</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Message</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Type</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Recipient</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Channel</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Sent On</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Read On</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Action URL</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Notification"); }
        });
    </script>
}
