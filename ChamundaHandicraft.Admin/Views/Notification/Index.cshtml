@*
    Insights - Notifications listing.  Spec: docs/Admin Flows/
*@
@{
    ViewData["Title"] = "Notifications";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Notifications</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Insights</li>
            <li>Notifications Listing</li>
        </ul>
    </div>
}

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search notification title or recipient" id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="custom_button secondary_button" onclick="toolbarAction('Mark All Read')"><i class="fas fa-check-double"></i> Mark All Read</button>

            </div>
        </div>
    </div>

    <div class="table-main">
        <table id="notification-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:240px;">Title</th>
                    <th style="min-width:300px;">Message</th>
                    <th style="min-width:150px;">Type</th>
                    <th style="min-width:180px;">Recipient</th>
                    <th style="min-width:140px;">Channel</th>
                    <th style="min-width:150px;">Sent On</th>
                    <th style="min-width:130px;">Status</th>
                    <th style="min-width:80px;">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        let datatable;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Notification"); }

            datatable = $('#notification-grid').DataTable({
                paging: true, ordering: true, filter: false, destroy: true,
                bLengthChange: false, pageLength: 10, scrollX: true, autoWidth: false,
                language: { emptyTable: "No records to show yet" },
                initComplete: function () {
                    const $w = $("#notification-grid").closest(".dataTables_wrapper");
                    if (!$w.parent().hasClass("tb-responsive")) { $w.wrap("<div class='tb-responsive'></div>"); }
                }
            });
        });

        function fnSearch(ctrl) {
            $("#clearSearch").toggle(($(ctrl).val() || '').length > 0);
            if (datatable) datatable.draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (datatable) datatable.draw();
        }

        function toolbarAction(name) {
            if (typeof showSuccessMessage === 'function') {
                showSuccessMessage(name + ' will be wired with the Notification API.');
            }
        }
    </script>
}
