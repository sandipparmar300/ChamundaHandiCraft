@{
    ViewData["Title"] = "Refund";
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    var heading = isEdit ? "Edit Refund" : "Add Refund";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Refund" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Refund" asp-action="Index" class="links">Refunds Listing</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form method="post" id="refundForm" enctype="multipart/form-data">

        <input type="hidden" id="Id" name="Id" value="0" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-rotate-left" style="color:var(--accent);margin-right:8px;"></i>Refund Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Refund Number <span class="req">*</span></label>
                        <input id="RefundNumber" name="RefundNumber" class="form-control-custom" placeholder="Enter refund number" />
                        <span class="error-msg" data-valmsg-for="RefundNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Order Number <span class="req">*</span></label>
                        <input id="OrderNumber" name="OrderNumber" class="form-control-custom" placeholder="Enter order number" />
                        <span class="error-msg" data-valmsg-for="OrderNumber"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Amount <span class="req">*</span></label>
                        <input id="Amount" name="Amount" class="form-control-custom" placeholder="0.00" />
                        <span class="error-msg" data-valmsg-for="Amount"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Refund Mode <span class="req">*</span></label>
                        <select id="RefundMode" name="RefundMode" class="form-control-custom select2-single">
                            <option value="">Select refund mode</option>
                            <option>Original Payment Method</option>
                            <option>Bank Transfer</option>
                            <option>Store Credit</option>
                            <option>Wallet</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="RefundMode"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reason <span class="req">*</span></label>
                        <select id="Reason" name="Reason" class="form-control-custom select2-single">
                            <option value="">Select reason</option>
                            <option>Return Approved</option>
                            <option>Order Cancelled</option>
                            <option>Damaged Item</option>
                            <option>Price Adjustment</option>
                            <option>Duplicate Payment</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Reason"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <select id="Status" name="Status" class="form-control-custom select2-single">
                            <option value="">Select status</option>
                            <option>Requested</option>
                            <option>Approved</option>
                            <option>Processing</option>
                            <option>Completed</option>
                            <option>Rejected</option>
                        </select>
                        <span class="error-msg" data-valmsg-for="Status"></span>
                    </div>

                    <div class="col-lg-12 col-md-6">
                        <label class="form-label-custom">Remarks</label>
                        <textarea id="Remarks" name="Remarks" class="form-control-custom" rows="3" placeholder="Enter remarks"></textarea>
                        <span class="error-msg" data-valmsg-for="Remarks"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Is Active</span>
                    <label class="ia-switch">
                        <input type="checkbox" id="IsActiveCheckbox" name="IsActive" checked />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">Active</span>
                </div>
            </div>

            <div>
                <a asp-controller="Refund" asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="button" class="btn-save">
                    <i class="fas fa-save"></i> @(isEdit ? "Update Changes" : "Save Changes")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Payment"); }
            $('#uploadBox').click(function () { $('#Photo').click(); });
        });

        function previewUpload(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function (e) { document.getElementById('ImagePreview').src = e.target.result; };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
