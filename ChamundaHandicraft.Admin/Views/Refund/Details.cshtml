@model RefundGridItem
@{
    ViewData["Title"] = "Refund Details";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Refund" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Refund Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Refund" asp-action="Index" class="links">Refunds Listing</a></li>
            <li>Details</li>
        </ul>
    </div>
}

<main class="page-content">

    <section class="form-section">
        <div class="form-section-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-circle-info" style="color:var(--accent);margin-right:8px;"></i>Refund Information</h2>
            <a asp-controller="Refund" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button secondary_button"><i class="fas fa-pen"></i> Edit</a>
        </div>

        <div class="form-section-body">
            <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Refund Number</label>
                        <p class="detail-value">@Model.RefundNumber</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Order Number</label>
                        <p class="detail-value">@Model.OrderNumber</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Customer</label>
                        <p class="detail-value">@Model.CustomerName</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Amount</label>
                        <p class="detail-value">@Money.Inr(Model.Amount)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Refund Mode</label>
                        <p class="detail-value">@Model.OriginalMethod</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Reason</label>
                        <p class="detail-value">@(Model.Reason ?? "—")</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Status</label>
                        <p class="detail-value">@Model.Status</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Requested On</label>
                        <p class="detail-value">@Money.LongDate(Model.RequestedOn)</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Approved By</label>
                        <p class="detail-value">&mdash;</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Processed On</label>
                        <p class="detail-value">@(Model.CompletedOn is null ? "—" : Money.LongDate(Model.CompletedOn.Value))</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Gateway Reference</label>
                        <p class="detail-value">@(Model.GatewayReference ?? "—")</p>
                    </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Payment"); }
        });
    </script>
}
