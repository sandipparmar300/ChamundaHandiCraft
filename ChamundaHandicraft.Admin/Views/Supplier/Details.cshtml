@model ChamundaHandicraft.Helper.ViewModel.Admin.SupplierDetailViewModel
@{
    ViewData["Title"] = $"Supplier: {Model.SupplierName}";
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Supplier" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">Supplier Details</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Supplier" asp-action="Index" class="links">Suppliers Listing</a></li>
            <li>@Model.SupplierName</li>
        </ul>
    </div>
}

<main class="page-content">
    <div class="row g-4">
        <!-- Summary Card -->
        <div class="col-lg-4 col-md-12">
            <div class="common-box p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width:56px; height:56px; color:var(--accent);">
                        <i class="fas fa-truck-loading fa-2x"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">@Model.SupplierName</h4>
                        <span class="badge bg-secondary font-12">@Model.Code</span>
                    </div>
                </div>

                <hr class="my-3" />

                <div class="mb-2">
                    <span class="text-muted font-12 d-block">Status</span>
                    @await Html.PartialAsync("_StatusPill", Model.IsActive)
                </div>

                <div class="mb-2">
                    <span class="text-muted font-12 d-block">Purchase Orders Raised</span>
                    <strong class="fs-5">@Model.PurchaseOrderCount</strong>
                </div>

                <div class="mb-3">
                    <span class="text-muted font-12 d-block">Outstanding Balance</span>
                    <strong class="fs-5 text-danger">@Money.Inr(Model.OutstandingAmount)</strong>
                </div>

                <div class="d-grid gap-2">
                    <a asp-controller="Supplier" asp-action="Edit" asp-route-id="@Model.Id" class="custom_button primary_button text-center">
                        <i class="fas fa-pen me-1"></i> Edit Supplier
                    </a>
                    <a asp-controller="Purchase" asp-action="Index" asp-route-supplierId="@Model.Id" class="btn btn-outline-secondary">
                        <i class="fas fa-file-invoice me-1"></i> View Purchase Orders
                    </a>
                </div>
            </div>
        </div>

        <!-- Details Card -->
        <div class="col-lg-8 col-md-12">
            <div class="common-box p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="fas fa-info-circle me-2" style="color:var(--accent);"></i>Supplier Information</h5>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">Contact Person</label>
                        <span class="fw-semibold">@(Model.ContactPerson ?? "—")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">Phone</label>
                        <span class="fw-semibold">@(Model.Phone ?? "—")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">Email</label>
                        <span class="fw-semibold">@(Model.Email ?? "—")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">GSTIN</label>
                        <span class="fw-semibold">@(Model.Gstin ?? "—")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">Payment Terms</label>
                        <span class="fw-semibold">@Model.PaymentTermsDays days</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">City &amp; State</label>
                        <span class="fw-semibold">@(string.Join(", ", new[] { Model.City, Model.StateName }.Where(s => !string.IsNullOrWhiteSpace(s))))</span>
                    </div>

                    <div class="col-12">
                        <label class="text-muted font-12 d-block">Address</label>
                        <span class="fw-semibold">@(Model.AddressLine1 ?? "—")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">Created On</label>
                        <span class="fw-semibold">@Model.CreatedOn.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted font-12 d-block">Last Updated</label>
                        <span class="fw-semibold">@(Model.UpdatedOn?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Inventory"); }
        });
    </script>
}
