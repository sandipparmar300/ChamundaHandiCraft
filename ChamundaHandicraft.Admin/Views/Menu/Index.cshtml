@model PagedResult<MenuGridItem>
@{
    ViewData["Title"] = "Menus";
}

@section Header {
    <div class="page-head">
        <div class="page-head-left">
            <h2 class="page-title">Menus</h2>
        </div>
        <ul class="page-breadcrumb">
            <li>Catalog</li>
            <li>Storefront Navigation Menus</li>
        </ul>
    </div>
}

@Html.AntiForgeryToken()

<section class="listing-section common-box">
    <div class="latest-orders">
        <div class="div-search-box-panel flex-ending-cls-here">
            <div class="listing-search d-flex align-items-center gap-2">
                <div class="search-box">
                    <span class="search-icon">
                        <img src="~/assets/images/search-icon.svg" width="16" height="16" alt="search">
                    </span>
                    <input placeholder="Search menu..." id="txtSearch" onkeyup="fnSearch(this);">
                    <span class="clear-icon" id="clearSearch" onclick="clearSearch()" style="display:none; cursor:pointer;">&#10006;</span>
                </div>

                <select id="locationFilter" class="form-select font-13" style="width: 160px; height: 42px;" onchange="filterLocation(this)">
                    <option value="">All Locations</option>
                    <option value="Header">Header</option>
                    <option value="MegaMenu">Mega Menu</option>
                    <option value="Footer">Footer</option>
                    <option value="Mobile">Mobile Drawer</option>
                </select>
            </div>

            <a asp-controller="Menu" asp-action="Add" class="custom_button primary_button">
                <i class="fas fa-plus me-1"></i> Add Menu Item
            </a>
        </div>
    </div>

    <div class="table-main">
        <table id="menu-grid" class="custom-datatable listing-order-table">
            <thead>
                <tr>
                    <th style="min-width:180px;">Menu Title</th>
                    <th style="min-width:120px;">Location</th>
                    <th style="min-width:200px;">Target URL</th>
                    <th style="min-width:140px;">Parent Menu</th>
                    <th style="min-width:90px;" class="text-end">Items</th>
                    <th style="min-width:90px;" class="text-center">Order</th>
                    <th style="min-width:100px;">Status</th>
                    <th style="min-width:110px; text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    var locBadgeClass = row.Location switch
                    {
                        "MegaMenu" => "bg-primary",
                        "Header" => "bg-info text-dark",
                        "Footer" => "bg-secondary",
                        "Mobile" => "bg-dark",
                        _ => "bg-light text-muted border"
                    };

                    <tr id="menu-row-@row.Id" data-location="@row.Location">
                        <td>
                            <a asp-action="Edit" asp-route-id="@row.Id" class="fw-semibold text-dark">@row.Title</a>
                            @if (!string.IsNullOrEmpty(row.Badge))
                            {
                                <span class="badge bg-danger font-10 ms-1">@row.Badge</span>
                            }
                        </td>
                        <td>
                            <span class="badge @locBadgeClass font-12">@row.Location</span>
                        </td>
                        <td class="t-mono font-12 text-secondary">
                            @(string.IsNullOrEmpty(row.Url) ? "—" : row.Url)
                            @if (row.OpensInNewTab)
                            {
                                <i class="fas fa-external-link-alt font-10 ms-1 text-muted" title="Opens in new tab"></i>
                            }
                        </td>
                        <td class="text-muted">@(string.IsNullOrEmpty(row.ParentTitle) ? "—" : row.ParentTitle)</td>
                        <td class="text-end fw-semibold">@row.ChildCount</td>
                        <td class="text-center">@row.SortOrder</td>
                        <td>@await Html.PartialAsync("_StatusPill", row.IsActive)</td>
                        <td class="text-center">
                            <a asp-action="Add" asp-route-parentId="@row.Id" class="btn btn-sm btn-white border py-0 px-2 font-11 text-primary shadow-sm" title="Add nested sub-item under @row.Title"><i class="fas fa-plus font-10 me-1"></i>Sub</a>
                            <a asp-action="Edit" asp-route-id="@row.Id" title="Edit" class="text-primary ms-1"><i class="fas fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@row.Id" title="View Details" class="ms-2 text-info"><i class="fas fa-eye"></i></a>
                            <a href="javascript:void(0);" onclick="confirmDeleteMenu(@row.Id, '@Html.Raw(Html.Encode(row.Title))', @row.ChildCount)" title="Delete" class="ms-2 text-danger"><i class="fas fa-trash-alt"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal delete-common-modal common-modal" id="menu-delete-confirm-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close-modal" data-bs-dismiss="modal" aria-label="Close">
                    <picture><img src="~/assets/images/close-icon.svg" alt="close" width="24" height="24"></picture>
                </button>
            </div>
            <div class="modal-body">
                <h3>Delete Menu Item</h3>
                <p>Are you sure you want to delete <strong id="deleteMenuTitle"></strong>?</p>
                <div id="deleteMenuWarning" class="alert alert-warning d-none font-12 text-start"></div>
                <div class="delete-edit-btn">
                    <button type="button" class="custom_button secondary_button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btn-delete-menu-yes" class="custom_button primary_button" onclick="executeDeleteMenu()">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let menuDataTable;
        let deleteMenuTargetId = 0;

        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Category"); }

            menuDataTable = $('#menu-grid').DataTable({
                paging: true,
                ordering: true,
                filter: true,
                dom: 't<"table-footer-controls d-flex justify-content-between align-items-center mt-3"ip>',
                bLengthChange: false,
                pageLength: 15,
                scrollX: true,
                autoWidth: false,
                language: {
                    emptyTable: 'No menu items yet. <a href="/Menu/Add">Add the first one</a>.',
                    zeroRecords: "No matching menu items found"
                }
            });
        });

        function fnSearch(ctrl) {
            var val = $(ctrl).val() || '';
            $("#clearSearch").toggle(val.length > 0);
            if (menuDataTable) menuDataTable.search(val).draw();
        }

        function clearSearch() {
            $("#txtSearch").val('');
            $("#clearSearch").hide();
            if (menuDataTable) menuDataTable.search('').draw();
        }

        function filterLocation(ctrl) {
            var loc = $(ctrl).val() || '';
            if (menuDataTable) {
                menuDataTable.column(1).search(loc).draw();
            }
        }

        function confirmDeleteMenu(id, title, childCount) {
            deleteMenuTargetId = id;
            $('#deleteMenuTitle').text(title);

            var $warn = $('#deleteMenuWarning');
            if (childCount > 0) {
                $warn.removeClass('d-none').html('<i class="fas fa-exclamation-triangle me-1"></i> This menu item contains <strong>' + childCount + ' sub-items</strong>. Deleting it will also remove its nested links.');
            } else {
                $warn.addClass('d-none').empty();
            }

            var modal = new bootstrap.Modal(document.getElementById('menu-delete-confirm-modal'));
            modal.show();
        }

        function executeDeleteMenu() {
            if (!deleteMenuTargetId) return;

            var token = $('input[name="__RequestVerificationToken"]').val();
            var $btn = $('#btn-delete-menu-yes');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Deleting...');

            $.ajax({
                url: '/Menu/Delete?id=' + deleteMenuTargetId,
                type: 'POST',
                headers: { 'RequestVerificationToken': token },
                success: function (res) {
                    $('#menu-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');

                    if (res.success) {
                        if (typeof showSuccessMessage === 'function') {
                            showSuccessMessage(res.message || 'Menu item deleted successfully.');
                        } else if (typeof Swal !== 'undefined') {
                            Swal.fire({ icon: 'success', title: 'Deleted', text: res.message || 'Menu item deleted successfully.', timer: 1500, showConfirmButton: false });
                        }
                        $('#menu-row-' + deleteMenuTargetId).fadeOut(400, function () {
                            if (menuDataTable) menuDataTable.row(this).remove().draw(false);
                        });
                    } else {
                        if (typeof showErrorMessage === 'function') {
                            showErrorMessage(res.message || 'Failed to delete menu item.');
                        } else if (typeof Swal !== 'undefined') {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'Failed to delete menu item.' });
                        } else {
                            alert(res.message || 'Failed to delete menu item.');
                        }
                    }
                },
                error: function (xhr) {
                    $('#menu-delete-confirm-modal').modal('hide');
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt me-1"></i> Delete');
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'An unexpected error occurred.';
                    if (typeof showErrorMessage === 'function') {
                        showErrorMessage(msg);
                    } else {
                        alert(msg);
                    }
                }
            });
        }
    </script>
}
