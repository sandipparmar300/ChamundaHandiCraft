@model MenuGridItem
@{
    var isEdit = Model.Id > 0;
    var heading = isEdit ? "Edit Menu Item" : "Add Menu Item";
    ViewData["Title"] = heading;
    var parents = ViewBag.Parents as List<IdNamePair> ?? new List<IdNamePair>();
    var categories = ViewBag.Categories as List<IdNamePair> ?? new List<IdNamePair>();
}

@section Header {
    <div class="page-head commondetails-page-cls">
        <div class="page-head-left">
            <a asp-controller="Menu" asp-action="Index">
                <picture><img src="~/assets/images/small-left-arrow.svg" alt="back" width="18" height="18" /></picture>
            </a>
            <h2 class="page-title">@heading</h2>
        </div>
        <ul class="page-breadcrumb">
            <li><a asp-controller="Menu" asp-action="Index" class="links">Menus</a></li>
            <li>@heading</li>
        </ul>
    </div>
}

<main class="page-content">

    <form asp-controller="Menu" asp-action="Save" method="post" id="menuForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedOn" />

        <section class="form-section">
            <div class="form-section-header">
                <h2><i class="fas fa-bars-staggered" style="color:var(--accent);margin-right:8px;"></i>Menu Information</h2>
            </div>

            <div class="form-section-body">
                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Menu Title <span class="req">*</span></label>
                        <input asp-for="Title" class="form-control-custom" placeholder="e.g. Home Décor" required />
                        <span class="text-danger font-12" asp-validation-for="Title"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Menu Location <span class="req">*</span></label>
                        <select asp-for="Location" class="form-control-custom select2-single" required>
                            <option value="Header">Header Navigation</option>
                            <option value="MegaMenu">Mega Menu Column</option>
                            <option value="Footer">Footer Column</option>
                            <option value="Mobile">Mobile Drawer</option>
                        </select>
                        <span class="text-danger font-12" asp-validation-for="Location"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Parent Menu Item</label>
                        <select asp-for="ParentId" class="form-control-custom select2-single">
                            <option value="">None (Top Level Root Item)</option>
                            @foreach (var parent in parents)
                            {
                                <option value="@parent.Id">@parent.Name</option>
                            }
                        </select>
                        <small class="text-muted font-11 d-block mt-1">
                            <i class="fas fa-info-circle me-1 text-primary"></i>
                            Leave as <strong>"None"</strong> for a main top-level menu item, or select a parent to create a nested sub-item under it.
                        </small>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <label class="form-label-custom">Target URL / Link Path <span class="req">*</span></label>
                        <input asp-for="Url" class="form-control-custom" placeholder="e.g. /c/home-decor or /about-us" required />
                        <span class="text-danger font-12" asp-validation-for="Url"></span>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label-custom">Link Type</label>
                        <select asp-for="LinkType" class="form-control-custom" id="selLinkType" onchange="onLinkTypeChange(this)">
                            <option value="Custom">Custom Link</option>
                            <option value="Category">Category Link</option>
                            <option value="CmsPage">CMS Page</option>
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6" id="categoryPickerWrapper" style="display:none;">
                        <label class="form-label-custom">Select Category</label>
                        <select class="form-control-custom" id="selCategory" onchange="onCategorySelected(this)">
                            <option value="">Choose category...</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Name">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Badge Text</label>
                        <input asp-for="Badge" class="form-control-custom" placeholder="e.g. New, Sale, Hot" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Display Order</label>
                        <input asp-for="SortOrder" type="number" class="form-control-custom" placeholder="0" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label-custom">Open in New Tab</label>
                        <select asp-for="OpensInNewTab" class="form-control-custom">
                            <option value="false">No (Open in Same Tab)</option>
                            <option value="true">Yes (Open in New Tab)</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label-custom">Description / Internal Notes</label>
                        <textarea asp-for="Description" class="form-control-custom" rows="2" placeholder="Optional notes for menu merchandising"></textarea>
                    </div>

                </div>
            </div>
        </section>

        <div class="form-action-bar">
            <div class="is-active-row" id="isActiveRow">
                <div class="is-toggle-item" id="isToggleItem">
                    <span class="ia-label">Status</span>
                    <label class="ia-switch">
                        <input type="checkbox" asp-for="IsActive" id="IsActiveCheckbox" />
                        <span class="ia-slider"></span>
                    </label>
                    <span class="ia-status" id="isActiveStatus">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Menu" asp-action="Index" class="custom_button secondary_button">Cancel</a>
                <button type="submit" class="custom_button primary_button" id="btnSubmit">
                    <i class="fas fa-save me-1"></i> @(isEdit ? "Update Menu" : "Save Menu")
                </button>
            </div>
        </div>

    </form>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            if (typeof fnSelectMenu === 'function') { fnSelectMenu("menu-Category"); }

            $('#IsActiveCheckbox').change(function () {
                $('#isActiveStatus').text(this.checked ? 'Active' : 'Inactive');
            });
        });

        function onLinkTypeChange(ctrl) {
            var val = $(ctrl).val();
            if (val === 'Category') {
                $('#categoryPickerWrapper').slideDown();
            } else {
                $('#categoryPickerWrapper').slideUp();
            }
        }

        function onCategorySelected(ctrl) {
            var catName = $(ctrl).val() || '';
            if (catName) {
                var slug = catName.toLowerCase().trim().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
                $('#Url').val('/c/' + slug);
            }
        }
    </script>
}
