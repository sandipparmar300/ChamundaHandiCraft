{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "The Admin panel never touches the database. Every read and write goes through the gateway.",
  "APIGatewayBaseUrl": "https://localhost:7138/",

  "Session": {
    "IdleTimeoutMinutes": 30
  },

  "TwoFactor": {
    "AesKey": "",
    "AesIV": ""
  },

  "Ui": {
    "DefaultPageSize": 25,
    "PageSizeOptions": [ 10, 25, 50, 100 ],
    "DateFormat": "dd MMM yyyy",
    "DateTimeFormat": "dd MMM yyyy HH:mm",
    "Currency": "INR",
    "CurrencySymbol": "₹",
    "Timezone": "India Standard Time"
  }
}
